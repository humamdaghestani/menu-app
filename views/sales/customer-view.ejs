<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= customer.name %> — <%= tenant.name %></title>
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    body{font-family:'Segoe UI',sans-serif;background:#0f0f1a;color:#e0e0e0;min-height:100vh;display:flex}
    .sidebar{width:220px;background:#1a1a2e;display:flex;flex-direction:column;position:fixed;top:0;left:0;bottom:0;z-index:100;padding:0 0 20px}
    .sidebar-brand{padding:20px 16px 16px;border-bottom:1px solid rgba(255,255,255,.07);display:flex;align-items:center;gap:10px}
    .sidebar-brand img{width:36px;height:36px;border-radius:8px;object-fit:cover}
    .brand-emoji{font-size:1.4rem}
    .brand-text h2{color:#fff;font-size:.88rem;font-weight:700;line-height:1.2}
    .brand-text span{color:#555;font-size:.72rem}
    .sidebar-nav{flex:1;padding:12px 10px;display:flex;flex-direction:column;gap:2px;overflow-y:auto}
    .sidebar-nav a,.sidebar-nav button{display:flex;align-items:center;gap:9px;padding:10px 12px;border-radius:9px;color:#888;text-decoration:none;font-size:.85rem;background:none;border:none;cursor:pointer;width:100%;transition:background .15s,color .15s;font-family:inherit}
    .sidebar-nav a:hover,.sidebar-nav button:hover{background:rgba(255,255,255,.07);color:#fff}
    .sidebar-nav a.active{background:#2563eb;color:#fff;font-weight:600}
    .sidebar-nav .icon{font-size:1rem;width:18px;text-align:center;flex-shrink:0}
    .sidebar-nav .divider{height:1px;background:rgba(255,255,255,.06);margin:4px 0}
    .sidebar-footer{padding:0 10px}
    .view-menu-btn{display:flex;align-items:center;justify-content:center;gap:8px;background:rgba(255,255,255,.06);color:#666;padding:9px;border-radius:9px;text-decoration:none;font-size:.8rem;transition:background .15s}
    .view-menu-btn:hover{background:rgba(255,255,255,.12);color:#fff}
    .main{margin-left:220px;flex:1;padding:28px;max-width:1100px}
    .btn{padding:7px 14px;border:none;border-radius:8px;cursor:pointer;font-size:.82rem;font-weight:600;font-family:inherit;text-decoration:none;display:inline-flex;align-items:center;gap:6px}
    .btn-primary{background:#2563eb;color:#fff}.btn-primary:hover{opacity:.88}
    .btn-ghost{background:rgba(255,255,255,.08);color:#ccc}.btn-ghost:hover{background:rgba(255,255,255,.14)}
    .btn-danger{background:rgba(231,76,60,.12);color:#e74c3c}
    .btn-sm{padding:4px 10px;font-size:.75rem}
    .topbar{display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;flex-wrap:wrap;gap:10px}
    .profile-card{background:#1a1a2e;border-radius:16px;border:1px solid #2a2a3e;padding:24px;display:flex;align-items:center;gap:20px;margin-bottom:20px}
    .avatar-lg{width:64px;height:64px;border-radius:50%;background:linear-gradient(135deg,#2563eb,#7c5cbf);display:flex;align-items:center;justify-content:center;font-size:1.6rem;font-weight:800;color:#fff;flex-shrink:0}
    .kpi-row{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px;margin-bottom:20px}
    .kpi{background:#1a1a2e;border-radius:12px;border:1px solid #2a2a3e;padding:15px 16px}
    .kpi-label{font-size:.65rem;text-transform:uppercase;color:#444;font-weight:700;margin-bottom:6px}
    .kpi-val{font-size:1.25rem;font-weight:800}
    .grid2{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px}
    @media(max-width:820px){.grid2{grid-template-columns:1fr}}
    .card{background:#1a1a2e;border-radius:14px;border:1px solid #2a2a3e;overflow:hidden}
    .card-head{padding:13px 18px;border-bottom:1px solid #2a2a3e;font-size:.88rem;font-weight:700;color:#fff;display:flex;align-items:center;justify-content:space-between}
    table{width:100%;border-collapse:collapse}
    td{padding:10px 14px;font-size:.83rem;color:#ccc;border-bottom:1px solid rgba(255,255,255,.04)}
    tr:last-child td{border-bottom:none}
    tr.clickable:hover td{background:rgba(255,255,255,.02);cursor:pointer}
    .empty{text-align:center;padding:40px 24px;color:#444;font-size:.82rem}
    .badge{display:inline-block;padding:2px 9px;border-radius:20px;font-size:.7rem;font-weight:700}
    .b-draft{background:rgba(255,255,255,.07);color:#666}
    .b-sent{background:rgba(37,99,235,.15);color:#60a5fa}
    .b-paid,.b-accepted{background:rgba(0,184,148,.12);color:#00b894}
    .b-overdue,.b-rejected{background:rgba(231,76,60,.12);color:#e74c3c}
    .b-partial{background:rgba(241,196,15,.12);color:#f1c40f}
    .b-expired{background:rgba(149,165,166,.12);color:#95a5a6}
    .progress-bar{height:4px;background:#2a2a3e;border-radius:2px;overflow:hidden;margin-top:3px;min-width:60px}
    .progress-fill{height:100%;border-radius:2px;background:#00b894}
    .alert{border-radius:10px;padding:10px 16px;font-size:.85rem;margin-bottom:16px}
    .alert-ok{background:rgba(0,184,148,.1);border:1px solid rgba(0,184,148,.25);color:#00b894}
    @media(max-width:768px){.sidebar{width:56px}.brand-text,.sidebar-nav span:not(.icon){display:none}.main{margin-left:56px;padding:16px}}
  </style>
</head>
<body>
<aside class="sidebar">
  <div class="sidebar-brand">
    <% if (tenant.logo_url) { %><img src="<%= tenant.logo_url %>" alt="" /><% } else { %><span class="brand-emoji">💼</span><% } %>
    <div class="brand-text"><h2><%= tenant.name %></h2><span>Sales</span></div>
  </div>
  <nav class="sidebar-nav">
    <a href="/admin"><span class="icon">🏠</span><span>Home</span></a>
    <div class="divider"></div>
    <a href="/sales"><span class="icon">📊</span><span>Dashboard</span></a>
    <a href="/sales/quotations"><span class="icon">📄</span><span>Quotations</span></a>
    <a href="/sales/invoices"><span class="icon">🧾</span><span>Invoices</span></a>
    <a href="/sales/returns"><span class="icon">↩️</span><span>Sales Returns</span></a>
    <a href="/sales/customers" class="active"><span class="icon">👥</span><span>Customers</span></a>
    <div class="divider"></div>
    <form method="POST" action="/admin/logout" style="margin-top:auto">
      <button type="submit"><span class="icon">🚪</span><span>Logout</span></button>
    </form>
  </nav>
  <div class="sidebar-footer">
    <a href="/?tenant=<%= tenant.subdomain %>" target="_blank" class="view-menu-btn"><span>🔗</span><span>View Menu</span></a>
  </div>
</aside>

<div class="main">
  <% if (locals.success) { %><div class="alert alert-ok">✓ <%= success %></div><% } %>

  <div class="topbar">
    <div style="display:flex;align-items:center;gap:10px">
      <a href="/sales/customers" class="btn btn-ghost">← Customers</a>
      <span style="font-size:1rem;font-weight:800;color:#fff"><%= customer.name %></span>
    </div>
    <div style="display:flex;gap:8px">
      <a href="/sales/invoices" class="btn btn-primary">+ New Invoice</a>
    </div>
  </div>

  <!-- Profile -->
  <div class="profile-card">
    <div class="avatar-lg"><%= customer.name.charAt(0).toUpperCase() %></div>
    <div style="flex:1">
      <div style="font-size:1.1rem;font-weight:800;color:#fff;margin-bottom:4px"><%= customer.name %></div>
      <% if (customer.phone) { %><div style="font-size:.82rem;color:#666;margin-bottom:2px">📞 <%= customer.phone %></div><% } %>
      <% if (customer.email) { %><div style="font-size:.82rem;color:#666;margin-bottom:2px">✉️ <%= customer.email %></div><% } %>
      <% if (customer.notes) { %><div style="font-size:.78rem;color:#444;margin-top:6px"><%= customer.notes %></div><% } %>
      <div style="font-size:.72rem;color:#333;margin-top:8px">Customer since <%= new Date(customer.created_at).toLocaleDateString('en-GB',{month:'long',year:'numeric'}) %></div>
    </div>
  </div>

  <!-- KPIs -->
  <%
    const totalBilled = invoices.reduce((s,i)=>s+parseFloat(i.total||0),0);
    const totalPaid   = invoices.reduce((s,i)=>s+parseFloat(i.paid_amount||0),0);
    const totalOwed   = Math.max(0, totalBilled - totalPaid);
    const overdueCount = invoices.filter(i => i.due_date && new Date(i.due_date)<new Date() && i.status!=='paid').length;
  %>
  <div class="kpi-row">
    <div class="kpi"><div class="kpi-label">Total Invoiced</div><div class="kpi-val" style="color:#fff"><%= tenant.currency||'' %><%= totalBilled.toLocaleString(undefined,{maximumFractionDigits:0}) %></div></div>
    <div class="kpi"><div class="kpi-label">Paid</div><div class="kpi-val" style="color:#00b894"><%= tenant.currency||'' %><%= totalPaid.toLocaleString(undefined,{maximumFractionDigits:0}) %></div></div>
    <div class="kpi"><div class="kpi-label">Outstanding</div><div class="kpi-val" style="color:<%= totalOwed>0?'#f1c40f':'#444' %>"><%= tenant.currency||'' %><%= totalOwed.toLocaleString(undefined,{maximumFractionDigits:0}) %></div></div>
    <div class="kpi"><div class="kpi-label">Overdue</div><div class="kpi-val" style="color:<%= overdueCount>0?'#e74c3c':'#444' %>"><%= overdueCount %></div></div>
    <div class="kpi"><div class="kpi-label">Quotations</div><div class="kpi-val" style="color:#60a5fa"><%= quotations.length %></div></div>
  </div>

  <div class="grid2">
    <!-- Invoices -->
    <div class="card">
      <div class="card-head">🧾 Invoices (<%= invoices.length %>)</div>
      <% if (!invoices.length) { %>
      <div class="empty">No invoices for this customer.</div>
      <% } else { invoices.forEach(inv => {
           const isOverdue = inv.due_date && new Date(inv.due_date)<new Date() && inv.status!=='paid';
           const dispStatus = isOverdue ? 'overdue' : inv.status;
           const pct = parseFloat(inv.total)>0 ? Math.min(100,Math.round(parseFloat(inv.paid_amount||0)/parseFloat(inv.total)*100)) : 0;
      %>
      <tr class="clickable" onclick="window.location='/sales/invoices/<%= inv.id %>'">
        <td>
          <div style="color:#60a5fa;font-weight:700"><%= inv.invoice_no %></div>
          <div style="font-size:.72rem;color:#444"><%= new Date(inv.invoice_date).toLocaleDateString() %></div>
        </td>
        <td style="text-align:right">
          <div style="font-weight:700;color:#fff"><%= tenant.currency||'' %><%= parseFloat(inv.total||0).toFixed(2) %></div>
          <div class="progress-bar"><div class="progress-fill" style="width:<%= pct %>%"></div></div>
        </td>
        <td><span class="badge b-<%= dispStatus %>"><%= dispStatus %></span></td>
      </tr>
      <% }) } %>
    </div>

    <!-- Quotations -->
    <div class="card">
      <div class="card-head">📄 Quotations (<%= quotations.length %>)</div>
      <% if (!quotations.length) { %>
      <div class="empty">No quotations for this customer.</div>
      <% } else { quotations.forEach(q => { %>
      <tr class="clickable" onclick="window.location='/sales/quotations/<%= q.id %>'">
        <td>
          <div style="color:#a78bdf;font-weight:700"><%= q.quotation_no %></div>
          <div style="font-size:.72rem;color:#444"><%= new Date(q.quotation_date).toLocaleDateString() %></div>
        </td>
        <td style="text-align:right">
          <div style="font-weight:700;color:#fff"><%= tenant.currency||'' %><%= parseFloat(q.total||0).toFixed(2) %></div>
        </td>
        <td><span class="badge b-<%= q.status %>"><%= q.status %></span></td>
      </tr>
      <% }) } %>
    </div>
  </div>
</div>
</body>
</html>
