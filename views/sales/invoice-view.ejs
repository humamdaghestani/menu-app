<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= invoice.invoice_no %> — <%= tenant.name %></title>
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    body{font-family:'Segoe UI',sans-serif;background:#0f0f1a;color:#e0e0e0;min-height:100vh;display:flex}
    .sidebar{width:220px;background:#1a1a2e;display:flex;flex-direction:column;position:fixed;top:0;left:0;bottom:0;z-index:100;padding:0 0 20px}
    .sidebar-brand{padding:20px 16px 16px;border-bottom:1px solid rgba(255,255,255,.07);display:flex;align-items:center;gap:10px}
    .sidebar-brand img{width:36px;height:36px;border-radius:8px;object-fit:cover}
    .brand-emoji{font-size:1.4rem}
    .brand-text h2{color:#fff;font-size:.88rem;font-weight:700;line-height:1.2}
    .brand-text span{color:#555;font-size:.72rem}
    .sidebar-nav{flex:1;padding:12px 10px;display:flex;flex-direction:column;gap:2px;overflow-y:auto}
    .sidebar-nav a,.sidebar-nav button{display:flex;align-items:center;gap:9px;padding:10px 12px;border-radius:9px;color:#888;text-decoration:none;font-size:.85rem;background:none;border:none;cursor:pointer;width:100%;transition:background .15s,color .15s;font-family:inherit}
    .sidebar-nav a:hover,.sidebar-nav button:hover{background:rgba(255,255,255,.07);color:#fff}
    .sidebar-nav a.active{background:#2563eb;color:#fff;font-weight:600}
    .sidebar-nav .icon{font-size:1rem;width:18px;text-align:center;flex-shrink:0}
    .sidebar-nav .divider{height:1px;background:rgba(255,255,255,.06);margin:4px 0}
    .sidebar-footer{padding:0 10px}
    .view-menu-btn{display:flex;align-items:center;justify-content:center;gap:8px;background:rgba(255,255,255,.06);color:#666;padding:9px;border-radius:9px;text-decoration:none;font-size:.8rem;transition:background .15s}
    .view-menu-btn:hover{background:rgba(255,255,255,.12);color:#fff}
    .main{margin-left:220px;flex:1;padding:28px}
    .btn{padding:7px 14px;border:none;border-radius:8px;cursor:pointer;font-size:.82rem;font-weight:600;font-family:inherit;text-decoration:none;display:inline-flex;align-items:center;gap:6px;transition:opacity .15s}
    .btn-primary{background:#2563eb;color:#fff}.btn-primary:hover{opacity:.88}
    .btn-success{background:#00b894;color:#fff}.btn-success:hover{opacity:.88}
    .btn-warn{background:rgba(241,196,15,.15);color:#f1c40f}
    .btn-danger{background:rgba(231,76,60,.12);color:#e74c3c}
    .btn-ghost{background:rgba(255,255,255,.08);color:#ccc}.btn-ghost:hover{background:rgba(255,255,255,.14);color:#fff}
    .topbar{display:flex;align-items:center;justify-content:space-between;margin-bottom:22px;gap:12px;flex-wrap:wrap}
    .topbar-left{display:flex;align-items:center;gap:12px}
    .badge{display:inline-block;padding:4px 12px;border-radius:20px;font-size:.75rem;font-weight:700}
    .b-draft{background:rgba(255,255,255,.07);color:#666}
    .b-sent{background:rgba(37,99,235,.15);color:#60a5fa}
    .b-paid{background:rgba(0,184,148,.12);color:#00b894}
    .b-overdue{background:rgba(231,76,60,.12);color:#e74c3c}
    .b-partial{background:rgba(241,196,15,.12);color:#f1c40f}
    .alert{border-radius:10px;padding:10px 16px;font-size:.85rem;margin-bottom:16px}
    .alert-ok{background:rgba(0,184,148,.1);border:1px solid rgba(0,184,148,.25);color:#00b894}
    .alert-err{background:rgba(231,76,60,.1);border:1px solid rgba(231,76,60,.25);color:#e74c3c}
    .doc{background:#1a1a2e;border-radius:16px;border:1px solid #2a2a3e;padding:32px;max-width:860px;margin-bottom:24px}
    .doc-header{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:28px;padding-bottom:24px;border-bottom:1px solid #2a2a3e}
    .doc-logo{width:60px;height:60px;border-radius:12px;object-fit:cover}
    .doc-logo-ph{width:60px;height:60px;border-radius:12px;background:#2a2a3e;display:flex;align-items:center;justify-content:center;font-size:1.5rem}
    .doc-company h1{font-size:1rem;font-weight:700;color:#fff}
    .doc-company p{font-size:.78rem;color:#444;margin-top:2px}
    .doc-title{text-align:right}
    .doc-title h2{font-size:1.4rem;font-weight:800;color:#fff;margin-bottom:4px}
    .doc-title .inv-no{color:#2563eb;font-size:1rem;font-weight:700}
    .doc-meta{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:24px}
    .meta-box h4{font-size:.65rem;text-transform:uppercase;color:#444;font-weight:700;margin-bottom:8px}
    .meta-box .name{font-size:.95rem;font-weight:700;color:#fff;margin-bottom:2px}
    .meta-box .info{font-size:.8rem;color:#666}
    .meta-dates{display:flex;gap:20px;flex-wrap:wrap}
    .meta-date{background:#0f0f1a;border-radius:8px;padding:10px 14px}
    .meta-date .lbl{font-size:.65rem;text-transform:uppercase;color:#444;font-weight:700;margin-bottom:3px}
    .meta-date .val{font-size:.88rem;font-weight:700;color:#fff}
    .items-section table{width:100%;border-collapse:collapse}
    .items-section th{text-align:left;font-size:.67rem;text-transform:uppercase;color:#444;font-weight:700;padding:8px 12px;border-bottom:2px solid #2a2a3e}
    .items-section td{padding:10px 12px;font-size:.85rem;border-bottom:1px solid rgba(255,255,255,.04);color:#ccc}
    .items-section tr:last-child td{border-bottom:none}
    .totals-block{margin-left:auto;margin-top:16px;width:280px}
    .trow{display:flex;justify-content:space-between;padding:5px 0;font-size:.85rem;color:#666}
    .trow.big{font-size:1rem;font-weight:800;color:#fff;border-top:1px solid #2a2a3e;padding-top:10px;margin-top:4px}
    .trow.paid-row{color:#00b894}
    .trow.owed-row{color:#f1c40f;font-weight:700}
    .notes-block{margin-top:20px;padding-top:16px;border-top:1px solid #2a2a3e;font-size:.82rem;color:#555;white-space:pre-wrap}
    .payment-card{background:#1a1a2e;border-radius:16px;border:1px solid #2a2a3e;padding:24px;max-width:860px;margin-bottom:24px}
    .payment-card h3{font-size:.9rem;font-weight:700;color:#fff;margin-bottom:16px}
    .pay-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;align-items:end}
    .fg{display:flex;flex-direction:column;gap:4px}
    .fl{font-size:.7rem;font-weight:700;text-transform:uppercase;color:#555}
    input[type=number],input[type=date]{width:100%;background:#0f0f1a;border:1.5px solid #2a2a3e;color:#fff;padding:8px 10px;border-radius:8px;font-family:inherit;font-size:.85rem;outline:none}
    input:focus{border-color:#2563eb}
    .status-flow{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:8px}
    .step{background:#2a2a3e;color:#666;padding:6px 14px;border-radius:20px;font-size:.78rem;font-weight:600;position:relative}
    .step.done{background:rgba(0,184,148,.15);color:#00b894}
    .step.active{background:#2563eb;color:#fff}
    .step.bad{background:rgba(231,76,60,.15);color:#e74c3c}
    @media print{
      body{background:#fff;color:#000;display:block}
      .sidebar,.topbar .btn,.payment-card,.no-print{display:none!important}
      .main{margin-left:0;padding:0}
      .doc{border:none;padding:0;background:#fff}
      .doc-header,.doc-meta,.meta-date,.notes-block{color:#000}
      .doc-company h1,.doc-title h2,.meta-box .name{color:#000}
      .doc-company p,.meta-box .info,.meta-date .lbl,.trow{color:#444}
      .meta-date{background:#f5f5f5}
      .doc-logo-ph{background:#eee}
      .items-section th,.trow.big{color:#000}
      .trow.paid-row,.trow.owed-row{color:#555}
    }
    @media(max-width:768px){.sidebar{width:56px}.brand-text,.sidebar-nav span:not(.icon){display:none}.main{margin-left:56px;padding:16px}}
  </style>
</head>
<body>
<aside class="sidebar">
  <div class="sidebar-brand">
    <% if (tenant.logo_url) { %><img src="<%= tenant.logo_url %>" alt="" /><% } else { %><span class="brand-emoji">💼</span><% } %>
    <div class="brand-text"><h2><%= tenant.name %></h2><span>Sales</span></div>
  </div>
  <nav class="sidebar-nav">
    <a href="/admin"><span class="icon">🏠</span><span>Home</span></a>
    <div class="divider"></div>
    <a href="/sales"><span class="icon">📊</span><span>Dashboard</span></a>
    <a href="/sales/quotations"><span class="icon">📄</span><span>Quotations</span></a>
    <a href="/sales/invoices" class="active"><span class="icon">🧾</span><span>Invoices</span></a>
    <a href="/sales/returns"><span class="icon">↩️</span><span>Sales Returns</span></a>
    <a href="/sales/customers"><span class="icon">👥</span><span>Customers</span></a>
    <div class="divider"></div>
    <form method="POST" action="/admin/logout" style="margin-top:auto">
      <button type="submit"><span class="icon">🚪</span><span>Logout</span></button>
    </form>
  </nav>
  <div class="sidebar-footer">
    <a href="/?tenant=<%= tenant.subdomain %>" target="_blank" class="view-menu-btn"><span>🔗</span><span>View Menu</span></a>
  </div>
</aside>

<div class="main">
  <% const isOverdue = invoice.due_date && new Date(invoice.due_date)<new Date() && invoice.status!=='paid'; %>
  <% const displayStatus = isOverdue && invoice.status!=='paid' ? 'overdue' : invoice.status; %>

  <% if (locals.success) { %><div class="alert alert-ok">✓ <%= success %></div><% } %>
  <% if (locals.error)   { %><div class="alert alert-err">✗ <%= error %></div><% } %>

  <div class="topbar no-print">
    <div class="topbar-left">
      <a href="/sales/invoices" class="btn btn-ghost">← Back</a>
      <span style="font-size:1rem;font-weight:800;color:#fff"><%= invoice.invoice_no %></span>
      <span class="badge b-<%= displayStatus %>"><%= displayStatus %></span>
    </div>
    <div style="display:flex;gap:8px;flex-wrap:wrap">
      <% if (invoice.status==='draft') { %>
      <form method="POST" action="/sales/invoices/<%= invoice.id %>/status">
        <input type="hidden" name="status" value="sent" />
        <button type="submit" class="btn btn-primary">Mark Sent</button>
      </form>
      <% } %>
      <% if (invoice.status==='sent'||invoice.status==='partial'||displayStatus==='overdue') { %>
      <form method="POST" action="/sales/invoices/<%= invoice.id %>/status">
        <input type="hidden" name="status" value="paid" />
        <button type="submit" class="btn btn-success">Mark Fully Paid</button>
      </form>
      <% } %>
      <button onclick="window.print()" class="btn btn-ghost">🖨 Print</button>
      <form method="POST" action="/sales/invoices/<%= invoice.id %>/delete" onsubmit="return confirm('Delete invoice?')">
        <button type="submit" class="btn btn-danger">Delete</button>
      </form>
    </div>
  </div>

  <!-- Status flow -->
  <div class="status-flow no-print">
    <div class="step <%= invoice.status==='draft'?'active':'done' %>">Draft</div>
    <span style="color:#444">→</span>
    <div class="step <%= invoice.status==='sent'||invoice.status==='partial'?'active':invoice.status==='paid'?'done':'' %>">Sent</div>
    <span style="color:#444">→</span>
    <% if (isOverdue) { %><div class="step bad">Overdue</div><span style="color:#444">→</span><% } %>
    <div class="step <%= invoice.status==='partial'?'active':'' %>">Partial</div>
    <span style="color:#444">→</span>
    <div class="step <%= invoice.status==='paid'?'done active':'' %>">Paid ✓</div>
  </div>

  <!-- Payment recording (shown when not fully paid) -->
  <% const totalNum = parseFloat(invoice.total||0); const paidNum = parseFloat(invoice.paid_amount||0); const owed = Math.max(0,totalNum-paidNum); %>
  <% if (invoice.status !== 'paid' && owed > 0) { %>
  <div class="payment-card no-print">
    <h3>💳 Record Payment</h3>
    <form method="POST" action="/sales/invoices/<%= invoice.id %>/status">
      <div class="pay-grid">
        <div class="fg"><div class="fl">Amount Received</div><input type="number" name="payment_amount" value="<%= owed.toFixed(2) %>" min="0.01" step="0.01" /></div>
        <div class="fg"><div class="fl">Payment Method</div>
          <select name="payment_method" style="background:#0f0f1a;border:1.5px solid #2a2a3e;color:#fff;padding:8px 10px;border-radius:8px;font-family:inherit;font-size:.85rem;outline:none;width:100%">
            <option>Cash</option><option>Bank Transfer</option><option>Cheque</option><option>Card</option>
          </select>
        </div>
        <button type="submit" class="btn btn-success">Save Payment</button>
      </div>
      <div style="margin-top:8px;font-size:.78rem;color:#555">
        Total: <strong style="color:#fff"><%= tenant.currency||'' %><%= totalNum.toFixed(2) %></strong> &nbsp;|&nbsp;
        Paid: <strong style="color:#00b894"><%= tenant.currency||'' %><%= paidNum.toFixed(2) %></strong> &nbsp;|&nbsp;
        Remaining: <strong style="color:#f1c40f"><%= tenant.currency||'' %><%= owed.toFixed(2) %></strong>
      </div>
    </form>
  </div>
  <% } %>

  <!-- Invoice document -->
  <div class="doc">
    <div class="doc-header">
      <div style="display:flex;align-items:center;gap:16px">
        <% if (tenant.logo_url) { %><img class="doc-logo" src="<%= tenant.logo_url %>" alt="" /><% } else { %><div class="doc-logo-ph">🏪</div><% } %>
        <div class="doc-company">
          <h1><%= tenant.name %></h1>
          <p><%= tenant.description||'' %></p>
          <% if (tenant.whatsapp) { %><p>📞 <%= tenant.whatsapp %></p><% } %>
        </div>
      </div>
      <div class="doc-title">
        <h2>INVOICE</h2>
        <div class="inv-no"><%= invoice.invoice_no %></div>
        <div style="margin-top:8px;font-size:.78rem;color:#555">Issued: <%= new Date(invoice.invoice_date).toLocaleDateString() %></div>
        <% if (invoice.due_date) { %>
        <div style="font-size:.78rem;color:<%= isOverdue?'#e74c3c':'#555' %>">Due: <%= new Date(invoice.due_date).toLocaleDateString() %><%= isOverdue?' ⚠ OVERDUE':'' %></div>
        <% } %>
      </div>
    </div>

    <div class="doc-meta">
      <div class="meta-box">
        <h4>Bill To</h4>
        <div class="name"><%= invoice.customer_name||'—' %></div>
        <% if (invoice.customer_phone) { %><div class="info">📞 <%= invoice.customer_phone %></div><% } %>
      </div>
      <div style="text-align:right">
        <div class="meta-dates">
          <div class="meta-date"><div class="lbl">Status</div><div class="val"><%= displayStatus.toUpperCase() %></div></div>
          <div class="meta-date"><div class="lbl">Amount Due</div><div class="val" style="color:<%= invoice.status==='paid'?'#00b894':'#f1c40f' %>"><%= tenant.currency||'' %><%= owed.toFixed(2) %></div></div>
        </div>
      </div>
    </div>

    <div class="items-section">
      <table>
        <thead>
          <tr>
            <th>#</th>
            <th>Description</th>
            <th style="text-align:right">Qty</th>
            <th style="text-align:right">Unit Price</th>
            <th style="text-align:right">Total</th>
          </tr>
        </thead>
        <tbody>
          <% const items = Array.isArray(invoice.items)?invoice.items:[];
             items.forEach((it,i) => {
               const lTotal = parseFloat(it.qty||1)*parseFloat(it.price||0);
          %>
          <tr>
            <td style="color:#444"><%= i+1 %></td>
            <td style="color:#fff;font-weight:500"><%= it.name||'—' %></td>
            <td style="text-align:right"><%= parseFloat(it.qty||1).toFixed(2) %></td>
            <td style="text-align:right"><%= tenant.currency||'' %><%= parseFloat(it.price||0).toFixed(2) %></td>
            <td style="text-align:right;font-weight:600"><%= tenant.currency||'' %><%= lTotal.toFixed(2) %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>

      <div class="totals-block">
        <% const subtotal = parseFloat(invoice.subtotal||0);
           const discPct  = parseFloat(invoice.discount_pct||0);
           const taxPct   = parseFloat(invoice.tax_pct||0);
           const discAmt  = subtotal * discPct / 100;
           const taxAmt   = (subtotal - discAmt) * taxPct / 100;
        %>
        <div class="trow"><span>Subtotal</span><span><%= tenant.currency||'' %><%= subtotal.toFixed(2) %></span></div>
        <% if (discPct>0) { %><div class="trow"><span>Discount (<%= discPct %>%)</span><span style="color:#e74c3c">−<%= tenant.currency||'' %><%= discAmt.toFixed(2) %></span></div><% } %>
        <% if (taxPct>0)  { %><div class="trow"><span>Tax (<%= taxPct %>%)</span><span>+<%= tenant.currency||'' %><%= taxAmt.toFixed(2) %></span></div><% } %>
        <div class="trow big"><span>Total</span><span><%= tenant.currency||'' %><%= totalNum.toFixed(2) %></span></div>
        <% if (paidNum>0) { %>
        <div class="trow paid-row"><span>Paid</span><span>−<%= tenant.currency||'' %><%= paidNum.toFixed(2) %></span></div>
        <div class="trow owed-row"><span>Balance Due</span><span><%= tenant.currency||'' %><%= owed.toFixed(2) %></span></div>
        <% } %>
      </div>
    </div>

    <% if (invoice.notes) { %>
    <div class="notes-block"><strong style="color:#ccc;font-size:.8rem;display:block;margin-bottom:6px">Notes / Payment Terms</strong><%= invoice.notes %></div>
    <% } %>
  </div>
</div>
</body>
</html>
