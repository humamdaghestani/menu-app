<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sales — <%= tenant.name %></title>
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    body{font-family:'Segoe UI',sans-serif;background:#0f0f1a;color:#e0e0e0;min-height:100vh;display:flex}
    /* Sidebar */
    .sidebar{width:220px;background:#1a1a2e;display:flex;flex-direction:column;position:fixed;top:0;left:0;bottom:0;z-index:100;padding:0 0 20px}
    .sidebar-brand{padding:20px 16px 16px;border-bottom:1px solid rgba(255,255,255,.07);display:flex;align-items:center;gap:10px}
    .sidebar-brand img{width:36px;height:36px;border-radius:8px;object-fit:cover}
    .brand-emoji{font-size:1.4rem}
    .brand-text h2{color:#fff;font-size:.88rem;font-weight:700;line-height:1.2}
    .brand-text span{color:#555;font-size:.72rem}
    .sidebar-nav{flex:1;padding:12px 10px;display:flex;flex-direction:column;gap:2px;overflow-y:auto}
    .sidebar-nav a,.sidebar-nav button{display:flex;align-items:center;gap:9px;padding:10px 12px;border-radius:9px;color:#888;text-decoration:none;font-size:.85rem;background:none;border:none;cursor:pointer;width:100%;transition:background .15s,color .15s;font-family:inherit}
    .sidebar-nav a:hover,.sidebar-nav button:hover{background:rgba(255,255,255,.07);color:#fff}
    .sidebar-nav a.active{background:#2563eb;color:#fff;font-weight:600}
    .sidebar-nav .icon{font-size:1rem;width:18px;text-align:center;flex-shrink:0}
    .sidebar-nav .divider{height:1px;background:rgba(255,255,255,.06);margin:4px 0}
    .sidebar-footer{padding:0 10px}
    .view-menu-btn{display:flex;align-items:center;justify-content:center;gap:8px;background:rgba(255,255,255,.06);color:#666;padding:9px;border-radius:9px;text-decoration:none;font-size:.8rem;transition:background .15s}
    .view-menu-btn:hover{background:rgba(255,255,255,.12);color:#fff}
    /* Main */
    .main{margin-left:220px;flex:1;padding:28px;max-width:1100px}
    .page-header{margin-bottom:24px}
    .page-header h1{font-size:1.4rem;font-weight:800;color:#fff}
    .page-header p{color:#555;font-size:.82rem;margin-top:3px}
    /* Filter */
    .filter-bar{display:flex;gap:8px;align-items:flex-end;flex-wrap:wrap;margin-bottom:20px}
    .fg{display:flex;flex-direction:column;gap:3px}
    .fl{font-size:.65rem;font-weight:700;text-transform:uppercase;color:#444;letter-spacing:.3px}
    input[type=date]{background:#1a1a2e;border:1.5px solid #2a2a3e;color:#fff;padding:6px 10px;border-radius:8px;font-family:inherit;font-size:.8rem;outline:none}
    .btn{padding:7px 14px;border:none;border-radius:8px;cursor:pointer;font-size:.82rem;font-weight:600;font-family:inherit;text-decoration:none;display:inline-flex;align-items:center;gap:6px}
    .btn-primary{background:#2563eb;color:#fff}.btn-primary:hover{opacity:.88}
    .btn-ghost{background:rgba(255,255,255,.08);color:#ccc}.btn-ghost:hover{background:rgba(255,255,255,.14);color:#fff}
    /* KPIs */
    .kpi-row{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:14px;margin-bottom:24px}
    .kpi{background:#1a1a2e;border-radius:12px;border:1px solid #2a2a3e;padding:18px 20px}
    .kpi-label{font-size:.67rem;text-transform:uppercase;color:#444;font-weight:700;margin-bottom:8px}
    .kpi-val{font-size:1.5rem;font-weight:800}
    .kpi-sub{font-size:.72rem;color:#444;margin-top:4px}
    /* Module cards */
    .modules{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:14px;margin-bottom:28px}
    .mod-card{background:#1a1a2e;border:1px solid #2a2a3e;border-radius:14px;padding:20px 18px;text-decoration:none;color:#ccc;transition:border-color .15s,transform .15s;display:flex;flex-direction:column;gap:6px}
    .mod-card:hover{border-color:#2563eb;transform:translateY(-2px);color:#fff}
    .mod-icon{font-size:1.8rem;margin-bottom:4px}
    .mod-name{font-size:.95rem;font-weight:700;color:#fff}
    .mod-desc{font-size:.75rem;color:#555;line-height:1.4}
    /* Recent tables */
    .grid2{display:grid;grid-template-columns:1fr 1fr;gap:16px}
    @media(max-width:820px){.grid2{grid-template-columns:1fr}}
    .card{background:#1a1a2e;border-radius:12px;border:1px solid #2a2a3e;overflow:hidden}
    .card-head{padding:12px 16px;border-bottom:1px solid #2a2a3e;font-size:.85rem;font-weight:700;color:#fff;display:flex;justify-content:space-between;align-items:center}
    table{width:100%;border-collapse:collapse}
    td{padding:9px 14px;font-size:.8rem;color:#888;border-bottom:1px solid rgba(255,255,255,.03)}
    tr:last-child td{border-bottom:none}
    tr:hover td{background:rgba(255,255,255,.02)}
    .badge{display:inline-block;padding:2px 8px;border-radius:12px;font-size:.68rem;font-weight:700}
    .b-draft{background:rgba(255,255,255,.07);color:#666}
    .b-sent{background:rgba(37,99,235,.15);color:#60a5fa}
    .b-accepted,.b-paid{background:rgba(0,184,148,.12);color:#00b894}
    .b-rejected,.b-overdue{background:rgba(231,76,60,.12);color:#e74c3c}
    .b-expired{background:rgba(149,165,166,.12);color:#95a5a6}
    @media(max-width:768px){.sidebar{width:56px}.brand-text,.sidebar-nav span:not(.icon){display:none}.main{margin-left:56px;padding:16px}}
  </style>
</head>
<body>
<aside class="sidebar">
  <div class="sidebar-brand">
    <% if (tenant.logo_url) { %><img src="<%= tenant.logo_url %>" alt="" /><% } else { %><span class="brand-emoji">💼</span><% } %>
    <div class="brand-text"><h2><%= tenant.name %></h2><span>Sales</span></div>
  </div>
  <nav class="sidebar-nav">
    <a href="/admin"><span class="icon">🏠</span><span>Home</span></a>
    <div class="divider"></div>
    <a href="/sales" class="active"><span class="icon">📊</span><span>Dashboard</span></a>
    <a href="/sales/quotations"><span class="icon">📄</span><span>Quotations</span></a>
    <a href="/sales/invoices"><span class="icon">🧾</span><span>Invoices</span></a>
    <a href="/sales/returns"><span class="icon">↩️</span><span>Sales Returns</span></a>
    <a href="/sales/customers"><span class="icon">👥</span><span>Customers</span></a>
    <div class="divider"></div>
    <form method="POST" action="/admin/logout" style="margin-top:auto">
      <button type="submit"><span class="icon">🚪</span><span>Logout</span></button>
    </form>
  </nav>
  <div class="sidebar-footer">
    <a href="/?tenant=<%= tenant.subdomain %>" target="_blank" class="view-menu-btn"><span>🔗</span><span>View Menu</span></a>
  </div>
</aside>

<div class="main">
  <div class="page-header">
    <h1>💼 Sales</h1>
    <p>Manage quotations, invoices, returns, and customers</p>
  </div>

  <form method="GET" action="/sales" class="filter-bar">
    <div class="fg"><div class="fl">From</div><input type="date" name="from" value="<%= from %>" /></div>
    <div class="fg"><div class="fl">To</div><input type="date" name="to" value="<%= to %>" /></div>
    <button type="submit" class="btn btn-primary">Apply</button>
    <a href="/sales" class="btn btn-ghost">This Month</a>
  </form>

  <div class="kpi-row">
    <div class="kpi">
      <div class="kpi-label">Quotations</div>
      <div class="kpi-val" style="color:#60a5fa"><%= kpi.quotations.cnt %></div>
      <div class="kpi-sub"><%= tenant.currency||'' %><%= kpi.quotations.total.toLocaleString(undefined,{maximumFractionDigits:0}) %> total value</div>
    </div>
    <div class="kpi">
      <div class="kpi-label">Invoices Issued</div>
      <div class="kpi-val" style="color:#fff"><%= kpi.invoices.cnt %></div>
      <div class="kpi-sub"><%= tenant.currency||'' %><%= kpi.invoices.total.toLocaleString(undefined,{maximumFractionDigits:0}) %> total</div>
    </div>
    <div class="kpi">
      <div class="kpi-label">Collected</div>
      <div class="kpi-val" style="color:#00b894"><%= tenant.currency||'' %><%= kpi.invoices.paid.toLocaleString(undefined,{maximumFractionDigits:0}) %></div>
      <div class="kpi-sub">from invoices</div>
    </div>
    <div class="kpi">
      <div class="kpi-label">Returns</div>
      <div class="kpi-val" style="color:#e74c3c"><%= kpi.returns.cnt %></div>
      <div class="kpi-sub"><%= tenant.currency||'' %><%= kpi.returns.total.toLocaleString(undefined,{maximumFractionDigits:0}) %> refunded</div>
    </div>
    <div class="kpi">
      <div class="kpi-label">Customers</div>
      <div class="kpi-val" style="color:#a78bdf"><%= kpi.customers %></div>
      <div class="kpi-sub">total registered</div>
    </div>
    <a href="/sales/invoices?status=overdue" class="kpi" style="text-decoration:none;border-color:<%= kpi.overdue.cnt>0?'rgba(231,76,60,.3)':'#2a2a3e' %>">
      <div class="kpi-label">Overdue Invoices</div>
      <div class="kpi-val" style="color:<%= kpi.overdue.cnt>0?'#e74c3c':'#444' %>"><%= kpi.overdue.cnt %></div>
      <div class="kpi-sub"><%= kpi.overdue.cnt>0 ? (tenant.currency||'')+kpi.overdue.amount.toLocaleString(undefined,{maximumFractionDigits:0})+' owed' : 'none' %></div>
    </a>
  </div>

  <!-- Module cards -->
  <div class="modules">
    <a href="/sales/quotations" class="mod-card">
      <div class="mod-icon">📄</div>
      <div class="mod-name">Quotations</div>
      <div class="mod-desc">عرض سعر — Price quotes for customers with discount & tax</div>
    </a>
    <a href="/sales/invoices" class="mod-card">
      <div class="mod-icon">🧾</div>
      <div class="mod-name">Invoices</div>
      <div class="mod-desc">فواتير مبيعات — Issue and track customer invoices</div>
    </a>
    <a href="/sales/returns" class="mod-card">
      <div class="mod-icon">↩️</div>
      <div class="mod-name">Sales Returns</div>
      <div class="mod-desc">مرتجع مبيعات — Record returned items and refunds</div>
    </a>
    <a href="/sales/customers" class="mod-card">
      <div class="mod-icon">👥</div>
      <div class="mod-name">Customers</div>
      <div class="mod-desc">Customer list, credit balances, and receivables</div>
    </a>
  </div>

  <!-- Recent activity -->
  <div class="grid2">
    <div class="card">
      <div class="card-head">Recent Quotations <a href="/sales/quotations" style="font-size:.72rem;color:#60a5fa;text-decoration:none;font-weight:400">View all →</a></div>
      <table>
        <% if (!recentQuotations.length) { %>
        <tr><td style="text-align:center;padding:24px;color:#444">No quotations yet</td></tr>
        <% } else { recentQuotations.forEach(q => { %>
        <tr onclick="window.location='/sales/quotations/<%= q.id %>'" style="cursor:pointer">
          <td><span style="color:#60a5fa;font-weight:600"><%= q.quotation_no %></span><br/><span style="font-size:.72rem;color:#555"><%= q.customer_name||'—' %></span></td>
          <td style="text-align:right"><%= tenant.currency||'' %><%= parseFloat(q.total||0).toFixed(2) %><br/><span class="badge b-<%= q.status %>"><%= q.status %></span></td>
        </tr>
        <% }) } %>
      </table>
    </div>
    <div class="card">
      <div class="card-head">Recent Invoices <a href="/sales/invoices" style="font-size:.72rem;color:#60a5fa;text-decoration:none;font-weight:400">View all →</a></div>
      <table>
        <% if (!recentInvoices.length) { %>
        <tr><td style="text-align:center;padding:24px;color:#444">No invoices yet</td></tr>
        <% } else { recentInvoices.forEach(inv => { %>
        <tr onclick="window.location='/sales/invoices/<%= inv.id %>'" style="cursor:pointer">
          <td><span style="color:#fff;font-weight:600"><%= inv.invoice_no %></span><br/><span style="font-size:.72rem;color:#555"><%= inv.customer_name||'—' %></span></td>
          <td style="text-align:right"><%= tenant.currency||'' %><%= parseFloat(inv.total||0).toFixed(2) %><br/><span class="badge b-<%= inv.status %>"><%= inv.status %></span></td>
        </tr>
        <% }) } %>
      </table>
    </div>
  </div>
</div>
</body>
</html>
