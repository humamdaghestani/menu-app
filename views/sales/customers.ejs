<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Customers — <%= tenant.name %></title>
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    body{font-family:'Segoe UI',sans-serif;background:#0f0f1a;color:#e0e0e0;min-height:100vh;display:flex}
    .sidebar{width:220px;background:#1a1a2e;display:flex;flex-direction:column;position:fixed;top:0;left:0;bottom:0;z-index:100;padding:0 0 20px}
    .sidebar-brand{padding:20px 16px 16px;border-bottom:1px solid rgba(255,255,255,.07);display:flex;align-items:center;gap:10px}
    .sidebar-brand img{width:36px;height:36px;border-radius:8px;object-fit:cover}
    .brand-emoji{font-size:1.4rem}
    .brand-text h2{color:#fff;font-size:.88rem;font-weight:700;line-height:1.2}
    .brand-text span{color:#555;font-size:.72rem}
    .sidebar-nav{flex:1;padding:12px 10px;display:flex;flex-direction:column;gap:2px;overflow-y:auto}
    .sidebar-nav a,.sidebar-nav button{display:flex;align-items:center;gap:9px;padding:10px 12px;border-radius:9px;color:#888;text-decoration:none;font-size:.85rem;background:none;border:none;cursor:pointer;width:100%;transition:background .15s,color .15s;font-family:inherit}
    .sidebar-nav a:hover,.sidebar-nav button:hover{background:rgba(255,255,255,.07);color:#fff}
    .sidebar-nav a.active{background:#2563eb;color:#fff;font-weight:600}
    .sidebar-nav .icon{font-size:1rem;width:18px;text-align:center;flex-shrink:0}
    .sidebar-nav .divider{height:1px;background:rgba(255,255,255,.06);margin:4px 0}
    .sidebar-footer{padding:0 10px}
    .view-menu-btn{display:flex;align-items:center;justify-content:center;gap:8px;background:rgba(255,255,255,.06);color:#666;padding:9px;border-radius:9px;text-decoration:none;font-size:.8rem;transition:background .15s}
    .view-menu-btn:hover{background:rgba(255,255,255,.12);color:#fff}
    .main{margin-left:220px;flex:1;padding:28px}
    .page-title{font-size:1.3rem;font-weight:800;color:#fff;margin-bottom:4px}
    .page-sub{font-size:.82rem;color:#555;margin-bottom:20px}
    .btn{padding:7px 14px;border:none;border-radius:8px;cursor:pointer;font-size:.82rem;font-weight:600;font-family:inherit;text-decoration:none;display:inline-flex;align-items:center;gap:6px}
    .btn-primary{background:#2563eb;color:#fff}.btn-primary:hover{opacity:.88}
    .btn-ghost{background:rgba(255,255,255,.08);color:#ccc}.btn-ghost:hover{background:rgba(255,255,255,.14);color:#fff}
    .btn-danger{background:rgba(231,76,60,.12);color:#e74c3c}
    .btn-sm{padding:4px 10px;font-size:.75rem}
    .search-bar{display:flex;gap:8px;margin-bottom:20px;align-items:center}
    .search-bar input{flex:1;max-width:360px;background:#1a1a2e;border:1.5px solid #2a2a3e;color:#fff;padding:8px 12px;border-radius:10px;font-family:inherit;font-size:.85rem;outline:none}
    .search-bar input:focus{border-color:#2563eb}
    .kpi-row{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:12px;margin-bottom:20px}
    .kpi{background:#1a1a2e;border-radius:12px;border:1px solid #2a2a3e;padding:15px 16px}
    .kpi-label{font-size:.65rem;text-transform:uppercase;color:#444;font-weight:700;margin-bottom:6px}
    .kpi-val{font-size:1.3rem;font-weight:800}
    .card{background:#1a1a2e;border-radius:14px;border:1px solid #2a2a3e;overflow:hidden;margin-bottom:20px}
    .card-head{padding:13px 18px;border-bottom:1px solid #2a2a3e;font-size:.88rem;font-weight:700;color:#fff;display:flex;align-items:center;justify-content:space-between}
    table{width:100%;border-collapse:collapse}
    th{text-align:left;font-size:.67rem;text-transform:uppercase;color:#444;font-weight:700;padding:9px 14px;border-bottom:1px solid #2a2a3e}
    td{padding:10px 14px;font-size:.83rem;color:#ccc;border-bottom:1px solid rgba(255,255,255,.04)}
    tr:last-child td{border-bottom:none}
    .empty{text-align:center;padding:60px 24px;color:#444}
    .avatar{width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,#2563eb,#7c5cbf);display:flex;align-items:center;justify-content:center;font-size:.9rem;font-weight:700;color:#fff;flex-shrink:0}
    .customer-cell{display:flex;align-items:center;gap:10px}
    .credit-bar{height:4px;background:#2a2a3e;border-radius:2px;overflow:hidden;margin-top:3px;min-width:60px}
    .credit-fill{height:100%;border-radius:2px;background:#f1c40f}
    .alert{border-radius:10px;padding:10px 16px;font-size:.85rem;margin-bottom:16px}
    .alert-ok{background:rgba(0,184,148,.1);border:1px solid rgba(0,184,148,.25);color:#00b894}
    .alert-err{background:rgba(231,76,60,.1);border:1px solid rgba(231,76,60,.25);color:#e74c3c}
    .modal-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.7);z-index:200;align-items:center;justify-content:center;padding:20px}
    .modal-overlay.open{display:flex}
    .modal{background:#1a1a2e;border-radius:16px;border:1px solid #2a2a3e;width:100%;max-width:480px;padding:28px}
    .modal h2{font-size:1rem;font-weight:700;color:#fff;margin-bottom:20px}
    .form-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
    .form-group{display:flex;flex-direction:column;gap:5px}
    .form-group.full{grid-column:1/-1}
    label{font-size:.75rem;font-weight:600;color:#555}
    input[type=text],input[type=email],input[type=tel],textarea{width:100%;background:#0f0f1a;border:1.5px solid #2a2a3e;color:#fff;padding:8px 10px;border-radius:8px;font-family:inherit;font-size:.85rem;outline:none}
    input:focus,textarea:focus{border-color:#2563eb}
    textarea{resize:vertical;min-height:60px}
    @media(max-width:768px){.sidebar{width:56px}.brand-text,.sidebar-nav span:not(.icon){display:none}.main{margin-left:56px;padding:16px}}
  </style>
</head>
<body>
<aside class="sidebar">
  <div class="sidebar-brand">
    <% if (tenant.logo_url) { %><img src="<%= tenant.logo_url %>" alt="" /><% } else { %><span class="brand-emoji">💼</span><% } %>
    <div class="brand-text"><h2><%= tenant.name %></h2><span>Sales</span></div>
  </div>
  <nav class="sidebar-nav">
    <a href="/admin"><span class="icon">🏠</span><span>Home</span></a>
    <div class="divider"></div>
    <a href="/sales"><span class="icon">📊</span><span>Dashboard</span></a>
    <a href="/sales/quotations"><span class="icon">📄</span><span>Quotations</span></a>
    <a href="/sales/orders"><span class="icon">📦</span><span>Sales Orders</span></a>
    <a href="/sales/invoices"><span class="icon">🧾</span><span>Invoices</span></a>
    <a href="/sales/returns"><span class="icon">↩️</span><span>Sales Returns</span></a>
    <a href="/sales/customers" class="active"><span class="icon">👥</span><span>Customers</span></a>
    <div class="divider"></div>
    <form method="POST" action="/admin/logout" style="margin-top:auto">
      <button type="submit"><span class="icon">🚪</span><span>Logout</span></button>
    </form>
  </nav>
  <div class="sidebar-footer">
    <a href="/?tenant=<%= tenant.subdomain %>" target="_blank" class="view-menu-btn"><span>🔗</span><span>View Menu</span></a>
  </div>
</aside>

<div class="main">
  <div class="page-title">👥 Customers — العملاء</div>
  <div class="page-sub">Manage customer records, credits, and balances.</div>

  <% if (locals.success) { %><div class="alert alert-ok">✓ <%= success %></div><% } %>
  <% if (locals.error)   { %><div class="alert alert-err">✗ <%= error %></div><% } %>

  <div class="search-bar">
    <input type="text" id="searchInput" placeholder="Search by name or phone..." oninput="filterCustomers()" />
    <button type="button" class="btn btn-primary" onclick="document.getElementById('newModal').classList.add('open')">+ Add Customer</button>
  </div>

  <div class="kpi-row">
    <div class="kpi"><div class="kpi-label">Total Customers</div><div class="kpi-val" style="color:#60a5fa"><%= customers.length %></div></div>
    <div class="kpi"><div class="kpi-label">Total Receivable</div><div class="kpi-val" style="color:#f1c40f"><%= tenant.currency||'' %><%= kpi.totalOwed.toLocaleString(undefined,{maximumFractionDigits:0}) %></div></div>
    <div class="kpi"><div class="kpi-label">Credit Balances</div><div class="kpi-val" style="color:#00b894"><%= tenant.currency||'' %><%= kpi.totalCredit.toLocaleString(undefined,{maximumFractionDigits:0}) %></div></div>
    <div class="kpi"><div class="kpi-label">With Open Invoices</div><div class="kpi-val" style="color:#fff"><%= kpi.withOpen %></div></div>
  </div>

  <div class="card">
    <div class="card-head">All Customers <span style="font-size:.72rem;color:#444;font-weight:400"><%= customers.length %> records</span></div>
    <% if (!customers.length) { %>
    <div class="empty">No customers yet. Click <strong>+ Add Customer</strong> to create one.</div>
    <% } else { %>
    <div style="overflow-x:auto">
    <table id="custTable">
      <thead><tr><th>Customer</th><th>Phone</th><th>Invoices</th><th>Total Billed</th><th>Paid</th><th>Balance Due</th><th>Credit</th><th></th></tr></thead>
      <tbody>
      <% customers.forEach(c => {
           const owed = Math.max(0, parseFloat(c.total_billed||0) - parseFloat(c.total_paid||0));
           const credit = parseFloat(c.credit_balance||0);
           const initial = (c.name||'?').charAt(0).toUpperCase();
      %>
      <tr class="cust-row" onclick="window.location='/sales/customers/<%= c.id %>'" style="cursor:pointer">
        <td>
          <div class="customer-cell">
            <div class="avatar"><%= initial %></div>
            <div>
              <div style="color:#fff;font-weight:600"><%= c.name %></div>
              <% if(c.email){%><div style="font-size:.72rem;color:#444"><%= c.email %></div><%}%>
            </div>
          </div>
        </td>
        <td style="color:#666"><%= c.phone||'—' %></td>
        <td style="text-align:center"><%= c.invoice_count||0 %></td>
        <td style="font-weight:700;color:#fff"><%= tenant.currency||'' %><%= parseFloat(c.total_billed||0).toFixed(2) %></td>
        <td style="color:#00b894"><%= tenant.currency||'' %><%= parseFloat(c.total_paid||0).toFixed(2) %></td>
        <td>
          <span style="color:<%= owed>0?'#f1c40f':'#444' %>;font-weight:700"><%= tenant.currency||'' %><%= owed.toFixed(2) %></span>
          <% if(parseFloat(c.total_billed||0)>0){const pct=Math.min(100,Math.round(parseFloat(c.total_paid||0)/parseFloat(c.total_billed||0)*100));%>
          <div class="credit-bar"><div class="credit-fill" style="width:<%= pct %>%"></div></div>
          <%}%>
        </td>
        <td style="color:<%= credit>0?'#00b894':'#444' %>"><%= credit>0?'+':'' %><%= tenant.currency||'' %><%= credit.toFixed(2) %></td>
        <td>
          <a href="/sales/invoices?customer=<%= encodeURIComponent(c.name) %>" class="btn btn-ghost btn-sm" title="View invoices" onclick="event.stopPropagation()">🧾</a>
        </td>
      </tr>
      <% }) %>
      </tbody>
    </table>
    </div>
    <% } %>
  </div>
</div>

<!-- New Customer Modal -->
<div class="modal-overlay" id="newModal" onclick="if(event.target===this)this.classList.remove('open')">
  <div class="modal">
    <h2>👥 Add Customer</h2>
    <form method="POST" action="/sales/customers">
      <div class="form-grid">
        <div class="form-group full"><label>Name *</label><input type="text" name="name" required placeholder="Customer full name" /></div>
        <div class="form-group"><label>Phone</label><input type="tel" name="phone" placeholder="07..." /></div>
        <div class="form-group"><label>Email</label><input type="email" name="email" placeholder="optional" /></div>
        <div class="form-group full"><label>Notes</label><textarea name="notes" rows="2" placeholder="Address, additional info..."></textarea></div>
      </div>
      <div style="display:flex;justify-content:flex-end;gap:10px;margin-top:20px">
        <button type="button" class="btn btn-ghost" onclick="document.getElementById('newModal').classList.remove('open')">Cancel</button>
        <button type="submit" class="btn btn-primary">Add Customer</button>
      </div>
    </form>
  </div>
</div>
<script>
function filterCustomers(){
  const q=document.getElementById('searchInput').value.toLowerCase();
  document.querySelectorAll('.cust-row').forEach(tr=>{
    const txt=tr.textContent.toLowerCase();
    tr.style.display=txt.includes(q)?'':'none';
  });
}
</script>
</body>
</html>
