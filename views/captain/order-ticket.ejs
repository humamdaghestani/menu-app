<%
const now = (function() {
  const d = new Date();
  const dd = String(d.getDate()).padStart(2,'0');
  const mm = String(d.getMonth()+1).padStart(2,'0');
  const h24 = d.getHours(); const ampm = h24 >= 12 ? 'PM' : 'AM';
  const h12 = h24 % 12 || 12;
  const mi = String(d.getMinutes()).padStart(2,'0');
  const ss = String(d.getSeconds()).padStart(2,'0');
  return dd+'/'+mm+'/'+d.getFullYear()+' '+ampm+' '+h12+':'+mi+':'+ss;
})();
%><!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Order #<%= order.id %> — <%= order.table_name %></title>
  <style>
    * { margin:0;padding:0;box-sizing:border-box; }
    body { font-family:Arial,sans-serif;font-size:14px;font-weight:700;color:#000;width:290px;margin:0 auto;padding:10px 8px; }
    .ctr { text-align:center;margin-bottom:6px; }
    .shop { font-size:16px;font-weight:900; }
    .ls  { border-top:2px solid #000;margin:6px 0; }
    .ld  { border-top:1px dashed #000;margin:5px 0; }
    .meta { font-size:12px;margin:3px 0;display:flex;justify-content:space-between; }
    .ticket-label { font-size:22px;font-weight:900;text-align:center;letter-spacing:2px;margin:6px 0; }
    .item-row { display:flex;align-items:flex-start;gap:6px;padding:6px 0;border-bottom:1px dashed #ccc; }
    .item-row:last-child { border-bottom:none; }
    .item-qty  { font-size:20px;font-weight:900;min-width:32px;text-align:center;line-height:1.1; }
    .item-name { font-size:14px;font-weight:700;flex:1;line-height:1.3; }
    .item-note { font-size:11px;font-weight:400;color:#333;margin-top:3px; }
    .actions { text-align:center;margin:12px 0; }
    .btn-print { background:#1a1a2e;color:#fff;border:none;padding:8px 22px;border-radius:6px;cursor:pointer;font-size:.85rem;font-weight:600; }
    @media print { @page { margin:2mm;size:80mm auto; } .actions { display:none; } body { padding:2px; } }
  </style>
</head>
<body>

<div class="actions">
  <button class="btn-print" onclick="window.print()">🖨️ Print</button>
</div>

<div class="ctr">
  <div class="shop"><%= tenant.name %></div>
</div>

<div class="ls"></div>

<div class="ticket-label">ORDER TICKET</div>

<div class="meta"><span>Table</span><span><strong><%= order.table_name || '—' %></strong></span></div>
<div class="meta"><span>Order #</span><span><strong><%= order.id %></strong></span></div>
<div class="meta"><span>Type</span><span><strong><%= order.order_type === 'takeaway' ? 'Takeaway' : 'Dine-in' %></strong></span></div>
<div class="meta"><span>Time</span><span><strong><%= now %></strong></span></div>
<% if (order.note) { %>
<div class="meta" style="margin-top:4px;background:#f5f5f5;padding:4px 6px;border-radius:4px">
  <span>📝 Note:</span><span style="font-weight:700"><%= order.note %></span>
</div>
<% } %>

<div class="ls"></div>

<% orderItems.forEach(function(oi) { %>
<div class="item-row">
  <div class="item-qty"><%= oi.quantity %>×</div>
  <div>
    <div class="item-name"><%= oi.name %></div>
    <% if (oi.notes) { %><div class="item-note">📝 <%= oi.notes %></div><% } %>
  </div>
</div>
<% }); %>

<div class="ld"></div>
<div style="text-align:center;font-size:11px;font-weight:400;color:#666;margin-top:4px">Printed by <%= currentUser.name || currentUser.username %></div>

<script>
  window.onload = function() { setTimeout(function() { window.print(); }, 400); };
  window.onafterprint = function() { window.close(); };
</script>
</body>
</html>
