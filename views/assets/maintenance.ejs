<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Maintenance â€” <%= asset.name %></title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Segoe UI', sans-serif; background: #0f0f1a; color: #e0e0e0; min-height: 100vh; }
    .topbar { background: #1a1a2e; height: 60px; display: flex; align-items: center; justify-content: space-between; padding: 0 20px; border-bottom: 1px solid rgba(255,255,255,.07); }
    .topbar-brand { font-weight: 700; color: #fff; font-size: 1rem; }
    .topbar-sub { font-size: .72rem; color: #555; }
    .btn { padding: 7px 14px; border: none; border-radius: 8px; cursor: pointer; font-size: .82rem; font-weight: 600; font-family: inherit; text-decoration: none; display: inline-flex; align-items: center; gap: 5px; }
    .btn-ghost { background: rgba(255,255,255,.08); color: #ccc; }
    .btn-ghost:hover { background: rgba(255,255,255,.14); color: #fff; }
    .btn-primary { background: #7c5cbf; color: #fff; }
    .btn-danger { background: rgba(231,76,60,.15); color: #e74c3c; }
    .main { padding: 28px; max-width: 1000px; margin: 0 auto; }
    .section { background: #1a1a2e; border: 1.5px solid #2a2a3e; border-radius: 12px; padding: 20px; margin-bottom: 20px; }
    .section h3 { color: #fff; font-size: .92rem; font-weight: 700; margin-bottom: 16px; }
    table { width: 100%; border-collapse: collapse; font-size: .85rem; }
    th { text-align: left; color: #555; font-size: .72rem; text-transform: uppercase; padding: 8px 10px; border-bottom: 1px solid #2a2a3e; }
    td { padding: 10px; border-bottom: 1px solid #1e1e32; color: #ccc; }
    tr:last-child td { border-bottom: none; }
    .form-group { margin-bottom: 12px; }
    .form-group label { display: block; font-size: .78rem; color: #aaa; margin-bottom: 4px; }
    .form-group input, .form-group textarea { width: 100%; background: #0f0f1a; border: 1.5px solid #2a2a3e; color: #fff; padding: 8px 10px; border-radius: 8px; font-size: .85rem; font-family: inherit; }
    .form-group textarea { height: 60px; resize: vertical; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .asset-info { display: flex; gap: 24px; flex-wrap: wrap; margin-bottom: 24px; }
    .info-item { background: #1a1a2e; border: 1.5px solid #2a2a3e; border-radius: 10px; padding: 14px 18px; }
    .info-label { font-size: .7rem; color: #555; text-transform: uppercase; margin-bottom: 4px; }
    .info-val { color: #fff; font-weight: 600; }
  </style>
</head>
<body>
<div class="topbar">
  <div style="display:flex;align-items:center;gap:8px">
    <a href="C:\Users\ASUS" class="btn btn-ghost" style="padding:6px 10px;font-size:1.1rem;flex-shrink:0" title="All Modules">ðŸ </a>
    <div>
      <div class="topbar-brand">ðŸ”§ Maintenance Log</div>
      <div class="topbar-sub"><%= asset.name %></div>
    </div>
  </div>
  <div style="display:flex;gap:8px">
    <a href="/assets" class="btn btn-ghost">â† All Assets</a>
    <button onclick="history.back()" class="btn btn-ghost">â† Back</button>
  </div>
</div>

<div class="main">
  <div class="asset-info">
    <div class="info-item"><div class="info-label">Asset</div><div class="info-val"><%= asset.name %></div></div>
    <div class="info-item"><div class="info-label">Category</div><div class="info-val"><%= asset.category || 'â€”' %></div></div>
    <div class="info-item"><div class="info-label">Purchase Price</div><div class="info-val">$<%= parseFloat(asset.purchase_price).toFixed(2) %></div></div>
    <div class="info-item"><div class="info-label">Current Value</div><div class="info-val">$<%= parseFloat(asset.current_value).toFixed(2) %></div></div>
    <div class="info-item"><div class="info-label">Status</div><div class="info-val"><%= asset.status %></div></div>
  </div>

  <div style="display:grid;grid-template-columns:1fr 320px;gap:20px">
    <div class="section">
      <h3>ðŸ”§ Maintenance History</h3>
      <table>
        <thead><tr><th>Date</th><th>Description</th><th>Cost</th><th>Next Service</th><th></th></tr></thead>
        <tbody>
        <% log.forEach(m => { %>
        <tr>
          <td><%= m.service_date.toISOString().slice(0,10) %></td>
          <td><%= m.description || 'â€”' %></td>
          <td>$<%= parseFloat(m.cost).toFixed(2) %></td>
          <td style="<%= m.next_service_date && new Date(m.next_service_date) <= new Date() ? 'color:#e74c3c' : '' %>"><%= m.next_service_date ? m.next_service_date.toISOString().slice(0,10) : 'â€”' %></td>
          <td>
            <form method="POST" action="/assets/<%= asset.id %>/maintenance/<%= m.id %>/delete" onsubmit="return confirm('Delete?')">
              <button class="btn btn-danger" style="font-size:.72rem;padding:3px 8px">âœ•</button>
            </form>
          </td>
        </tr>
        <% }) %>
        <% if (!log.length) { %><tr><td colspan="5" style="color:#555;text-align:center;padding:24px">No maintenance records</td></tr><% } %>
        </tbody>
      </table>
    </div>

    <div class="section">
      <h3>âž• Log Service</h3>
      <form method="POST" action="/assets/<%= asset.id %>/maintenance">
        <div class="form-group"><label>Service Date *</label><input type="date" name="service_date" value="<%= new Date().toISOString().slice(0,10) %>" required /></div>
        <div class="form-group"><label>Description</label><textarea name="description" placeholder="What was done..."></textarea></div>
        <div class="form-group"><label>Cost ($)</label><input type="number" name="cost" step="0.01" value="0" /></div>
        <div class="form-group"><label>Next Service Date</label><input type="date" name="next_service_date" /></div>
        <button type="submit" class="btn btn-primary" style="width:100%">Log Service</button>
      </form>
    </div>
  </div>
</div>
</body>
</html>
