<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Payment — <%= order.table_name %></title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Segoe UI', sans-serif; background: #0f0f1a; color: #e0e0e0; min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 24px; }

    .card { background: #1a1a2e; border-radius: 16px; border: 1px solid rgba(255,255,255,.08); padding: 32px; width: 100%; max-width: 440px; }
    h1 { font-size: 1.2rem; font-weight: 700; color: #fff; margin-bottom: 6px; }
    .sub { font-size: .82rem; color: #555; margin-bottom: 28px; }

    .order-summary { background: #0f0f1a; border-radius: 10px; padding: 14px; margin-bottom: 24px; }
    .summary-row { display: flex; justify-content: space-between; font-size: .82rem; color: #888; padding: 4px 0; }
    .summary-row.total { font-size: 1.1rem; font-weight: 700; color: #fff; border-top: 1px solid #2a2a3e; margin-top: 8px; padding-top: 10px; }

    .method-row { display: flex; gap: 10px; margin-bottom: 20px; }
    .method-btn { flex: 1; padding: 12px; border: 2px solid #2a2a3e; border-radius: 10px; background: #0f0f1a; color: #888; font-size: .88rem; font-weight: 600; cursor: pointer; font-family: inherit; transition: all .15s; text-align: center; }
    .method-btn.active { border-color: #7c5cbf; color: #fff; background: rgba(124,92,191,.12); }

    label { display: block; font-size: .78rem; font-weight: 600; color: #666; margin-bottom: 6px; }
    .amount-input { width: 100%; padding: 12px 14px; background: #0f0f1a; border: 2px solid #2a2a3e; border-radius: 10px; color: #fff; font-size: 1.3rem; font-weight: 700; outline: none; font-family: inherit; margin-bottom: 16px; }
    .amount-input:focus { border-color: #7c5cbf; }

    .change-box { background: rgba(0,184,148,.08); border: 1px solid rgba(0,184,148,.25); border-radius: 10px; padding: 12px 16px; display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }
    .change-label { font-size: .82rem; color: #00b894; font-weight: 600; }
    .change-amount { font-size: 1.2rem; font-weight: 700; color: #00b894; }

    .btn { width: 100%; padding: 13px; border: none; border-radius: 10px; cursor: pointer; font-size: .95rem; font-weight: 700; font-family: inherit; transition: opacity .15s; }
    .btn-pay { background: #00b894; color: #fff; }
    .btn-pay:hover { opacity: .88; }
    .btn-back { background: rgba(255,255,255,.07); color: #888; margin-top: 10px; }
    .btn-back:hover { background: rgba(255,255,255,.12); color: #ccc; }

    .quick-amounts { display: flex; gap: 8px; margin-bottom: 16px; flex-wrap: wrap; }
    .quick-btn { padding: 7px 14px; border: 1.5px solid #2a2a3e; border-radius: 8px; background: #0f0f1a; color: #888; font-size: .8rem; font-weight: 600; cursor: pointer; font-family: inherit; }
    .quick-btn:hover { border-color: #7c5cbf; color: #fff; }

    /* Customer picker */
    .customer-section { margin-bottom: 20px; }
    .customer-search-wrap { position: relative; }
    .customer-search { width: 100%; padding: 10px 12px; background: #0f0f1a; border: 1.5px solid #2a2a3e; border-radius: 10px; color: #fff; font-size: .88rem; font-family: inherit; outline: none; }
    .customer-search:focus { border-color: #7c5cbf; }
    .customer-dropdown { position: absolute; top: calc(100% + 4px); left: 0; right: 0; background: #1a1a2e; border: 1.5px solid #2a2a3e; border-radius: 10px; z-index: 50; max-height: 220px; overflow-y: auto; display: none; box-shadow: 0 8px 24px rgba(0,0,0,.4); }
    .customer-dropdown.open { display: block; }
    .cust-opt { padding: 10px 14px; cursor: pointer; font-size: .85rem; color: #ccc; border-bottom: 1px solid rgba(255,255,255,.04); display: flex; align-items: center; gap: 10px; }
    .cust-opt:last-child { border-bottom: none; }
    .cust-opt:hover { background: rgba(124,92,191,.15); color: #fff; }
    .cust-opt.cash { color: #888; }
    .cust-avatar { width: 28px; height: 28px; border-radius: 50%; background: rgba(124,92,191,.25); display: flex; align-items: center; justify-content: center; font-size: .75rem; font-weight: 700; color: #a78bdf; flex-shrink: 0; }
    .cust-info { flex: 1; min-width: 0; }
    .cust-name { font-weight: 600; }
    .cust-phone { font-size: .72rem; color: #555; }
    .selected-customer { display: flex; align-items: center; gap: 10px; padding: 9px 12px; background: rgba(124,92,191,.1); border: 1.5px solid rgba(124,92,191,.4); border-radius: 10px; cursor: pointer; }
    .selected-customer.cash-selected { background: rgba(255,255,255,.04); border-color: #2a2a3e; }
    .selected-name { font-size: .88rem; font-weight: 600; color: #fff; flex: 1; }
    .change-cust { font-size: .72rem; color: #555; }
  </style>
</head>
<body>

<div class="card">
  <h1>💳 Payment</h1>
  <div class="sub"><%= order.table_name %> · Order #<%= order.id %></div>

  <div class="order-summary">
    <% orderItems.forEach(oi => { %>
    <div class="summary-row">
      <span><%= oi.quantity %>× <%= oi.name %></span>
      <span><%= tenant.currency || '$' %><%= (oi.price * oi.quantity).toFixed(2) %></span>
    </div>
    <% }) %>
    <% if (discount > 0) { %>
    <div class="summary-row" style="color:#00b894">
      <span>Discount</span>
      <span>−<%= tenant.currency || '$' %><%= discount.toFixed(2) %></span>
    </div>
    <% } %>
    <div class="summary-row total">
      <span>Total</span>
      <span><%= tenant.currency || '$' %><%= total.toFixed(2) %></span>
    </div>
  </div>

  <form method="POST" action="/pos/order/<%= order.id %>/pay" id="payForm">
    <!-- Customer -->
    <div class="customer-section">
      <label>Customer</label>
      <input type="hidden" name="customer_id" id="customerIdInput" value="" />

      <!-- Selected display -->
      <div id="selectedCustomer" class="selected-customer cash-selected" onclick="openCustomerPicker()">
        <div class="cust-avatar">👤</div>
        <span class="selected-name" id="selectedName">Cash Customer</span>
        <span class="change-cust">tap to change</span>
      </div>

      <!-- Picker dropdown -->
      <div id="custPickerWrap" style="display:none;position:relative;margin-top:6px">
        <input type="text" class="customer-search" id="custSearch" placeholder="Search by name or phone..." oninput="filterCustomers()" />
        <div class="customer-dropdown open" id="custDropdown">
          <div class="cust-opt cash" onclick="selectCustomer('', 'Cash Customer', '')">
            <div class="cust-avatar" style="background:rgba(255,255,255,.06);color:#555">💵</div>
            <div class="cust-info"><div class="cust-name" style="color:#888">Cash Customer</div></div>
          </div>
          <% customers.forEach(c => { %>
          <div class="cust-opt" data-name="<%= c.name.toLowerCase() %>" data-phone="<%= (c.phone||'').toLowerCase() %>"
               onclick="selectCustomer('<%= c.id %>', '<%= c.name.replace(/'/g, "\\'") %>', '<%= c.phone || '' %>')">
            <div class="cust-avatar"><%= c.name.charAt(0).toUpperCase() %></div>
            <div class="cust-info">
              <div class="cust-name"><%= c.name %></div>
              <% if (c.phone) { %><div class="cust-phone"><%= c.phone %></div><% } %>
            </div>
          </div>
          <% }) %>
        </div>
      </div>
    </div>

    <!-- Payment Method -->
    <div class="method-row">
      <div class="method-btn active" id="btnCash" onclick="setMethod('cash')">💵 Cash</div>
      <div class="method-btn" id="btnCard" onclick="setMethod('card')">💳 Card</div>
    </div>
    <input type="hidden" name="method" id="methodInput" value="cash" />

    <!-- Amount Paid -->
    <div id="cashSection">
      <label>Amount Received</label>
      <div class="quick-amounts">
        <% [total, Math.ceil(total/5)*5, Math.ceil(total/10)*10, Math.ceil(total/50)*50].filter((v,i,a)=>a.indexOf(v)===i).forEach(amt => { %>
        <button type="button" class="quick-btn" onclick="setAmount(<%= amt.toFixed(2) %>)"><%= tenant.currency || '$' %><%= amt.toFixed(2) %></button>
        <% }) %>
      </div>
      <input type="number" class="amount-input" name="amount_paid" id="amountInput"
        value="<%= total.toFixed(2) %>" min="<%= total.toFixed(2) %>" step="0.01"
        oninput="calcChange()" />

      <div class="change-box">
        <span class="change-label">Change</span>
        <span class="change-amount" id="changeAmt"><%= tenant.currency || '$' %>0.00</span>
      </div>
    </div>

    <button type="submit" class="btn btn-pay" onclick="return validatePay()">✓ Confirm Payment</button>
  </form>
  <a href="/pos/order/<%= order.id %>" class="btn btn-back" style="display:block;text-align:center;text-decoration:none;margin-top:10px">← Back to Order</a>
</div>

<script>
  const TOTAL = <%= total.toFixed(2) %>;
  const CUR   = '<%= tenant.currency || "$" %>';

  function setMethod(m) {
    document.getElementById('methodInput').value = m;
    document.getElementById('btnCash').classList.toggle('active', m === 'cash');
    document.getElementById('btnCard').classList.toggle('active', m === 'card');
    document.getElementById('cashSection').style.display = m === 'cash' ? '' : 'none';
    if (m === 'card') document.getElementById('amountInput').value = TOTAL.toFixed(2);
  }

  function setAmount(v) {
    document.getElementById('amountInput').value = v.toFixed(2);
    calcChange();
  }

  function calcChange() {
    const paid = parseFloat(document.getElementById('amountInput').value) || 0;
    const change = Math.max(0, paid - TOTAL);
    document.getElementById('changeAmt').textContent = CUR + change.toFixed(2);
  }

  function validatePay() {
    const paid = parseFloat(document.getElementById('amountInput').value) || 0;
    if (document.getElementById('methodInput').value === 'cash' && paid < TOTAL) {
      alert('Amount received must be at least ' + CUR + TOTAL.toFixed(2));
      return false;
    }
    return true;
  }

  calcChange();

  // Customer picker
  function openCustomerPicker() {
    document.getElementById('selectedCustomer').style.display = 'none';
    document.getElementById('custPickerWrap').style.display = '';
    document.getElementById('custSearch').focus();
  }

  function selectCustomer(id, name, phone) {
    document.getElementById('customerIdInput').value = id;
    document.getElementById('selectedName').textContent = name;
    const sel = document.getElementById('selectedCustomer');
    sel.style.display = '';
    sel.className = 'selected-customer' + (id ? '' : ' cash-selected');
    document.getElementById('custPickerWrap').style.display = 'none';
    document.getElementById('custSearch').value = '';
    filterCustomers();
  }

  function filterCustomers() {
    const q = document.getElementById('custSearch').value.toLowerCase();
    document.querySelectorAll('.cust-opt:not(.cash)').forEach(el => {
      const match = !q || el.dataset.name.includes(q) || el.dataset.phone.includes(q);
      el.style.display = match ? '' : 'none';
    });
  }

  // Close picker when clicking outside
  document.addEventListener('click', e => {
    const wrap = document.getElementById('custPickerWrap');
    if (wrap && wrap.style.display !== 'none' && !wrap.contains(e.target) && !document.getElementById('selectedCustomer').contains(e.target)) {
      selectCustomer(
        document.getElementById('customerIdInput').value,
        document.getElementById('selectedName').textContent,
        ''
      );
    }
  });
</script>
</body>
</html>
