<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Payment — <%= order.table_name %></title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Segoe UI', sans-serif; background: #0f0f1a; color: #e0e0e0; min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 24px; }

    .card { background: #1a1a2e; border-radius: 16px; border: 1px solid rgba(255,255,255,.08); padding: 32px; width: 100%; max-width: 440px; }
    h1 { font-size: 1.2rem; font-weight: 700; color: #fff; margin-bottom: 6px; }
    .sub { font-size: .82rem; color: #555; margin-bottom: 28px; }

    .order-summary { background: #0f0f1a; border-radius: 10px; padding: 14px; margin-bottom: 24px; }
    .summary-row { display: flex; justify-content: space-between; font-size: .82rem; color: #888; padding: 4px 0; }
    .summary-row.total { font-size: 1.1rem; font-weight: 700; color: #fff; border-top: 1px solid #2a2a3e; margin-top: 8px; padding-top: 10px; }

    .method-row { display: flex; gap: 10px; margin-bottom: 20px; }
    .method-btn { flex: 1; padding: 12px; border: 2px solid #2a2a3e; border-radius: 10px; background: #0f0f1a; color: #888; font-size: .88rem; font-weight: 600; cursor: pointer; font-family: inherit; transition: all .15s; text-align: center; }
    .method-btn.active { border-color: #7c5cbf; color: #fff; background: rgba(124,92,191,.12); }

    label { display: block; font-size: .78rem; font-weight: 600; color: #666; margin-bottom: 6px; }
    .amount-input { width: 100%; padding: 12px 14px; background: #0f0f1a; border: 2px solid #2a2a3e; border-radius: 10px; color: #fff; font-size: 1.3rem; font-weight: 700; outline: none; font-family: inherit; margin-bottom: 16px; }
    .amount-input:focus { border-color: #7c5cbf; }

    .change-box { background: rgba(0,184,148,.08); border: 1px solid rgba(0,184,148,.25); border-radius: 10px; padding: 12px 16px; display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }
    .change-label { font-size: .82rem; color: #00b894; font-weight: 600; }
    .change-amount { font-size: 1.2rem; font-weight: 700; color: #00b894; }

    .btn { width: 100%; padding: 13px; border: none; border-radius: 10px; cursor: pointer; font-size: .95rem; font-weight: 700; font-family: inherit; transition: opacity .15s; }
    .btn-pay { background: #00b894; color: #fff; }
    .btn-pay:hover { opacity: .88; }
    .btn-back { background: rgba(255,255,255,.07); color: #888; margin-top: 10px; }
    .btn-back:hover { background: rgba(255,255,255,.12); color: #ccc; }

    .quick-amounts { display: flex; gap: 8px; margin-bottom: 16px; flex-wrap: wrap; }
    .quick-btn { padding: 7px 14px; border: 1.5px solid #2a2a3e; border-radius: 8px; background: #0f0f1a; color: #888; font-size: .8rem; font-weight: 600; cursor: pointer; font-family: inherit; }
    .quick-btn:hover { border-color: #7c5cbf; color: #fff; }

    /* Currency toggle */
    .currency-toggle { display: flex; gap: 8px; margin-bottom: 12px; }
    .cur-btn { flex: 1; padding: 10px; border: 2px solid #2a2a3e; border-radius: 10px; background: #0f0f1a; color: #888; font-size: .88rem; font-weight: 700; cursor: pointer; font-family: inherit; text-align: center; transition: all .15s; }
    .cur-btn.active { border-color: #f39c12; color: #f39c12; background: rgba(243,156,18,.1); }
    .iqd-equiv { background: rgba(243,156,18,.08); border: 1px solid rgba(243,156,18,.2); border-radius: 10px; padding: 10px 14px; margin-bottom: 14px; display: flex; justify-content: space-between; align-items: center; font-size: .85rem; }
    .iqd-label { color: #f39c12; font-weight: 600; }
    .iqd-val   { color: #fff; font-weight: 800; font-size: 1rem; }
    .rate-badge { font-size: .72rem; color: #555; margin-top: 2px; }

    /* Tip */
    .tip-section { margin-bottom: 20px; }
    .tip-quick { display: flex; gap: 6px; margin-bottom: 10px; flex-wrap: wrap; }
    .tip-pct-btn { padding: 7px 14px; border: 1.5px solid #2a2a3e; border-radius: 8px; background: #0f0f1a; color: #888; font-size: .8rem; font-weight: 700; cursor: pointer; font-family: inherit; transition: all .15s; }
    .tip-pct-btn.active { border-color: #00b894; color: #00b894; background: rgba(0,184,148,.08); }
    .tip-pct-btn:hover:not(.active) { border-color: #555; color: #ccc; }
    .tip-input { width: 100%; padding: 10px 14px; background: #0f0f1a; border: 1.5px solid #2a2a3e; border-radius: 10px; color: #00b894; font-size: 1.1rem; font-weight: 700; outline: none; font-family: inherit; }
    .tip-input:focus { border-color: #00b894; }
    /* Customer picker */
    .customer-section { margin-bottom: 20px; }
    .customer-search-wrap { position: relative; }
    .customer-search { width: 100%; padding: 10px 12px; background: #0f0f1a; border: 1.5px solid #2a2a3e; border-radius: 10px; color: #fff; font-size: .88rem; font-family: inherit; outline: none; }
    .customer-search:focus { border-color: #7c5cbf; }
    .customer-dropdown { position: absolute; top: calc(100% + 4px); left: 0; right: 0; background: #1a1a2e; border: 1.5px solid #2a2a3e; border-radius: 10px; z-index: 50; max-height: 220px; overflow-y: auto; display: none; box-shadow: 0 8px 24px rgba(0,0,0,.4); }
    .customer-dropdown.open { display: block; }
    .cust-opt { padding: 10px 14px; cursor: pointer; font-size: .85rem; color: #ccc; border-bottom: 1px solid rgba(255,255,255,.04); display: flex; align-items: center; gap: 10px; }
    .cust-opt:last-child { border-bottom: none; }
    .cust-opt:hover { background: rgba(124,92,191,.15); color: #fff; }
    .cust-opt.cash { color: #888; }
    .cust-avatar { width: 28px; height: 28px; border-radius: 50%; background: rgba(124,92,191,.25); display: flex; align-items: center; justify-content: center; font-size: .75rem; font-weight: 700; color: #a78bdf; flex-shrink: 0; }
    .cust-info { flex: 1; min-width: 0; }
    .cust-name { font-weight: 600; }
    .cust-phone { font-size: .72rem; color: #555; }
    .selected-customer { display: flex; align-items: center; gap: 10px; padding: 9px 12px; background: rgba(124,92,191,.1); border: 1.5px solid rgba(124,92,191,.4); border-radius: 10px; cursor: pointer; }
    .selected-customer.cash-selected { background: rgba(255,255,255,.04); border-color: #2a2a3e; }
    .selected-name { font-size: .88rem; font-weight: 600; color: #fff; flex: 1; }
    .change-cust { font-size: .72rem; color: #555; }
    /* Loyalty */
    .loyalty-box { background: rgba(253,203,110,.06); border: 1px solid rgba(253,203,110,.2); border-radius: 10px; padding: 12px 14px; margin-bottom: 20px; }
    .loyalty-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
    .loyalty-title { font-size: .82rem; font-weight: 700; color: #fdcb6e; }
    .loyalty-pts { font-size: 1rem; font-weight: 700; color: #fdcb6e; }
    .loyalty-redeem-row { display: flex; gap: 8px; align-items: center; }
    .loyalty-redeem-input { flex: 1; padding: 8px 10px; background: #0f0f1a; border: 1.5px solid rgba(253,203,110,.3); border-radius: 8px; color: #fdcb6e; font-size: .88rem; font-family: inherit; outline: none; }
    .loyalty-redeem-input:focus { border-color: #fdcb6e; }
    .loyalty-value { font-size: .75rem; color: #888; margin-top: 5px; }
  </style>
</head>
<body>

<div class="card">
  <h1>💳 Payment</h1>
  <div class="sub"><%= order.table_name %> · Order #<%= order.id %></div>

  <div class="order-summary">
    <% orderItems.forEach(oi => { %>
    <div class="summary-row">
      <span><%= oi.quantity %>× <%= oi.name %></span>
      <span><%= tenant.currency || '$' %><%= (oi.price * oi.quantity).toFixed(2) %></span>
    </div>
    <% }) %>
    <% if (discount > 0) { %>
    <div class="summary-row" style="color:#00b894">
      <span>Discount</span>
      <span>−<%= tenant.currency || '$' %><%= discount.toFixed(2) %></span>
    </div>
    <% } %>
    <% if (serviceFeePct > 0) { %>
    <div class="summary-row" style="color:#e17055">
      <span>Service Fee (<%= serviceFeePct %>%)</span>
      <span><%= tenant.currency || '$' %><%= serviceFee.toFixed(2) %></span>
    </div>
    <% } %>
    <div class="summary-row" id="tipSummaryRow" style="display:none;color:#00b894">
      <span>Tip</span>
      <span id="tipSummaryAmt"><%= tenant.currency || '$' %>0.00</span>
    </div>
    <div class="summary-row total">
      <span>Grand Total</span>
      <span id="grandTotal"><%= tenant.currency || '$' %><%= grandTotal.toFixed(2) %></span>
    </div>
  </div>

  <form method="POST" action="/pos/order/<%= order.id %>/pay" id="payForm">
    <!-- Customer -->
    <div class="customer-section">
      <label>Customer</label>
      <input type="hidden" name="customer_id" id="customerIdInput" value="" />

      <!-- Selected display -->
      <div id="selectedCustomer" class="selected-customer cash-selected" onclick="openCustomerPicker()">
        <div class="cust-avatar">👤</div>
        <span class="selected-name" id="selectedName">Cash Customer</span>
        <span class="change-cust">tap to change</span>
      </div>

      <!-- Picker dropdown -->
      <div id="custPickerWrap" style="display:none;position:relative;margin-top:6px">
        <input type="text" class="customer-search" id="custSearch" placeholder="Search by name or phone..." oninput="filterCustomers()" />
        <div class="customer-dropdown open" id="custDropdown">
          <div class="cust-opt cash" onclick="selectCustomer('', 'Cash Customer', '', 0)">
            <div class="cust-avatar" style="background:rgba(255,255,255,.06);color:#555">💵</div>
            <div class="cust-info"><div class="cust-name" style="color:#888">Cash Customer</div></div>
          </div>
          <% customers.forEach(c => { %>
          <div class="cust-opt" data-name="<%= c.name.toLowerCase() %>" data-phone="<%= (c.phone||'').toLowerCase() %>"
               onclick="selectCustomer('<%= c.id %>', '<%= c.name.replace(/'/g, "\\'") %>', '<%= c.phone || '' %>', <%= c.loyalty_points || 0 %>)">
            <div class="cust-avatar"><%= c.name.charAt(0).toUpperCase() %></div>
            <div class="cust-info">
              <div class="cust-name"><%= c.name %></div>
              <% if (c.phone) { %><div class="cust-phone"><%= c.phone %></div><% } %>
            </div>
          </div>
          <% }) %>
        </div>
      </div>
    </div>

    <!-- Loyalty Points Redemption -->
    <% if (loyaltyProgram) { %>
    <div class="loyalty-box" id="loyaltyBox" style="display:none">
      <div class="loyalty-header">
        <div class="loyalty-title">⭐ Loyalty Points</div>
        <div class="loyalty-pts" id="custLoyaltyPts">0 pts</div>
      </div>
      <div class="loyalty-redeem-row">
        <input type="number" class="loyalty-redeem-input" name="redeem_points" id="redeemPtsInput"
          value="0" min="0" placeholder="0" oninput="updateLoyaltyDiscount()" />
        <span style="font-size:.82rem;color:#fdcb6e;white-space:nowrap">pts to redeem</span>
      </div>
      <div class="loyalty-value" id="loyaltyDiscountVal">Redemption value: <%= tenant.currency||'$' %>0.00</div>
    </div>
    <% } else { %>
    <input type="hidden" name="redeem_points" value="0" />
    <% } %>

    <!-- Tip -->
    <div class="tip-section">
      <label>Tip</label>
      <div class="tip-quick">
        <button type="button" class="tip-pct-btn active" onclick="setTipPct(0)">No Tip</button>
        <button type="button" class="tip-pct-btn" onclick="setTipPct(10)">10%</button>
        <button type="button" class="tip-pct-btn" onclick="setTipPct(15)">15%</button>
        <button type="button" class="tip-pct-btn" onclick="setTipPct(20)">20%</button>
        <button type="button" class="tip-pct-btn" onclick="setTipPct(-1)">Custom</button>
      </div>
      <input type="number" class="tip-input" name="tip_amount" id="tipInput" value="0.00" min="0" step="0.01" oninput="tipChanged()" placeholder="0.00" style="display:none" />
    </div>

    <!-- Payment Method -->
    <div class="method-row">
      <div class="method-btn active" id="btnCash" onclick="setMethod('cash')">💵 Cash</div>
      <div class="method-btn" id="btnCard" onclick="setMethod('card')">💳 Card</div>
    </div>
    <input type="hidden" name="method" id="methodInput" value="cash" />
    <input type="hidden" name="received_currency" id="currencyInput" value="USD" />
    <input type="hidden" name="exchange_rate" value="<%= exchangeRate %>" />
    <input type="hidden" name="service_fee_pct" value="<%= serviceFeePct %>" />

    <!-- Amount Paid -->
    <div id="cashSection">
      <!-- Currency toggle (only shown when exchange rate > 1) -->
      <% if (exchangeRate > 1) { %>
      <div class="currency-toggle">
        <button type="button" class="cur-btn active" id="btnUSD" onclick="setCurrency('USD')">$ USD</button>
        <button type="button" class="cur-btn" id="btnIQD" onclick="setCurrency('IQD')">🇮🇶 IQD</button>
      </div>
      <!-- IQD equiv display -->
      <div class="iqd-equiv" id="iqdEquiv" style="display:none">
        <div>
          <div class="iqd-label">Total in IQD</div>
          <div class="rate-badge">Rate: 1 <%= tenant.currency || '$' %> = <%= exchangeRate.toFixed(0) %> IQD</div>
        </div>
        <div class="iqd-val" id="totalIQD"><%= (grandTotal * exchangeRate).toFixed(0) %> IQD</div>
      </div>
      <% } %>

      <label id="amountLabel">Amount Received (<%= tenant.currency || '$' %>)</label>
      <div class="quick-amounts" id="quickAmounts">
        <% [grandTotal, Math.ceil(grandTotal/5)*5, Math.ceil(grandTotal/10)*10, Math.ceil(grandTotal/50)*50].filter((v,i,a)=>a.indexOf(v)===i).forEach(amt => { %>
        <button type="button" class="quick-btn usd-btn" onclick="setAmountUSD(<%= amt.toFixed(2) %>)"><%= tenant.currency || '$' %><%= amt.toFixed(2) %></button>
        <% }) %>
        <% const EXRATE = exchangeRate; %>
        <% if (exchangeRate > 1) { [grandTotal * exchangeRate, Math.ceil(grandTotal * exchangeRate / 1000)*1000, Math.ceil(grandTotal * exchangeRate / 5000)*5000].filter((v,i,a)=>a.indexOf(v)===i).forEach(amt => { %>
        <button type="button" class="quick-btn iqd-btn" style="display:none;border-color:rgba(243,156,18,.3);color:#f39c12" onclick="setAmountIQD(<%= amt.toFixed(0) %>)"><%= amt.toFixed(0) %> IQD</button>
        <% }) } %>
      </div>
      <input type="number" class="amount-input" name="amount_paid" id="amountInput"
        value="<%= grandTotal.toFixed(2) %>" min="0" step="0.01"
        oninput="calcChange()" />

      <div class="change-box">
        <span class="change-label">Change</span>
        <span class="change-amount" id="changeAmt"><%= tenant.currency || '$' %>0.00</span>
      </div>
      <!-- IQD change display -->
      <div class="iqd-equiv" id="changeIQDBox" style="display:none;margin-top:-10px;margin-bottom:16px;background:rgba(0,184,148,.06);border-color:rgba(0,184,148,.2)">
        <span class="iqd-label" style="color:#00b894">Change in IQD</span>
        <span class="iqd-val" id="changeIQD" style="color:#00b894">0 IQD</span>
      </div>
    </div>

    <button type="submit" class="btn btn-pay" onclick="return validatePay()">✓ Confirm Payment</button>
  </form>
  <a href="/pos/order/<%= order.id %>" class="btn btn-back" style="display:block;text-align:center;text-decoration:none;margin-top:10px">← Back to Order</a>
</div>

<script>
  const TOTAL       = <%= grandTotal.toFixed(2) %>;
  const CUR         = '<%= tenant.currency || "$" %>';
  const EXRATE      = <%= exchangeRate %>;
  const REDEEM_RATE = <%= loyaltyProgram ? parseFloat(loyaltyProgram.redeem_rate) : 0 %>;
  const MIN_REDEEM  = <%= loyaltyProgram ? loyaltyProgram.min_redeem_pts : 0 %>;
  let   curMode  = 'USD';   // 'USD' | 'IQD'
  let   _tip     = 0;
  let   _tipMode = 0;   // 0 = no tip, -1 = custom, else pct
  let   _redeemPts = 0;

  function setTipPct(pct) {
    _tipMode = pct;
    document.querySelectorAll('.tip-pct-btn').forEach((b, i) => b.classList.remove('active'));
    event.target.classList.add('active');
    const tipInput = document.getElementById('tipInput');
    if (pct === -1) {
      tipInput.style.display = '';
      tipInput.focus();
      _tip = parseFloat(tipInput.value) || 0;
    } else {
      tipInput.style.display = 'none';
      _tip = pct > 0 ? parseFloat((TOTAL * pct / 100).toFixed(2)) : 0;
      tipInput.value = _tip.toFixed(2);
    }
    updateTipDisplay();
    calcChange();
  }

  function tipChanged() {
    _tip = parseFloat(document.getElementById('tipInput').value) || 0;
    updateTipDisplay();
    calcChange();
  }

  function updateTipDisplay() {
    const row = document.getElementById('tipSummaryRow');
    const amt = document.getElementById('tipSummaryAmt');
    const gt  = document.getElementById('grandTotal');
    if (_tip > 0) {
      row.style.display = '';
      amt.textContent = CUR + _tip.toFixed(2);
    } else {
      row.style.display = 'none';
    }
    gt.textContent = CUR + (TOTAL + _tip).toFixed(2);
  }

  function setMethod(m) {
    document.getElementById('methodInput').value = m;
    document.getElementById('btnCash').classList.toggle('active', m === 'cash');
    document.getElementById('btnCard').classList.toggle('active', m === 'card');
    document.getElementById('cashSection').style.display = m === 'cash' ? '' : 'none';
    if (m === 'card') {
      document.getElementById('amountInput').value = TOTAL.toFixed(2);
      calcChange();
    }
  }

  function setCurrency(mode) {
    curMode = mode;
    document.getElementById('currencyInput').value = mode;

    const btnUSD = document.getElementById('btnUSD');
    const btnIQD = document.getElementById('btnIQD');
    if (btnUSD) btnUSD.classList.toggle('active', mode === 'USD');
    if (btnIQD) btnIQD.classList.toggle('active', mode === 'IQD');

    const iqdEquiv   = document.getElementById('iqdEquiv');
    const changeIQDB = document.getElementById('changeIQDBox');
    const label      = document.getElementById('amountLabel');

    document.querySelectorAll('.usd-btn').forEach(b => b.style.display = mode === 'USD' ? '' : 'none');
    document.querySelectorAll('.iqd-btn').forEach(b => b.style.display = mode === 'IQD' ? '' : 'none');

    if (mode === 'IQD') {
      if (iqdEquiv)   iqdEquiv.style.display   = '';
      if (changeIQDB) changeIQDB.style.display  = '';
      if (label)      label.textContent          = 'Amount Received (IQD)';
      // Default to total in IQD
      document.getElementById('amountInput').value = (TOTAL * EXRATE).toFixed(0);
    } else {
      if (iqdEquiv)   iqdEquiv.style.display   = 'none';
      if (changeIQDB) changeIQDB.style.display  = 'none';
      if (label)      label.textContent          = 'Amount Received (' + CUR + ')';
      document.getElementById('amountInput').value = TOTAL.toFixed(2);
    }
    calcChange();
  }

  function setAmountUSD(v) {
    document.getElementById('amountInput').value = v.toFixed(2);
    calcChange();
  }

  function setAmountIQD(v) {
    document.getElementById('amountInput').value = v.toFixed(0);
    calcChange();
  }

  function calcChange() {
    const paid     = parseFloat(document.getElementById('amountInput').value) || 0;
    const grandTot = TOTAL + _tip;
    if (curMode === 'IQD') {
      const totalIQD  = grandTot * EXRATE;
      const changeIQD = Math.max(0, paid - totalIQD);
      document.getElementById('changeAmt').textContent = changeIQD.toFixed(0) + ' IQD';
      const ciqd = document.getElementById('changeIQD');
      if (ciqd) ciqd.textContent = changeIQD.toFixed(0) + ' IQD';
    } else {
      const change = Math.max(0, paid - grandTot);
      document.getElementById('changeAmt').textContent = CUR + change.toFixed(2);
    }
  }

  function validatePay() {
    const paid     = parseFloat(document.getElementById('amountInput').value) || 0;
    const grandTot = TOTAL + _tip;
    if (document.getElementById('methodInput').value === 'cash') {
      const minRequired = curMode === 'IQD' ? grandTot * EXRATE : grandTot;
      if (paid < minRequired) {
        const msg = curMode === 'IQD'
          ? 'Amount received must be at least ' + (grandTot * EXRATE).toFixed(0) + ' IQD'
          : 'Amount received must be at least ' + CUR + grandTot.toFixed(2);
        alert(msg);
        return false;
      }
    }
    return true;
  }

  calcChange();

  // Customer picker
  function openCustomerPicker() {
    document.getElementById('selectedCustomer').style.display = 'none';
    document.getElementById('custPickerWrap').style.display = '';
    document.getElementById('custSearch').focus();
  }

  function selectCustomer(id, name, phone, loyaltyPts) {
    document.getElementById('customerIdInput').value = id;
    document.getElementById('selectedName').textContent = name;
    const sel = document.getElementById('selectedCustomer');
    sel.style.display = '';
    sel.className = 'selected-customer' + (id ? '' : ' cash-selected');
    document.getElementById('custPickerWrap').style.display = 'none';
    document.getElementById('custSearch').value = '';
    filterCustomers();
    // Loyalty
    const lbox = document.getElementById('loyaltyBox');
    const lpts = document.getElementById('custLoyaltyPts');
    const rinp = document.getElementById('redeemPtsInput');
    if (lbox) {
      if (id && loyaltyPts >= MIN_REDEEM) {
        lbox.style.display = '';
        if (lpts) lpts.textContent = loyaltyPts.toLocaleString() + ' pts';
        if (rinp) { rinp.max = loyaltyPts; rinp.value = 0; }
        _redeemPts = 0;
        updateLoyaltyDiscount();
      } else {
        lbox.style.display = 'none';
        if (rinp) rinp.value = 0;
        _redeemPts = 0;
      }
    }
  }

  function updateLoyaltyDiscount() {
    const rinp = document.getElementById('redeemPtsInput');
    if (!rinp) return;
    _redeemPts = Math.max(0, parseInt(rinp.value) || 0);
    const discVal = _redeemPts * REDEEM_RATE;
    const el = document.getElementById('loyaltyDiscountVal');
    if (el) el.textContent = 'Redemption value: ' + CUR + discVal.toFixed(2) + ' (applied as discount at save)';
  }

  function filterCustomers() {
    const q = document.getElementById('custSearch').value.toLowerCase();
    document.querySelectorAll('.cust-opt:not(.cash)').forEach(el => {
      const match = !q || el.dataset.name.includes(q) || el.dataset.phone.includes(q);
      el.style.display = match ? '' : 'none';
    });
  }

  // Close picker when clicking outside
  document.addEventListener('click', e => {
    const wrap = document.getElementById('custPickerWrap');
    if (wrap && wrap.style.display !== 'none' && !wrap.contains(e.target) && !document.getElementById('selectedCustomer').contains(e.target)) {
      selectCustomer(
        document.getElementById('customerIdInput').value,
        document.getElementById('selectedName').textContent,
        ''
      );
    }
  });
</script>
</body>
