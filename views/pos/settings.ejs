<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>POS Settings — <%= tenant.name %></title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Segoe UI', sans-serif; background: #0f0f1a; color: #e0e0e0; min-height: 100vh; }
    .topbar { background: #1a1a2e; height: 56px; display: flex; align-items: center; justify-content: space-between; padding: 0 24px; border-bottom: 1px solid rgba(255,255,255,.07); }
    .topbar-title { font-weight: 700; color: #fff; }
    .btn { padding: 7px 16px; border: none; border-radius: 8px; cursor: pointer; font-size: .82rem; font-weight: 600; font-family: inherit; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; }
    .btn-ghost { background: rgba(255,255,255,.08); color: #ccc; }
    .btn-ghost:hover { background: rgba(255,255,255,.14); color: #fff; }
    .btn-primary { background: #7c5cbf; color: #fff; }
    .btn-primary:hover { opacity: .88; }
    .btn-danger { background: rgba(255,71,87,.15); color: #ff6b7a; border: 1px solid rgba(255,71,87,.3); }
    .btn-sm { padding: 5px 12px; font-size: .76rem; }
    .btn-test { background: rgba(52,152,219,.15); color: #3498db; border: 1px solid rgba(52,152,219,.3); }
    .btn-test:hover { background: rgba(52,152,219,.25); }

    .tabs { background: #1a1a2e; display: flex; gap: 0; border-bottom: 1px solid rgba(255,255,255,.07); padding: 0 24px; }
    .tab { padding: 14px 20px; font-size: .85rem; font-weight: 600; color: #555; cursor: pointer; border-bottom: 2px solid transparent; transition: all .15s; }
    .tab.active { color: #fff; border-bottom-color: #7c5cbf; }
    .tab:hover { color: #ccc; }

    .main { padding: 28px 24px; max-width: 760px; margin: 0 auto; }
    .tab-panel { display: none; }
    .tab-panel.active { display: block; }

    .card { background: #1a1a2e; border-radius: 14px; border: 1px solid rgba(255,255,255,.06); padding: 24px; margin-bottom: 20px; }
    .card h2 { font-size: .9rem; font-weight: 700; color: #fff; margin-bottom: 4px; }
    .card-desc { font-size: .78rem; color: #555; margin-bottom: 18px; }

    .form-row { display: grid; grid-template-columns: 1fr 1fr auto; gap: 10px; align-items: end; margin-bottom: 16px; }
    label { display: block; font-size: .75rem; font-weight: 600; color: #666; margin-bottom: 5px; }
    input[type=text], input[type=number], select { width: 100%; padding: 9px 12px; background: #0f0f1a; border: 1.5px solid #2a2a3e; border-radius: 8px; color: #fff; font-size: .88rem; outline: none; font-family: inherit; }
    input:focus, select:focus { border-color: #7c5cbf; }
    select option { background: #1a1a2e; }

    .tables-list { display: flex; flex-direction: column; gap: 8px; }
    .table-row { display: flex; align-items: center; gap: 10px; padding: 12px 14px; background: #0f0f1a; border-radius: 10px; border: 1px solid #2a2a3e; }
    .table-row-name { flex: 1; font-size: .88rem; font-weight: 600; color: #fff; }
    .table-row-cap { font-size: .78rem; color: #555; }
    .table-actions { display: flex; gap: 6px; }
    .edit-form { display: none; background: #13132a; border-radius: 10px; padding: 14px; margin-top: 8px; }
    .edit-form.open { display: block; }
    .edit-row { display: grid; grid-template-columns: 1fr 1fr auto; gap: 8px; align-items: end; }

    /* Toggle switch */
    .perm-row { display: flex; align-items: center; justify-content: space-between; padding: 14px 0; border-bottom: 1px solid rgba(255,255,255,.05); }
    .perm-row:last-child { border-bottom: none; }
    .perm-info { flex: 1; }
    .perm-label { font-size: .88rem; font-weight: 600; color: #ccc; margin-bottom: 2px; }
    .perm-desc  { font-size: .75rem; color: #555; }
    .toggle-wrap { position: relative; display: inline-block; width: 44px; height: 24px; flex-shrink: 0; }
    .toggle-wrap input { opacity: 0; width: 0; height: 0; }
    .toggle-slider { position: absolute; inset: 0; background: #2a2a3e; border-radius: 24px; cursor: pointer; transition: .2s; }
    .toggle-slider:before { content: ''; position: absolute; width: 18px; height: 18px; left: 3px; top: 3px; background: #555; border-radius: 50%; transition: .2s; }
    .toggle-wrap input:checked + .toggle-slider { background: #7c5cbf; }
    .toggle-wrap input:checked + .toggle-slider:before { transform: translateX(20px); background: #fff; }

    .save-row { display: flex; justify-content: flex-end; margin-top: 8px; }

    /* Printer cards */
    .printer-list { display: flex; flex-direction: column; gap: 10px; }
    .printer-card { background: #0f0f1a; border: 1px solid #2a2a3e; border-radius: 12px; overflow: hidden; }
    .printer-card.inactive { opacity: .55; }
    .printer-main { display: flex; align-items: center; gap: 14px; padding: 14px 16px; flex-wrap: wrap; }
    .printer-icon { font-size: 1.4rem; flex-shrink: 0; }
    .printer-info { flex: 1; min-width: 0; }
    .printer-name { font-size: .9rem; font-weight: 700; color: #fff; margin-bottom: 3px; }
    .printer-meta { font-size: .75rem; color: #555; display: flex; gap: 10px; flex-wrap: wrap; }
    .printer-actions { display: flex; gap: 6px; align-items: center; flex-shrink: 0; }
    .role-badge { padding: 3px 9px; border-radius: 10px; font-size: .68rem; font-weight: 700; }
    .role-receipt { background: rgba(124,92,191,.15); color: #c4b0f0; }
    .role-kitchen { background: rgba(231,76,60,.12); color: #e74c3c; }
    .role-both    { background: rgba(0,184,148,.12); color: #00b894; }
    .active-dot { width: 8px; height: 8px; border-radius: 50%; background: #00b894; display: inline-block; margin-right: 4px; }
    .inactive-dot { width: 8px; height: 8px; border-radius: 50%; background: #444; display: inline-block; margin-right: 4px; }
    .test-result { font-size: .73rem; padding: 4px 10px; border-radius: 6px; display: none; }
    .test-result.ok  { background: rgba(0,184,148,.12); color: #00b894; }
    .test-result.err { background: rgba(231,76,60,.12); color: #e74c3c; }

    .printer-edit-form { display: none; background: #13132a; border-top: 1px solid #2a2a3e; padding: 16px; }
    .printer-edit-form.open { display: block; }
    .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 10px; }
    .grid3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px; margin-bottom: 10px; }
    .grid4 { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 10px; margin-bottom: 10px; }

    /* Add printer form */
    .add-printer-form { border: 1.5px dashed #2a2a3e; border-radius: 12px; padding: 20px; }
    .add-printer-form h3 { font-size: .85rem; font-weight: 700; color: #fff; margin-bottom: 14px; }
  </style>
</head>
<body>

<div class="topbar">
  <div style="display:flex;align-items:center;gap:8px">
    <a href="/pos/tables" class="btn btn-ghost" style="padding:6px 10px;font-size:1.1rem;flex-shrink:0" title="Pos Home">🏠</a>
    <a href="/admin" class="btn btn-ghost" style="padding:5px 10px;font-size:.78rem;flex-shrink:0" title="All Modules">⊞ Modules</a>
    <div class="topbar-title">⚙️ POS Settings</div>
  </div>
  <button onclick="history.back()" class="btn btn-ghost">← Back</button>
</div>

<div class="tabs">
  <div class="tab active" onclick="switchTab('tables', this)">🪑 Tables</div>
  <div class="tab" onclick="switchTab('permissions', this)">🔐 Permissions</div>
  <div class="tab" onclick="switchTab('fees', this)">💰 Fees</div>
  <div class="tab" onclick="switchTab('printers', this)">🖨️ Printers</div>
  <div class="tab" onclick="switchTab('bill', this)">🧾 Bill</div>
  <% if (tenant.feat_modifiers) { %><a href="/pos/modifiers" class="tab" style="text-decoration:none;color:inherit">⚙️ Modifiers</a><% } %>
  <% if (tenant.feat_happy_hour) { %><a href="/pos/happy-hours" class="tab" style="text-decoration:none;color:inherit">🎉 Happy Hours</a><% } %>
</div>

<div class="main">

  <!-- TABLES TAB -->
  <div class="tab-panel active" id="tab-tables">
    <div class="card">
      <h2>Add New Table</h2>
      <p class="card-desc">Each table appears on the POS table map. Tables are shared across sessions.</p>
      <form method="POST" action="/pos/settings/tables">
        <div class="form-row">
          <div>
            <label>Table Name *</label>
            <input type="text" name="name" required placeholder="e.g. Table 1, Bar, Terrace" />
          </div>
          <div>
            <label>Capacity</label>
            <input type="number" name="capacity" value="4" min="1" max="50" />
          </div>
          <button type="submit" class="btn btn-primary">Add</button>
        </div>
      </form>
    </div>

    <div class="card">
      <h2>Your Tables (<%= tables.length %>)</h2>
      <% if (tables.length === 0) { %>
      <p style="color:#444;font-size:.85rem;text-align:center;padding:24px">No tables yet. Add one above.</p>
      <% } else { %>
      <div class="tables-list">
        <% tables.forEach(t => { %>
        <div>
          <div class="table-row">
            <div>
              <div class="table-row-name">🪑 <%= t.name %></div>
              <div class="table-row-cap">Capacity: <%= t.capacity %></div>
            </div>
            <div class="table-actions">
              <button class="btn btn-ghost btn-sm" onclick="toggleEdit('t_<%= t.id %>')">Edit</button>
              <form method="POST" action="/pos/settings/tables/<%= t.id %>/delete" style="display:inline" onsubmit="return confirm('Delete <%= t.name %>?')">
                <button class="btn btn-danger btn-sm" type="submit">Delete</button>
              </form>
            </div>
          </div>
          <div class="edit-form" id="t_<%= t.id %>">
            <form method="POST" action="/pos/settings/tables/<%= t.id %>/edit">
              <div class="edit-row">
                <div><label>Name</label><input type="text" name="name" value="<%= t.name %>" required /></div>
                <div><label>Capacity</label><input type="number" name="capacity" value="<%= t.capacity %>" min="1" /></div>
                <button type="submit" class="btn btn-primary btn-sm">Save</button>
              </div>
            </form>
          </div>
        </div>
        <% }) %>
      </div>
      <% } %>
    </div>
  </div>

  <!-- PERMISSIONS TAB -->
  <div class="tab-panel" id="tab-permissions">
    <div class="card">
      <h2>Cashier Permissions</h2>
      <p class="card-desc">Control what a POS cashier can do without manager approval.</p>
      <form method="POST" action="/pos/settings/permissions">
        <div class="perm-row">
          <div class="perm-info">
            <div class="perm-label">Void Orders</div>
            <div class="perm-desc">Allow cashiers to cancel / void an order</div>
          </div>
          <label class="toggle-wrap">
            <input type="checkbox" name="pos_allow_void" value="1" <%= tenant.pos_allow_void !== false ? 'checked' : '' %> />
            <span class="toggle-slider"></span>
          </label>
        </div>
        <div class="perm-row">
          <div class="perm-info">
            <div class="perm-label">Apply Discounts</div>
            <div class="perm-desc">Allow cashiers to add percent or fixed discounts on orders</div>
          </div>
          <label class="toggle-wrap">
            <input type="checkbox" name="pos_allow_discount" value="1" <%= tenant.pos_allow_discount !== false ? 'checked' : '' %> />
            <span class="toggle-slider"></span>
          </label>
        </div>
        <div class="perm-row">
          <div class="perm-info">
            <div class="perm-label">Open Takeaway Orders</div>
            <div class="perm-desc">Allow cashiers to create takeaway orders</div>
          </div>
          <label class="toggle-wrap">
            <input type="checkbox" name="pos_allow_takeaway" value="1" <%= tenant.pos_allow_takeaway !== false ? 'checked' : '' %> />
            <span class="toggle-slider"></span>
          </label>
        </div>
        <div class="perm-row">
          <div class="perm-info">
            <div class="perm-label">Print Receipts</div>
            <div class="perm-desc">Allow cashiers to view and print the receipt after payment</div>
          </div>
          <label class="toggle-wrap">
            <input type="checkbox" name="pos_allow_receipt" value="1" <%= tenant.pos_allow_receipt !== false ? 'checked' : '' %> />
            <span class="toggle-slider"></span>
          </label>
        </div>
        <div class="save-row">
          <button type="submit" class="btn btn-primary">Save Permissions</button>
        </div>
      </form>
    </div>

    <div class="card">
      <h2>🔐 Permanent Passcodes</h2>
      <p class="card-desc">Set a permanent manager passcode that can be reused (instead of a one-time generated code). Leave blank to clear / disable.</p>
      <form method="POST" action="/pos/settings/perm-passcode">
        <div class="form-row" style="display:flex;flex-direction:column;gap:14px;padding:8px 0">
          <div>
            <label style="display:block;font-size:.8rem;color:#aaa;margin-bottom:6px">Void / Delete Passcode</label>
            <input type="text" name="perm_void_code" value="<%= tenant.pos_perm_void_code || '' %>"
              placeholder="e.g. 1234 (leave blank to disable)"
              style="width:100%;max-width:320px;background:#1a1a2e;border:1px solid #333;border-radius:8px;padding:10px 14px;color:#e0e0e0;font-size:.95rem" />
          </div>
          <div>
            <label style="display:block;font-size:.8rem;color:#aaa;margin-bottom:6px">Discount Passcode</label>
            <input type="text" name="perm_discount_code" value="<%= tenant.pos_perm_discount_code || '' %>"
              placeholder="e.g. 5678 (leave blank to disable)"
              style="width:100%;max-width:320px;background:#1a1a2e;border:1px solid #333;border-radius:8px;padding:10px 14px;color:#e0e0e0;font-size:.95rem" />
          </div>
        </div>
        <div class="save-row">
          <button type="submit" class="btn btn-primary">Save Passcodes</button>
        </div>
      </form>
    </div>

    <div class="card">
      <h2>Display Settings</h2>
      <p class="card-desc">Control what appears on the POS screen for cashiers.</p>
      <form method="POST" action="/pos/settings/display">
        <div class="perm-row">
          <div class="perm-info">
            <div class="perm-label">Show Kitchen Button</div>
            <div class="perm-desc">Show the Kitchen Display link in the POS topbar</div>
          </div>
          <label class="toggle-wrap">
            <input type="checkbox" name="pos_show_kitchen" value="1" <%= tenant.pos_show_kitchen !== false ? 'checked' : '' %> />
            <span class="toggle-slider"></span>
          </label>
        </div>
        <div class="perm-row">
          <div class="perm-info">
            <div class="perm-label">Show Item Images</div>
            <div class="perm-desc">Display menu item images on the order screen</div>
          </div>
          <label class="toggle-wrap">
            <input type="checkbox" name="pos_show_images" value="1" <%= tenant.pos_show_images !== false ? 'checked' : '' %> />
            <span class="toggle-slider"></span>
          </label>
        </div>
        <div class="perm-row">
          <div class="perm-info">
            <div class="perm-label">Show Table Capacity</div>
            <div class="perm-desc">Show seat count under each table on the table map</div>
          </div>
          <label class="toggle-wrap">
            <input type="checkbox" name="pos_show_capacity" value="1" <%= tenant.pos_show_capacity !== false ? 'checked' : '' %> />
            <span class="toggle-slider"></span>
          </label>
        </div>
        <div class="save-row">
          <button type="submit" class="btn btn-primary">Save Display</button>
        </div>
      </form>
    </div>

  </div>

  <!-- FEES TAB -->
  <div class="tab-panel" id="tab-fees">
    <div class="card">
      <h2>💰 Service Fee</h2>
      <p class="card-desc">Automatically add a service charge on every order at checkout. When enabled a <strong>Service Fee</strong> button appears on the cashier screen showing the calculated amount.</p>
      <form method="POST" action="/pos/settings/service-fee">
        <div class="perm-row">
          <div class="perm-info">
            <div class="perm-label">Enable Service Fee</div>
            <div class="perm-desc">Adds a percentage on top of the order total, shown at payment</div>
          </div>
          <label class="toggle-wrap">
            <input type="checkbox" name="pos_service_fee_enabled" value="1" id="sfToggle"
              <%= tenant.pos_service_fee_enabled ? 'checked' : '' %> onchange="toggleSFInput(this)" />
            <span class="toggle-slider"></span>
          </label>
        </div>
        <div id="sfPctRow" style="margin-top:18px;<%= tenant.pos_service_fee_enabled ? '' : 'display:none' %>">
          <label>Service Fee Percentage</label>
          <div style="display:flex;align-items:center;gap:10px;max-width:240px;margin-top:6px">
            <input type="number" name="pos_service_fee_pct" id="sfPctInput"
              value="<%= parseFloat(tenant.pos_service_fee_pct) || 0 %>"
              min="0" max="100" step="0.01" placeholder="e.g. 10" style="width:130px" />
            <span style="color:#888;font-size:1rem;font-weight:700">%</span>
          </div>
          <p style="font-size:.72rem;color:#444;margin-top:6px">Enter a number between 0 and 100. Example: 10 = 10% service charge.</p>
        </div>
        <div class="save-row" style="margin-top:20px">
          <button type="submit" class="btn btn-primary">Save Service Fee</button>
        </div>
      </form>
    </div>
  </div>

  <!-- PRINTERS TAB -->
  <div class="tab-panel" id="tab-printers">

    <!-- Add Printer -->
    <div class="card">
      <h2>Add Printer</h2>
      <p class="card-desc">Configure a network (IP-based) thermal printer for receipts or kitchen tickets.</p>
      <form method="POST" action="/pos/settings/printers" class="add-printer-form">
        <div class="grid2">
          <div>
            <label>Printer Name *</label>
            <input type="text" name="name" required placeholder="e.g. Kitchen Printer, Counter" />
          </div>
          <div>
            <label>Role *</label>
            <select name="role">
              <option value="receipt">🧾 Receipt — prints customer receipts</option>
              <option value="kitchen">🍳 Kitchen — prints kitchen order tickets</option>
              <option value="both">📋 Both — receipts & kitchen tickets</option>
            </select>
          </div>
        </div>
        <div class="grid4">
          <div>
            <label>IP Address *</label>
            <input type="text" name="ip_address" placeholder="192.168.1.100" pattern="[\d\.]+" />
          </div>
          <div>
            <label>Port</label>
            <input type="number" name="port" value="9100" min="1" max="65535" />
          </div>
          <div>
            <label>Paper Width</label>
            <select name="paper_width">
              <option value="80mm">80 mm</option>
              <option value="58mm">58 mm</option>
            </select>
          </div>
          <div style="display:flex;align-items:flex-end">
            <button type="submit" class="btn btn-primary" style="width:100%">Add Printer</button>
          </div>
        </div>
      </form>
    </div>

    <!-- Existing Printers -->
    <div class="card">
      <h2>Configured Printers (<%= printers.length %>)</h2>
      <% if (printers.length === 0) { %>
      <p style="color:#444;font-size:.85rem;text-align:center;padding:28px">No printers configured yet.</p>
      <% } else { %>
      <div class="printer-list" style="margin-top:4px">
        <% printers.forEach(p => { %>
        <div class="printer-card <%= p.is_active ? '' : 'inactive' %>">
          <div class="printer-main">
            <div class="printer-icon"><% if(p.role==='kitchen'){%>🍳<%}else if(p.role==='both'){%>📋<%}else{%>🧾<%}%></div>
            <div class="printer-info">
              <div class="printer-name">
                <% if (p.is_active) { %><span class="active-dot"></span><% } else { %><span class="inactive-dot"></span><% } %>
                <%= p.name %>
                <span class="role-badge role-<%= p.role %>"><%= p.role === 'receipt' ? 'Receipt' : p.role === 'kitchen' ? 'Kitchen' : 'Both' %></span>
              </div>
              <div class="printer-meta">
                <% if (p.connection_type === 'network') { %>
                  <span>🌐 <%= p.ip_address || 'No IP' %>:<%= p.port || 9100 %></span>
                <% } %>
                <span>📄 <%= p.paper_width || '80mm' %></span>
              </div>
            </div>
            <div class="printer-actions">
              <span class="test-result" id="test_<%= p.id %>"></span>
              <% if (p.connection_type === 'network' && p.ip_address) { %>
              <button class="btn btn-test btn-sm" onclick="testPrinter(<%= p.id %>)">Test</button>
              <% } %>
              <button class="btn btn-ghost btn-sm" onclick="toggleEdit('p_<%= p.id %>')">Edit</button>
              <form method="POST" action="/pos/settings/printers/<%= p.id %>/delete" style="display:inline" onsubmit="return confirm('Delete printer <%= p.name %>?')">
                <button class="btn btn-danger btn-sm" type="submit">✕</button>
              </form>
            </div>
          </div>
          <div class="printer-edit-form" id="p_<%= p.id %>">
            <form method="POST" action="/pos/settings/printers/<%= p.id %>/edit">
              <div class="grid2">
                <div>
                  <label>Printer Name</label>
                  <input type="text" name="name" value="<%= p.name %>" required />
                </div>
                <div>
                  <label>Role</label>
                  <select name="role">
                    <option value="receipt" <%= p.role==='receipt'?'selected':'' %>>🧾 Receipt</option>
                    <option value="kitchen" <%= p.role==='kitchen'?'selected':'' %>>🍳 Kitchen</option>
                    <option value="both"    <%= p.role==='both'   ?'selected':'' %>>📋 Both</option>
                  </select>
                </div>
              </div>
              <div class="grid3">
                <div>
                  <label>IP Address</label>
                  <input type="text" name="ip_address" value="<%= p.ip_address || '' %>" placeholder="192.168.1.100" />
                </div>
                <div>
                  <label>Port</label>
                  <input type="number" name="port" value="<%= p.port || 9100 %>" min="1" max="65535" />
                </div>
                <div>
                  <label>Paper Width</label>
                  <select name="paper_width">
                    <option value="80mm" <%= (p.paper_width||'80mm')==='80mm'?'selected':'' %>>80 mm</option>
                    <option value="58mm" <%= p.paper_width==='58mm'?'selected':'' %>>58 mm</option>
                  </select>
                </div>
              </div>
              <div style="display:flex;justify-content:space-between;align-items:center;margin-top:4px">
                <label style="display:flex;align-items:center;gap:8px;margin:0;cursor:pointer">
                  <input type="checkbox" name="is_active" value="1" <%= p.is_active ? 'checked' : '' %> style="width:14px;height:14px;accent-color:#7c5cbf" />
                  <span style="font-size:.82rem;color:#ccc">Active</span>
                </label>
                <div style="display:flex;gap:8px">
                  <button type="button" class="btn btn-ghost btn-sm" onclick="toggleEdit('p_<%= p.id %>')">Cancel</button>
                  <button type="submit" class="btn btn-primary btn-sm">Save</button>
                </div>
              </div>
            </form>
          </div>
        </div>
        <% }) %>
      </div>
      <% } %>
    </div>

    <!-- Category → Printer Assignments -->
    <div class="card">
      <h2>Category → Printer</h2>
      <p class="card-desc">Choose which printer each menu category prints to. Only kitchen and "both" printers are shown — receipt printers are triggered automatically on payment.</p>
      <% const kitchenPrinters = printers.filter(p => p.is_active && (p.role === 'kitchen' || p.role === 'both')); %>
      <% if (kitchenPrinters.length === 0) { %>
      <p style="color:#444;font-size:.82rem;padding:12px 0">No active kitchen printers configured above. Add a printer with role Kitchen or Both first.</p>
      <% } else if (categories.length === 0) { %>
      <p style="color:#444;font-size:.82rem;padding:12px 0">No menu categories found.</p>
      <% } else { %>
      <form method="POST" action="/pos/settings/printers/categories">
        <div style="display:flex;flex-direction:column;gap:0">
          <% categories.forEach((cat, i) => { %>
          <div style="display:flex;align-items:center;justify-content:space-between;padding:11px 0;border-bottom:1px solid rgba(255,255,255,.05)<%= i===categories.length-1?';border-bottom:none':'' %>">
            <div style="font-size:.88rem;font-weight:600;color:#ccc;display:flex;align-items:center;gap:8px">
              <% if (cat.image_url) { %><img src="<%= cat.image_url %>" style="width:26px;height:26px;border-radius:6px;object-fit:cover" /><% } else { %><span style="width:26px;height:26px;background:#2a2a3e;border-radius:6px;display:inline-flex;align-items:center;justify-content:center;font-size:.8rem">🍽️</span><% } %>
              <%= cat.name %>
            </div>
            <select name="category[<%= cat.id %>]" style="width:220px;padding:7px 10px;background:#0f0f1a;border:1.5px solid #2a2a3e;border-radius:8px;color:#fff;font-size:.82rem;outline:none;font-family:inherit">
              <option value="">— No printer —</option>
              <% kitchenPrinters.forEach(p => { %>
              <option value="<%= p.id %>" <%= cat.printer_id === p.id ? 'selected' : '' %>><%= p.name %> (<%= p.ip_address || 'no IP' %>)</option>
              <% }) %>
            </select>
          </div>
          <% }) %>
        </div>
        <div class="save-row" style="margin-top:14px">
          <button type="submit" class="btn btn-primary">Save Assignments</button>
        </div>
      </form>
      <% } %>
    </div>

    <!-- Kitchen Station Assignment -->
    <% if (tenant.feat_kitchen_routing) { %>
    <div class="card">
      <h2>🍳 Kitchen Stations</h2>
      <p class="card-desc">Assign each category to a kitchen station. The kitchen display can then filter by station (e.g. /pos/kitchen?station=grill).</p>
      <% if (categories.length === 0) { %>
      <p style="color:#444;font-size:.82rem;padding:12px 0">No menu categories found.</p>
      <% } else { %>
      <form method="POST" action="/pos/settings/kitchen-stations">
        <div style="display:flex;flex-direction:column;gap:0">
          <% categories.forEach((cat, i) => { %>
          <div style="display:flex;align-items:center;justify-content:space-between;padding:11px 0;border-bottom:1px solid rgba(255,255,255,.05)<%= i===categories.length-1?';border-bottom:none':'' %>">
            <div style="font-size:.88rem;font-weight:600;color:#ccc;display:flex;align-items:center;gap:8px">
              <% if (cat.image_url) { %><img src="<%= cat.image_url %>" style="width:26px;height:26px;border-radius:6px;object-fit:cover" /><% } else { %><span style="width:26px;height:26px;background:#2a2a3e;border-radius:6px;display:inline-flex;align-items:center;justify-content:center;font-size:.8rem">🍽️</span><% } %>
              <%= cat.name %>
            </div>
            <input type="text" name="station[<%= cat.id %>]" value="<%= cat.kitchen_station || 'main' %>"
              placeholder="main" style="width:160px;padding:7px 10px;background:#0f0f1a;border:1.5px solid #2a2a3e;border-radius:8px;color:#fff;font-size:.82rem;outline:none;font-family:inherit" />
          </div>
          <% }) %>
        </div>
        <div class="save-row" style="margin-top:14px">
          <button type="submit" class="btn btn-primary">Save Stations</button>
        </div>
      </form>
      <% } %>
    </div>
    <% } %>

    <!-- Info box -->
    <div style="background:rgba(52,152,219,.06);border:1px solid rgba(52,152,219,.2);border-radius:12px;padding:16px 20px;font-size:.78rem;color:#666;line-height:1.7">
      <strong style="color:#3498db">ℹ️ How network printing works</strong><br>
      Your printer must be on the same local network as the POS device. Most ESC/POS thermal printers use port <strong style="color:#ccc">9100</strong> by default. Check your printer's settings page or manual for its IP address. The <strong style="color:#ccc">Test</strong> button checks if the printer is reachable over the network.
    </div>
  </div>

  <!-- BILL TAB -->
  <div class="tab-panel" id="tab-bill">
    <div style="display:grid;grid-template-columns:1fr 260px;gap:20px;align-items:start">

      <!-- Settings form -->
      <div>
        <form method="POST" action="/pos/settings/bill" id="billForm" oninput="updatePreview()">
          <div class="card">
            <h2>Language</h2>
            <p class="card-desc">Choose which language(s) to print on the bill.</p>
            <div style="display:flex;flex-direction:column;gap:10px">
              <% const billLang = tenant.bill_language || 'en'; %>
              <% [
                ['en',       '🇬🇧 English only'],
                ['ar',       '🇸🇦 Arabic only'],
                ['ku',       '🏴 Kurdish only'],
                ['en_ar',    '🇬🇧 + 🇸🇦 English & Arabic'],
                ['en_ku',    '🇬🇧 + 🏴 English & Kurdish'],
                ['en_ar_ku', '🇬🇧 + 🇸🇦 + 🏴 All three'],
              ].forEach(([val, label]) => { %>
              <label style="display:flex;align-items:center;gap:10px;cursor:pointer;padding:10px 12px;border:1.5px solid <%= billLang===val ? '#7c5cbf' : '#2a2a3e' %>;border-radius:10px;transition:.15s" id="lang_lbl_<%= val %>">
                <input type="radio" name="bill_language" value="<%= val %>" <%= billLang===val?'checked':'' %> style="accent-color:#7c5cbf;width:16px;height:16px" onchange="highlightLang()" />
                <span style="font-size:.88rem"><%= label %></span>
              </label>
              <% }) %>
            </div>
          </div>

          <div class="card">
            <h2>Style</h2>
            <p class="card-desc">Paper size and font size for the printed bill.</p>
            <div class="grid2" style="margin-bottom:14px">
              <div>
                <label>Paper Width</label>
                <select name="bill_paper_width">
                  <option value="80mm" <%= (tenant.bill_paper_width||'80mm')==='80mm'?'selected':'' %>>80 mm (standard)</option>
                  <option value="58mm" <%= tenant.bill_paper_width==='58mm'?'selected':'' %>>58 mm (narrow)</option>
                </select>
              </div>
              <div>
                <label>Font Size</label>
                <select name="bill_font_size">
                  <option value="small"  <%= tenant.bill_font_size==='small' ?'selected':'' %>>Small</option>
                  <option value="normal" <%= (tenant.bill_font_size||'normal')==='normal'?'selected':'' %>>Normal</option>
                  <option value="large"  <%= tenant.bill_font_size==='large' ?'selected':'' %>>Large</option>
                </select>
              </div>
            </div>
            <div class="perm-row" style="padding:10px 0">
              <div class="perm-info">
                <div class="perm-label">Show IQD Total</div>
                <div class="perm-desc">Print an extra line showing the total in Iraqi Dinar when exchange rate is set</div>
              </div>
              <label class="toggle-wrap">
                <input type="checkbox" name="bill_show_iqd" value="1" <%= tenant.bill_show_iqd !== false ? 'checked' : '' %> />
                <span class="toggle-slider"></span>
              </label>
            </div>
          </div>

          <div class="card">
            <h2>Content</h2>
            <p class="card-desc">Custom text printed above and below the order items.</p>
            <div style="margin-bottom:14px">
              <label>Header (address, phone — shown under restaurant name)</label>
              <textarea name="bill_custom_header" rows="3" placeholder="e.g. Erbil, Pearl&#10;07744333300" style="width:100%;background:#1a1a2e;border:1px solid #2a2a3e;border-radius:8px;padding:8px 12px;color:#e0e0e0;font-size:.88rem;resize:vertical"><%= tenant.bill_custom_header || '' %></textarea>
            </div>
            <div>
              <label>Footer (thank you message)</label>
              <input type="text" name="bill_custom_footer" value="<%= tenant.bill_custom_footer || '' %>" placeholder="e.g. Thank you! Come again soon." maxlength="160" />
            </div>
          </div>

          <!-- Custom Labels -->
          <% const savedLabels = (() => { try { return JSON.parse(tenant.bill_custom_labels || '{}'); } catch(e) { return {}; } })(); %>
          <div class="card">
            <h2>Customize Labels</h2>
            <p class="card-desc">Override every text label on the bill. Quick Fill loads a language preset into the fields — then edit freely.</p>

            <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px">
              <button type="button" class="btn btn-ghost btn-sm" onclick="quickFill('en')">🇬🇧 English</button>
              <button type="button" class="btn btn-ghost btn-sm" onclick="quickFill('ku')">🏴 Kurdish</button>
              <button type="button" class="btn btn-ghost btn-sm" onclick="quickFill('ar')">🇸🇦 Arabic</button>
              <button type="button" class="btn btn-ghost btn-sm" onclick="quickFill('en_ku')">🇬🇧+🏴 EN+KU</button>
              <button type="button" class="btn btn-ghost btn-sm" onclick="quickFill('en_ar')">🇬🇧+🇸🇦 EN+AR</button>
              <button type="button" class="btn btn-ghost btn-sm" onclick="clearLabels()" style="color:#e74c3c">✕ Clear all</button>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:0">
              <div style="font-size:.65rem;font-weight:700;color:#444;text-transform:uppercase;letter-spacing:.05em;padding:6px 0;border-bottom:1px solid #1a1a2e;grid-column:1/-1">Column Headers</div>
              <% [
                ['lbl_item',      'Item column',   savedLabels.item],
                ['lbl_qty',       'QTY column',    savedLabels.qty],
                ['lbl_price',     'Price column',  savedLabels.price],
                ['lbl_total_col', 'Total column',  savedLabels.total_col],
              ].forEach(([name, label, val]) => { %>
              <div style="padding:6px 10px 6px 0">
                <label style="font-size:.72rem;color:#666;display:block;margin-bottom:3px"><%= label %></label>
                <input type="text" name="<%= name %>" id="<%= name %>" value="<%= val || '' %>" placeholder="default" maxlength="60"
                  style="width:100%;background:#1a1a2e;border:1px solid #2a2a3e;border-radius:6px;padding:6px 10px;color:#fff;font-size:.83rem;font-family:inherit" oninput="updatePreview()" />
              </div>
              <% }) %>

              <div style="font-size:.65rem;font-weight:700;color:#444;text-transform:uppercase;letter-spacing:.05em;padding:10px 0 6px;border-bottom:1px solid #1a1a2e;grid-column:1/-1">Totals Section</div>
              <% [
                ['lbl_subtotal',  'Sub Total',   savedLabels.subtotal],
                ['lbl_svcfee',    'Service',     savedLabels.svcfee],
                ['lbl_discount',  'Discount',    savedLabels.discount],
                ['lbl_total',     'Net Total',   savedLabels.total],
              ].forEach(([name, label, val]) => { %>
              <div style="padding:6px 10px 6px 0">
                <label style="font-size:.72rem;color:#666;display:block;margin-bottom:3px"><%= label %></label>
                <input type="text" name="<%= name %>" id="<%= name %>" value="<%= val || '' %>" placeholder="default" maxlength="60"
                  style="width:100%;background:#1a1a2e;border:1px solid #2a2a3e;border-radius:6px;padding:6px 10px;color:#fff;font-size:.83rem;font-family:inherit" oninput="updatePreview()" />
              </div>
              <% }) %>

              <div style="font-size:.65rem;font-weight:700;color:#444;text-transform:uppercase;letter-spacing:.05em;padding:10px 0 6px;border-bottom:1px solid #1a1a2e;grid-column:1/-1">Other Labels</div>
              <% [
                ['lbl_served_by', 'Served by',   savedLabels.served_by],
                ['lbl_dine_in',   'Dine-in type',savedLabels.dine_in],
                ['lbl_thanks',    'Thank you',   savedLabels.thanks],
                ['lbl_takeaway',  'Takeaway type',savedLabels.takeaway],
              ].forEach(([name, label, val]) => { %>
              <div style="padding:6px 10px 6px 0">
                <label style="font-size:.72rem;color:#666;display:block;margin-bottom:3px"><%= label %></label>
                <input type="text" name="<%= name %>" id="<%= name %>" value="<%= val || '' %>" placeholder="default" maxlength="80"
                  style="width:100%;background:#1a1a2e;border:1px solid #2a2a3e;border-radius:6px;padding:6px 10px;color:#fff;font-size:.83rem;font-family:inherit" oninput="updatePreview()" />
              </div>
              <% }) %>
            </div>
          </div>

          <!-- Silent Printing -->
          <div class="card">
            <h2>Silent Printing (No Dialog)</h2>
            <p class="card-desc">Configure a local print agent to send bills directly to a named printer — no browser dialog, one click to print.</p>

            <div style="background:#1a1a2e;border-radius:8px;padding:12px 14px;margin:0 0 14px;font-size:.82rem;color:#aaa;line-height:1.8">
              <strong style="color:#c9b8ff">One-time setup (on the POS computer):</strong><br>
              1. Click <strong>Download Installer</strong> below.<br>
              2. Right-click the downloaded file → <strong>Run with PowerShell</strong>.<br>
              3. It installs everything automatically and runs in the background — done.<br>
              <span style="color:#666;font-size:.75rem">Requires Windows + Node.js (auto-installed if missing). Starts automatically when Windows starts.</span>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:14px">
              <div>
                <label>Printer Name <span style="color:#666;font-weight:400">(exact Windows name)</span></label>
                <input type="text" name="pos_print_agent_printer"
                  value="<%= tenant.pos_print_agent_printer || '' %>"
                  placeholder="e.g. EPSON L6490" />
                <div style="font-size:.72rem;color:#555;margin-top:4px">Windows → Settings → Bluetooth &amp; devices → Printers &amp; scanners → printer name</div>
              </div>
              <div>
                <label>Agent Port <span style="color:#666;font-weight:400">(default 9191)</span></label>
                <input type="text" name="pos_print_agent_port"
                  value="<%= tenant.pos_print_agent_port || '9191' %>"
                  placeholder="9191" maxlength="5" style="width:110px" />
              </div>
            </div>

            <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">
              <a href="/pos/print-agent-installer" class="btn btn-primary btn-sm" download="install-pos-print-agent.ps1">⬇ Download Installer</a>
              <button type="button" class="btn btn-ghost btn-sm" id="agentTestBtn" onclick="testAgent()">🔌 Test Connection</button>
              <span id="agentTestResult" style="font-size:.8rem"></span>
            </div>
          </div>

          <div class="save-row">
            <button type="submit" class="btn btn-primary">💾 Save Bill Settings</button>
          </div>
        </form>
      </div>

      <!-- Live preview -->
      <div style="position:sticky;top:16px">
        <div style="font-size:.72rem;font-weight:700;color:#444;text-transform:uppercase;letter-spacing:.5px;margin-bottom:8px">Preview</div>
        <div id="billPreview" style="background:#fff;color:#000;border-radius:10px;padding:14px 10px;font-family:'Courier New',monospace;font-size:12px;box-shadow:0 4px 24px rgba(0,0,0,.4);width:240px;min-height:320px">
          <!-- filled by JS -->
        </div>
      </div>
    </div>
  </div>

</div>

<script>
function switchTab(name, el) {
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
  el.classList.add('active');
  document.getElementById('tab-' + name).classList.add('active');
}
function toggleEdit(id) {
  document.getElementById(id).classList.toggle('open');
}
function toggleSFInput(cb) {
  document.getElementById('sfPctRow').style.display = cb.checked ? '' : 'none';
}
function testAgent() {
  const port = (document.querySelector('[name=pos_print_agent_port]').value || '').trim() || '9191';
  const btn  = document.getElementById('agentTestBtn');
  const out  = document.getElementById('agentTestResult');
  btn.disabled = true;
  out.style.color = '#aaa';
  out.textContent = 'Connecting…';
  fetch(`/pos/print-agent-ping?port=${encodeURIComponent(port)}`)
    .then(r => r.json())
    .then(r => {
      if (r.ok) {
        out.style.color = '#2ecc71';
        out.textContent = 'Agent is running — silent printing active';
      } else {
        out.style.color = '#e74c3c';
        out.textContent = 'Not running — download and run the installer first';
      }
    })
    .catch(() => {
      out.style.color = '#e74c3c';
      out.textContent = 'Could not reach agent';
    })
    .finally(() => { btn.disabled = false; });
}

async function testPrinter(id) {
  const resultEl = document.getElementById('test_' + id);
  resultEl.style.display = 'inline-block';
  resultEl.className = 'test-result';
  resultEl.textContent = '⏳ Testing…';
  try {
    const r = await fetch('/pos/settings/printers/' + id + '/test', { method: 'POST' });
    const d = await r.json();
    resultEl.className = 'test-result ' + (d.ok ? 'ok' : 'err');
    resultEl.textContent = d.ok ? '✓ ' + d.message : '✗ ' + d.error;
  } catch (e) {
    resultEl.className = 'test-result err';
    resultEl.textContent = '✗ Network error';
  }
  setTimeout(() => { resultEl.style.display = 'none'; }, 5000);
}

// Auto-activate tab from URL ?tab=
const urlTab = new URLSearchParams(location.search).get('tab');
if (urlTab) {
  const tabEl = document.querySelector(`.tab[onclick*="${urlTab}"]`);
  if (tabEl) switchTab(urlTab, tabEl);
}

// ── Bill label presets ────────────────────────────────────────────────────────
const PRESETS = {
  en: { item:'Item', qty:'QTY', price:'Price', total_col:'Total', subtotal:'Sub Total', svcfee:'Service', discount:'Discount', total:'Net Total', served_by:'Served by', dine_in:'Dine-in', takeaway:'Takeaway', thanks:'Thank you!' },
  ar: { item:'الصنف', qty:'الكمية', price:'السعر', total_col:'المجموع', subtotal:'المجموع', svcfee:'رسوم الخدمة', discount:'خصم', total:'المجموع الكلي', served_by:'خدمك', dine_in:'طلب داخلي', takeaway:'تيك أواي', thanks:'شكراً لكم!' },
  ku: { item:'باپهت', qty:'بر', price:'نرخ', total_col:'گشتی', subtotal:'گشتی', svcfee:'سێرڤس', discount:'دشکاندەن', total:'کۆی گشتی', served_by:'تو خزمەت کردن لەلایان', dine_in:'طلب داخلي', takeaway:'تیک ئەوی', thanks:'سوپاس!' },
};

const LABEL_KEYS = ['item','qty','price','total_col','subtotal','svcfee','discount','total','served_by','dine_in','takeaway','thanks'];

function getCustomLabels() {
  const cl = {};
  LABEL_KEYS.forEach(k => {
    const el = document.getElementById('lbl_' + k);
    if (el && el.value.trim()) cl[k] = el.value.trim();
  });
  return cl;
}

function resolveLabel(key, customLabels, langs) {
  if (customLabels[key]) return customLabels[key];
  // Build from language presets
  const parts = langs.map(l => (PRESETS[l] || PRESETS.en)[key] || '').filter((v,i,a) => a.indexOf(v)===i && v);
  return parts.join(' - ');
}

function quickFill(preset) {
  const langs = preset.split('_');
  LABEL_KEYS.forEach(k => {
    const el = document.getElementById('lbl_' + k);
    if (!el) return;
    const parts = langs.map(l => (PRESETS[l] || PRESETS.en)[k] || '').filter((v,i,a) => a.indexOf(v)===i && v);
    el.value = parts.join(' - ');
  });
  updatePreview();
}

function clearLabels() {
  LABEL_KEYS.forEach(k => { const el = document.getElementById('lbl_' + k); if (el) el.value = ''; });
  updatePreview();
}

function buildPreviewHTML() {
  const lang     = (document.querySelector('[name=bill_language]:checked') || {}).value || 'en';
  const langs    = lang.split('_');
  const hdr      = (document.querySelector('[name=bill_custom_header]') || {}).value || '';
  const ftr      = (document.querySelector('[name=bill_custom_footer]') || {}).value || '';
  const showIQD  = document.querySelector('[name=bill_show_iqd]')?.checked;
  const tenantName = '<%= tenant.name.replace(/\\/g,"\\\\").replace(/'/g,"\\'") %>';
  const cl       = getCustomLabels();
  const L        = k => resolveLabel(k, cl, langs);

  const now = (() => {
    const d = new Date();
    const dd = String(d.getDate()).padStart(2,'0'), mm = String(d.getMonth()+1).padStart(2,'0');
    const h24 = d.getHours(), ampm = h24>=12?'PM':'AM', h12 = h24%12||12;
    const mi = String(d.getMinutes()).padStart(2,'0'), ss = String(d.getSeconds()).padStart(2,'0');
    return `${dd}/${mm}/${d.getFullYear()} ${ampm} ${h12}:${mi}:${ss}`;
  })();

  function BH(key) {
    const parts = langs.map(l => cl[key] || (PRESETS[l]||PRESETS.en)[key] || '').filter((v,i,a)=>a.indexOf(v)===i&&v);
    if (cl[key]) return cl[key]; // custom always single-line in preview
    return parts.length > 1 ? parts[0] + '<br><small style="font-size:9px">' + parts[parts.length-1] + '</small>' : (parts[0]||'');
  }

  return `<div style="font-family:Arial,sans-serif;font-size:11px;font-weight:700;color:#000">
    <div style="text-align:center;font-size:15px;font-weight:900;margin-bottom:2px">${tenantName}</div>
    ${hdr ? `<div style="text-align:center;font-size:10px;font-weight:700;white-space:pre-line;margin-bottom:3px">${hdr}</div>` : ''}
    <div style="border-top:2px solid #000;margin:5px 0"></div>
    <div style="display:flex;justify-content:space-between;font-size:10px;margin:2px 0"><span>${L('dine_in')} ز.وصل #1042</span></div>
    <div style="display:flex;justify-content:space-between;font-size:10px;margin:2px 0"><span>Table 1</span><span>${now}</span></div>
    <div style="border:1.5px solid #000;height:20px;margin:4px 0"></div>
    <table style="width:100%;border-collapse:collapse;font-size:10px">
      <tr>
        <th style="border:1.5px solid #000;padding:3px;text-align:left;font-weight:900">${BH('item')}</th>
        <th style="border:1.5px solid #000;padding:3px;text-align:center;font-weight:900">${BH('qty')}</th>
        <th style="border:1.5px solid #000;padding:3px;text-align:right;font-weight:900">${BH('price')}</th>
        <th style="border:1.5px solid #000;padding:3px;text-align:right;font-weight:900">${BH('total_col')}</th>
      </tr>
      <tr>
        <td style="border:1.5px solid #000;padding:3px">Espresso</td>
        <td style="border:1.5px solid #000;padding:3px;text-align:center">2</td>
        <td style="border:1.5px solid #000;padding:3px;text-align:right">5,000</td>
        <td style="border:1.5px solid #000;padding:3px;text-align:right">10,000</td>
      </tr>
      <tr>
        <td style="border:1.5px solid #000;padding:3px">Juice</td>
        <td style="border:1.5px solid #000;padding:3px;text-align:center">1</td>
        <td style="border:1.5px solid #000;padding:3px;text-align:right">3,500</td>
        <td style="border:1.5px solid #000;padding:3px;text-align:right">3,500</td>
      </tr>
    </table>
    <div style="border-top:1px dashed #000;margin:4px 0"></div>
    <div style="display:flex;justify-content:space-between;font-size:10px;padding:2px 0"><span>${L('subtotal')}</span><span>13,500</span></div>
    <div style="display:flex;justify-content:space-between;font-size:10px;padding:2px 0"><span>${L('svcfee')}</span><span></span></div>
    <div style="display:flex;justify-content:space-between;font-size:10px;padding:2px 0"><span>${L('discount')}</span><span></span></div>
    <div style="display:flex;justify-content:space-between;font-size:13px;font-weight:900;border-top:2px solid #000;margin-top:3px;padding-top:3px"><span>${L('total')}</span><span>13,500</span></div>
    ${showIQD ? `<div style="display:flex;justify-content:space-between;font-size:9px;padding:2px 0"><span>IQD</span><span>13,500</span></div>` : ''}
    <div style="border-top:2px solid #000;margin:4px 0"></div>
    <div style="text-align:center;font-size:10px">${L('served_by')} : Cashier</div>
    ${ftr ? `<div style="text-align:center;font-size:10px;margin-top:2px">${ftr}</div>` : `<div style="text-align:center;font-size:10px;margin-top:2px">${L('thanks')}</div>`}
  </div>`;
}

function updatePreview() {
  const el = document.getElementById('billPreview');
  if (el) el.innerHTML = buildPreviewHTML();
}

function highlightLang() {
  document.querySelectorAll('[id^=lang_lbl_]').forEach(el => {
    const radio = el.querySelector('input[type=radio]');
    el.style.borderColor = radio.checked ? '#7c5cbf' : '#2a2a3e';
  });
  updatePreview();
}

updatePreview();
</script>
</body>
</html>
