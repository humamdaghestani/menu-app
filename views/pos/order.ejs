<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Order — <%= order.table_name %></title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Segoe UI', sans-serif; background: #0f0f1a; color: #e0e0e0; height: 100vh; display: flex; flex-direction: column; overflow: hidden; }

    /* ── Topbar ── */
    .topbar { background: #1a1a2e; height: 52px; display: flex; align-items: center; justify-content: space-between; padding: 0 16px; border-bottom: 1px solid rgba(255,255,255,.07); flex-shrink: 0; gap: 12px; }
    .topbar-left { display: flex; align-items: center; gap: 10px; min-width: 0; }
    .table-chip { background: rgba(124,92,191,.2); color: #a78bdf; font-weight: 700; font-size: .82rem; padding: 4px 12px; border-radius: 20px; white-space: nowrap; }
    .order-num { font-size: .75rem; color: #444; }
    .topbar-right { display: flex; gap: 6px; flex-shrink: 0; }
    .btn { padding: 6px 12px; border: none; border-radius: 7px; cursor: pointer; font-size: .78rem; font-weight: 600; font-family: inherit; text-decoration: none; display: inline-flex; align-items: center; gap: 5px; white-space: nowrap; }
    .btn-ghost { background: rgba(255,255,255,.07); color: #999; }
    .btn-ghost:hover { background: rgba(255,255,255,.13); color: #fff; }
    .btn-danger { background: rgba(255,71,87,.12); color: #ff6b7a; }
    .btn-pay { background: #00b894; color: #fff; font-size: .85rem; padding: 7px 18px; }
    .btn-pay:hover { opacity: .88; }
    .btn-pay:disabled { opacity: .35; cursor: not-allowed; }

    /* ── Main layout ── */
    .layout { display: flex; flex: 1; overflow: hidden; }

    /* ── Menu Panel ── */
    .menu-panel { flex: 1; display: flex; flex-direction: column; overflow: hidden; }

    .search-bar { padding: 10px 12px; background: #13132a; border-bottom: 1px solid rgba(255,255,255,.05); flex-shrink: 0; }
    .search-input { width: 100%; padding: 8px 14px 8px 36px; background: #0f0f1a; border: 1.5px solid #2a2a3e; border-radius: 8px; color: #fff; font-size: .85rem; outline: none; font-family: inherit; }
    .search-input:focus { border-color: #7c5cbf; }
    .search-wrap { position: relative; }
    .search-icon { position: absolute; left: 10px; top: 50%; transform: translateY(-50%); color: #444; font-size: .9rem; pointer-events: none; }

    .cat-bar { display: flex; gap: 6px; padding: 10px 12px; background: #13132a; border-bottom: 1px solid rgba(255,255,255,.05); overflow-x: auto; scrollbar-width: none; flex-shrink: 0; }
    .cat-bar::-webkit-scrollbar { display: none; }
    .cat-btn { padding: 5px 14px; border-radius: 20px; border: 1.5px solid #2a2a3e; background: none; color: #666; font-size: .75rem; font-weight: 600; cursor: pointer; white-space: nowrap; font-family: inherit; transition: all .15s; }
    .cat-btn.active { background: #7c5cbf; border-color: #7c5cbf; color: #fff; }
    .cat-btn:hover:not(.active) { border-color: #555; color: #ccc; }

    .items-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 8px; padding: 10px 12px; overflow-y: auto; flex: 1; align-content: start; }
    .item-card { background: #1a1a2e; border-radius: 10px; border: 1.5px solid #2a2a3e; cursor: pointer; transition: all .15s; overflow: hidden; }
    .item-card:hover { border-color: #7c5cbf; transform: translateY(-1px); }
    .item-card:active { transform: scale(.97); }
    .item-card-img { width: 100%; height: 72px; object-fit: cover; display: block; background: #2a2a3e; }
    .item-card-img-placeholder { width: 100%; height: 72px; background: linear-gradient(135deg,#1e1e3a,#2a2a4e); display: flex; align-items: center; justify-content: center; font-size: 1.6rem; }
    .item-card-body { padding: 8px 10px; }
    .item-card-name { font-size: .78rem; font-weight: 600; color: #ddd; line-height: 1.3; margin-bottom: 4px; }
    .item-card-price { font-size: .8rem; color: #7c5cbf; font-weight: 700; }
    .item-card.hidden { display: none; }

    /* ── Order Panel ── */
    .order-panel { width: 320px; flex-shrink: 0; display: flex; flex-direction: column; background: #13132a; border-left: 1px solid rgba(255,255,255,.06); }

    .order-list { flex: 1; overflow-y: auto; padding: 8px; min-height: 0; }
    .order-empty { text-align: center; padding: 32px 12px; color: #333; font-size: .82rem; line-height: 1.6; }

    .order-item { display: flex; align-items: flex-start; gap: 6px; padding: 8px 6px; border-radius: 8px; border-bottom: 1px solid rgba(255,255,255,.04); cursor: pointer; }
    .order-item:last-child { border-bottom: none; }
    .order-item.selected { background: rgba(124,92,191,.12); border-radius: 8px; border-bottom-color: transparent; }
    .oi-info { flex: 1; min-width: 0; }
    .oi-name { font-size: .8rem; color: #ddd; font-weight: 600; line-height: 1.3; }
    .oi-note { font-size: .7rem; color: #555; margin-top: 2px; display: flex; align-items: center; gap: 4px; }
    .oi-note-edit { background: none; border: none; color: #555; cursor: pointer; font-size: .68rem; padding: 0; font-family: inherit; text-decoration: underline; }
    .oi-note-edit:hover { color: #888; }
    .qty-ctrl { display: flex; align-items: center; gap: 3px; }
    .qty-btn { width: 22px; height: 22px; border-radius: 5px; border: none; background: #2a2a3e; color: #ccc; cursor: pointer; font-size: .85rem; font-weight: 700; display: flex; align-items: center; justify-content: center; padding: 0; }
    .qty-btn:hover { background: #7c5cbf; color: #fff; }
    .qty-num { font-size: .8rem; color: #fff; font-weight: 700; width: 18px; text-align: center; }
    .oi-price { font-size: .8rem; color: #7c5cbf; font-weight: 700; white-space: nowrap; min-width: 48px; text-align: right; }

    /* ── Numpad ── */
    .numpad-area { flex-shrink: 0; border-top: 1px solid rgba(255,255,255,.06); }
    .np-display { padding: 7px 12px; background: #0f0f1a; display: flex; align-items: center; justify-content: space-between; gap: 8px; }
    .np-display-label { font-size: .7rem; color: #444; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 160px; }
    .np-display-val { font-size: 1.1rem; font-weight: 700; color: #fff; min-width: 40px; text-align: right; font-variant-numeric: tabular-nums; }
    .np-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 1px; background: rgba(255,255,255,.04); }
    .np-btn { background: #13132a; border: none; color: #ccc; font-size: .95rem; font-weight: 600; font-family: inherit; padding: 11px 0; cursor: pointer; transition: background .1s; text-align: center; }
    .np-btn:hover { background: #1e1e3a; color: #fff; }
    .np-btn:active { background: #2a2a4a; }
    .np-btn.np-ok  { color: #00b894; font-size: 1.1rem; }
    .np-btn.np-ok:hover { background: rgba(0,184,148,.12); }
    .np-btn.np-back { font-size: .85rem; }
    .np-modes { display: flex; gap: 1px; background: rgba(255,255,255,.04); flex-shrink: 0; }
    .np-mode-btn { flex: 1; padding: 7px 0; border: none; background: #13132a; color: #333; font-size: .6rem; font-weight: 700; cursor: pointer; font-family: inherit; text-transform: uppercase; letter-spacing: .4px; transition: all .12s; }
    .np-mode-btn.active { background: rgba(124,92,191,.18); color: #c4b5fd; }
    .np-mode-btn:hover:not(.active) { color: #777; background: rgba(255,255,255,.04); }

    /* ── Action buttons (below numpad) ── */
    .order-actions { display: flex; gap: 1px; background: rgba(255,255,255,.04); flex-shrink: 0; }
    .action-btn { flex: 1; padding: 9px 4px; border: none; background: #13132a; color: #666; font-size: .7rem; font-weight: 600; cursor: pointer; font-family: inherit; text-align: center; transition: all .15s; display: flex; flex-direction: column; align-items: center; gap: 2px; }
    .action-btn:hover { color: #c4b5fd; background: rgba(124,92,191,.08); }
    .action-btn span { font-size: .65rem; }

    .order-footer { padding: 10px 12px; border-top: 1px solid rgba(255,255,255,.06); flex-shrink: 0; }
    .totals { margin-bottom: 12px; }
    .total-row { display: flex; justify-content: space-between; font-size: .8rem; color: #666; padding: 2px 0; }
    .total-row.discount { color: #00b894; }
    .total-row.grand { font-size: 1rem; font-weight: 700; color: #fff; padding-top: 8px; border-top: 1px solid #2a2a3e; margin-top: 6px; }

    /* ── Modals ── */
    .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.6); z-index: 200; align-items: center; justify-content: center; padding: 20px; }
    .modal-overlay.open { display: flex; }
    .modal-box { background: #1a1a2e; border-radius: 14px; border: 1px solid rgba(255,255,255,.1); padding: 24px; width: 100%; max-width: 360px; }
    .modal-box h3 { font-size: .95rem; font-weight: 700; color: #fff; margin-bottom: 16px; }
    .modal-input { width: 100%; padding: 10px 12px; background: #0f0f1a; border: 1.5px solid #2a2a3e; border-radius: 8px; color: #fff; font-size: .9rem; outline: none; font-family: inherit; margin-bottom: 12px; }
    .modal-input:focus { border-color: #7c5cbf; }
    .modal-footer { display: flex; gap: 8px; justify-content: flex-end; margin-top: 4px; }
    .btn-modal-cancel { background: rgba(255,255,255,.07); color: #888; }
    .btn-modal-ok { background: #7c5cbf; color: #fff; }
    .type-toggle { display: flex; gap: 6px; margin-bottom: 12px; }
    .type-btn { flex: 1; padding: 8px; border: 1.5px solid #2a2a3e; border-radius: 8px; background: #0f0f1a; color: #888; font-size: .8rem; font-weight: 600; cursor: pointer; font-family: inherit; text-align: center; }
    .type-btn.active { border-color: #7c5cbf; color: #c4b5fd; background: rgba(124,92,191,.12); }

    .split-result { background: #0f0f1a; border-radius: 8px; padding: 12px; text-align: center; margin-bottom: 12px; }
    .split-per { font-size: 1.3rem; font-weight: 700; color: #fff; }
    .split-sub { font-size: .75rem; color: #555; margin-top: 4px; }

    @media (max-width: 680px) {
      .order-panel { width: 100%; position: fixed; bottom: 0; left: 0; right: 0; max-height: 75vh; z-index: 10; border-top: 2px solid #7c5cbf; border-left: none; }
      .menu-panel { padding-bottom: 75vh; }
      body { overflow: auto; height: auto; }
      .layout { flex-direction: column; height: auto; overflow: visible; }
    }
  </style>
</head>
<body>

<div class="topbar">
  <div class="topbar-left">
    <span class="table-chip">🪑 <%= order.table_name %></span>
    <span class="order-num">#<%= order.id %></span>
  </div>
  <div class="topbar-right">
    <button class="btn btn-ghost" onclick="printBill()" title="Print bill">🖨️</button>
    <button class="btn btn-danger" onclick="openVoid()">🗑️ Void</button>
    <a href="/pos/tables" class="btn btn-ghost">← Tables</a>
  </div>
</div>

<div class="layout">

  <!-- ── Menu Panel ── -->
  <div class="menu-panel">
    <div class="search-bar">
      <div class="search-wrap">
        <span class="search-icon">🔍</span>
        <input type="text" class="search-input" id="searchInput" placeholder="Search items..." oninput="filterItems()" />
      </div>
    </div>
    <div class="cat-bar">
      <button class="cat-btn active" data-cat="all" onclick="filterCat('all',this)">All</button>
      <% categories.forEach(c => { %>
      <button class="cat-btn" data-cat="<%= c.id %>" onclick="filterCat('<%= c.id %>',this)"><%= c.name %></button>
      <% }) %>
    </div>
    <div class="items-grid" id="itemsGrid">
      <% menuItems.forEach(item => { %>
      <div class="item-card" data-cat="<%= item.category_id %>" data-name="<%= item.name.toLowerCase() %>" onclick="addItem(<%= item.id %>)">
        <% if (item.image_url) { %>
        <img class="item-card-img" src="<%= item.image_url %>" alt="<%= item.name %>" loading="lazy" />
        <% } else { %>
        <div class="item-card-img-placeholder">🍽️</div>
        <% } %>
        <div class="item-card-body">
          <div class="item-card-name"><%= item.name %></div>
          <div class="item-card-price"><%= tenant.currency || '$' %><%= item.price %></div>
        </div>
      </div>
      <% }) %>
    </div>
  </div>

  <!-- ── Order Panel ── -->
  <div class="order-panel">

    <div class="order-list" id="orderList">
      <% if (orderItems.length === 0) { %>
      <div class="order-empty">Tap items on the left<br />to add them here</div>
      <% } else { %>
      <% orderItems.forEach(oi => { %>
      <div class="order-item">
        <div class="oi-info">
          <div class="oi-name"><%= oi.name %></div>
          <div class="oi-note">
            <% if (oi.notes) { %><span>📝 <%= oi.notes %></span><% } %>
            <button class="oi-note-edit" onclick="openItemNote(<%= oi.id %>, <%- JSON.stringify(oi.notes||'') %>)">
              <%= oi.notes ? 'edit note' : '+ note' %>
            </button>
          </div>
        </div>
        <div class="qty-ctrl">
          <button type="button" class="qty-btn" onclick="changeQty(<%= oi.id %>, -1)">−</button>
          <span class="qty-num"><%= oi.quantity %></span>
          <button type="button" class="qty-btn" onclick="changeQty(<%= oi.id %>, 1)">+</button>
        </div>
        <div class="oi-price"><%= tenant.currency || '$' %><%= (oi.price * oi.quantity).toFixed(2) %></div>
      </div>
      <% }) %>
      <% } %>
    </div>

    <!-- ── Numpad ── -->
    <div class="numpad-area">
      <div class="np-modes">
        <button class="np-mode-btn active" id="modeQty"     onclick="setNpMode('qty')">QTY</button>
        <button class="np-mode-btn"        id="modePrc"     onclick="setNpMode('price')">PRICE</button>
        <button class="np-mode-btn"        id="modeDiscPct" onclick="setNpMode('disc-pct')">DISC%</button>
        <button class="np-mode-btn"        id="modeDiscFix" onclick="setNpMode('disc-fix')">DISC$</button>
      </div>
      <div class="np-display">
        <div class="np-display-label" id="npLabel">Tap an item</div>
        <div class="np-display-val" id="npVal">—</div>
      </div>
      <div class="np-grid">
        <button class="np-btn" onclick="numpadPress('7')">7</button>
        <button class="np-btn" onclick="numpadPress('8')">8</button>
        <button class="np-btn" onclick="numpadPress('9')">9</button>
        <button class="np-btn" onclick="numpadPress('4')">4</button>
        <button class="np-btn" onclick="numpadPress('5')">5</button>
        <button class="np-btn" onclick="numpadPress('6')">6</button>
        <button class="np-btn" onclick="numpadPress('1')">1</button>
        <button class="np-btn" onclick="numpadPress('2')">2</button>
        <button class="np-btn" onclick="numpadPress('3')">3</button>
        <button class="np-btn np-back" onclick="numpadPress('back')">⌫</button>
        <button class="np-btn" onclick="numpadPress('0')">0</button>
        <button class="np-btn np-ok" onclick="numpadPress('ok')">✓</button>
      </div>
    </div>

    <!-- ── Action buttons ── -->
    <div class="order-actions">
      <button class="action-btn" onclick="openDiscount()">🏷️<span>Discount</span></button>
      <button class="action-btn" onclick="openSplit()">✂️<span>Split</span></button>
      <button class="action-btn" onclick="openOrderNote()">📝<span>Note</span></button>
      <button class="action-btn" onclick="printBill()">🖨️<span>Print</span></button>
    </div>

    <div class="order-footer">
      <div class="totals" id="totalsArea">
        <div class="total-row"><span>Subtotal</span><span><%= tenant.currency || '$' %><%= subtotal.toFixed(2) %></span></div>
        <% if (discount > 0) { %>
        <div class="total-row discount">
          <span>Discount (<%= order.discount_type === 'percent' ? order.discount_value + '%' : (tenant.currency||'$') + parseFloat(order.discount_value).toFixed(2) %>)</span>
          <span>−<%= tenant.currency || '$' %><%= discount.toFixed(2) %></span>
        </div>
        <% } %>
        <% if (order.note) { %><div class="total-row"><span style="color:#f39c12">📝 <%= order.note %></span></div><% } %>
        <div class="total-row grand"><span>Total</span><span><%= tenant.currency || '$' %><%= total.toFixed(2) %></span></div>
      </div>
      <div id="payArea">
        <% if (orderItems.length > 0) { %>
        <a href="/pos/order/<%= order.id %>/pay" class="btn btn-pay" style="width:100%;justify-content:center;font-size:.9rem;padding:11px">
          💳 Pay <%= tenant.currency || '$' %><%= total.toFixed(2) %>
        </a>
        <% } else { %>
        <button class="btn btn-pay" disabled style="width:100%;justify-content:center;font-size:.9rem;padding:11px">💳 Pay</button>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- ── Void Passkey Modal ── -->
<div class="modal-overlay" id="voidModal">
  <div class="modal-box">
    <h3>🗑️ Cancel Order</h3>
    <p style="font-size:.8rem;color:#666;margin-bottom:14px">Ask your manager to generate a <strong>Void</strong> passkey, then enter it below.</p>
    <form id="voidForm">
      <label style="font-size:.7rem;color:#555;font-weight:700;display:block;margin-bottom:5px;text-transform:uppercase">Manager Passkey</label>
      <input type="text" class="modal-input" name="passkey" maxlength="6" minlength="6"
        placeholder="6-digit code" inputmode="numeric" autocomplete="off"
        style="font-size:1.4rem;letter-spacing:6px;text-align:center;font-weight:700" />
      <div class="modal-footer">
        <button type="button" class="btn btn-modal-cancel" onclick="closeModal('voidModal')">Cancel</button>
        <button type="submit" class="btn" style="background:#e74c3c;color:#fff;padding:6px 16px">Cancel Order</button>
      </div>
    </form>
  </div>
</div>

<!-- ── Discount Numpad Passkey Modal ── -->
<div class="modal-overlay" id="discNpModal">
  <div class="modal-box" style="max-width:300px">
    <h3>🏷️ Manager Passkey</h3>
    <p style="font-size:.78rem;color:#555;margin-bottom:12px" id="discNpDesc"></p>
    <input type="text" class="modal-input" id="discNpPasskey" maxlength="6" minlength="6"
      placeholder="6-digit code" inputmode="numeric" autocomplete="off"
      style="font-size:1.4rem;letter-spacing:6px;text-align:center;font-weight:700" />
    <div class="modal-footer">
      <button type="button" class="btn btn-modal-cancel" onclick="closeModal('discNpModal')">Cancel</button>
      <button type="button" class="btn btn-modal-ok" onclick="applyDiscountFromNp()">Apply</button>
    </div>
  </div>
</div>

<!-- ── Discount Modal ── -->
<div class="modal-overlay" id="discountModal">
  <div class="modal-box">
    <h3>🏷️ Apply Discount</h3>
    <form id="discountForm">
      <div class="type-toggle">
        <button type="button" class="type-btn active" id="btnPct" onclick="setDiscType('percent')">% Percent</button>
        <button type="button" class="type-btn" id="btnFixed" onclick="setDiscType('fixed')">$ Fixed</button>
        <button type="button" class="type-btn" id="btnNone" onclick="setDiscType('none')">✕ Remove</button>
      </div>
      <input type="hidden" name="discount_type" id="discTypeInput" value="percent" />
      <input type="number" class="modal-input" name="discount_value" id="discValueInput"
        min="0" step="0.01" placeholder="Enter amount..." />
      <div id="passkeyField">
        <label style="font-size:.7rem;color:#555;font-weight:700;display:block;margin-bottom:5px;text-transform:uppercase">Manager Passkey</label>
        <input type="text" class="modal-input" name="passkey" id="discPasskey" maxlength="6" minlength="6"
          placeholder="6-digit code" inputmode="numeric" autocomplete="off"
          style="font-size:1.3rem;letter-spacing:6px;text-align:center;font-weight:700" />
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-modal-cancel" onclick="closeModal('discountModal')">Cancel</button>
        <button type="submit" class="btn btn-modal-ok">Apply</button>
      </div>
    </form>
  </div>
</div>

<!-- ── Split Modal ── -->
<div class="modal-overlay" id="splitModal">
  <div class="modal-box">
    <h3>✂️ Split Bill</h3>
    <label style="font-size:.78rem;color:#666;margin-bottom:6px;display:block">Number of people</label>
    <input type="number" class="modal-input" id="splitCount" value="2" min="2" max="20" oninput="calcSplit()" />
    <div class="split-result">
      <div class="split-per" id="splitPer"><%= tenant.currency || '$' %><%= (total / 2).toFixed(2) %></div>
      <div class="split-sub">per person</div>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn btn-modal-cancel" onclick="closeModal('splitModal')">Close</button>
    </div>
  </div>
</div>

<!-- ── Order Note Modal ── -->
<div class="modal-overlay" id="noteModal">
  <div class="modal-box">
    <h3>📝 Order Note</h3>
    <form id="noteForm">
      <textarea class="modal-input" name="note" id="noteText" rows="3" placeholder="e.g. allergy info, special requests..."
        style="resize:vertical"><%= order.note || '' %></textarea>
      <div class="modal-footer">
        <button type="button" class="btn btn-modal-cancel" onclick="closeModal('noteModal')">Cancel</button>
        <button type="submit" class="btn btn-modal-ok">Save</button>
      </div>
    </form>
  </div>
</div>

<!-- ── Item Note Modal ── -->
<div class="modal-overlay" id="itemNoteModal">
  <div class="modal-box">
    <h3>📝 Item Note</h3>
    <form id="itemNoteForm">
      <textarea class="modal-input" id="itemNoteText" rows="3" placeholder="e.g. no onions, well done..."></textarea>
      <div class="modal-footer">
        <button type="button" class="btn btn-modal-cancel" onclick="closeModal('itemNoteModal')">Cancel</button>
        <button type="submit" class="btn btn-modal-ok">Save</button>
      </div>
    </form>
  </div>
</div>

<script src="/pos-offline.js"></script>
<script>
/* ── Seed state from server ── */
const CUR      = <%- JSON.stringify(tenant.currency || '$') %>;
const ORDER_ID = <%= order.id %>;
const menuCache = <%- JSON.stringify(menuItems.map(m => ({ id: m.id, name: m.name, price: parseFloat(m.price) || 0, category_id: m.category_id }))) %>;

let _items = <%- JSON.stringify(orderItems.map(i => ({ id: i.id, menu_item_id: i.menu_item_id, name: i.name, price: parseFloat(i.price) || 0, quantity: i.quantity, notes: i.notes || null }))) %>;
let _order = {
  discount_type:  <%- JSON.stringify(order.discount_type  || 'none') %>,
  discount_value: <%= parseFloat(order.discount_value || 0) %>,
  note:           <%- JSON.stringify(order.note || null) %>,
};
let _currentItemNoteId = null;
let _selectedItemId    = null;
let _npInput           = '';
let _npMode            = 'qty'; // 'qty' | 'price' | 'disc-pct' | 'disc-fix'
let _pendingDiscValue  = 0;
let _pendingDiscType   = 'percent';

/* ── Helpers ── */
function _esc(s) {
  return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}
function _totals() {
  const sub = _items.reduce((s, i) => s + i.price * i.quantity, 0);
  let tot = sub;
  const dv = _order.discount_value;
  if (_order.discount_type === 'percent' && dv) tot = Math.max(0, sub - sub * dv / 100);
  else if (_order.discount_type === 'fixed' && dv) tot = Math.max(0, sub - dv);
  return { subtotal: sub, total: tot, discount: sub - tot };
}

/* ── Render order panel from _items / _order ── */
function _render(srv) {
  if (srv) { _items = srv.items.map(i => ({ ...i, price: parseFloat(i.price) || 0 })); _order = srv.order; }
  const { subtotal, total, discount } = srv || _totals();

  // Order list
  const list = document.getElementById('orderList');
  if (!_items.length) {
    list.innerHTML = '<div class="order-empty">Tap items on the left<br/>to add them here</div>';
  } else {
    list.innerHTML = _items.map(oi => `
      <div class="order-item${oi.id === _selectedItemId ? ' selected' : ''}" onclick="selectItem(${oi.id}, event)">
        <div class="oi-info">
          <div class="oi-name">${_esc(oi.name)}</div>
          <div class="oi-note">
            ${oi.notes ? `<span>📝 ${_esc(oi.notes)}</span>` : ''}
            <button class="oi-note-edit" onclick="event.stopPropagation();openItemNote(${oi.id}, ${JSON.stringify(oi.notes||'')})">
              ${oi.notes ? 'edit note' : '+ note'}
            </button>
          </div>
        </div>
        <div class="qty-ctrl">
          <button type="button" class="qty-btn" onclick="event.stopPropagation();changeQty(${oi.id}, -1)">−</button>
          <span class="qty-num">${oi.quantity}</span>
          <button type="button" class="qty-btn" onclick="event.stopPropagation();changeQty(${oi.id}, 1)">+</button>
        </div>
        <div class="oi-price">${CUR}${(oi.price * oi.quantity).toFixed(2)}</div>
      </div>`).join('');
  }

  // Totals
  const dv = parseFloat(_order.discount_value) || 0;
  document.getElementById('totalsArea').innerHTML = `
    <div class="total-row"><span>Subtotal</span><span>${CUR}${subtotal.toFixed(2)}</span></div>
    ${discount > 0 ? `<div class="total-row discount"><span>Discount (${_order.discount_type === 'percent' ? dv + '%' : CUR + dv.toFixed(2)})</span><span>−${CUR}${discount.toFixed(2)}</span></div>` : ''}
    ${_order.note ? `<div class="total-row"><span style="color:#f39c12">📝 ${_esc(_order.note)}</span></div>` : ''}
    <div class="total-row grand"><span>Total</span><span>${CUR}${total.toFixed(2)}</span></div>`;

  // Pay button
  document.getElementById('payArea').innerHTML = _items.length
    ? `<a href="/pos/order/${ORDER_ID}/pay" class="btn btn-pay" style="width:100%;justify-content:center;font-size:.9rem;padding:11px">💳 Pay ${CUR}${total.toFixed(2)}</a>`
    : `<button class="btn btn-pay" disabled style="width:100%;justify-content:center;font-size:.9rem;padding:11px">💳 Pay</button>`;

  // Keep split modal in sync
  document.getElementById('splitPer').textContent = CUR + (total / (parseInt(document.getElementById('splitCount').value)||2)).toFixed(2);
  _npUpdate();
}

/* ── Item actions ── */
async function addItem(menuItemId) {
  const r = await posAction(`/pos/api/order/${ORDER_ID}/add-item`, { menu_item_id: menuItemId }, () => {
    const mi = menuCache.find(m => m.id == menuItemId);
    if (!mi) return;
    const ex = _items.find(i => i.menu_item_id == menuItemId && !i.notes);
    if (ex) { ex.quantity++; }
    else _items.push({ id: -(Date.now()), menu_item_id: menuItemId, name: mi.name, price: mi.price, quantity: 1, notes: null });
    _render();
  });
  if (r.ok && !r.offline) _render(r.data);
}

async function changeQty(itemId, delta) {
  // Handle locally-created items (negative IDs, offline only)
  if (itemId < 0) {
    const i = _items.findIndex(x => x.id === itemId);
    if (i < 0) return;
    _items[i].quantity += delta;
    if (_items[i].quantity <= 0) _items.splice(i, 1);
    _render(); return;
  }
  const r = await posAction(`/pos/api/order/${ORDER_ID}/item/${itemId}/qty`, { delta }, () => {
    const i = _items.findIndex(x => x.id === itemId);
    if (i < 0) return;
    _items[i].quantity += delta;
    if (_items[i].quantity <= 0) _items.splice(i, 1);
    _render();
  });
  if (r.ok && !r.offline) _render(r.data);
}

/* ── Numpad ── */
function _npUpdate() {
  const item = _selectedItemId !== null ? _items.find(x => x.id === _selectedItemId) : null;
  let label, val;
  if (_npMode === 'disc-pct')      label = 'Discount (%)';
  else if (_npMode === 'disc-fix') label = 'Discount (Amount)';
  else if (!item)                  label = 'Tap an item';
  else                             label = item.name;

  if (_npInput) {
    val = _npMode === 'price' ? CUR + (parseInt(_npInput) / 100).toFixed(2) : _npInput;
  } else if (_npMode === 'qty' && item)   val = String(item.quantity);
  else if (_npMode === 'price' && item)   val = CUR + item.price.toFixed(2);
  else                                    val = '—';

  document.getElementById('npLabel').textContent = label;
  document.getElementById('npVal').textContent   = val;
}

function setNpMode(mode) {
  _npMode = mode;
  _npInput = '';
  if (mode.startsWith('disc')) { _selectedItemId = null; }
  ['modeQty','modePrc','modeDiscPct','modeDiscFix'].forEach(id => document.getElementById(id).classList.remove('active'));
  const map = { 'qty':'modeQty', 'price':'modePrc', 'disc-pct':'modeDiscPct', 'disc-fix':'modeDiscFix' };
  document.getElementById(map[mode]).classList.add('active');
  _render(); _npUpdate();
}

function selectItem(id, e) {
  if (e) e.stopPropagation();
  if (_selectedItemId === id) {
    _selectedItemId = null; _npInput = '';
  } else {
    _selectedItemId = id; _npInput = '';
    if (_npMode.startsWith('disc')) setNpMode('qty');
  }
  _render(); _npUpdate();
}

async function numpadPress(key) {
  // ── Discount modes (no item needed) ──────────────────────────────────
  if (_npMode.startsWith('disc')) {
    if (key === 'back') {
      _npInput = _npInput.slice(0, -1);
    } else if (key === 'ok') {
      const val = parseFloat(_npInput) || 0;
      _npInput = '';
      _npUpdate();
      if (val === 0) {
        // Remove existing discount (no passkey required)
        const r = await posAction(`/pos/api/order/${ORDER_ID}/discount`, { discount_type: 'none', discount_value: 0, passkey: '' });
        if (r.ok && !r.offline) _render(r.data);
        return;
      }
      _pendingDiscValue = val;
      _pendingDiscType  = _npMode === 'disc-pct' ? 'percent' : 'fixed';
      document.getElementById('discNpPasskey').value = '';
      document.getElementById('discNpDesc').textContent =
        `Apply ${_pendingDiscType === 'percent' ? val + '%' : CUR + parseFloat(val).toFixed(2)} discount`;
      openModal('discNpModal');
      setTimeout(() => document.getElementById('discNpPasskey').focus(), 100);
    } else {
      if (_npInput.length >= 6) return;
      _npInput += key;
    }
    _npUpdate();
    return;
  }

  // ── QTY / PRICE modes (item must be selected) ─────────────────────────
  if (_selectedItemId === null) return;
  const item = _items.find(x => x.id === _selectedItemId);
  if (!item) return;

  if (key === 'back') {
    _npInput = _npInput.slice(0, -1);
  } else if (key === 'ok') {
    if (_npMode === 'qty') {
      const newQty = parseInt(_npInput) || 0;
      _npInput = '';
      if (newQty === 0) {
        await changeQty(_selectedItemId, -item.quantity);
        _selectedItemId = null;
      } else if (newQty !== item.quantity) {
        await changeQty(_selectedItemId, newQty - item.quantity);
      }
    } else if (_npMode === 'price') {
      const newPrice = _npInput ? parseInt(_npInput) / 100 : null;
      _npInput = '';
      if (newPrice !== null && newPrice >= 0) await setItemPrice(_selectedItemId, newPrice);
    }
    _npUpdate(); return;
  } else {
    if (_npMode === 'qty'   && _npInput.length >= 3) return;
    if (_npMode === 'price' && _npInput.length >= 7) return;
    _npInput += key;
  }
  _npUpdate();
}

async function setItemPrice(itemId, price) {
  const i = _items.findIndex(x => x.id === itemId);
  if (i >= 0) { _items[i].price = price; _render(); }  // optimistic
  const r = await posAction(`/pos/api/order/${ORDER_ID}/item/${itemId}/price`, { price });
  if (r.ok && !r.offline) _render(r.data);
}

async function applyDiscountFromNp() {
  const passkey = document.getElementById('discNpPasskey').value.trim();
  closeModal('discNpModal');
  const r = await posAction(`/pos/api/order/${ORDER_ID}/discount`, {
    discount_type:  _pendingDiscType,
    discount_value: _pendingDiscValue,
    passkey,
  });
  if (r.ok && !r.offline) _render(r.data);
  else if (!r.ok && r.error === 'invalid_passkey') {
    _showErrorToast('Invalid or expired passkey — ask manager for a new code');
    setTimeout(() => {
      document.getElementById('discNpPasskey').value = '';
      openModal('discNpModal');
    }, 150);
  }
}

/* ── Category & search filter ── */
let _activeCat = 'all';
function filterCat(cat, btn) {
  _activeCat = cat;
  document.querySelectorAll('.cat-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  applyFilter();
}
function filterItems() { applyFilter(); }
function applyFilter() {
  const q = document.getElementById('searchInput').value.toLowerCase().trim();
  document.querySelectorAll('.item-card').forEach(card => {
    const matchCat  = _activeCat === 'all' || card.dataset.cat == _activeCat;
    const matchName = !q || card.dataset.name.includes(q);
    card.classList.toggle('hidden', !(matchCat && matchName));
  });
}

/* ── Modals ── */
function openModal(id) { document.getElementById(id).classList.add('open'); }
function closeModal(id) { document.getElementById(id).classList.remove('open'); }
document.querySelectorAll('.modal-overlay').forEach(m => {
  m.addEventListener('click', e => { if (e.target === m) m.classList.remove('open'); });
});

/* ── Void ── */
function openVoid() { openModal('voidModal'); }
document.getElementById('voidForm').addEventListener('submit', async e => {
  e.preventDefault();
  const passkey = e.target.passkey.value.trim();
  closeModal('voidModal');
  const r = await posAction(`/pos/api/order/${ORDER_ID}/void`, { passkey });
  if (r.ok && r.data && r.data.redirect) {
    window.location.href = r.data.redirect;
  } else if (!r.ok) {
    _showErrorToast('Invalid or expired passkey — ask manager for a new code');
    setTimeout(() => openVoid(), 150);
  }
});

/* ── Discount ── */
function openDiscount() { openModal('discountModal'); }
function setDiscType(t) {
  document.getElementById('discTypeInput').value = t;
  ['Pct','Fixed','None'].forEach(x => document.getElementById('btn'+x).classList.remove('active'));
  const map = { percent:'Pct', fixed:'Fixed', none:'None' };
  document.getElementById('btn' + map[t]).classList.add('active');
  const isRemove = t === 'none';
  document.getElementById('discValueInput').style.display = isRemove ? 'none' : '';
  document.getElementById('passkeyField').style.display   = isRemove ? 'none' : '';
}
document.getElementById('discountForm').addEventListener('submit', async e => {
  e.preventDefault();
  const fd = new FormData(e.target);
  closeModal('discountModal');
  const r = await posAction(`/pos/api/order/${ORDER_ID}/discount`, {
    discount_type:  fd.get('discount_type'),
    discount_value: fd.get('discount_value'),
    passkey:        fd.get('passkey'),
  });
  if (r.ok && !r.offline) _render(r.data);
  else if (!r.ok && r.error === 'invalid_passkey') {
    _showErrorToast('Invalid or expired passkey — ask manager for a new code');
    setTimeout(() => openDiscount(), 150);
  }
});

/* ── Order Note ── */
function openOrderNote() { document.getElementById('noteText').value = _order.note || ''; openModal('noteModal'); }
document.getElementById('noteForm').addEventListener('submit', async e => {
  e.preventDefault();
  const note = e.target.note.value.trim() || null;
  _order.note = note;
  _render();
  closeModal('noteModal');
  posAction(`/pos/api/order/${ORDER_ID}/note`, { note });
});

/* ── Item Note ── */
function openItemNote(itemId, currentNote) {
  _currentItemNoteId = itemId;
  document.getElementById('itemNoteText').value = currentNote;
  openModal('itemNoteModal');
}
document.getElementById('itemNoteForm').addEventListener('submit', async e => {
  e.preventDefault();
  const note = document.getElementById('itemNoteText').value.trim() || null;
  closeModal('itemNoteModal');
  const i = _items.findIndex(x => x.id === _currentItemNoteId);
  if (i >= 0) { _items[i].notes = note; _render(); }
  if (_currentItemNoteId > 0) {
    const r = await posAction(`/pos/api/order/${ORDER_ID}/item/${_currentItemNoteId}/note`, { note });
    if (r.ok && !r.offline) _render(r.data);
  }
});

/* ── Split ── */
function openSplit() { openModal('splitModal'); calcSplit(); }
function calcSplit() {
  const { total } = _totals();
  const n = parseInt(document.getElementById('splitCount').value) || 2;
  document.getElementById('splitPer').textContent = CUR + (total / n).toFixed(2);
}

/* ── Error toast ── */
function _showErrorToast(msg) {
  const t = document.createElement('div');
  t.style.cssText = 'position:fixed;top:60px;left:50%;transform:translateX(-50%);background:#c0392b;color:#fff;padding:10px 22px;border-radius:8px;font-size:.85rem;font-weight:700;z-index:999;box-shadow:0 4px 16px rgba(0,0,0,.35)';
  t.textContent = '✗ ' + msg;
  document.body.appendChild(t);
  setTimeout(() => t.remove(), 4000);
}

<% if (errorParam === 'passkey') { %>
_showErrorToast('Invalid or expired passkey — ask manager for a new code');
<% if (modalParam === 'discount') { %>setTimeout(() => openDiscount(), 150);<% } %>
<% if (modalParam === 'void') { %>setTimeout(() => openVoid(), 150);<% } %>
<% } %>

// Fix initial render: re-render from JS state so all items have onclick handlers
_render();
</script>

<script>
  // ── Bill labels per language ──────────────────────────────────────────────
  const BILL_LABELS = {
    en: { bill:'BILL',    table:'Table',    order:'Order #',        date:'Date',    subtotal:'Subtotal',      discount:'Discount',    total:'TOTAL',        thanks:'Thank you!' },
    ar: { bill:'فاتورة', table:'الطاولة', order:'رقم الطلب',       date:'التاريخ', subtotal:'المجموع الجزئي', discount:'خصم',        total:'المجموع',      thanks:'شكراً لكم!' },
    ku: { bill:'پسووڵە', table:'مێز',     order:'ژمارەی داواکاری', date:'بەروار',  subtotal:'کۆی لایەنی',     discount:'داشکاندن',   total:'کۆی گشتی',    thanks:'سوپاس!' },
  };

  function printBill() {
    const orderItems  = <%- JSON.stringify(orderItems) %>;
    const order       = <%- JSON.stringify(order) %>;
    const subtotal    = <%= subtotal.toFixed(2) %>;
    const discount    = <%= discount.toFixed(2) %>;
    const total       = <%= total.toFixed(2) %>;
    const CUR         = '<%= (tenant.currency || "$").replace(/\\/g,"\\\\").replace(/'/g,"\\'") %>';
    const EXRATE      = <%= exchangeRate %>;
    const tenantName  = '<%- tenant.name.replace(/\\/g,"\\\\").replace(/'/g,"\\'") %>';

    // Bill settings from tenant
    const billLang    = '<%= tenant.bill_language || "en" %>';
    const billFontSz  = '<%= tenant.bill_font_size || "normal" %>';
    const billWidth   = '<%= tenant.bill_paper_width || "80mm" %>';
    const showIQD     = <%= tenant.bill_show_iqd !== false ? 'true' : 'false' %>;
    const customHdr   = '<%- (tenant.bill_custom_header || "").replace(/\\/g,"\\\\").replace(/'/g,"\\'") %>';
    const customFtr   = '<%- (tenant.bill_custom_footer || "").replace(/\\/g,"\\\\").replace(/'/g,"\\'") %>';

    const fsMap  = { small:'11px', normal:'13px', large:'15px' };
    const fontSize = fsMap[billFontSz] || '13px';
    const fsBig    = (parseInt(fontSize) + 4) + 'px';

    // Resolve labels (supports composite: 'en_ar', 'en_ar_ku')
    const langs    = billLang.split('_');
    const labelsAll = langs.map(l => BILL_LABELS[l] || BILL_LABELS.en);
    function L(key) {
      return labelsAll.map(ll => ll[key]).filter((v,i,a) => a.indexOf(v)===i).join(' / ');
    }
    // RTL direction for purely Arabic/Kurdish bills
    const isRTL = langs.every(l => l === 'ar' || l === 'ku');
    const dir   = isRTL ? ' dir="rtl"' : '';

    const now = new Date().toLocaleString();

    const itemRows = orderItems.map(oi => {
      const lineTotal = (parseFloat(oi.price) * oi.quantity).toFixed(2);
      const noteHtml  = oi.notes ? `<tr><td colspan="2" style="padding-left:14px;font-size:${parseInt(fontSize)-2}px;color:#555">📝 ${oi.notes}</td></tr>` : '';
      return `<tr>
        <td style="padding:3px 0">${oi.quantity}&times; ${oi.name}</td>
        <td style="text-align:right;white-space:nowrap;padding:3px 0">${CUR}${lineTotal}</td>
      </tr>${noteHtml}`;
    }).join('');

    const discountRow = discount > 0
      ? `<tr><td>${L('discount')}</td><td style="text-align:right">&minus;${CUR}${discount.toFixed(2)}</td></tr>` : '';
    const iqdRow = (showIQD && EXRATE > 1)
      ? `<tr style="font-size:${parseInt(fontSize)-2}px;color:#444"><td>${L('total')} (IQD)</td><td style="text-align:right">${Math.round(total * EXRATE).toLocaleString()} IQD</td></tr>` : '';
    const noteRow = order.note ? `<div style="font-size:${parseInt(fontSize)-2}px;color:#555;margin:4px 0">📝 ${order.note}</div>` : '';
    const headerRow = customHdr ? `<div style="text-align:center;margin:4px 0;font-size:${parseInt(fontSize)-1}px">${customHdr}</div>` : '';
    const footerText = customFtr || L('thanks');

    const html = `<!DOCTYPE html>
<html${dir}>
<head>
  <meta charset="UTF-8">
  <title>${L('bill')} #${order.id}</title>
  <style>
    * { margin:0; padding:0; box-sizing:border-box; }
    body { font-family:'Courier New',Courier,monospace; font-size:${fontSize}; width:${billWidth === '58mm' ? '200px' : '280px'}; margin:0 auto; padding:10px 8px; }
    hr  { border:none; border-top:1px dashed #000; margin:7px 0; }
    table { width:100%; border-collapse:collapse; }
    .center { text-align:center; }
    .total-row { font-weight:bold; font-size:${fsBig}; border-top:2px solid #000; margin-top:4px; }
    .footer { text-align:center; font-size:${parseInt(fontSize)-2}px; margin-top:10px; color:#555; }
    @media print { @page { margin:3mm; size:${billWidth} auto; } }
  </style>
</head>
<body>
  <div class="center">
    <div style="font-size:${fsBig};font-weight:bold">${tenantName}</div>
    <div style="letter-spacing:2px;margin:3px 0;font-size:${parseInt(fontSize)-1}px">— ${L('bill')} —</div>
  </div>
  <hr>
  ${headerRow}
  <table>
    <tr><td>${L('table')}</td><td style="text-align:right">${order.table_name || '—'}</td></tr>
    <tr><td>${L('order')}</td><td style="text-align:right">${order.id}</td></tr>
    <tr><td>${L('date')}</td><td style="text-align:right">${now}</td></tr>
  </table>
  <hr>
  <table><tbody>${itemRows}</tbody></table>
  <hr>
  <table>
    <tr><td>${L('subtotal')}</td><td style="text-align:right">${CUR}${subtotal.toFixed(2)}</td></tr>
    ${discountRow}
    <tr class="total-row"><td>${L('total')}</td><td style="text-align:right">${CUR}${total.toFixed(2)}</td></tr>
    ${iqdRow}
  </table>
  ${noteRow}
  <hr>
  <div class="footer">${footerText}</div>
</body>
</html>`;

    const frame = document.createElement('iframe');
    frame.style.cssText = 'position:fixed;top:-9999px;left:-9999px;width:1px;height:1px;border:none;';
    document.body.appendChild(frame);
    const fdoc = frame.contentDocument || frame.contentWindow.document;
    fdoc.open(); fdoc.write(html); fdoc.close();
    frame.contentWindow.focus();
    setTimeout(() => {
      frame.contentWindow.print();
      setTimeout(() => frame.remove(), 1000);
    }, 300);
  }
</script>
</body>
</html>
