<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Close Session — <%= tenant.name %></title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Segoe UI', sans-serif; background: #0f0f1a; color: #e0e0e0; min-height: 100vh; padding: 24px; }
    .main { max-width: 560px; margin: 0 auto; }
    h1 { font-size: 1.2rem; font-weight: 700; color: #fff; margin-bottom: 4px; }
    .sub { font-size: .82rem; color: #555; margin-bottom: 24px; }
    .card { background: #1a1a2e; border-radius: 14px; border: 1px solid rgba(255,255,255,.07); padding: 22px; margin-bottom: 16px; }
    .card h2 { font-size: .88rem; font-weight: 700; color: #888; text-transform: uppercase; letter-spacing: .4px; margin-bottom: 16px; }
    .stat-row { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid rgba(255,255,255,.04); font-size: .85rem; }
    .stat-row:last-child { border-bottom: none; }
    .stat-label { color: #666; }
    .stat-val { color: #fff; font-weight: 600; }
    .stat-val.green { color: #00b894; }
    .stat-val.purple { color: #7c5cbf; }
    label { display: block; font-size: .78rem; font-weight: 600; color: #666; margin-bottom: 6px; }
    input, textarea { width: 100%; padding: 10px 12px; background: #0f0f1a; border: 1.5px solid #2a2a3e; border-radius: 8px; color: #fff; font-size: .9rem; outline: none; font-family: inherit; }
    input:focus, textarea:focus { border-color: #7c5cbf; }
    .form-group { margin-bottom: 14px; }
    .btn { padding: 11px 24px; border: none; border-radius: 10px; cursor: pointer; font-size: .88rem; font-weight: 700; font-family: inherit; text-decoration: none; display: inline-flex; align-items: center; gap: 7px; }
    .btn-close { background: #e74c3c; color: #fff; }
    .btn-close:hover { opacity: .88; }
    .btn-ghost { background: rgba(255,255,255,.07); color: #888; }
    .btns { display: flex; gap: 10px; margin-top: 4px; }
    .divider { border: none; border-top: 1px solid rgba(255,255,255,.06); margin: 16px 0; }
    .orders-table { width: 100%; border-collapse: collapse; font-size: .78rem; }
    .orders-table th { text-align: left; color: #444; padding: 6px 8px; font-weight: 600; font-size: .7rem; text-transform: uppercase; }
    .orders-table td { padding: 8px 8px; border-top: 1px solid rgba(255,255,255,.04); color: #ccc; }
    .badge { padding: 2px 8px; border-radius: 10px; font-size: .68rem; font-weight: 700; }
    .badge-paid { background: rgba(0,184,148,.15); color: #00b894; }
    .badge-void { background: rgba(255,71,87,.12); color: #ff6b7a; }
    .blocker { background: rgba(231,76,60,.08); border: 1.5px solid rgba(231,76,60,.35); border-radius: 14px; padding: 22px; margin-bottom: 16px; }
    .blocker h2 { color: #e74c3c; font-size: .95rem; margin-bottom: 10px; }
    .blocker p  { font-size: .82rem; color: #888; margin-bottom: 16px; }
    .open-order-row { display: flex; justify-content: space-between; align-items: center; padding: 8px 10px; background: rgba(231,76,60,.06); border-radius: 8px; margin-bottom: 6px; font-size: .82rem; }
    .open-order-row:last-child { margin-bottom: 0; }
    .open-table  { font-weight: 700; color: #fff; }
    .open-status { padding: 2px 8px; border-radius: 10px; font-size: .68rem; font-weight: 700; background: rgba(241,196,15,.15); color: #f1c40f; text-transform: capitalize; }
    .btn-tables { background: #7c5cbf; color: #fff; }
    .btn-tables:hover { opacity: .88; }
    .z-table { width: 100%; border-collapse: collapse; font-size: .82rem; }
    .z-table th { text-align: left; color: #444; font-size: .68rem; text-transform: uppercase; padding: 5px 8px; border-bottom: 1px solid #2a2a3e; }
    .z-table td { padding: 8px 8px; border-bottom: 1px solid rgba(255,255,255,.03); }
    .z-table tr:last-child td { border-bottom: none; }
    .z-bar { height: 6px; background: rgba(124,92,191,.25); border-radius: 3px; margin-top: 4px; }
    .z-bar-fill { height: 100%; background: #7c5cbf; border-radius: 3px; }
    .blind-banner { background: rgba(253,203,110,.08); border: 1px solid rgba(253,203,110,.3); border-radius: 10px; padding: 12px 16px; margin-bottom: 14px; font-size: .82rem; color: #fdcb6e; }
    .comp-pill { font-size: .68rem; background: rgba(231,76,60,.12); color: #e74c3c; padding: 2px 8px; border-radius: 10px; }
    @media print { .no-print { display: none !important; } body { background: #fff; color: #000; } .card { border: 1px solid #ddd; background: #fff; } }
  </style>
</head>
<body>
<div class="main">
  <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:4px">
    <h1>🔒 Close Session</h1>
    <button onclick="window.print()" class="btn btn-ghost no-print" style="padding:7px 14px;font-size:.78rem">🖨 Print Z-Report</button>
  </div>
  <div class="sub">Session opened <%= new Date(session.opened_at).toLocaleString() %></div>

  <!-- Blocker: open orders -->
  <% if (openOrders && openOrders.length > 0) { %>
  <div class="blocker">
    <h2>⚠️ Cannot close — <%= openOrders.length %> open order<%= openOrders.length > 1 ? 's' : '' %></h2>
    <p>All tables must be paid or voided before you can close the session.</p>
    <% openOrders.forEach(o => { %>
    <div class="open-order-row">
      <span class="open-table"><%= o.table_name || ('Order #' + o.id) %></span>
      <span class="open-status"><%= o.status %></span>
    </div>
    <% }) %>
    <div class="btns" style="margin-top:16px">
      <a href="/pos/tables" class="btn btn-tables">Go to Tables →</a>
    </div>
  </div>
  <% } %>

  <!-- Z-Report Summary -->
  <div class="card">
    <h2>📊 Z-Report</h2>
    <div class="stat-row"><span class="stat-label">Orders Completed</span><span class="stat-val"><%= summary.count %></span></div>
    <div class="stat-row"><span class="stat-label">Total Sales</span><span class="stat-val green"><%= tenant.currency || '$' %><%= summary.total.toFixed(2) %></span></div>
    <div class="stat-row"><span class="stat-label">Cash Sales</span><span class="stat-val"><%= tenant.currency || '$' %><%= summary.cash.toFixed(2) %></span></div>
    <div class="stat-row"><span class="stat-label">Card Sales</span><span class="stat-val"><%= tenant.currency || '$' %><%= summary.card.toFixed(2) %></span></div>
    <% if (summary.tips > 0) { %>
    <div class="stat-row"><span class="stat-label">Tips Collected</span><span class="stat-val green"><%= tenant.currency || '$' %><%= summary.tips.toFixed(2) %></span></div>
    <% } %>
    <div class="stat-row"><span class="stat-label">Total Covers</span><span class="stat-val"><%= summary.covers %></span></div>
    <% if (parseFloat(zStats.total_service_fees) > 0) { %>
    <div class="stat-row"><span class="stat-label">Service Fees Collected</span><span class="stat-val" style="color:#e17055"><%= tenant.currency || '$' %><%= parseFloat(zStats.total_service_fees).toFixed(2) %></span></div>
    <% } %>
    <% if (parseFloat(zStats.total_discounts) > 0) { %>
    <div class="stat-row"><span class="stat-label">Discounts Given (<%= zStats.discount_orders %> orders)</span><span class="stat-val" style="color:#e17055">−<%= tenant.currency || '$' %><%= parseFloat(zStats.total_discounts).toFixed(2) %></span></div>
    <% } %>
    <% if (zStats.voids > 0) { %>
    <div class="stat-row"><span class="stat-label">Void Orders</span><span class="stat-val" style="color:#e74c3c"><%= zStats.voids %></span></div>
    <% } %>
    <div class="stat-row"><span class="stat-label">Opening Cash</span><span class="stat-val purple"><%= Math.round(parseFloat(session.opening_cash)).toLocaleString() %> IQD</span></div>
    <div class="stat-row"><span class="stat-label">Cash Received (IQD)</span><span class="stat-val"><%= Math.round(summary.cashIQD).toLocaleString() %> IQD</span></div>
    <!-- Expected is hidden from cashier — revealed after they submit their count -->
    <div class="stat-row no-print" id="expectedRow" style="display:none">
      <span class="stat-label">Expected in Drawer</span>
      <span class="stat-val green" id="expectedAmt"><%= Math.round(parseFloat(session.opening_cash) + summary.cashIQD).toLocaleString() %> IQD</span>
    </div>
  </div>

  <!-- Top Items -->
  <% if (topItems && topItems.length > 0) { %>
  <% const maxRev = Math.max(...topItems.map(i => parseFloat(i.revenue) || 0)); %>
  <div class="card">
    <h2>🔥 Top Selling Items</h2>
    <table class="z-table">
      <thead><tr><th>Item</th><th>Qty</th><th style="text-align:right">Revenue</th></tr></thead>
      <tbody>
      <% topItems.forEach(item => { %>
      <tr>
        <td>
          <%= item.name %>
          <div class="z-bar"><div class="z-bar-fill" style="width:<%= maxRev > 0 ? Math.round(parseFloat(item.revenue)/maxRev*100) : 0 %>%"></div></div>
        </td>
        <td style="color:#888"><%= item.qty %></td>
        <td style="text-align:right;font-weight:700;color:#7c5cbf"><%= tenant.currency || '$' %><%= parseFloat(item.revenue).toFixed(2) %></td>
      </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>

  <!-- Per-Cashier Breakdown -->
  <% if (cashierStats && cashierStats.length > 0) { %>
  <div class="card">
    <h2>👤 By Cashier</h2>
    <table class="z-table">
      <thead>
        <tr>
          <th>Cashier</th>
          <th style="text-align:center">Orders</th>
          <th style="text-align:center">Discounts</th>
          <th style="text-align:right">Tips</th>
          <th style="text-align:right">Sales</th>
        </tr>
      </thead>
      <tbody>
      <% cashierStats.forEach(c => { %>
      <tr>
        <td style="font-weight:600"><%= c.cashier_name || ('User #' + c.created_by) %></td>
        <td style="text-align:center;color:#888"><%= c.order_count %></td>
        <td style="text-align:center">
          <% if (c.discounts_given > 0) { %>
          <span class="comp-pill"><%= c.discounts_given %> disc · −<%= tenant.currency || '$' %><%= parseFloat(c.total_discounts).toFixed(2) %></span>
          <% } else { %><span style="color:#444">—</span><% } %>
        </td>
        <td style="text-align:right;color:#00b894"><%= parseFloat(c.tip_total) > 0 ? (tenant.currency||'$') + parseFloat(c.tip_total).toFixed(2) : '—' %></td>
        <td style="text-align:right;font-weight:700;color:#fff"><%= tenant.currency || '$' %><%= parseFloat(c.total_sales).toFixed(2) %></td>
      </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>

  <!-- Comp / Void Item Audit -->
  <% if (compLog && compLog.length > 0) { %>
  <div class="card">
    <h2>🚨 Comped Items This Session</h2>
    <table class="z-table">
      <thead><tr><th>Item</th><th>Reason</th><th>By</th></tr></thead>
      <tbody>
      <% compLog.forEach(c => { %>
      <tr>
        <td style="color:#e74c3c;font-weight:600"><%= c.item_name || '—' %></td>
        <td style="color:#888"><%= c.reason || '—' %></td>
        <td style="color:#666"><%= c.cashier_name || 'Unknown' %></td>
      </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>

  <!-- Close form — Blind Cash Count -->
  <div class="card no-print">
    <h2>🔒 Close Session</h2>
    <div class="blind-banner">
      🙈 <strong>Blind Count</strong> — Count your cash drawer independently before submitting. The system's expected amount is hidden until after you close.
    </div>
    <form method="POST" action="/pos/session/close" onsubmit="return onCloseSubmit(event)">
      <div class="form-group">
        <label>Actual Cash in Drawer (IQD)</label>
        <input type="number" name="closing_cash" id="closingCashInput" value="" min="0" step="500"
          placeholder="Count your drawer and enter here..." oninput="showVariance()" />
      </div>
      <div id="varianceBox" style="display:none;border-radius:8px;padding:10px 14px;margin-bottom:12px;font-size:.85rem;font-weight:700"></div>
      <div class="form-group">
        <label>Notes (optional)</label>
        <textarea name="notes" rows="2" placeholder="Any notes about this shift..."></textarea>
      </div>
      <div class="btns">
        <a href="/pos/tables" class="btn btn-ghost">← Tables</a>
        <% if (openOrders && openOrders.length > 0) { %>
        <button type="button" class="btn btn-close" disabled style="opacity:.35;cursor:not-allowed" title="Resolve open orders first">🔒 Close Session</button>
        <% } else { %>
        <button type="submit" class="btn btn-close">🔒 Close Session</button>
        <% } %>
      </div>
    </form>
  </div>

  <script>
    const EXPECTED_IQD = <%= Math.round(parseFloat(session.opening_cash) + summary.cashIQD) %>;
    function showVariance() {
      const actual    = parseInt(document.getElementById('closingCashInput').value) || 0;
      const variance  = actual - EXPECTED_IQD;
      const box       = document.getElementById('varianceBox');
      const expRow    = document.getElementById('expectedRow');
      if (!actual) { box.style.display = 'none'; return; }
      expRow.style.display = '';
      box.style.display    = '';
      if (variance === 0) {
        box.style.background = 'rgba(0,184,148,.1)'; box.style.color = '#00b894';
        box.textContent = '✓ Exact match — drawer balances perfectly';
      } else if (variance > 0) {
        box.style.background = 'rgba(116,185,255,.1)'; box.style.color = '#74b9ff';
        box.textContent = '↑ Over by ' + Math.abs(variance).toLocaleString() + ' IQD';
      } else {
        box.style.background = 'rgba(231,76,60,.1)'; box.style.color = '#e74c3c';
        box.textContent = '↓ Short by ' + Math.abs(variance).toLocaleString() + ' IQD';
      }
    }
    function onCloseSubmit(e) {
      const val = document.getElementById('closingCashInput').value;
      if (!val) {
        alert('Please enter the actual cash count from your drawer.');
        e.preventDefault(); return false;
      }
      return confirm('Close this session? This action cannot be undone.');
    }
  </script>
</div>
</body>
</html>
