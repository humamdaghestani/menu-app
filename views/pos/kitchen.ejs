<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Kitchen Display — <%= tenant.name %></title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Segoe UI', sans-serif; background: #0a0a0f; color: #e0e0e0; min-height: 100vh; }

    .topbar { background: #111; height: 52px; display: flex; align-items: center; justify-content: space-between; padding: 0 20px; border-bottom: 1px solid #222; }
    .topbar-brand { font-weight: 700; color: #fff; font-size: .95rem; display: flex; align-items: center; gap: 10px; }
    .live-dot { width: 8px; height: 8px; border-radius: 50%; background: #00b894; animation: pulse 1.5s infinite; }
    @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.3} }
    .btn { padding: 6px 14px; border: none; border-radius: 8px; cursor: pointer; font-size: .78rem; font-weight: 600; font-family: inherit; text-decoration: none; }
    .btn-ghost { background: rgba(255,255,255,.08); color: #ccc; }

    .main { padding: 16px; }
    .orders-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; }

    .order-ticket { background: #1a1a2e; border-radius: 12px; border: 2px solid #2a2a3e; overflow: hidden; }
    .ticket-header { background: #13132a; padding: 12px 16px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #2a2a3e; }
    .ticket-table { font-size: 1rem; font-weight: 700; color: #fff; }
    .ticket-time { font-size: .72rem; color: #555; }
    .ticket-order { font-size: .72rem; color: #666; margin-top: 2px; }
    .ticket-items { padding: 12px 16px; }
    .ticket-item { display: flex; justify-content: space-between; align-items: flex-start; padding: 8px 0; border-bottom: 1px solid rgba(255,255,255,.04); }
    .ticket-item:last-child { border-bottom: none; }
    .ticket-item.new-item { background: rgba(253,203,110,.04); border-radius: 6px; padding: 8px 6px; }
    .ti-name { font-size: .9rem; color: #fff; font-weight: 600; }
    .ti-qty { font-size: .9rem; color: #7c5cbf; font-weight: 700; min-width: 28px; }
    .ti-note { font-size: .72rem; color: #555; margin-top: 3px; }
    .new-badge { font-size: .58rem; font-weight: 900; background: #fdcb6e; color: #0a0a0f; padding: 2px 6px; border-radius: 4px; margin-left: 6px; vertical-align: middle; letter-spacing: .3px; }
    .course-header { font-size: .6rem; font-weight: 900; text-transform: uppercase; letter-spacing: .8px; color: #444; padding: 6px 0 2px; }
    .has-new { border-color: rgba(253,203,110,.5) !important; }
    .cover-chip { font-size: .68rem; color: #74b9ff; background: rgba(116,185,255,.12); padding: 2px 7px; border-radius: 10px; }
    .ticket-note { padding: 10px 16px; background: rgba(255,200,0,.06); border-top: 1px solid rgba(255,200,0,.1); font-size: .78rem; color: #f0b429; }
    .ticket-footer { padding: 12px 16px; border-top: 1px solid #2a2a3e; display: flex; gap: 8px; }
    .btn-done { flex: 1; padding: 9px; border: none; border-radius: 8px; background: #00b894; color: #fff; font-size: .82rem; font-weight: 700; cursor: pointer; font-family: inherit; }
    .btn-done:hover { opacity: .88; }
    .btn-view { padding: 9px 14px; border-radius: 8px; background: rgba(255,255,255,.07); color: #888; font-size: .82rem; font-weight: 600; text-decoration: none; border: none; cursor: pointer; font-family: inherit; }

    .elapsed { font-size: .72rem; font-weight: 700; padding: 3px 8px; border-radius: 10px; }
    .elapsed-ok { background: rgba(0,184,148,.15); color: #00b894; }
    .elapsed-warn { background: rgba(243,156,18,.15); color: #f39c12; }
    .elapsed-late { background: rgba(231,76,60,.15); color: #e74c3c; }

    .empty { text-align: center; padding: 100px 24px; color: #333; }
    .empty-icon { font-size: 4rem; margin-bottom: 16px; }
    .empty p { font-size: 1rem; }
  </style>
</head>
<body>

<div class="topbar">
  <div style="display:flex;align-items:center;gap:8px">
    <a href="/admin" class="btn btn-ghost" style="padding:6px 10px;font-size:1.1rem;flex-shrink:0" title="All Modules">🏠</a>
    <a href="/pos/home" class="btn btn-ghost" style="padding:5px 14px;font-size:.82rem;font-weight:600;flex-shrink:0">POS</a>
    <div class="topbar-brand">
      <div class="live-dot"></div>
      🍳 Kitchen Display — <%= tenant.name %>
    </div>
  </div>
  <button onclick="history.back()" class="btn btn-ghost">← Back</button>
</div>

<% if (tenant.feat_kitchen_routing && stations && stations.length > 1) { %>
<div style="background:#111;border-bottom:1px solid #222;padding:0 20px;display:flex;gap:4px;overflow-x:auto">
  <a href="/pos/kitchen" class="<%= !station ? 'station-tab active' : 'station-tab' %>" style="padding:10px 16px;text-decoration:none;font-size:.82rem;font-weight:700;color:<%=!station?'#fff':'#555'%>;border-bottom:2px solid <%=!station?'#7c5cbf':'transparent'%>;white-space:nowrap">All Stations</a>
  <% stations.forEach(s => { %>
  <a href="/pos/kitchen?station=<%= encodeURIComponent(s) %>" style="padding:10px 16px;text-decoration:none;font-size:.82rem;font-weight:700;color:<%=station===s?'#fff':'#555'%>;border-bottom:2px solid <%=station===s?'#7c5cbf':'transparent'%>;white-space:nowrap">🍳 <%= s %></a>
  <% }) %>
</div>
<% } %>

<div class="main">
  <div class="orders-grid" id="ordersGrid">
    <% if (orders.length === 0) { %>
    <div class="empty" style="grid-column:1/-1">
      <div class="empty-icon">✅</div>
      <p>All clear — no open orders</p>
    </div>
    <% } %>
    <% orders.forEach(o => { %>
    <% const mins = Math.floor((Date.now() - new Date(o.created_at).getTime()) / 60000); %>
    <% const hasNew = (o.items || []).some(i => !i.sent_to_kitchen); %>
    <% const courseOrder = ['starter','main','dessert','drink']; %>
    <% const grouped = {}; (o.items||[]).forEach(i => { const c = i.course || 'main'; if (!grouped[c]) grouped[c]=[]; grouped[c].push(i); }); %>
    <div class="order-ticket<%= hasNew ? ' has-new' : '' %>" id="ticket_<%= o.id %>">
      <div class="ticket-header">
        <div>
          <div class="ticket-table">🪑 <%= o.table_name %> <% if (o.cover_count > 1) { %><span class="cover-chip">×<%= o.cover_count %></span><% } %></div>
          <div class="ticket-order">Order #<%= o.id %><% if (hasNew) { %> <span style="color:#fdcb6e;font-size:.68rem;font-weight:700">● NEW</span><% } %></div>
        </div>
        <span class="elapsed <%= mins < 10 ? 'elapsed-ok' : mins < 20 ? 'elapsed-warn' : 'elapsed-late' %>">
          <%= mins %>m
        </span>
      </div>
      <div class="ticket-items">
        <% courseOrder.forEach(course => { if (!grouped[course]) return; %>
        <% if (Object.keys(grouped).length > 1) { %>
        <div class="course-header"><%= course === 'main' ? '🍽 Main' : course === 'starter' ? '🥗 Starter' : course === 'dessert' ? '🍮 Dessert' : '🥤 Drink' %></div>
        <% } %>
        <% grouped[course].forEach(item => { %>
        <div class="ticket-item<%= !item.sent_to_kitchen ? ' new-item' : '' %>">
          <div>
            <div class="ti-name"><%= item.name %><% if (!item.sent_to_kitchen) { %><span class="new-badge">NEW</span><% } %></div>
            <% if (item.notes) { %><div class="ti-note">📝 <%= item.notes %></div><% } %>
          </div>
          <div class="ti-qty">×<%= item.quantity %></div>
        </div>
        <% }) %>
        <% }) %>
      </div>
      <% if (o.note) { %>
      <div class="ticket-note">📋 <%= o.note %></div>
      <% } %>
      <% if (o.kitchen_done_at) { %>
      <div style="padding:8px 16px;font-size:.72rem;color:#00b894;background:rgba(0,184,148,.05);border-top:1px solid #2a2a3e">
        ✓ Kitchen done <%= Math.floor((new Date(o.kitchen_done_at) - new Date(o.kitchen_sent_at || o.created_at)) / 60000) %>m prep time
      </div>
      <% } %>
      <div class="ticket-footer">
        <button class="btn-done" onclick="markDone(<%= o.id %>)">✓ Done — Close Order</button>
        <a href="/pos/order/<%= o.id %>" class="btn-view">View</a>
      </div>
    </div>
    <% }) %>
  </div>
</div>

<script>
  async function markDone(orderId) {
    // Log kitchen done time first (for prep time tracking)
    try {
      await fetch('/pos/api/order/' + orderId + '/kitchen-done', { method: 'POST', headers: {'Content-Type':'application/json'}, body: '{}' });
    } catch {}
    if (!confirm('Mark this order as paid/done?')) return;
    window.location.href = '/pos/order/' + orderId + '/pay';
  }

  const COURSE_ORDER = ['starter','main','dessert','drink'];
  function renderTicket(o, now) {
    const mins    = Math.floor((now - new Date(o.created_at).getTime()) / 60000);
    const cls     = mins < 10 ? 'elapsed-ok' : mins < 20 ? 'elapsed-warn' : 'elapsed-late';
    const hasNew  = (o.items||[]).some(i => !i.sent_to_kitchen);
    const grouped = {};
    (o.items||[]).forEach(i => { const c = i.course||'main'; if (!grouped[c]) grouped[c]=[]; grouped[c].push(i); });
    const multiCourse = Object.keys(grouped).length > 1;
    const courseLabels = { starter:'🥗 Starter', main:'🍽 Main', dessert:'🍮 Dessert', drink:'🥤 Drink' };
    let itemsHtml = '';
    COURSE_ORDER.forEach(c => {
      if (!grouped[c]) return;
      if (multiCourse) itemsHtml += `<div class="course-header">${courseLabels[c]||c}</div>`;
      grouped[c].forEach(item => {
        const isNew = !item.sent_to_kitchen;
        itemsHtml += `<div class="ticket-item${isNew?' new-item':''}">
          <div><div class="ti-name">${item.name}${isNew?'<span class="new-badge">NEW</span>':''}</div>${item.notes?`<div class="ti-note">📝 ${item.notes}</div>`:''}</div>
          <div class="ti-qty">×${item.quantity}</div></div>`;
      });
    });
    const coverChip = o.cover_count > 1 ? `<span class="cover-chip">×${o.cover_count}</span>` : '';
    const newLabel  = hasNew ? ' <span style="color:#fdcb6e;font-size:.68rem;font-weight:700">● NEW</span>' : '';
    return `<div class="order-ticket${hasNew?' has-new':''}" id="ticket_${o.id}">
      <div class="ticket-header">
        <div><div class="ticket-table">🪑 ${o.table_name} ${coverChip}</div><div class="ticket-order">Order #${o.id}${newLabel}</div></div>
        <span class="elapsed ${cls}">${mins}m</span>
      </div>
      <div class="ticket-items">${itemsHtml}</div>
      ${o.note?`<div class="ticket-note">📋 ${o.note}</div>`:''}
      <div class="ticket-footer">
        <button class="btn-done" onclick="markDone(${o.id})">✓ Done</button>
        <a href="/pos/order/${o.id}" class="btn-view">View</a>
      </div></div>`;
  }

  // Auto-refresh every 8 seconds
  async function refresh() {
    try {
      const r = await fetch('/pos/api/kitchen');
      const data = await r.json();
      if (data.orders.length === 0) {
        document.getElementById('ordersGrid').innerHTML = '<div class="empty" style="grid-column:1/-1"><div class="empty-icon">✅</div><p>All clear — no open orders</p></div>';
        return;
      }
      const now = Date.now();
      document.getElementById('ordersGrid').innerHTML = data.orders.map(o => renderTicket(o, now)).join('');
    } catch {}
  }

  setInterval(refresh, 8000);
</script>
</body>
</html>
