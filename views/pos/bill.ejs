<%
const BILL_LABELS = {
  en: { item:'Item', qty:'QTY', price:'Price', total_col:'Total', subtotal:'Sub Total', svcfee:'Service', discount:'Discount', total:'Net Total', served_by:'Served by', dine_in:'Dine-in', takeaway:'Takeaway', thanks:'Thank you!' },
  ar: { item:'الصنف', qty:'الكمية', price:'السعر', total_col:'المجموع', subtotal:'المجموع', svcfee:'رسوم الخدمة', discount:'خصم', total:'المجموع الكلي', served_by:'خدمك', dine_in:'طلب داخلي', takeaway:'تيك أواي', thanks:'شكراً لكم!' },
  ku: { item:'باپهت', qty:'بر', price:'نرخ', total_col:'گشتی', subtotal:'گشتی', svcfee:'سێرڤس', discount:'دشکاندەن', total:'کۆی گشتی', served_by:'تو خزمەت کردن لەلایان', dine_in:'طلب داخلي', takeaway:'تیک ئەوی', thanks:'سوپاس!' },
};
const billLang  = tenant.bill_language || 'en';
const langs     = billLang.split('_');
const labelsAll = langs.map(l => BILL_LABELS[l] || BILL_LABELS.en);
function L(key) {
  if (customLabels[key] && customLabels[key].trim()) return customLabels[key].trim();
  return labelsAll.map(ll => ll[key] || '').filter((v,i,a) => a.indexOf(v) === i && v).join(' - ');
}
function BH(key) {
  if (customLabels[key] && customLabels[key].trim()) return customLabels[key].trim();
  const parts = labelsAll.map(ll => ll[key] || '').filter((v,i,a) => a.indexOf(v) === i && v);
  if (parts.length === 1) return parts[0];
  return parts[0] + '<br><small style="font-size:9px">' + parts[parts.length-1] + '</small>';
}
function fmtN(n) {
  n = parseFloat(n) || 0;
  if (n % 1 === 0) return Math.round(n).toLocaleString('en-US');
  const p = n.toFixed(2).split('.');
  p[0] = p[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  return p.join('.');
}
const CUR      = tenant.currency || '$';
const pw       = (tenant.bill_paper_width || '80mm') === '58mm' ? '195px' : '290px';
const billW    = tenant.bill_paper_width || '80mm';
const showIQD  = tenant.bill_show_iqd !== false;
const customHdr = tenant.bill_custom_header || '';
const customFtr = tenant.bill_custom_footer || '';
const now = (function() {
  const d = new Date();
  const dd = String(d.getDate()).padStart(2,'0');
  const mm = String(d.getMonth()+1).padStart(2,'0');
  const h24 = d.getHours(); const ampm = h24 >= 12 ? 'PM' : 'AM';
  const h12 = h24 % 12 || 12;
  const mi = String(d.getMinutes()).padStart(2,'0');
  const ss = String(d.getSeconds()).padStart(2,'0');
  return dd+'/'+mm+'/'+d.getFullYear()+' '+ampm+' '+h12+':'+mi+':'+ss;
})();
const orderTypeLbl = L(order.order_type === 'takeaway' ? 'takeaway' : 'dine_in') || 'Dine-in';
%><!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Bill #<%= order.id %></title>
  <style>
    * { margin:0;padding:0;box-sizing:border-box; }
    body { font-family:Arial,'Segoe UI',sans-serif;font-size:13px;font-weight:700;color:#000;width:<%= pw %>;margin:0 auto;padding:8px 6px; }
    .ctr { text-align:center; }
    .ls  { border-top:2px solid #000;margin:6px 0; }
    .ld  { border-top:1px dashed #000;margin:5px 0; }
    .ir  { display:flex;justify-content:space-between;font-size:12px;font-weight:700;margin:3px 0; }
    table.it { width:100%;border-collapse:collapse;margin:4px 0; }
    table.it th { border:1.5px solid #000;padding:5px 4px;font-size:11px;text-align:center;font-weight:900;line-height:1.4;background:#fff; }
    table.it td { border:1.5px solid #000;font-size:12px;font-weight:700;vertical-align:middle; }
    .tr  { display:flex;justify-content:space-between;padding:4px 0;font-size:12px;font-weight:700; }
    .trg { display:flex;justify-content:space-between;padding:5px 0;font-size:15px;font-weight:900;border-top:2px solid #000;margin-top:4px; }
    .ftr { text-align:center;font-size:11px;font-weight:700;margin-top:6px; }
    .actions { text-align:center;margin:12px 0;font-family:'Segoe UI',sans-serif; }
    .btn-print { background:#2d3436;color:#fff;border:none;padding:8px 20px;border-radius:6px;cursor:pointer;font-size:.85rem;font-weight:600; }
    @media print { @page { margin:2mm;size:<%= billW %> auto; } .actions { display:none; } body { padding:2px; } }
  </style>
</head>
<body>

<div class="actions">
  <button class="btn-print" onclick="window.print()">🖨️ Print</button>
</div>

<div class="ctr">
  <div style="font-size:19px;font-weight:900;letter-spacing:.3px;margin-bottom:2px"><%= tenant.name %></div>
  <% if (customHdr) { %><div style="font-size:11px;font-weight:700;line-height:1.6;margin-bottom:3px"><%- customHdr.replace(/\n/g,'<br>') %></div><% } %>
</div>

<div class="ls"></div>

<div class="ir">
  <span><%= orderTypeLbl %> &nbsp; ز.وصل Bill # <%= order.id %></span>
</div>
<div class="ir">
  <span><%= order.table_name || '—' %></span>
  <span><%= now %></span>
</div>

<% if (order.note) { %>
<div style="border:1.5px solid #000;padding:5px;margin:5px 0;font-size:11px;font-weight:700">📝 <%= order.note %></div>
<% } else { %>
<div style="border:1.5px solid #000;height:28px;margin:5px 0"></div>
<% } %>

<table class="it">
  <thead><tr>
    <th style="text-align:left;width:44%"><%- BH('item') %></th>
    <th style="width:12%"><%- BH('qty') %></th>
    <th style="width:20%"><%- BH('price') %></th>
    <th style="width:24%"><%- BH('total_col') %></th>
  </tr></thead>
  <tbody>
  <% orderItems.forEach(function(oi) { %>
    <tr>
      <td style="text-align:left;padding:5px"><%= oi.name %></td>
      <td style="text-align:center;padding:5px"><%= oi.quantity %></td>
      <td style="text-align:right;padding:5px;white-space:nowrap"><%= CUR %><%= fmtN(parseFloat(oi.price)) %></td>
      <td style="text-align:right;padding:5px;white-space:nowrap"><%= CUR %><%= fmtN(parseFloat(oi.price) * oi.quantity) %></td>
    </tr>
    <% if (oi.notes) { %>
    <tr><td colspan="4" style="padding:2px 5px;font-size:10px;border-top:none;color:#222">📝 <%= oi.notes %></td></tr>
    <% } %>
  <% }); %>
  </tbody>
</table>

<div class="ld"></div>

<div class="tr"><span><%= L('subtotal') %></span><span><%= CUR %><%= fmtN(subtotal) %></span></div>
<% if (svcFee > 0) { %>
<div class="tr"><span><%= L('svcfee') %><%= serviceFeePct > 0 ? ' (' + serviceFeePct + '%)' : '' %></span><span><%= CUR %><%= fmtN(svcFee) %></span></div>
<% } %>
<% if (discount > 0) { %>
<div class="tr"><span><%= L('discount') %></span><span>&minus;<%= CUR %><%= fmtN(discount) %></span></div>
<% } %>
<div class="trg"><span><%= L('total') %></span><span><%= CUR %><%= fmtN(grandTotal) %></span></div>
<% if (showIQD && exchangeRate > 1 && CUR !== 'IQD' && CUR !== 'د.ع') { %>
<div style="display:flex;justify-content:space-between;font-size:11px;font-weight:700;padding:2px 0"><span>IQD</span><span><%= Math.round(grandTotal * exchangeRate).toLocaleString() %></span></div>
<% } %>

<div class="ls"></div>

<div class="ftr"><%= L('served_by') %> : <%= currentUser.name || currentUser.username %></div>
<div class="ftr" style="margin-top:3px"><%= customFtr || L('thanks') %></div>

<script>
  window.onload = function() { setTimeout(function() { window.print(); }, 400); };
  window.onafterprint = function() { window.close(); };
</script>
</body>
</html>
