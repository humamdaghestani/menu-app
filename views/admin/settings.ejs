<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>General Settings — <%= tenant.name %></title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root { --accent: <%= tenant.theme_color || '#e94560' %>; --sidebar-w: 240px; }
    body { font-family: 'Segoe UI', sans-serif; background: #f4f5f7; color: #222; display: flex; min-height: 100vh; }

    .sidebar { width: var(--sidebar-w); background: #1a1a2e; display: flex; flex-direction: column; position: fixed; top: 0; left: 0; bottom: 0; z-index: 100; padding: 0 0 24px; }
    .sidebar-brand { padding: 24px 20px 20px; border-bottom: 1px solid rgba(255,255,255,.08); display: flex; align-items: center; gap: 12px; }
    .sidebar-brand img { width: 40px; height: 40px; border-radius: 10px; object-fit: cover; background: #fff; flex-shrink: 0; }
    .sidebar-brand .brand-emoji { font-size: 1.6rem; }
    .sidebar-brand-text h2 { color: #fff; font-size: .95rem; font-weight: 700; line-height: 1.2; }
    .sidebar-brand-text span { color: #aaa; font-size: .75rem; }
    .sidebar-nav { flex: 1; padding: 16px 12px; display: flex; flex-direction: column; gap: 4px; overflow-y: auto; }
    .sidebar-nav a, .sidebar-nav button { display: flex; align-items: center; gap: 10px; padding: 11px 14px; border-radius: 10px; color: #aaa; text-decoration: none; font-size: .9rem; background: none; border: none; cursor: pointer; width: 100%; transition: background .15s, color .15s; font-family: inherit; }
    .sidebar-nav a:hover, .sidebar-nav button:hover { background: rgba(255,255,255,.07); color: #fff; }
    .sidebar-nav a.active { background: var(--accent); color: #fff; font-weight: 600; }
    .sidebar-nav .icon { font-size: 1.1rem; width: 20px; text-align: center; }
    .sidebar-footer { padding: 0 12px; }
    .view-menu-btn { display: flex; align-items: center; justify-content: center; gap: 8px; background: rgba(255,255,255,.07); color: #ccc; padding: 10px; border-radius: 10px; text-decoration: none; font-size: .85rem; transition: background .15s, color .15s; }
    .view-menu-btn:hover { background: rgba(255,255,255,.14); color: #fff; }

    .main { margin-left: var(--sidebar-w); flex: 1; padding: 32px; max-width: 760px; }
    .page-header { margin-bottom: 28px; }
    .page-header h1 { font-size: 1.4rem; font-weight: 700; color: #1a1a2e; }
    .page-header p { color: #888; font-size: .9rem; margin-top: 4px; }

    .card { background: #fff; border-radius: 14px; padding: 28px; margin-bottom: 24px; box-shadow: 0 2px 8px rgba(0,0,0,.06); }
    .card h2 { font-size: 1rem; font-weight: 700; color: #1a1a2e; margin-bottom: 20px; padding-bottom: 12px; border-bottom: 1px solid #f0f0f0; }
    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .form-group { display: flex; flex-direction: column; gap: 6px; }
    .form-group.full { grid-column: 1 / -1; }
    label { font-size: .8rem; font-weight: 600; color: #555; }
    input, textarea { padding: 10px 12px; border: 1.5px solid #e8e8e8; border-radius: 8px; font-size: .9rem; outline: none; font-family: inherit; background: #fafafa; transition: border-color .2s; }
    input:focus, textarea:focus { border-color: var(--accent); background: #fff; }
    .form-actions { display: flex; justify-content: flex-end; margin-top: 20px; }
    .btn { padding: 10px 24px; border: none; border-radius: 8px; cursor: pointer; font-size: .9rem; font-weight: 600; font-family: inherit; }
    .btn-primary { background: var(--accent); color: #fff; }
    .btn-primary:hover { opacity: .88; }
    .btn-ghost { background: #f0f0f0; color: #444; }
    #toast { position: fixed; bottom: 28px; right: 28px; background: #1a1a2e; color: #fff; padding: 12px 20px; border-radius: 10px; font-size: .88rem; font-weight: 500; box-shadow: 0 8px 24px rgba(0,0,0,.2); transform: translateY(80px); opacity: 0; transition: transform .3s, opacity .3s; z-index: 999; }
    #toast.show { transform: translateY(0); opacity: 1; }
    #toast.success { border-left: 4px solid #00b894; }
    .shortcut-card { background: linear-gradient(135deg, #1a1a2e, #16213e); border-radius: 14px; padding: 20px 24px; margin-bottom: 24px; display: flex; align-items: center; gap: 16px; text-decoration: none; color: #fff; border: 1px solid #2a2a3e; transition: border-color .2s; }
    .shortcut-card:hover { border-color: var(--accent); }
    .shortcut-icon { font-size: 2rem; }
    .shortcut-title { font-size: 1rem; font-weight: 700; margin-bottom: 3px; }
    .shortcut-desc { font-size: .8rem; color: #888; }
    @media(max-width:768px){ .sidebar{width:64px;} .sidebar-brand-text,.sidebar-nav span:not(.icon){display:none;} .main{margin-left:64px;padding:20px 16px;} .form-grid{grid-template-columns:1fr;} }
  </style>
</head>
<body>

<aside class="sidebar">
  <div class="sidebar-brand">
    <% if (tenant.logo_url) { %><img src="<%= tenant.logo_url %>" alt="<%= tenant.name %>" /><% } else { %><span class="brand-emoji">🍽️</span><% } %>
    <div class="sidebar-brand-text"><h2><%= tenant.name %></h2><span>Admin Panel</span></div>
  </div>
  <nav class="sidebar-nav">
    <a href="/admin"><span class="icon">🏠</span><span>Home</span></a>
    <div style="height:1px;background:rgba(255,255,255,.06);margin:4px 0 6px"></div>
    <% const _isAdmin = currentUser && currentUser.role === 'admin'; const _perms = (currentUser && currentUser.permissions) || []; const _can = p => _isAdmin || _perms.includes(p); %>
    <% if (_isAdmin || _can('access_menu')) { %><a href="/admin/dashboard"><span class="icon">🍽️</span><span>Menu</span></a><% } %>
    <% if (tenant.feat_pos && (_isAdmin || _can('access_pos'))) { %><a href="/pos"><span class="icon">🖥️</span><span>Point of Sale</span></a><% } %>
    <% if (tenant.feat_inventory && (_isAdmin || _can('access_inventory'))) { %>
    <a href="/inventory"><span class="icon">📦</span><span>Inventory</span></a>
    <a href="/inventory/purchases"><span class="icon">🧾</span><span>Purchases</span></a>
    <% } %>
    <% if (tenant.feat_accounting && (_isAdmin || _can('access_accounting'))) { %><a href="/accounting"><span class="icon">📒</span><span>Accounting</span></a><% } %>
    <% if (tenant.feat_reports && _isAdmin) { %><a href="/reports"><span class="icon">📊</span><span>Reports</span></a><% } %>
    <% if (tenant.feat_hr && _isAdmin) { %><a href="/hr"><span class="icon">👤</span><span>HR & Payroll</span></a><% } %>
    <div style="height:1px;background:rgba(255,255,255,.06);margin:4px 0 6px"></div>
    <% if (_isAdmin) { %>
    <a href="/admin/workspace"><span class="icon">👥</span><span>Team & Access</span></a>
    <a href="/admin/users"><span class="icon">👤</span><span>Users</span></a>
    <a href="/admin/audit"><span class="icon">🔍</span><span>Audit Log</span></a>
    <% } %>
    <a href="/admin/settings" class="active"><span class="icon">⚙️</span><span>Settings</span></a>
    <form method="POST" action="/admin/logout" style="margin-top:auto">
      <button type="submit"><span class="icon">🚪</span><span>Logout</span></button>
    </form>
  </nav>
  <div class="sidebar-footer">
    <a href="/?tenant=<%= tenant.subdomain %>" target="_blank" class="view-menu-btn"><span>🔗</span><span>View Menu</span></a>
  </div>
</aside>

<div class="main">
  <div class="page-header">
    <h1>⚙️ General Settings</h1>
    <p>System-wide configuration — restaurant identity, currency, security</p>
  </div>

  <!-- Shortcut cards -->
  <a href="/admin/menu-settings" class="shortcut-card">
    <div class="shortcut-icon">🎨</div>
    <div>
      <div class="shortcut-title">Menu & Branding Settings</div>
      <div class="shortcut-desc">Logo, theme color, opening hours, menu appearance, custom CSS</div>
    </div>
    <span style="margin-left:auto;font-size:1.3rem;color:#555">→</span>
  </a>
  <a href="/admin/users" class="shortcut-card">
    <div class="shortcut-icon">👥</div>
    <div>
      <div class="shortcut-title">Users</div>
      <div class="shortcut-desc">Manage staff accounts, roles, and permissions</div>
    </div>
    <span style="margin-left:auto;font-size:1.3rem;color:#555">→</span>
  </a>

  <!-- General Info -->
  <form method="POST" action="/admin/settings">
    <div class="card">
      <h2>🏪 Restaurant Info</h2>
      <div class="form-grid">
        <div class="form-group">
          <label>Restaurant Name *</label>
          <input type="text" name="name" value="<%= tenant.name %>" required />
        </div>
        <div class="form-group">
          <label>Tagline / Short Description</label>
          <input type="text" name="description" value="<%= tenant.description || '' %>" placeholder="e.g. Best burgers in town" />
        </div>
        <div class="form-group">
          <label>WhatsApp Number <small style="color:#aaa;font-weight:400">(with country code)</small></label>
          <input type="text" name="whatsapp" value="<%= tenant.whatsapp || '' %>" placeholder="9647501234567" />
        </div>
        <div class="form-group">
          <label>Currency Symbol</label>
          <input type="text" name="currency" value="<%= tenant.currency || '$' %>" maxlength="8" />
          <div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:6px">
            <% ['$','€','£','IQD','﷼','₹','₺','AED'].forEach(c => { %>
            <button type="button" onclick="document.querySelector('[name=currency]').value='<%= c %>'"
              style="background:#f0f0f0;border:1.5px solid #e0e0e0;border-radius:6px;padding:4px 10px;font-size:.8rem;cursor:pointer;font-family:inherit"><%= c %></button>
            <% }) %>
          </div>
        </div>
      </div>
      <div class="form-actions">
        <button class="btn btn-primary" type="submit">Save</button>
      </div>
    </div>
  </form>

  <!-- Change Password -->
  <div class="card">
    <h2>🔐 Change Password</h2>
    <form method="POST" action="/admin/settings/password" style="max-width:400px">
      <div class="form-group" style="margin-bottom:14px">
        <label>Email (Username)</label>
        <input type="email" name="email" value="<%= user.email %>" required />
      </div>
      <div class="form-group" style="margin-bottom:14px">
        <label>Current Password</label>
        <input type="password" name="current_password" required placeholder="Enter current password" />
      </div>
      <div class="form-group" style="margin-bottom:14px">
        <label>New Password</label>
        <input type="password" name="new_password" required placeholder="At least 6 characters" minlength="6" />
      </div>
      <div class="form-group" style="margin-bottom:20px">
        <label>Confirm New Password</label>
        <input type="password" name="confirm_password" required placeholder="Repeat new password" minlength="6" />
      </div>
      <button class="btn btn-primary" type="submit">Update Credentials</button>
    </form>
  </div>

  <!-- Kitchen Display Token -->
  <div class="card">
    <h2>🍳 Kitchen Display Token</h2>
    <p style="font-size:.85rem;color:#888;margin-bottom:16px">Use this token to connect a standalone Kitchen Display at <strong>/kitchen?token=…</strong> — no staff login required.</p>
    <% if (tenant.kitchen_token) { %>
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px;flex-wrap:wrap">
      <code style="background:#0f0f1a;border:1px solid #2a2a3e;border-radius:8px;padding:9px 14px;font-size:.82rem;color:#a78bdf;word-break:break-all;flex:1"><%= tenant.kitchen_token %></code>
      <button type="button" onclick="navigator.clipboard.writeText(document.querySelector('code').textContent).then(()=>showT('Copied!','success'))" class="btn btn-ghost">Copy</button>
      <a href="/kitchen?token=<%= tenant.kitchen_token %>" target="_blank" class="btn btn-ghost">Open KDS ↗</a>
    </div>
    <% } else { %>
    <p style="font-size:.82rem;color:#555;margin-bottom:14px">No token generated yet.</p>
    <% } %>
    <form method="POST" action="/admin/settings/kitchen-token">
      <button type="submit" class="btn btn-primary"><%= tenant.kitchen_token ? '🔄 Regenerate Token' : '+ Generate Token' %></button>
    </form>
    <% if (locals.kitchen_token) { %>
    <div style="margin-top:14px;background:rgba(0,184,148,.12);border:1px solid rgba(0,184,148,.3);border-radius:10px;padding:12px 16px;font-size:.82rem;color:#00b894">
      ✓ New token: <strong><code><%= locals.kitchen_token %></code></strong><br>
      <a href="/kitchen?token=<%= locals.kitchen_token %>" target="_blank" style="color:#00b894">Open Kitchen Display ↗</a>
    </div>
    <% } %>
  </div>
</div>

<div id="toast"></div>
<script>
  function showT(msg, type) {
    const t = document.getElementById('toast');
    t.textContent = (type === 'error' ? '✗ ' : '✓ ') + msg;
    t.className = 'show' + (type !== 'error' ? ' success' : '');
    setTimeout(() => t.className = '', 3500);
  }
  const p = new URLSearchParams(location.search);
  if (p.get('success')) showT(decodeURIComponent(p.get('success')), 'success');
  if (p.get('error'))   showT(decodeURIComponent(p.get('error')), 'error');
</script>
</body>
</html>
