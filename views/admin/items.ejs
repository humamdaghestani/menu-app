<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Items — <%= tenant.name %></title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root { --accent: <%= tenant.theme_color || '#e94560' %>; --sidebar-w: 240px; }
    body { font-family: 'Segoe UI', sans-serif; background: #f4f5f7; color: #222; display: flex; min-height: 100vh; }

    .sidebar { width: var(--sidebar-w); background: #1a1a2e; display: flex; flex-direction: column; position: fixed; top: 0; left: 0; bottom: 0; z-index: 100; padding: 0 0 24px; }
    .sidebar-brand { padding: 24px 20px 20px; border-bottom: 1px solid rgba(255,255,255,.08); display: flex; align-items: center; gap: 12px; }
    .sidebar-brand img { width: 40px; height: 40px; border-radius: 10px; object-fit: cover; background: #fff; flex-shrink: 0; }
    .sidebar-brand .brand-emoji { font-size: 1.6rem; }
    .sidebar-brand-text h2 { color: #fff; font-size: .95rem; font-weight: 700; line-height: 1.2; }
    .sidebar-brand-text span { color: #aaa; font-size: .75rem; }
    .sidebar-nav { flex: 1; padding: 16px 12px; display: flex; flex-direction: column; gap: 4px; }
    .sidebar-nav a, .sidebar-nav button { display: flex; align-items: center; gap: 10px; padding: 11px 14px; border-radius: 10px; color: #aaa; text-decoration: none; font-size: .9rem; background: none; border: none; cursor: pointer; width: 100%; transition: background .15s, color .15s; font-family: inherit; }
    .sidebar-nav a:hover, .sidebar-nav button:hover { background: rgba(255,255,255,.07); color: #fff; }
    .sidebar-nav a.active { background: var(--accent); color: #fff; font-weight: 600; }
    .sidebar-nav .icon { font-size: 1.1rem; width: 20px; text-align: center; }
    .sidebar-footer { padding: 0 12px; }
    .view-menu-btn { display: flex; align-items: center; justify-content: center; gap: 8px; background: rgba(255,255,255,.07); color: #ccc; padding: 10px; border-radius: 10px; text-decoration: none; font-size: .85rem; transition: background .15s; }
    .view-menu-btn:hover { background: rgba(255,255,255,.14); color: #fff; }
    .dark-toggle { background: none; border: none; cursor: pointer; font-size: 1.1rem; padding: 8px; border-radius: 8px; transition: background .15s; color: #aaa; width: 100%; text-align: left; display: flex; align-items: center; gap: 10px; }
    .dark-toggle:hover { background: rgba(255,255,255,.07); color: #fff; }

    .main { margin-left: var(--sidebar-w); flex: 1; padding: 32px; min-height: 100vh; }
    .page-header { margin-bottom: 28px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; }
    .page-header h1 { font-size: 1.4rem; font-weight: 700; color: #1a1a2e; }
    .page-header p { color: #888; font-size: .9rem; margin-top: 4px; }

    .card { background: #fff; border-radius: 14px; padding: 24px; margin-bottom: 24px; box-shadow: 0 2px 8px rgba(0,0,0,.06); }
    .card-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; }
    .card-header h2 { font-size: 1rem; font-weight: 700; color: #1a1a2e; }

    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .form-group { display: flex; flex-direction: column; gap: 6px; }
    .form-group.full { grid-column: 1 / -1; }
    label { font-size: .8rem; font-weight: 600; color: #555; }
    input, select, textarea { padding: 10px 12px; border: 1.5px solid #e8e8e8; border-radius: 8px; font-size: .9rem; outline: none; font-family: inherit; background: #fafafa; transition: border-color .2s, box-shadow .2s; }
    input:focus, select:focus, textarea:focus { border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 15%, transparent); background: #fff; }
    textarea { resize: vertical; min-height: 80px; }
    .form-actions { display: flex; justify-content: flex-end; margin-top: 16px; }

    .btn { padding: 10px 20px; border: none; border-radius: 8px; cursor: pointer; font-size: .88rem; font-weight: 600; font-family: inherit; transition: opacity .15s, transform .1s; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; }
    .btn:active { transform: scale(.97); }
    .btn-primary { background: var(--accent); color: #fff; }
    .btn-primary:hover { opacity: .88; }
    .btn-ghost { background: #f0f0f0; color: #555; }
    .btn-ghost:hover { background: #e4e4e4; }
    .btn-danger { background: #fff0f3; color: #e94560; border: 1px solid #f5c2cb; }
    .btn-danger:hover { background: #fde0e6; }
    .btn-sm { padding: 6px 12px; font-size: .8rem; }
    .btn-dupe { background: #f0f4ff; color: #4c6ef5; border: 1px solid #c5d0fa; }
    .btn-dupe:hover { background: #dce4ff; }
    .btn-star { background: #f5f5f5; color: #bbb; border: 1px solid #e0e0e0; }
    .btn-star.active { background: #fff3d4; color: #d4880a; border-color: #f5d98e; }
    .btn-upload { background: #f0f4ff; color: #4c6ef5; border: 1px solid #c5d0fa; }
    .btn-upload:hover { background: #dce4ff; }

    .items-table { width: 100%; border-collapse: collapse; }
    .items-table th { text-align: left; padding: 10px 14px; font-size: .78rem; font-weight: 700; color: #888; text-transform: uppercase; letter-spacing: .5px; border-bottom: 2px solid #f0f0f0; background: #fafafa; }
    .items-table td { padding: 14px; border-bottom: 1px solid #f5f5f5; vertical-align: middle; }
    .items-table tr:last-child td { border-bottom: none; }
    .items-table tr:hover td { background: #fafcff; }
    .item-img { width: 52px; height: 42px; object-fit: cover; border-radius: 8px; background: #f0f0f0; }
    .item-name { font-weight: 600; font-size: .9rem; }
    .item-desc { color: #aaa; font-size: .78rem; margin-top: 2px; }

    .badge { display: inline-block; padding: 3px 9px; border-radius: 12px; font-size: .72rem; font-weight: 700; text-transform: uppercase; }
    .badge-spicy      { background: #ffe5e5; color: #e00; }
    .badge-popular    { background: #fff3d4; color: #d4880a; }
    .badge-new        { background: #d4f5ec; color: #0a8a63; }
    .badge-vegetarian { background: #d4f0d4; color: #1a7a1a; }
    .badge-none       { background: #f0f0f0; color: #aaa; }

    .toggle { position: relative; display: inline-block; width: 40px; height: 22px; }
    .toggle input { opacity: 0; width: 0; height: 0; }
    .slider { position: absolute; inset: 0; background: #ccc; border-radius: 22px; cursor: pointer; transition: .2s; }
    .slider::before { content: ''; position: absolute; width: 16px; height: 16px; border-radius: 50%; background: #fff; left: 3px; top: 3px; transition: .2s; box-shadow: 0 1px 4px rgba(0,0,0,.2); }
    input:checked + .slider { background: var(--accent); }
    input:checked + .slider::before { transform: translateX(18px); }

    .actions-cell { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; }
    .drag-handle { cursor: grab; color: #ccc; font-size: 1rem; padding: 0 4px; user-select: none; flex-shrink: 0; }
    .drag-handle:hover { color: #888; }
    .sortable-ghost { opacity: .4; background: #f0f4ff !important; }
    .sortable-chosen { box-shadow: 0 4px 16px rgba(0,0,0,.12); }

    .table-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 16px; flex-wrap: wrap; }
    .table-search { position: relative; }
    .table-search svg { position: absolute; left: 10px; top: 50%; transform: translateY(-50%); color: #bbb; pointer-events: none; }
    .table-search input { padding: 8px 12px 8px 32px; border: 1.5px solid #e8e8e8; border-radius: 8px; font-size: .85rem; width: 240px; outline: none; font-family: inherit; background: #fafafa; transition: border-color .2s; }
    .table-search input:focus { border-color: var(--accent); background: #fff; }

    .badge-presets { display: flex; gap: 5px; flex-wrap: wrap; margin-top: 6px; }
    .preset-btn { background: #f0f0f0; border: 1.5px solid #e0e0e0; border-radius: 6px; padding: 4px 9px; font-size: .75rem; cursor: pointer; font-family: inherit; transition: background .15s; }
    .preset-btn:hover { background: #e4e4e4; }
    .preset-btn.clear { color: #aaa; }

    .img-row { display: flex; gap: 8px; align-items: center; }
    .img-row input[type="url"] { flex: 1; min-width: 0; }
    .upload-lbl { cursor: pointer; flex-shrink: 0; }
    .img-preview { width: 80px; height: 60px; border-radius: 8px; object-fit: cover; background: #f0f0f0; border: 1.5px dashed #ddd; display: none; margin-top: 8px; }
    .img-preview.show { display: block; }

    #toast { position: fixed; bottom: 28px; right: 28px; background: #1a1a2e; color: #fff; padding: 12px 20px; border-radius: 10px; font-size: .88rem; font-weight: 500; box-shadow: 0 8px 24px rgba(0,0,0,.2); transform: translateY(80px); opacity: 0; transition: transform .3s, opacity .3s; z-index: 999; max-width: 320px; display: flex; align-items: center; gap: 10px; }
    #toast.show { transform: translateY(0); opacity: 1; }
    #toast.success { border-left: 4px solid #00b894; }
    #toast.error   { border-left: 4px solid #e94560; }

    .overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.5); z-index: 300; align-items: center; justify-content: center; padding: 20px; }
    .overlay.open { display: flex; }
    .modal { background: #fff; border-radius: 16px; padding: 28px; width: 100%; max-width: 540px; animation: popIn .2s ease; max-height: 90vh; overflow-y: auto; }
    @keyframes popIn { from { transform: scale(.93); opacity: 0; } to { transform: scale(1); opacity: 1; } }
    .modal h3 { font-size: 1.1rem; font-weight: 700; margin-bottom: 20px; }
    .modal-footer { display: flex; gap: 10px; justify-content: flex-end; margin-top: 20px; }

    @media (max-width: 768px) {
      .sidebar { width: 64px; }
      .sidebar-brand-text, .sidebar-nav span:not(.icon) { display: none; }
      .main { margin-left: 64px; padding: 20px 16px; }
      .form-grid { grid-template-columns: 1fr; }
      .form-group.full { grid-column: 1; }
    }

    body.dark { background: #0f1117; color: #d0d0d0; }
    body.dark .card { background: #1a1a2e; box-shadow: 0 2px 8px rgba(0,0,0,.4); }
    body.dark .card-header h2, body.dark .page-header h1, body.dark .item-name { color: #e0e0e0; }
    body.dark input, body.dark select, body.dark textarea { background: #111827; border-color: rgba(255,255,255,.12); color: #d0d0d0; }
    body.dark input:focus, body.dark select:focus, body.dark textarea:focus { background: #1a1a2e; }
    body.dark label { color: #999; }
    body.dark .items-table th { background: #0f1117; color: #888; border-bottom-color: rgba(255,255,255,.08); }
    body.dark .items-table td { border-bottom-color: rgba(255,255,255,.05); }
    body.dark .items-table tr:hover td { background: rgba(255,255,255,.03); }
    body.dark .btn-ghost { background: rgba(255,255,255,.08); color: #ccc; }
    body.dark .btn-ghost:hover { background: rgba(255,255,255,.14); }
    body.dark .btn-danger { background: rgba(233,69,96,.15); border-color: rgba(233,69,96,.3); }
    body.dark .modal { background: #1a1a2e; }
    body.dark .modal h3 { color: #e0e0e0; }
    body.dark .overlay { background: rgba(0,0,0,.7); }
    body.dark .badge-none { background: rgba(255,255,255,.08); color: #888; }
    body.dark .table-search input { background: #111827; border-color: rgba(255,255,255,.12); color: #d0d0d0; }
    body.dark .preset-btn { background: rgba(255,255,255,.08); border-color: rgba(255,255,255,.12); color: #ccc; }
    body.dark .img-preview { border-color: rgba(255,255,255,.15); }
  </style>
</head>
<body>

<aside class="sidebar">
  <div class="sidebar-brand">
    <% if (tenant.logo_url) { %>
      <img src="<%= tenant.logo_url %>" alt="<%= tenant.name %>" />
    <% } else { %>
      <span class="brand-emoji">🍽️</span>
    <% } %>
    <div class="sidebar-brand-text">
      <h2><%= tenant.name %></h2>
      <span>Admin Panel</span>
    </div>
  </div>
  <nav class="sidebar-nav">
    <a href="/admin" title="All Modules"><span class="icon">🏠</span><span>All Modules</span></a>
    <div style="height:1px;background:rgba(255,255,255,.06);margin:4px 0 6px"></div>
    <% const _isAdmin = currentUser && currentUser.role === 'admin'; const _perms = (currentUser && currentUser.permissions) || []; const _can = p => _isAdmin || _perms.includes(p); %>
    <% if (_can('items')) { %><a href="/admin/dashboard"><span class="icon">📊</span><span>Dashboard</span></a><% } %>
    <% if (_can('items')) { %><a href="/admin/items" class="active"><span class="icon">🍽️</span><span>Items</span></a><% } %>
    <% if (_can('orders') && tenant.feat_orders !== false) { %><a href="/admin/orders"><span class="icon">📋</span><span>Orders</span></a><% } %>
    <% if (_can('feedback') && tenant.feat_feedback !== false) { %><a href="/admin/feedback"><span class="icon">💬</span><span>Feedback</span></a><% } %>
    <% if (_can('import') && tenant.feat_import !== false) { %><a href="/admin/import"><span class="icon">📥</span><span>Import</span></a><% } %>
    <% if (_isAdmin) { %><a href="/admin/qrcode"><span class="icon">📱</span><span>QR Code</span></a><% } %>
    <% if (tenant.feat_pos) { %><a href="/pos"><span class="icon">🖥️</span><span>POS</span></a><% } %>
    <% if (_isAdmin) { %><a href="/admin/users"><span class="icon">👥</span><span>Users</span></a><% } %>
    <% if (_isAdmin) { %><a href="/admin/settings"><span class="icon">⚙️</span><span>Settings</span></a><% } %>
    <button class="dark-toggle" id="darkToggle" onclick="toggleDark()" style="margin-top:auto">
      <span class="icon" id="darkIcon">🌙</span><span id="darkLabel">Dark Mode</span>
    </button>
    <form method="POST" action="/admin/logout">
      <button type="submit"><span class="icon">🚪</span><span>Logout</span></button>
    </form>
  </nav>
  <div class="sidebar-footer">
    <button onclick="history.back()" class="view-menu-btn" style="border:none;cursor:pointer;font-family:inherit;font-size:.85rem;width:100%;margin-bottom:8px">
      <span>←</span><span>Back</span>
    </button>
    <a href="/?tenant=<%= tenant.subdomain %>" target="_blank" class="view-menu-btn">
      <span>🔗</span><span>View Menu</span>
    </a>
  </div>
</aside>

<div class="main">
  <div class="page-header">
    <div>
      <h1>Menu Items</h1>
      <p><%= items.length %> item<%= items.length !== 1 ? 's' : '' %> in your menu</p>
    </div>
  </div>

  <%
    const rootCatsAdmin = categories.filter(c => !c.parent_id);
    const getSubcatsAdmin = pid => categories.filter(c => String(c.parent_id) === String(pid));
  %>

  <!-- Add Item -->
  <div class="card">
    <div class="card-header"><h2>Add New Item</h2></div>
    <form id="addForm" onsubmit="submitAdd(event)">
      <div class="form-grid">
        <div class="form-group">
          <label>Item Name *</label>
          <input type="text" name="name" placeholder="e.g. Classic Burger" required />
        </div>
        <div class="form-group">
          <label>Price</label>
          <input type="text" name="price" placeholder="e.g. 5000" <% if(!canEditPrices){%>readonly style="background:#f0f0f0;cursor:not-allowed" title="You don't have permission to edit prices"<%}%> />
        </div>
        <div class="form-group">
          <label>Category</label>
          <select name="category_id">
            <option value="">No category</option>
            <% rootCatsAdmin.forEach(cat => { %>
              <% const subs = getSubcatsAdmin(cat.id); %>
              <% if (subs.length > 0) { %>
                <optgroup label="<%= cat.name %>">
                  <option value="<%= cat.id %>"><%= cat.name %> (main)</option>
                  <% subs.forEach(sub => { %><option value="<%= sub.id %>">↳ <%= sub.name %></option><% }) %>
                </optgroup>
              <% } else { %>
                <option value="<%= cat.id %>"><%= cat.name %></option>
              <% } %>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label>Badge <span style="color:#bbb;font-weight:400">(optional)</span></label>
          <input type="text" name="badge" id="addBadge" placeholder="e.g. spicy, popular, new…" maxlength="24" />
          <div class="badge-presets">
            <button type="button" class="preset-btn" onclick="setBadge('addBadge','spicy')">🌶 Spicy</button>
            <button type="button" class="preset-btn" onclick="setBadge('addBadge','popular')">⭐ Popular</button>
            <button type="button" class="preset-btn" onclick="setBadge('addBadge','new')">🆕 New</button>
            <button type="button" class="preset-btn" onclick="setBadge('addBadge','vegetarian')">🌱 Veg</button>
            <button type="button" class="preset-btn clear" onclick="setBadge('addBadge','')">✕ Clear</button>
          </div>
        </div>
        <div class="form-group full">
          <label>Description (English)</label>
          <textarea name="description" placeholder="Describe the item..."></textarea>
        </div>
        <div class="form-group full">
          <label>الوصف (Arabic)</label>
          <textarea name="description_ar" placeholder="وصف الصنف..." dir="rtl"></textarea>
        </div>
        <div class="form-group full">
          <label>وەسف (Kurdish)</label>
          <textarea name="description_ku" placeholder="وەسفی بەرهەم..." dir="rtl"></textarea>
        </div>
        <div class="form-group">
          <label>Name (Arabic / الاسم)</label>
          <input type="text" name="name_ar" placeholder="مثال: برغر كلاسيكي" dir="rtl" />
        </div>
        <div class="form-group">
          <label>Name (Kurdish / ناو)</label>
          <input type="text" name="name_ku" placeholder="نموونە: برگەری کلاسیک" dir="rtl" />
        </div>
        <div class="form-group full">
          <label>Image URL</label>
          <div class="img-row">
            <input type="url" name="image_url" placeholder="https://… or use Upload →" id="addImageUrl" oninput="previewImg(this,'addPreview')" />
            <label class="btn btn-upload btn-sm upload-lbl">
              <span id="addUploadTxt">📷 Upload</span>
              <input type="file" accept="image/*" style="display:none" onchange="uploadImg(this,'addImageUrl','addPreview','addUploadTxt')" />
            </label>
          </div>
          <img id="addPreview" class="img-preview" />
        </div>
      </div>
      <div class="form-actions">
        <button class="btn btn-primary" type="submit" id="addBtn">Add Item</button>
      </div>
    </form>
  </div>

  <!-- Items List -->
  <div class="card">
    <div class="card-header">
      <h2>All Items</h2>
      <span style="color:#aaa;font-size:.85rem"><%= items.length %> items</span>
    </div>
    <% if (items.length === 0) { %>
      <p style="text-align:center;color:#bbb;padding:40px 0">No items yet. Add one above.</p>
    <% } else { %>
    <div class="table-toolbar">
      <div class="table-search">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        <input type="text" id="itemSearch" placeholder="Search items…" oninput="filterItems(this.value)" />
      </div>
      <span style="color:#aaa;font-size:.8rem">⋮⋮ Drag rows to reorder</span>
    </div>
    <div style="overflow-x:auto">
      <table class="items-table">
        <thead>
          <tr>
            <th style="width:32px"></th>
            <th>Image</th>
            <th>Item</th>
            <th>Price</th>
            <th>Category</th>
            <th>Badge</th>
            <th>Available</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="itemsTbody">
          <% items.forEach(item => { %>
          <tr data-id="<%= item.id %>">
            <td><span class="drag-handle">⋮⋮</span></td>
            <td><img class="item-img" src="<%= item.image_url || 'https://placehold.co/52x42?text=?' %>" alt="<%= item.name %>" /></td>
            <td>
              <div class="item-name"><%= item.name %></div>
              <div class="item-desc"><%= (item.description || '').substring(0,60) %><%= item.description && item.description.length > 60 ? '…' : '' %></div>
            </td>
            <td><strong><%= item.price %></strong></td>
            <td><%= item.category_name || '—' %></td>
            <td>
              <% if (item.badge) { %>
                <span class="badge badge-<%= item.badge %>"><%= item.badge %></span>
              <% } else { %>
                <span class="badge badge-none">—</span>
              <% } %>
            </td>
            <td>
              <label class="toggle">
                <input type="checkbox" <%= item.is_available !== false ? 'checked' : '' %> onchange="toggleItem(<%= item.id %>, this)" />
                <span class="slider"></span>
              </label>
            </td>
            <td>
              <div class="actions-cell">
                <button type="button" class="btn btn-star btn-sm <%= item.is_featured ? 'active' : '' %>" onclick="featureItem(<%= item.id %>, this)" title="Feature">⭐</button>
                <button type="button" class="btn btn-ghost btn-sm" onclick='openEdit(<%- JSON.stringify(item) %>)'>Edit</button>
                <button type="button" class="btn btn-dupe btn-sm" onclick="duplicateItem(<%= item.id %>, this)" title="Duplicate">⧉ Copy</button>
                <button type="button" class="btn btn-danger btn-sm" onclick="deleteItem(<%= item.id %>, this)">Delete</button>
              </div>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>
</div>

<!-- Edit Modal -->
<div class="overlay" id="editOverlay">
  <div class="modal">
    <h3>Edit Item</h3>
    <form id="editForm" onsubmit="submitEdit(event)">
      <div class="form-grid">
        <div class="form-group">
          <label>Item Name *</label>
          <input type="text" name="name" id="editName" required />
        </div>
        <div class="form-group">
          <label>Price</label>
          <input type="text" name="price" id="editPrice" <% if(!canEditPrices){%>readonly style="background:#f0f0f0;cursor:not-allowed" title="You don't have permission to edit prices"<%}%> />
        </div>
        <div class="form-group">
          <label>Category</label>
          <select name="category_id" id="editCategory">
            <option value="">No category</option>
            <% rootCatsAdmin.forEach(cat => { %>
              <% const subs = getSubcatsAdmin(cat.id); %>
              <% if (subs.length > 0) { %>
                <optgroup label="<%= cat.name %>">
                  <option value="<%= cat.id %>"><%= cat.name %> (main)</option>
                  <% subs.forEach(sub => { %><option value="<%= sub.id %>">↳ <%= sub.name %></option><% }) %>
                </optgroup>
              <% } else { %>
                <option value="<%= cat.id %>"><%= cat.name %></option>
              <% } %>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label>Badge</label>
          <input type="text" name="badge" id="editBadge" placeholder="e.g. spicy, popular…" maxlength="24" />
          <div class="badge-presets">
            <button type="button" class="preset-btn" onclick="setBadge('editBadge','spicy')">🌶 Spicy</button>
            <button type="button" class="preset-btn" onclick="setBadge('editBadge','popular')">⭐ Popular</button>
            <button type="button" class="preset-btn" onclick="setBadge('editBadge','new')">🆕 New</button>
            <button type="button" class="preset-btn" onclick="setBadge('editBadge','vegetarian')">🌱 Veg</button>
            <button type="button" class="preset-btn clear" onclick="setBadge('editBadge','')">✕ Clear</button>
          </div>
        </div>
        <div class="form-group full">
          <label>Description (English)</label>
          <textarea name="description" id="editDescription"></textarea>
        </div>
        <div class="form-group full">
          <label>الوصف (Arabic)</label>
          <textarea name="description_ar" id="editDescriptionAr" dir="rtl"></textarea>
        </div>
        <div class="form-group full">
          <label>وەسف (Kurdish)</label>
          <textarea name="description_ku" id="editDescriptionKu" dir="rtl"></textarea>
        </div>
        <div class="form-group">
          <label>Name (Arabic / الاسم)</label>
          <input type="text" name="name_ar" id="editNameAr" dir="rtl" />
        </div>
        <div class="form-group">
          <label>Name (Kurdish / ناو)</label>
          <input type="text" name="name_ku" id="editNameKu" dir="rtl" />
        </div>
        <div class="form-group full">
          <label>Image URL</label>
          <div class="img-row">
            <input type="url" name="image_url" id="editImageUrl" placeholder="https://…" oninput="previewImg(this,'editPreview')" />
            <label class="btn btn-upload btn-sm upload-lbl">
              <span id="editUploadTxt">📷 Upload</span>
              <input type="file" accept="image/*" style="display:none" onchange="uploadImg(this,'editImageUrl','editPreview','editUploadTxt')" />
            </label>
          </div>
          <img id="editPreview" class="img-preview" />
        </div>
      </div>
      <div class="form-group full" style="margin-top:4px">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px">
          <label style="margin:0">Options / Add-ons</label>
          <button type="button" class="btn btn-ghost btn-sm" onclick="addOptionGroup()">+ Add Group</button>
        </div>
        <div id="optionGroups" style="display:flex;flex-direction:column;gap:8px"></div>
        <input type="hidden" name="options" id="editOptions" value="[]" />
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-ghost" onclick="closeEdit()">Cancel</button>
        <button type="submit" class="btn btn-primary">Save Changes</button>
      </div>
    </form>
  </div>
</div>

<div id="toast"></div>

<script>
  let _optGroups = [];

  function renderOptionGroups() {
    const container = document.getElementById('optionGroups');
    if (!container) return;
    if (_optGroups.length === 0) { container.innerHTML = '<div style="color:#bbb;font-size:.8rem;padding:4px 0">No options yet. Click "+ Add Group" to add size, extras, etc.</div>'; return; }
    container.innerHTML = _optGroups.map((g, gi) => `
      <div style="border:1.5px solid #e0e0e0;border-radius:8px;padding:12px">
        <div style="display:flex;gap:8px;align-items:center;margin-bottom:8px;flex-wrap:wrap">
          <input type="text" value="${g.name.replace(/"/g,'&quot;')}" placeholder="Group name (e.g. Size)"
            style="flex:1;min-width:100px;padding:6px 10px;border:1.5px solid #ddd;border-radius:6px;font-family:inherit"
            oninput="_optGroups[${gi}].name=this.value;syncOptions()" />
          <label style="display:flex;align-items:center;gap:4px;font-size:.8rem;cursor:pointer;white-space:nowrap">
            <input type="checkbox" ${g.required?'checked':''} onchange="_optGroups[${gi}].required=this.checked;syncOptions()"> Required
          </label>
          <label style="display:flex;align-items:center;gap:4px;font-size:.8rem;cursor:pointer;white-space:nowrap">
            <input type="checkbox" ${g.multi?'checked':''} onchange="_optGroups[${gi}].multi=this.checked;syncOptions()"> Multi-select
          </label>
          <button type="button" onclick="removeOptionGroup(${gi})" style="background:none;border:none;color:#ff6b7a;cursor:pointer;font-size:1.2rem;line-height:1">×</button>
        </div>
        <div style="display:flex;flex-direction:column;gap:5px;margin-bottom:8px">
          ${g.choices.map((c, ci) => `
          <div style="display:flex;gap:6px;align-items:center">
            <input type="text" value="${c.label.replace(/"/g,'&quot;')}" placeholder="Choice (e.g. Large)"
              style="flex:1;padding:5px 8px;border:1.5px solid #ddd;border-radius:6px;font-size:.85rem;font-family:inherit"
              oninput="_optGroups[${gi}].choices[${ci}].label=this.value;syncOptions()" />
            <span style="color:#999;font-size:.8rem;white-space:nowrap">extra price</span>
            <input type="number" value="${c.price}" min="0" step="0.25" placeholder="0"
              style="width:72px;padding:5px 8px;border:1.5px solid #ddd;border-radius:6px;font-size:.85rem;font-family:inherit"
              oninput="_optGroups[${gi}].choices[${ci}].price=parseFloat(this.value)||0;syncOptions()" />
            <button type="button" onclick="removeChoice(${gi},${ci})" style="background:none;border:none;color:#ff6b7a;cursor:pointer;font-size:1.1rem;line-height:1">×</button>
          </div>`).join('')}
        </div>
        <button type="button" onclick="addChoice(${gi})" style="font-size:.78rem;padding:4px 10px;background:rgba(124,92,191,.08);color:#7c5cbf;border:1px solid rgba(124,92,191,.3);border-radius:6px;cursor:pointer">+ Add Choice</button>
      </div>
    `).join('');
  }

  function syncOptions() { document.getElementById('editOptions').value = JSON.stringify(_optGroups); }
  function addOptionGroup() { _optGroups.push({ name: '', required: false, multi: false, choices: [{ label: '', price: 0 }] }); renderOptionGroups(); syncOptions(); }
  function removeOptionGroup(gi) { _optGroups.splice(gi, 1); renderOptionGroups(); syncOptions(); }
  function addChoice(gi) { _optGroups[gi].choices.push({ label: '', price: 0 }); renderOptionGroups(); }
  function removeChoice(gi, ci) { _optGroups[gi].choices.splice(ci, 1); renderOptionGroups(); syncOptions(); }

  let _editItemId = null;

  function openEdit(item) {
    _editItemId = item.id;
    document.getElementById('editName').value          = item.name;
    document.getElementById('editNameAr').value        = item.name_ar || '';
    document.getElementById('editNameKu').value        = item.name_ku || '';
    document.getElementById('editPrice').value         = item.price;
    document.getElementById('editDescription').value   = item.description || '';
    document.getElementById('editDescriptionAr').value = item.description_ar || '';
    document.getElementById('editDescriptionKu').value = item.description_ku || '';
    document.getElementById('editImageUrl').value      = item.image_url || '';
    document.getElementById('editCategory').value      = item.category_id || '';
    document.getElementById('editBadge').value         = item.badge || '';
    _optGroups = item.options ? JSON.parse(JSON.stringify(item.options)) : [];
    renderOptionGroups(); syncOptions();
    previewImg(document.getElementById('editImageUrl'), 'editPreview');
    document.getElementById('editOverlay').classList.add('open');
  }
  function closeEdit() { document.getElementById('editOverlay').classList.remove('open'); }
  document.getElementById('editOverlay').addEventListener('click', e => { if (e.target === document.getElementById('editOverlay')) closeEdit(); });

  function formToParams(form) {
    const p = new URLSearchParams();
    new FormData(form).forEach((v, k) => { if (typeof v === 'string') p.append(k, v); });
    return p;
  }

  async function submitAdd(e) {
    e.preventDefault();
    const form = e.target;
    const btn = document.getElementById('addBtn');
    btn.disabled = true; btn.textContent = 'Adding…';
    try {
      const r = await fetch('/admin/items?json=1', { method: 'POST', body: formToParams(form) });
      const j = await r.json();
      if (j.ok && j.item) {
        const ni = j.item;
        const catSel = form.querySelector('[name=category_id]');
        const catName = catSel.options[catSel.selectedIndex]?.text.replace(/^↳ /,'') || '—';
        const tbody = document.getElementById('itemsTbody');
        const tr = document.createElement('tr');
        tr.dataset.id = ni.id;
        tr.innerHTML = buildRow(ni, catName);
        tbody.appendChild(tr);
        form.reset();
        document.getElementById('addPreview').classList.remove('show');
        showToast('Item added');
        // update count
        const hdr = document.querySelector('.card-header span[style*="aaa"]');
        if (hdr) hdr.textContent = tbody.querySelectorAll('tr').length + ' items';
      } else { showToast('Failed to add item', 'error'); }
    } catch(err) { console.error(err); showToast('Failed to add item', 'error'); }
    btn.disabled = false; btn.textContent = 'Add Item';
  }

  function buildRow(ni, catName) {
    const badge = ni.badge ? `<span class="badge badge-${ni.badge}">${ni.badge}</span>` : `<span class="badge badge-none">—</span>`;
    const img = ni.image_url || 'https://placehold.co/52x42?text=?';
    const desc = (ni.description || '').substring(0, 60);
    const itemJson = JSON.stringify(ni).replace(/'/g, '&#39;');
    return `
      <td><span class="drag-handle">⋮⋮</span></td>
      <td><img class="item-img" src="${img}" alt="${ni.name}" /></td>
      <td><div class="item-name">${ni.name}</div><div class="item-desc">${desc}</div></td>
      <td><strong>${ni.price || 0}</strong></td>
      <td>${catName === 'No category' ? '—' : catName}</td>
      <td>${badge}</td>
      <td><label class="toggle"><input type="checkbox" checked onchange="toggleItem(${ni.id},this)"/><span class="slider"></span></label></td>
      <td><div class="actions-cell">
        <button type="button" class="btn btn-star btn-sm" onclick="featureItem(${ni.id},this)" title="Feature">⭐</button>
        <button type="button" class="btn btn-ghost btn-sm" onclick='openEdit(${itemJson})'>Edit</button>
        <button type="button" class="btn btn-dupe btn-sm" onclick="duplicateItem(${ni.id},this)">⧉ Copy</button>
        <button type="button" class="btn btn-danger btn-sm" onclick="deleteItem(${ni.id},this)">Delete</button>
      </div></td>`;
  }

  async function submitEdit(e) {
    e.preventDefault();
    const form = e.target;
    const btn = form.querySelector('button[type=submit]');
    btn.disabled = true; btn.textContent = 'Saving…';
    const name  = document.getElementById('editName').value;
    const price = document.getElementById('editPrice').value;
    const badge = document.getElementById('editBadge').value;
    const img   = document.getElementById('editImageUrl').value;
    const desc  = document.getElementById('editDescription').value;
    const catSel = document.getElementById('editCategory');
    const catName = catSel.options[catSel.selectedIndex]?.text.replace(/^↳ /,'') || '—';
    try {
      const r = await fetch('/admin/items/' + _editItemId + '/edit?json=1', {
        method: 'POST', body: formToParams(form)
      });
      const j = await r.json();
      if (j.ok) {
        closeEdit();
        const row = document.querySelector(`#itemsTbody tr[data-id="${_editItemId}"]`);
        if (row) {
          row.querySelector('.item-name').textContent = name;
          row.querySelector('.item-desc').textContent = desc.substring(0, 60);
          row.cells[3].innerHTML = `<strong>${price}</strong>`;
          row.cells[4].textContent = catName === 'No category' ? '—' : catName;
          row.cells[5].innerHTML = badge
            ? `<span class="badge badge-${badge}">${badge}</span>`
            : `<span class="badge badge-none">—</span>`;
          row.querySelector('.item-img').src = img || 'https://placehold.co/52x42?text=?';
        }
        showToast('Item updated');
      } else { showToast('Failed to save', 'error'); }
    } catch(err) { console.error(err); showToast('Failed to save', 'error'); }
    btn.disabled = false; btn.textContent = 'Save Changes';
  }

  async function deleteItem(id, btn) {
    if (!confirm('Delete this item?')) return;
    btn.disabled = true;
    try {
      const r = await fetch('/admin/items/' + id + '/delete?json=1', { method: 'POST' });
      const j = await r.json();
      if (j.ok) {
        const row = document.querySelector(`#itemsTbody tr[data-id="${id}"]`);
        if (row) { row.style.transition = 'opacity .2s'; row.style.opacity = '0'; setTimeout(() => row.remove(), 200); }
        showToast('Item deleted');
      } else { showToast('Delete failed', 'error'); btn.disabled = false; }
    } catch { showToast('Delete failed', 'error'); btn.disabled = false; }
  }

  async function toggleItem(id, checkbox) {
    try {
      await fetch('/admin/items/' + id + '/toggle?json=1', { method: 'POST' });
    } catch { checkbox.checked = !checkbox.checked; }
  }

  async function featureItem(id, btn) {
    try {
      const r = await fetch('/admin/items/' + id + '/feature?json=1', { method: 'POST' });
      const j = await r.json();
      if (j.ok) {
        btn.classList.toggle('active', j.is_featured);
        showToast(j.is_featured ? 'Featured' : 'Unfeatured');
      }
    } catch { showToast('Failed', 'error'); }
  }

  async function duplicateItem(id, btn) {
    btn.disabled = true; btn.textContent = '…';
    try {
      const r = await fetch('/admin/items/' + id + '/duplicate?json=1', { method: 'POST' });
      const j = await r.json();
      if (j.ok && j.item) {
        const orig = document.querySelector(`#itemsTbody tr[data-id="${id}"]`);
        const catName = orig?.cells[4]?.textContent || '—';
        const tr = document.createElement('tr');
        tr.dataset.id = j.item.id;
        tr.innerHTML = buildRow(j.item, catName);
        if (orig) orig.insertAdjacentElement('afterend', tr);
        else document.getElementById('itemsTbody').appendChild(tr);
        showToast('Item duplicated');
      } else { showToast('Duplicate failed', 'error'); }
    } catch { showToast('Duplicate failed', 'error'); }
    btn.disabled = false; btn.textContent = '⧉ Copy';
  }

  function previewImg(input, previewId) {
    const preview = document.getElementById(previewId);
    if (input.value) { preview.src = input.value; preview.classList.add('show'); preview.onerror = () => preview.classList.remove('show'); }
    else { preview.classList.remove('show'); }
  }

  function showToast(msg, type = 'success') {
    const t = document.getElementById('toast');
    t.textContent = (type === 'success' ? '✓ ' : '✗ ') + msg;
    t.className = 'show ' + type;
    setTimeout(() => t.className = '', 3000);
  }

  const params = new URLSearchParams(location.search);
  if (params.get('success')) showToast(decodeURIComponent(params.get('success')));
  if (params.get('error'))   showToast(decodeURIComponent(params.get('error')), 'error');

  function toggleDark() {
    const isDark = document.body.classList.toggle('dark');
    localStorage.setItem('adminDark', isDark ? '1' : '');
    document.getElementById('darkIcon').textContent  = isDark ? '☀️' : '🌙';
    document.getElementById('darkLabel').textContent = isDark ? 'Light Mode' : 'Dark Mode';
  }
  if (localStorage.getItem('adminDark') === '1') {
    document.body.classList.add('dark');
    document.getElementById('darkIcon').textContent  = '☀️';
    document.getElementById('darkLabel').textContent = 'Light Mode';
  }

  function compressImage(file, maxW, quality) {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onerror = reject;
      reader.onload = e => {
        const img = new Image();
        img.onerror = reject;
        img.onload = () => {
          let w = img.width, h = img.height;
          if (w > maxW) { h = Math.round(h * maxW / w); w = maxW; }
          const canvas = document.createElement('canvas');
          canvas.width = w; canvas.height = h;
          canvas.getContext('2d').drawImage(img, 0, 0, w, h);
          resolve(canvas.toDataURL('image/jpeg', quality));
        };
        img.src = e.target.result;
      };
      reader.readAsDataURL(file);
    });
  }

  async function uploadImg(fileInput, urlId, previewId, textId) {
    const file = fileInput.files[0];
    if (!file) return;
    const textEl = document.getElementById(textId);
    const orig = textEl.textContent;
    textEl.textContent = '⏳ Uploading…';
    fileInput.disabled = true;
    try {
      const fd = new FormData();
      fd.append('file', file);
      const r = await fetch('/admin/upload', { method: 'POST', body: fd });
      const data = await r.json();
      if (data.ok) {
        document.getElementById(urlId).value = data.url;
        previewImg(document.getElementById(urlId), previewId);
        showToast('Image uploaded — save the form to apply');
      } else { showToast('Upload failed: ' + (data.error || 'unknown error'), 'error'); }
    } catch { showToast('Upload failed', 'error'); }
    textEl.textContent = orig;
    fileInput.disabled = false;
    fileInput.value = '';
  }

  function setBadge(inputId, value) { document.getElementById(inputId).value = value; }

  function filterItems(query) {
    const q = query.toLowerCase();
    document.querySelectorAll('#itemsTbody tr').forEach(row => {
      const text = row.querySelector('.item-name')?.textContent.toLowerCase() || '';
      const cat  = row.cells[4]?.textContent.toLowerCase() || '';
      row.style.display = (!q || text.includes(q) || cat.includes(q)) ? '' : 'none';
    });
  }
</script>
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
<script>
  const itemsTbody = document.getElementById('itemsTbody');
  if (itemsTbody) {
    Sortable.create(itemsTbody, {
      handle: '.drag-handle', animation: 150,
      ghostClass: 'sortable-ghost', chosenClass: 'sortable-chosen',
      onEnd() {
        const order = [...itemsTbody.querySelectorAll('tr')].map(r => r.dataset.id);
        fetch('/admin/items/reorder', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ order }) })
          .then(r => r.json()).then(d => { if (d.ok) showToast('Order saved'); });
      }
    });
  }
</script>
</body>
</html>
