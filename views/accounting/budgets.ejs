<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Budgets — <%= tenant.name %></title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Segoe UI', sans-serif; background: #0f0f1a; color: #e0e0e0; min-height: 100vh; }
    .topbar { background: #1a1a2e; height: 60px; display: flex; align-items: center; justify-content: space-between; padding: 0 20px; border-bottom: 1px solid rgba(255,255,255,.07); position: sticky; top: 0; z-index: 100; }
    .topbar-brand { font-weight: 700; color: #fff; font-size: 1rem; }
    .topbar-sub { font-size: .72rem; color: #555; }
    .btn { padding: 7px 14px; border: none; border-radius: 8px; cursor: pointer; font-size: .82rem; font-weight: 600; font-family: inherit; text-decoration: none; display: inline-flex; align-items: center; gap: 5px; }
    .btn-ghost { background: rgba(255,255,255,.08); color: #ccc; }
    .btn-ghost:hover { background: rgba(255,255,255,.14); color: #fff; }
    .btn-primary { background: #7c5cbf; color: #fff; }
    .btn-danger { background: rgba(231,76,60,.15); color: #e74c3c; }
    .main { padding: 28px; max-width: 1000px; margin: 0 auto; }
    .section { background: #1a1a2e; border: 1.5px solid #2a2a3e; border-radius: 12px; padding: 20px; margin-bottom: 20px; }
    .section h3 { color: #fff; font-size: .92rem; font-weight: 700; margin-bottom: 16px; }
    .budget-card { background: #0f0f1a; border: 1.5px solid #2a2a3e; border-radius: 10px; padding: 16px 18px; margin-bottom: 10px; display: flex; align-items: center; justify-content: space-between; gap: 16px; text-decoration: none; }
    .budget-card:hover { border-color: #7c5cbf; }
    .form-group { margin-bottom: 12px; }
    .form-group label { display: block; font-size: .78rem; color: #aaa; margin-bottom: 4px; }
    .form-group input, .form-group select { width: 100%; background: #0f0f1a; border: 1.5px solid #2a2a3e; color: #fff; padding: 8px 10px; border-radius: 8px; font-size: .85rem; font-family: inherit; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  </style>
</head>
<body>
<div class="topbar">
  <div style="display:flex;align-items:center;gap:8px">
    <a href="/accounting" class="btn btn-ghost" style="padding:6px 10px;font-size:1.1rem;flex-shrink:0" title="All Modules">🏠</a>
    <div>
      <div class="topbar-brand">📊 Budgets</div>
      <div class="topbar-sub"><%= tenant.name %></div>
    </div>
  </div>
  <div style="display:flex;gap:8px">
    <a href="/accounting" class="btn btn-ghost">📒 Accounting</a>
    <a href="/accounting/tax" class="btn btn-ghost">🧾 Tax Rates</a>
    <button onclick="history.back()" class="btn btn-ghost">← Back</button>
  </div>
</div>

<div class="main">
  <div style="display:grid;grid-template-columns:1fr 300px;gap:20px">
    <div class="section">
      <h3>📊 Budget Plans</h3>
      <% budgets.forEach(b => { %>
      <a href="/accounting/budgets/<%= b.id %>" class="budget-card" style="color:inherit">
        <div>
          <div style="color:#fff;font-weight:700;font-size:.95rem"><%= b.name %></div>
          <div style="font-size:.78rem;color:#555;margin-top:3px">
            <%= b.period_type %> &bull;
            <%= b.start_date.toISOString().slice(0,10) %> → <%= b.end_date.toISOString().slice(0,10) %>
          </div>
        </div>
        <div style="text-align:right">
          <div style="color:#7c5cbf;font-weight:700">$<%= parseFloat(b.total_planned).toFixed(2) %></div>
          <div style="font-size:.72rem;color:#555">planned</div>
        </div>
        <form method="POST" action="/accounting/budgets/<%= b.id %>/delete" onsubmit="return event.stopPropagation() || confirm('Delete budget?')">
          <button class="btn btn-danger" style="font-size:.72rem;padding:3px 8px">✕</button>
        </form>
      </a>
      <% }) %>
      <% if (!budgets.length) { %><div style="color:#555;text-align:center;padding:40px">No budgets yet</div><% } %>
    </div>

    <div class="section">
      <h3>➕ New Budget</h3>
      <form method="POST" action="/accounting/budgets">
        <div class="form-group"><label>Budget Name *</label><input type="text" name="name" required placeholder="Monthly Operations..." /></div>
        <div class="form-group"><label>Period Type</label>
          <select name="period_type"><option value="monthly">Monthly</option><option value="quarterly">Quarterly</option><option value="annual">Annual</option><option value="custom">Custom</option></select>
        </div>
        <div class="form-row">
          <div class="form-group"><label>Start Date *</label><input type="date" name="start_date" required /></div>
          <div class="form-group"><label>End Date *</label><input type="date" name="end_date" required /></div>
        </div>
        <div class="form-group"><label>Notes</label><input type="text" name="notes" /></div>
        <button type="submit" class="btn btn-primary" style="width:100%">Create Budget</button>
      </form>
    </div>
  </div>
</div>
</body>
</html>
