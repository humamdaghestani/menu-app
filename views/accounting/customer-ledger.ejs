<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= customer.name %> — Customer Ledger</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Segoe UI', sans-serif; background: #0f0f1a; color: #e0e0e0; min-height: 100vh; }
    .topbar { background: #1a1a2e; height: 56px; display: flex; align-items: center; justify-content: space-between; padding: 0 24px; border-bottom: 1px solid rgba(255,255,255,.07); gap: 12px; position: sticky; top: 0; z-index: 100; }
    .btn { padding: 7px 14px; border: none; border-radius: 8px; cursor: pointer; font-size: .82rem; font-weight: 600; font-family: inherit; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; }
    .btn-ghost   { background: rgba(255,255,255,.08); color: #ccc; }
    .btn-ghost:hover { background: rgba(255,255,255,.14); color: #fff; }
    .btn-print   { background: rgba(116,185,255,.12); color: #74b9ff; }
    .main { padding: 24px; max-width: 960px; margin: 0 auto; }
    .info-strip { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; margin-bottom: 20px; }
    .info-card { background: #1a1a2e; border-radius: 12px; border: 1px solid #2a2a3e; padding: 14px 18px; }
    .info-label { font-size: .68rem; text-transform: uppercase; color: #555; font-weight: 700; margin-bottom: 4px; }
    .info-val { font-size: 1.05rem; font-weight: 700; color: #fff; }
    .card { background: #1a1a2e; border-radius: 14px; border: 1px solid #2a2a3e; padding: 20px; margin-bottom: 16px; }
    .card-title { font-size: .92rem; font-weight: 700; color: #fff; margin-bottom: 14px; }
    table { width: 100%; border-collapse: collapse; font-size: .84rem; }
    th { text-align: left; font-size: .68rem; text-transform: uppercase; color: #444; font-weight: 700; padding: 7px 10px; border-bottom: 1px solid #2a2a3e; }
    td { padding: 10px; border-bottom: 1px solid rgba(255,255,255,.03); }
    tr:last-child td { border-bottom: none; }
    .pill { display: inline-block; padding: 2px 9px; border-radius: 20px; font-size: .7rem; font-weight: 700; }
    .pill-sale   { background: #6c5ce722; color: #a29bfe; }
    .pill-credit { background: #e74c3c22; color: #e74c3c; }
    .pill-pay    { background: #00b89422; color: #00b894; }
    .bal-pos  { color: #e74c3c; font-weight: 700; }
    .bal-zero { color: #00b894; font-weight: 700; }
    @media print {
      .topbar { display: none; }
      body { background: #fff; color: #000; }
      .card { border: 1px solid #ddd; background: #fff; }
    }
  </style>
</head>
<body>
<div class="topbar">
  <div style="display:flex;align-items:center;gap:8px">
    <a href="/accounting" class="btn btn-ghost" style="padding:6px 10px;font-size:1.1rem" title="All Modules">🏠</a>
    <span style="font-weight:700;color:#fff"><%= customer.name %> — Customer Statement</span>
  </div>
  <div style="display:flex;gap:8px">
    <a href="/accounting/customers" class="btn btn-ghost">← Credits</a>
    <button onclick="window.print()" class="btn btn-print">🖨 Print</button>
  </div>
</div>

<div class="main">
  <%
    const totDebit  = ledger.reduce((s,r) => s + parseFloat(r.debit  || 0), 0);
    const totCredit = ledger.reduce((s,r) => s + parseFloat(r.credit || 0), 0);
  %>
  <div class="info-strip">
    <div class="info-card">
      <div class="info-label">Customer</div>
      <div class="info-val"><%= customer.name %></div>
      <% if (customer.phone) { %><div style="color:#666;font-size:.78rem;margin-top:3px">📞 <%= customer.phone %></div><% } %>
    </div>
    <div class="info-card">
      <div class="info-label">POS Sales</div>
      <div class="info-val" style="color:#a29bfe">$<%= totalSales.toFixed(2) %></div>
      <div style="color:#666;font-size:.75rem;margin-top:2px"><%= visitCount %> visit<%= visitCount !== 1 ? 's' : '' %></div>
    </div>
    <div class="info-card">
      <div class="info-label">Credits Issued</div>
      <div class="info-val" style="color:#e74c3c">$<%= totDebit.toFixed(2) %></div>
    </div>
    <div class="info-card">
      <div class="info-label">Payments Received</div>
      <div class="info-val" style="color:#00b894">$<%= totCredit.toFixed(2) %></div>
    </div>
    <div class="info-card">
      <div class="info-label">Balance</div>
      <div class="info-val <%= closingBalance > 0 ? 'bal-pos' : 'bal-zero' %>">$<%= closingBalance.toFixed(2) %></div>
    </div>
  </div>

  <div class="card">
    <div class="card-title">📋 Transaction History</div>
    <table>
      <thead>
        <tr>
          <th>Date</th>
          <th>Type</th>
          <th>Reference</th>
          <th style="text-align:right">Debit</th>
          <th style="text-align:right">Credit</th>
          <th style="text-align:right">Balance</th>
        </tr>
      </thead>
      <tbody>
      <% ledger.forEach(row => { %>
      <tr>
        <td style="color:#888;font-size:.78rem;white-space:nowrap"><%= String(row.txn_date).slice(0,10) %></td>
        <td>
          <% if (row.type === 'POS Sale') { %><span class="pill pill-sale">🛒 POS Sale</span>
          <% } else if (row.type === 'Credit Issued') { %><span class="pill pill-credit">📋 Credit</span>
          <% } else { %><span class="pill pill-pay">💳 Payment</span>
          <% } %>
        </td>
        <td style="color:#aaa;font-size:.8rem"><%= row.reference || '—' %></td>
        <td style="text-align:right;color:#e74c3c;font-weight:600">
          <%= parseFloat(row.debit) > 0 ? '$' + parseFloat(row.debit).toFixed(2) : '' %>
        </td>
        <td style="text-align:right;color:#00b894;font-weight:600">
          <%= parseFloat(row.credit) > 0 ? '$' + parseFloat(row.credit).toFixed(2) : '' %>
        </td>
        <td style="text-align:right" class="<%= parseFloat(row.running_balance) > 0 ? 'bal-pos' : 'bal-zero' %>">
          $<%= parseFloat(row.running_balance).toFixed(2) %>
        </td>
      </tr>
      <% }) %>
      <% if (!ledger.length) { %>
      <tr><td colspan="6" style="color:#555;text-align:center;padding:20px">No transactions recorded</td></tr>
      <% } %>
      </tbody>
      <tfoot>
        <tr style="border-top:1px solid #2a2a3e">
          <td colspan="3" style="text-align:right;font-size:.78rem;color:#555;padding:10px">TOTAL</td>
          <td style="text-align:right;color:#e74c3c;font-weight:700;padding:10px">$<%= totDebit.toFixed(2) %></td>
          <td style="text-align:right;color:#00b894;font-weight:700;padding:10px">$<%= totCredit.toFixed(2) %></td>
          <td style="text-align:right;padding:10px" class="<%= closingBalance > 0 ? 'bal-pos' : 'bal-zero' %>">$<%= closingBalance.toFixed(2) %></td>
        </tr>
      </tfoot>
    </table>
  </div>
</div>
</body>
</html>
