<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Expenses â€” <%= tenant.name %></title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Segoe UI', sans-serif; background: #0f0f1a; color: #e0e0e0; min-height: 100vh; }
    .topbar { background: #1a1a2e; height: 56px; display: flex; align-items: center; justify-content: space-between; padding: 0 24px; border-bottom: 1px solid rgba(255,255,255,.07); gap: 12px; }
    .btn { padding: 7px 14px; border: none; border-radius: 8px; cursor: pointer; font-size: .82rem; font-weight: 600; font-family: inherit; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; }
    .btn-ghost   { background: rgba(255,255,255,.08); color: #ccc; }
    .btn-ghost:hover { background: rgba(255,255,255,.14); color: #fff; }
    .btn-primary { background: #7c5cbf; color: #fff; }
    .btn-primary:hover { opacity: .88; }
    .btn-danger  { background: rgba(231,76,60,.15); color: #e74c3c; border: 1px solid rgba(231,76,60,.3); }
    .btn-danger:hover { background: rgba(231,76,60,.25); }
    .btn-sm { padding: 4px 10px; font-size: .75rem; }

    .main { padding: 24px; max-width: 1000px; margin: 0 auto; }
    .card { background: #1a1a2e; border-radius: 14px; border: 1px solid #2a2a3e; padding: 20px; margin-bottom: 20px; }
    .card-title { font-size: .9rem; font-weight: 700; color: #fff; margin-bottom: 16px; display: flex; justify-content: space-between; align-items: center; }

    .form-row { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr auto; gap: 10px; align-items: end; }
    @media (max-width:700px) { .form-row { grid-template-columns: 1fr 1fr; } }
    .form-group { display: flex; flex-direction: column; gap: 5px; }
    .form-label { font-size: .68rem; font-weight: 700; color: #555; text-transform: uppercase; }
    .form-input { padding: 8px 12px; background: #0f0f1a; border: 1.5px solid #2a2a3e; border-radius: 8px; color: #fff; font-size: .88rem; font-family: inherit; outline: none; width: 100%; }
    .form-input:focus { border-color: #7c5cbf; }
    select.form-input option { background: #1a1a2e; }

    /* Date filter */
    .date-bar { display: flex; align-items: center; gap: 10px; margin-bottom: 20px; flex-wrap: wrap; }
    .date-bar input[type=date] { padding: 7px 10px; background: #1a1a2e; border: 1.5px solid #2a2a3e; border-radius: 8px; color: #fff; font-family: inherit; font-size: .85rem; outline: none; }
    .date-bar input[type=date]:focus { border-color: #7c5cbf; }

    /* Table */
    .exp-table { width: 100%; border-collapse: collapse; }
    .exp-table th { text-align: left; font-size: .68rem; text-transform: uppercase; color: #444; font-weight: 700; padding: 8px; border-bottom: 1px solid #2a2a3e; white-space: nowrap; }
    .exp-table td { padding: 10px 8px; border-bottom: 1px solid rgba(255,255,255,.03); font-size: .85rem; color: #ccc; vertical-align: middle; }
    .exp-table tr:last-child td { border-bottom: none; }
    .exp-table tr:hover td { background: rgba(255,255,255,.02); }

    /* Category manager */
    .overlay { position: fixed; inset: 0; background: rgba(0,0,0,.6); display: none; align-items: center; justify-content: center; z-index: 200; padding: 16px; }
    .overlay.open { display: flex; }
    .modal { background: #1a1a2e; border-radius: 16px; border: 1px solid #2a2a3e; width: 100%; max-width: 420px; padding: 24px; max-height: 90vh; overflow-y: auto; }
    .modal-title { font-size: 1rem; font-weight: 700; color: #fff; margin-bottom: 18px; }

    /* Edit modal */
    .edit-modal { max-width: 500px; }
    .edit-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px; }
    .edit-row.full { grid-template-columns: 1fr; }
  </style>
</head>
<body>

<div class="topbar">
  <div style="display:flex;align-items:center;gap:8px">
    <a href="C:\Users\ASUS" class="btn btn-ghost" style="padding:6px 10px;font-size:1.1rem;flex-shrink:0" title="All Modules">ðŸ </a>
    <span style="font-weight:700;color:#fff">ðŸ’¸ Expenses</span>
  </div>
  <div style="display:flex;gap:8px">
    <button class="btn btn-ghost" onclick="document.getElementById('catOverlay').classList.add('open')">ðŸ·ï¸ Categories</button>
    <button onclick="history.back()" class="btn btn-ghost">â† Back</button>
  </div>
</div>

<div class="main">

  <!-- Add expense -->
  <div class="card">
    <div class="card-title">Add Expense</div>
    <form method="POST" action="/accounting/expenses">
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Description *</label>
          <input type="text" name="description" class="form-input" placeholder="e.g. Monthly rent" required />
        </div>
        <div class="form-group">
          <label class="form-label">Amount *</label>
          <input type="number" name="amount" class="form-input" placeholder="0" min="0" step="0.01" required />
        </div>
        <div class="form-group">
          <label class="form-label">Date</label>
          <input type="date" name="expense_date" class="form-input" value="<%= new Date().toISOString().slice(0,10) %>" />
        </div>
        <div class="form-group">
          <label class="form-label">Category</label>
          <select name="category_id" class="form-input">
            <option value="">No category</option>
            <% categories.forEach(c => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %>
          </select>
        </div>
        <button type="submit" class="btn btn-primary" style="height:38px;white-space:nowrap">+ Add</button>
      </div>
      <div class="form-group" style="margin-top:10px">
        <label class="form-label">Notes (optional)</label>
        <input type="text" name="notes" class="form-input" placeholder="Any extra details..." />
      </div>
    </form>
  </div>

  <!-- Date filter + list -->
  <div class="card">
    <div class="card-title">
      <span>Expense List</span>
      <span style="color:#e74c3c;font-weight:800;font-size:1rem">
        Total: <%= total.toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2}) %> <%= tenant.currency || 'IQD' %>
      </span>
    </div>

    <form method="GET" action="/accounting/expenses" id="filterForm">
      <div class="date-bar">
        <span style="color:#555;font-size:.82rem">Period:</span>
        <input type="date" name="from" value="<%= dateFrom %>" onchange="this.form.submit()" />
        <span style="color:#444">â†’</span>
        <input type="date" name="to" value="<%= dateTo %>" onchange="this.form.submit()" />
      </div>
    </form>

    <% if (expenses.length === 0) { %>
      <p style="color:#444;text-align:center;padding:40px 0">No expenses in this period.</p>
    <% } else { %>
    <div style="overflow-x:auto">
    <table class="exp-table">
      <thead>
        <tr>
          <th>Date</th>
          <th>Description</th>
          <th>Category</th>
          <th>Notes</th>
          <th style="text-align:right">Amount</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
      <% expenses.forEach(e => { %>
      <tr>
        <td style="white-space:nowrap;color:#555"><%= e.expense_date.toISOString ? e.expense_date.toISOString().slice(0,10) : String(e.expense_date).slice(0,10) %></td>
        <td style="color:#ddd;font-weight:500"><%= e.description %></td>
        <td>
          <% if (e.cat_name) { %>
            <span style="font-size:.72rem;font-weight:700;padding:2px 8px;border-radius:8px;background:<%= e.cat_color %>22;color:<%= e.cat_color %>"><%= e.cat_name %></span>
          <% } else { %><span style="color:#333">â€”</span><% } %>
        </td>
        <td style="color:#444;font-size:.8rem"><%= e.notes || 'â€”' %></td>
        <td style="text-align:right;color:#e74c3c;font-weight:700;white-space:nowrap">
          <%= parseFloat(e.amount).toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2}) %>
        </td>
        <td style="white-space:nowrap">
          <div style="display:flex;gap:5px">
            <button type="button" class="btn btn-ghost btn-sm" onclick='openEdit(<%- JSON.stringify(e) %>)'>Edit</button>
            <form method="POST" action="/accounting/expenses/<%= e.id %>/delete" onsubmit="return confirm('Delete this expense?')" style="display:inline">
              <button type="submit" class="btn btn-danger btn-sm">âœ•</button>
            </form>
          </div>
        </td>
      </tr>
      <% }) %>
      </tbody>
    </table>
    </div>
    <% } %>
  </div>
</div>

<!-- Category Manager Modal -->
<div class="overlay" id="catOverlay" onclick="if(event.target===this)this.classList.remove('open')">
  <div class="modal">
    <div class="modal-title">ðŸ·ï¸ Expense Categories</div>
    <form method="POST" action="/accounting/categories" style="margin-bottom:20px">
      <div style="display:grid;grid-template-columns:1fr auto auto;gap:8px;align-items:end">
        <div class="form-group" style="margin-bottom:0">
          <label class="form-label">Name</label>
          <input type="text" name="name" class="form-input" placeholder="e.g. Rent" required />
        </div>
        <div class="form-group" style="margin-bottom:0">
          <label class="form-label">Color</label>
          <input type="color" name="color" value="#e74c3c" style="width:44px;height:38px;padding:2px;border-radius:8px;border:1.5px solid #2a2a3e;background:#0f0f1a;cursor:pointer" />
        </div>
        <button type="submit" class="btn btn-primary" style="height:38px">+ Add</button>
      </div>
    </form>
    <% if (categories.length === 0) { %>
      <p style="color:#444;font-size:.85rem;text-align:center;padding:16px 0">No categories yet.</p>
    <% } else { %>
      <div style="display:flex;flex-direction:column;gap:8px">
        <% categories.forEach(c => { %>
        <div style="display:flex;align-items:center;gap:10px;padding:9px 12px;background:#0f0f1a;border-radius:9px;border:1px solid #2a2a3e">
          <span style="width:12px;height:12px;border-radius:50%;background:<%= c.color %>;flex-shrink:0"></span>
          <span style="flex:1;color:#ddd;font-size:.88rem;font-weight:600"><%= c.name %></span>
          <form method="POST" action="/accounting/categories/<%= c.id %>/delete" onsubmit="return confirm('Delete category?')">
            <button type="submit" class="btn btn-danger btn-sm">âœ•</button>
          </form>
        </div>
        <% }) %>
      </div>
    <% } %>
    <div style="margin-top:16px;text-align:right">
      <button type="button" class="btn btn-ghost" onclick="document.getElementById('catOverlay').classList.remove('open')">Close</button>
    </div>
  </div>
</div>

<!-- Edit Expense Modal -->
<div class="overlay" id="editOverlay" onclick="if(event.target===this)this.classList.remove('open')">
  <div class="modal edit-modal">
    <div class="modal-title">âœï¸ Edit Expense</div>
    <form method="POST" id="editForm">
      <div class="edit-row">
        <div class="form-group">
          <label class="form-label">Description *</label>
          <input type="text" name="description" id="eDesc" class="form-input" required />
        </div>
        <div class="form-group">
          <label class="form-label">Amount *</label>
          <input type="number" name="amount" id="eAmount" class="form-input" min="0" step="0.01" required />
        </div>
      </div>
      <div class="edit-row">
        <div class="form-group">
          <label class="form-label">Date</label>
          <input type="date" name="expense_date" id="eDate" class="form-input" />
        </div>
        <div class="form-group">
          <label class="form-label">Category</label>
          <select name="category_id" id="eCat" class="form-input">
            <option value="">No category</option>
            <% categories.forEach(c => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %>
          </select>
        </div>
      </div>
      <div class="form-group edit-row full" style="margin-bottom:18px">
        <label class="form-label">Notes</label>
        <input type="text" name="notes" id="eNotes" class="form-input" placeholder="optional..." />
      </div>
      <div style="display:flex;gap:10px;justify-content:flex-end">
        <button type="button" class="btn btn-ghost" onclick="document.getElementById('editOverlay').classList.remove('open')">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
      </div>
    </form>
  </div>
</div>

<script>
function openEdit(e) {
  document.getElementById('eDesc').value   = e.description;
  document.getElementById('eAmount').value = e.amount;
  document.getElementById('eDate').value   = e.expense_date
    ? (e.expense_date.slice ? e.expense_date.slice(0,10) : new Date(e.expense_date).toISOString().slice(0,10))
    : '';
  document.getElementById('eCat').value    = e.category_id || '';
  document.getElementById('eNotes').value  = e.notes || '';
  document.getElementById('editForm').action = '/accounting/expenses/' + e.id + '/edit';
  document.getElementById('editOverlay').classList.add('open');
}
</script>
</body>
</html>
