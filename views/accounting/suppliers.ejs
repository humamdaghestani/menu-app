<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Supplier Ledger — <%= tenant.name %></title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Segoe UI', sans-serif; background: #0f0f1a; color: #e0e0e0; min-height: 100vh; }
    .topbar { background: #1a1a2e; height: 56px; display: flex; align-items: center; justify-content: space-between; padding: 0 24px; border-bottom: 1px solid rgba(255,255,255,.07); gap: 12px; }
    .topbar-brand { font-weight: 700; color: #fff; font-size: 1rem; }
    .btn { padding: 7px 14px; border: none; border-radius: 8px; cursor: pointer; font-size: .82rem; font-weight: 600; font-family: inherit; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; }
    .btn-ghost   { background: rgba(255,255,255,.08); color: #ccc; }
    .btn-ghost:hover { background: rgba(255,255,255,.14); color: #fff; }
    .btn-primary { background: #7c5cbf; color: #fff; }
    .btn-primary:hover { opacity: .88; }
    .btn-red { background: #e74c3c22; color: #e74c3c; }
    .btn-red:hover { background: #e74c3c; color: #fff; }

    .main { padding: 24px; max-width: 1100px; margin: 0 auto; }
    .two-col { display: grid; grid-template-columns: 1.2fr 1fr; gap: 16px; }
    @media (max-width: 740px) { .two-col { grid-template-columns: 1fr; } }
    .card { background: #1a1a2e; border-radius: 14px; border: 1px solid #2a2a3e; padding: 20px; margin-bottom: 16px; }
    .card-title { font-size: .92rem; font-weight: 700; color: #fff; margin-bottom: 16px; }

    /* ledger table */
    .ledger-table { width: 100%; border-collapse: collapse; font-size: .84rem; }
    .ledger-table th { text-align: left; font-size: .68rem; text-transform: uppercase; color: #444; font-weight: 700; padding: 7px 10px; border-bottom: 1px solid #2a2a3e; }
    .ledger-table td { padding: 11px 10px; border-bottom: 1px solid rgba(255,255,255,.03); vertical-align: middle; }
    .ledger-table tr:last-child td { border-bottom: none; }
    .ledger-table tr:hover td { background: rgba(255,255,255,.02); }

    .balance-badge { display: inline-block; padding: 3px 10px; border-radius: 20px; font-size: .72rem; font-weight: 700; }
    .balance-pos { background: #e74c3c22; color: #e74c3c; }
    .balance-zero { background: #00b89422; color: #00b894; }

    /* pay form */
    .pay-form { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    @media (max-width: 520px) { .pay-form { grid-template-columns: 1fr; } }
    .form-group { display: flex; flex-direction: column; gap: 6px; }
    .form-group label { font-size: .72rem; font-weight: 700; color: #555; text-transform: uppercase; letter-spacing: .4px; }
    .form-group input, .form-group select, .form-group textarea {
      padding: 9px 12px; background: #0f0f1a; border: 1.5px solid #2a2a3e; border-radius: 8px;
      color: #fff; font-family: inherit; font-size: .85rem; outline: none;
    }
    .form-group input:focus, .form-group select:focus { border-color: #7c5cbf; }
    .form-group.full { grid-column: 1 / -1; }

    /* autocomplete */
    .ac-wrap { position: relative; }
    .ac-drop { position: absolute; top: 100%; left: 0; right: 0; z-index: 999; background: #1a1a2e; border: 1.5px solid #2a2a3e; border-radius: 8px; max-height: 180px; overflow-y: auto; margin-top: 3px; display: none; }
    .ac-opt { padding: 9px 12px; cursor: pointer; font-size: .85rem; color: #ccc; }
    .ac-opt:hover, .ac-opt.focused { background: rgba(124,92,191,.25); color: #fff; }

    /* payments list */
    .pay-list { list-style: none; }
    .pay-item { display: flex; justify-content: space-between; align-items: center; padding: 9px 0; border-bottom: 1px solid rgba(255,255,255,.04); gap: 8px; }
    .pay-item:last-child { border-bottom: none; }
    .pay-meta { font-size: .78rem; color: #444; margin-top: 2px; }
  </style>
</head>
<body>

<div class="topbar">
  <div style="display:flex;align-items:center;gap:8px">
    <a href="/admin" class="btn btn-ghost" style="padding:6px 10px;font-size:1.1rem;flex-shrink:0" title="All Modules">🏠</a>
    <div class="topbar-brand">🏭 Supplier Ledger</div>
  </div>
  <div style="display:flex;gap:8px">
    <a href="/accounting" class="btn btn-ghost">← Accounting</a>
    <button onclick="history.back()" class="btn btn-ghost">← Back</button>
  </div>
</div>

<div class="main">
  <div class="two-col">

    <!-- LEFT: supplier balances + payment form -->
    <div>
      <!-- Supplier Balances -->
      <div class="card">
        <div class="card-title">Supplier Balances</div>
        <% if (ledger.length === 0) { %>
          <p style="color:#444;text-align:center;padding:30px 0;font-size:.85rem">No purchase receipts recorded yet.</p>
        <% } else { %>
        <div style="overflow-x:auto">
        <table class="ledger-table">
          <thead>
            <tr>
              <th>Supplier</th>
              <th style="text-align:right">Purchased</th>
              <th style="text-align:right">Paid</th>
              <th style="text-align:right">Balance</th>
            </tr>
          </thead>
          <tbody>
          <% let grandBalance = 0; ledger.forEach(row => { grandBalance += row.balance; %>
          <tr>
            <td style="color:#ddd;font-weight:600"><%= row.supplier_name %></td>
            <td style="text-align:right;color:#f39c12"><%= row.total_purchased.toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2}) %></td>
            <td style="text-align:right;color:#00b894"><%= row.total_paid.toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2}) %></td>
            <td style="text-align:right">
              <span class="balance-badge <%= row.balance > 0 ? 'balance-pos' : 'balance-zero' %>">
                <%= row.balance.toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2}) %>
              </span>
            </td>
          </tr>
          <% }) %>
          </tbody>
          <tfoot>
            <tr>
              <td colspan="3" style="padding:10px;font-weight:700;color:#fff;font-size:.88rem">Total Payable</td>
              <td style="text-align:right;padding:10px">
                <span class="balance-badge <%= grandBalance > 0 ? 'balance-pos' : 'balance-zero' %>" style="font-size:.82rem">
                  <%= grandBalance.toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2}) %>
                </span>
              </td>
            </tr>
          </tfoot>
        </table>
        </div>
        <% } %>
      </div>

      <!-- Record Payment -->
      <div class="card">
        <div class="card-title">Record Supplier Payment</div>
        <form method="POST" action="/accounting/suppliers/pay">
          <div class="pay-form">
            <div class="form-group full">
              <label>Supplier Name</label>
              <div class="ac-wrap">
                <input type="text" id="suppInput" placeholder="Type supplier name…" autocomplete="off" oninput="suppFilter(this.value)" onfocus="suppFilter(this.value)" />
                <input type="hidden" name="supplier_name" id="suppHidden" />
                <div class="ac-drop" id="suppDrop"></div>
              </div>
            </div>
            <div class="form-group">
              <label>Amount</label>
              <input type="number" name="amount" step="0.01" min="0" placeholder="0.00" required />
            </div>
            <div class="form-group">
              <label>Date</label>
              <input type="date" name="payment_date" value="<%= new Date().toISOString().slice(0,10) %>" required />
            </div>
            <div class="form-group">
              <label>Method</label>
              <select name="method">
                <option value="cash">Cash</option>
                <option value="bank_transfer">Bank Transfer</option>
                <option value="cheque">Cheque</option>
                <option value="other">Other</option>
              </select>
            </div>
            <div class="form-group">
              <label>Notes</label>
              <input type="text" name="notes" placeholder="Optional note" />
            </div>
            <div class="form-group full" style="margin-top:4px">
              <button type="submit" class="btn btn-primary">✅ Record Payment</button>
            </div>
          </div>
        </form>
      </div>
    </div>

    <!-- RIGHT: recent payments -->
    <div>
      <div class="card">
        <div class="card-title">Recent Payments</div>
        <% if (recentPayments.length === 0) { %>
          <p style="color:#444;text-align:center;padding:30px 0;font-size:.85rem">No payments recorded yet.</p>
        <% } else { %>
        <ul class="pay-list">
        <% recentPayments.forEach(p => { %>
          <li class="pay-item">
            <div>
              <div style="font-weight:600;color:#ddd"><%= p.supplier_name %></div>
              <div class="pay-meta"><%= String(p.payment_date).slice(0,10) %> · <%= p.method %><% if (p.notes) { %> · <%= p.notes %><% } %></div>
            </div>
            <div style="display:flex;align-items:center;gap:10px">
              <span style="font-weight:700;color:#00b894"><%= parseFloat(p.amount).toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2}) %></span>
              <form method="POST" action="/accounting/suppliers/pay/<%= p.id %>/delete" onsubmit="return confirm('Delete this payment?')">
                <button type="submit" class="btn btn-red" style="padding:4px 8px;font-size:.7rem">✕</button>
              </form>
            </div>
          </li>
        <% }) %>
        </ul>
        <% } %>
      </div>
    </div>

  </div>
</div>

<script>
const SUPPLIERS = <%- JSON.stringify(supplierNames) %>;
let suppIdx = -1;

function suppFilter(q) {
  const drop = document.getElementById('suppDrop');
  const matches = q.trim() === '' ? SUPPLIERS : SUPPLIERS.filter(s => s.toLowerCase().includes(q.toLowerCase()));
  if (matches.length === 0) { drop.style.display = 'none'; return; }
  drop.innerHTML = '';
  matches.forEach((s, i) => {
    const d = document.createElement('div');
    d.className = 'ac-opt';
    d.textContent = s;
    d.onmousedown = () => suppSelect(s);
    drop.appendChild(d);
  });
  drop.style.display = 'block';
  suppIdx = -1;
}

function suppSelect(name) {
  document.getElementById('suppInput').value = name;
  document.getElementById('suppHidden').value = name;
  document.getElementById('suppDrop').style.display = 'none';
}

document.getElementById('suppInput').addEventListener('keydown', function(e) {
  const drop = document.getElementById('suppDrop');
  const opts = drop.querySelectorAll('.ac-opt');
  if (e.key === 'ArrowDown') { suppIdx = Math.min(suppIdx+1, opts.length-1); }
  else if (e.key === 'ArrowUp') { suppIdx = Math.max(suppIdx-1, 0); }
  else if (e.key === 'Enter') {
    if (suppIdx >= 0 && opts[suppIdx]) { suppSelect(opts[suppIdx].textContent); e.preventDefault(); return; }
    document.getElementById('suppHidden').value = this.value;
    drop.style.display = 'none';
  } else if (e.key === 'Escape') { drop.style.display = 'none'; return; }
  opts.forEach((o, i) => o.classList.toggle('focused', i === suppIdx));
});

document.getElementById('suppInput').addEventListener('blur', function() {
  document.getElementById('suppHidden').value = this.value;
  setTimeout(() => document.getElementById('suppDrop').style.display = 'none', 150);
});

document.addEventListener('click', e => {
  if (!e.target.closest('.ac-wrap')) document.getElementById('suppDrop').style.display = 'none';
});
</script>
</body>
</html>
