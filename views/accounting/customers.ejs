<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Customer Credits — <%= tenant.name %></title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Segoe UI', sans-serif; background: #0f0f1a; color: #e0e0e0; min-height: 100vh; }
    .topbar { background: #1a1a2e; height: 56px; display: flex; align-items: center; justify-content: space-between; padding: 0 24px; border-bottom: 1px solid rgba(255,255,255,.07); gap: 12px; }
    .topbar-brand { font-weight: 700; color: #fff; font-size: 1rem; }
    .btn { padding: 7px 14px; border: none; border-radius: 8px; cursor: pointer; font-size: .82rem; font-weight: 600; font-family: inherit; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; }
    .btn-ghost { background: rgba(255,255,255,.08); color: #ccc; }
    .btn-ghost:hover { background: rgba(255,255,255,.14); color: #fff; }
    .btn-primary { background: #7c5cbf; color: #fff; }
    .btn-primary:hover { opacity: .88; }
    .btn-green { background: #00b89422; color: #00b894; }
    .btn-green:hover { background: #00b894; color: #fff; }
    .btn-red { background: #e74c3c22; color: #e74c3c; }
    .btn-red:hover { background: #e74c3c; color: #fff; }

    .main { padding: 24px; max-width: 1100px; margin: 0 auto; }
    .two-col { display: grid; grid-template-columns: 1.4fr 1fr; gap: 16px; }
    @media (max-width: 740px) { .two-col { grid-template-columns: 1fr; } }
    .card { background: #1a1a2e; border-radius: 14px; border: 1px solid #2a2a3e; padding: 20px; margin-bottom: 16px; }
    .card-title { font-size: .92rem; font-weight: 700; color: #fff; margin-bottom: 16px; }

    .credits-table { width: 100%; border-collapse: collapse; font-size: .84rem; }
    .credits-table th { text-align: left; font-size: .68rem; text-transform: uppercase; color: #444; font-weight: 700; padding: 7px 10px; border-bottom: 1px solid #2a2a3e; white-space: nowrap; }
    .credits-table td { padding: 10px; border-bottom: 1px solid rgba(255,255,255,.03); vertical-align: middle; }
    .credits-table tr:last-child td { border-bottom: none; }

    .status-badge { display: inline-block; padding: 2px 9px; border-radius: 20px; font-size: .68rem; font-weight: 700; }
    .status-open    { background: #e74c3c22; color: #e74c3c; }
    .status-partial { background: #f39c1222; color: #f39c12; }
    .status-paid    { background: #00b89422; color: #00b894; }

    .progress-bar { height: 5px; background: #2a2a3e; border-radius: 4px; margin-top: 4px; }
    .progress-fill { height: 5px; border-radius: 4px; background: #00b894; }

    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    @media (max-width: 480px) { .form-grid { grid-template-columns: 1fr; } }
    .form-group { display: flex; flex-direction: column; gap: 6px; }
    .form-group label { font-size: .72rem; font-weight: 700; color: #555; text-transform: uppercase; letter-spacing: .4px; }
    .form-group input, .form-group select, .form-group textarea {
      padding: 9px 12px; background: #0f0f1a; border: 1.5px solid #2a2a3e; border-radius: 8px;
      color: #fff; font-family: inherit; font-size: .85rem; outline: none;
    }
    .form-group input:focus, .form-group select:focus { border-color: #7c5cbf; }
    .form-group.full { grid-column: 1 / -1; }

    /* modal */
    .overlay { position: fixed; inset: 0; background: rgba(0,0,0,.6); z-index: 1000; display: none; align-items: center; justify-content: center; padding: 16px; }
    .overlay.open { display: flex; }
    .modal { background: #1a1a2e; border-radius: 16px; border: 1px solid #2a2a3e; padding: 24px; width: 100%; max-width: 400px; }
    .modal h3 { font-size: 1rem; font-weight: 700; color: #fff; margin-bottom: 18px; }
  </style>
</head>
<body>

<div class="topbar">
  <div style="display:flex;align-items:center;gap:8px">
    <a href="/admin" class="btn btn-ghost" style="padding:6px 10px;font-size:1.1rem;flex-shrink:0" title="All Modules">🏠</a>
    <div class="topbar-brand">🤝 Customer Credits</div>
  </div>
  <div style="display:flex;gap:8px">
    <a href="/accounting" class="btn btn-ghost">← Accounting</a>
    <button onclick="history.back()" class="btn btn-ghost">← Back</button>
  </div>
</div>

<div class="main">

  <% if (totalReceivable > 0) { %>
  <div style="background:#00b89411;border:1px solid #00b89433;border-radius:12px;padding:14px 20px;margin-bottom:18px;display:flex;justify-content:space-between;align-items:center">
    <span style="color:#aaa;font-size:.88rem">Total Outstanding Receivable</span>
    <span style="font-size:1.3rem;font-weight:800;color:#00b894"><%= totalReceivable.toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2}) %></span>
  </div>
  <% } %>

  <div class="two-col">
    <!-- LEFT: credits list -->
    <div>
      <div class="card">
        <div class="card-title">Credit Accounts</div>
        <% if (credits.length === 0) { %>
          <p style="color:#444;text-align:center;padding:30px 0;font-size:.85rem">No credit accounts yet.</p>
        <% } else { %>
        <div style="overflow-x:auto">
        <table class="credits-table">
          <thead>
            <tr>
              <th>Customer</th>
              <th style="text-align:right">Amount</th>
              <th style="text-align:right">Paid</th>
              <th style="text-align:right">Balance</th>
              <th>Status</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
          <% credits.forEach(c => {
            const pct = c.amount > 0 ? Math.min(100, Math.round(c.amount_paid / c.amount * 100)) : 0;
          %>
          <tr>
            <td>
              <div style="font-weight:600;color:#ddd"><%= c.customer_name %></div>
              <div style="font-size:.72rem;color:#444"><%= String(c.credit_date).slice(0,10) %><% if (c.due_date) { %> · due <%= String(c.due_date).slice(0,10) %><% } %></div>
              <div class="progress-bar" style="max-width:80px"><div class="progress-fill" style="width:<%= pct %>%"></div></div>
            </td>
            <td style="text-align:right;color:#f39c12;white-space:nowrap"><%= c.amount.toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2}) %></td>
            <td style="text-align:right;color:#00b894;white-space:nowrap"><%= c.amount_paid.toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2}) %></td>
            <td style="text-align:right;font-weight:700;white-space:nowrap;color:<%= c.balance > 0 ? '#e74c3c' : '#00b894' %>"><%= c.balance.toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2}) %></td>
            <td><span class="status-badge status-<%= c.status %>"><%= c.status %></span></td>
            <td style="white-space:nowrap">
              <% if (c.status !== 'paid') { %>
              <button class="btn btn-green" style="padding:4px 8px;font-size:.72rem" onclick='openPay(<%= c.id %>, "<%= c.customer_name.replace(/"/g, "&quot;") %>", <%= c.balance %>)'>Pay</button>
              <% } %>
              <form method="POST" action="/accounting/customers/credit/<%= c.id %>/delete" style="display:inline" onsubmit="return confirm('Delete this credit account?')">
                <button type="submit" class="btn btn-red" style="padding:4px 8px;font-size:.7rem">✕</button>
              </form>
            </td>
          </tr>
          <% }) %>
          </tbody>
        </table>
        </div>
        <% } %>
      </div>
    </div>

    <!-- RIGHT: add credit form -->
    <div>
      <div class="card">
        <div class="card-title">Add Credit Account</div>
        <form method="POST" action="/accounting/customers/credit">
          <div class="form-grid">
            <div class="form-group full">
              <label>Customer Name</label>
              <input type="text" name="customer_name" placeholder="Customer name" required />
            </div>
            <div class="form-group">
              <label>Amount</label>
              <input type="number" name="amount" step="0.01" min="0" placeholder="0.00" required />
            </div>
            <div class="form-group">
              <label>Date</label>
              <input type="date" name="credit_date" value="<%= new Date().toISOString().slice(0,10) %>" />
            </div>
            <div class="form-group">
              <label>Due Date</label>
              <input type="date" name="due_date" />
            </div>
            <div class="form-group full">
              <label>Notes</label>
              <input type="text" name="notes" placeholder="Optional note" />
            </div>
            <div class="form-group full">
              <button type="submit" class="btn btn-primary">➕ Add Credit</button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- Pay modal -->
<div class="overlay" id="payOverlay">
  <div class="modal">
    <h3 id="payTitle">Record Payment</h3>
    <form method="POST" id="payForm">
      <div class="form-grid">
        <div class="form-group">
          <label>Amount</label>
          <input type="number" name="amount" id="payAmount" step="0.01" min="0.01" required />
        </div>
        <div class="form-group">
          <label>Date</label>
          <input type="date" name="payment_date" id="payDate" value="<%= new Date().toISOString().slice(0,10) %>" />
        </div>
        <div class="form-group full">
          <label>Notes</label>
          <input type="text" name="notes" placeholder="Optional" />
        </div>
        <div class="form-group full" style="display:flex;gap:10px;margin-top:6px">
          <button type="submit" class="btn btn-primary" style="flex:1">✅ Record</button>
          <button type="button" class="btn btn-ghost" onclick="closePay()">Cancel</button>
        </div>
      </div>
    </form>
  </div>
</div>

<script>
function openPay(id, name, balance) {
  document.getElementById('payTitle').textContent = 'Payment from: ' + name;
  document.getElementById('payForm').action = '/accounting/customers/credit/' + id + '/pay';
  document.getElementById('payAmount').value = balance.toFixed(2);
  document.getElementById('payOverlay').classList.add('open');
}
function closePay() {
  document.getElementById('payOverlay').classList.remove('open');
}
document.getElementById('payOverlay').addEventListener('click', function(e) {
  if (e.target === this) closePay();
});
</script>
</body>
</html>
