<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AP / AR Aging Report</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Segoe UI', sans-serif; background: #0f0f1a; color: #e0e0e0; min-height: 100vh; }
    .topbar { background: #1a1a2e; height: 56px; display: flex; align-items: center; justify-content: space-between; padding: 0 24px; border-bottom: 1px solid rgba(255,255,255,.07); gap: 12px; position: sticky; top: 0; z-index: 100; }
    .btn { padding: 7px 14px; border: none; border-radius: 8px; cursor: pointer; font-size: .82rem; font-weight: 600; font-family: inherit; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; }
    .btn-ghost { background: rgba(255,255,255,.08); color: #ccc; }
    .btn-ghost:hover { background: rgba(255,255,255,.14); color: #fff; }
    .btn-print { background: rgba(116,185,255,.12); color: #74b9ff; }
    .main { padding: 24px; max-width: 1100px; margin: 0 auto; }
    .section-title { font-size: 1rem; font-weight: 700; color: #fff; margin: 24px 0 12px; }
    .card { background: #1a1a2e; border-radius: 14px; border: 1px solid #2a2a3e; padding: 20px; margin-bottom: 24px; overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; font-size: .84rem; min-width: 500px; }
    th { text-align: left; font-size: .68rem; text-transform: uppercase; color: #444; font-weight: 700; padding: 7px 10px; border-bottom: 1px solid #2a2a3e; }
    th.right { text-align: right; }
    td { padding: 9px 10px; border-bottom: 1px solid rgba(255,255,255,.03); }
    td.right { text-align: right; }
    tr:last-child td { border-bottom: none; }
    tfoot td { font-weight: 700; border-top: 1px solid #2a2a3e; }
    .bucket-pill { display: inline-block; padding: 3px 10px; border-radius: 20px; font-size: .72rem; font-weight: 700; }
    .b0 { background: #00b89420; color: #00b894; }
    .b1 { background: #fdcb6e20; color: #fdcb6e; }
    .b2 { background: #e1705520; color: #e17055; }
    .b3 { background: #e74c3c22; color: #e74c3c; }
    .summary-strip { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px,1fr)); gap: 12px; margin-bottom: 20px; }
    .sum-card { background: #1a1a2e; border-radius: 12px; border: 1px solid #2a2a3e; padding: 14px 18px; }
    .sum-label { font-size: .68rem; text-transform: uppercase; color: #555; font-weight: 700; margin-bottom: 4px; }
    .sum-val { font-size: 1.05rem; font-weight: 700; }
    @media print {
      .topbar { display: none; }
      body { background: #fff; color: #000; }
      .card { border: 1px solid #ddd; background: #fff; }
    }
  </style>
</head>
<body>
<div class="topbar">
  <div style="display:flex;align-items:center;gap:8px">
    <a href="C:\Users\ASUS" class="btn btn-ghost" style="padding:6px 10px;font-size:1.1rem" title="All Modules">ðŸ </a>
    <span style="font-weight:700;color:#fff">ðŸ“… AP / AR Aging Report</span>
  </div>
  <div style="display:flex;gap:8px">
    <a href="/accounting" class="btn btn-ghost">ðŸ“’ Accounting</a>
    <a href="/accounting/suppliers" class="btn btn-ghost">Suppliers</a>
    <button onclick="window.print()" class="btn btn-print">ðŸ–¨ Print</button>
    <button onclick="history.back()" class="btn btn-ghost">â† Back</button>
  </div>
</div>

<div class="main">

  <!-- AP Section -->
  <div class="section-title">ðŸ­ Accounts Payable (AP) â€” Supplier Aging</div>

  <div class="summary-strip">
    <div class="sum-card"><div class="sum-label">Total AP Balance</div><div class="sum-val" style="color:#e74c3c">$<%= apTotal.toFixed(2) %></div></div>
    <div class="sum-card"><div class="sum-label">Current (0â€“30)</div><div class="sum-val b0">$<%= (apSummary['0-30'] || 0).toFixed(2) %></div></div>
    <div class="sum-card"><div class="sum-label">31â€“60 days</div><div class="sum-val b1">$<%= (apSummary['31-60'] || 0).toFixed(2) %></div></div>
    <div class="sum-card"><div class="sum-label">61â€“90 days</div><div class="sum-val b2">$<%= (apSummary['61-90'] || 0).toFixed(2) %></div></div>
    <div class="sum-card"><div class="sum-label">Over 90 days</div><div class="sum-val b3">$<%= (apSummary['90+'] || 0).toFixed(2) %></div></div>
  </div>

  <div class="card">
    <table>
      <thead>
        <tr><th>Supplier</th><th>Oldest Invoice</th><th>Age Bucket</th><th class="right">Balance</th></tr>
      </thead>
      <tbody>
      <% apRows.forEach(row => { %>
      <tr>
        <td style="font-weight:600"><%= row.supplier_name %></td>
        <td style="color:#888;font-size:.8rem"><%= row.oldest_date ? String(row.oldest_date).slice(0,10) : 'â€”' %></td>
        <td>
          <span class="bucket-pill <%= row.bucket === '0-30' ? 'b0' : row.bucket === '31-60' ? 'b1' : row.bucket === '61-90' ? 'b2' : 'b3' %>">
            <%= row.bucket %>
          </span>
        </td>
        <td class="right" style="font-weight:700;color:#e74c3c">$<%= row.balance.toFixed(2) %></td>
      </tr>
      <% }) %>
      <% if (!apRows.length) { %>
        <tr><td colspan="4" style="color:#555;text-align:center;padding:20px">No outstanding payables</td></tr>
      <% } %>
      </tbody>
      <tfoot>
        <tr><td colspan="3" style="text-align:right;padding:10px;color:#666;font-size:.78rem">TOTAL AP</td><td class="right" style="padding:10px;color:#e74c3c">$<%= apTotal.toFixed(2) %></td></tr>
      </tfoot>
    </table>
  </div>

  <!-- AR Section -->
  <div class="section-title">ðŸ‘¤ Accounts Receivable (AR) â€” Customer Aging</div>

  <div class="summary-strip">
    <div class="sum-card"><div class="sum-label">Total AR Balance</div><div class="sum-val" style="color:#e17055">$<%= arTotal.toFixed(2) %></div></div>
    <div class="sum-card"><div class="sum-label">Current (0â€“30)</div><div class="sum-val b0">$<%= (arSummary['0-30'] || 0).toFixed(2) %></div></div>
    <div class="sum-card"><div class="sum-label">31â€“60 days</div><div class="sum-val b1">$<%= (arSummary['31-60'] || 0).toFixed(2) %></div></div>
    <div class="sum-card"><div class="sum-label">61â€“90 days</div><div class="sum-val b2">$<%= (arSummary['61-90'] || 0).toFixed(2) %></div></div>
    <div class="sum-card"><div class="sum-label">Over 90 days</div><div class="sum-val b3">$<%= (arSummary['90+'] || 0).toFixed(2) %></div></div>
  </div>

  <div class="card">
    <table>
      <thead>
        <tr><th>Customer</th><th>Credit Date</th><th>Due Date</th><th>Age Bucket</th><th class="right">Balance</th></tr>
      </thead>
      <tbody>
      <% arRows.forEach(row => { %>
      <tr>
        <td style="font-weight:600">
          <% if (row.customer_id) { %>
            <a href="/accounting/customers/<%= row.customer_id %>/ledger" style="color:#7c5cbf;text-decoration:none"><%= row.customer_name %></a>
          <% } else { %><%= row.customer_name %><% } %>
        </td>
        <td style="color:#888;font-size:.8rem"><%= row.credit_date ? String(row.credit_date).slice(0,10) : 'â€”' %></td>
        <td style="color:#888;font-size:.8rem"><%= row.due_date ? String(row.due_date).slice(0,10) : 'â€”' %></td>
        <td>
          <span class="bucket-pill <%= row.bucket === '0-30' ? 'b0' : row.bucket === '31-60' ? 'b1' : row.bucket === '61-90' ? 'b2' : 'b3' %>">
            <%= row.bucket %>
          </span>
        </td>
        <td class="right" style="font-weight:700;color:#e17055">$<%= row.balance.toFixed(2) %></td>
      </tr>
      <% }) %>
      <% if (!arRows.length) { %>
        <tr><td colspan="5" style="color:#555;text-align:center;padding:20px">No outstanding receivables</td></tr>
      <% } %>
      </tbody>
      <tfoot>
        <tr><td colspan="4" style="text-align:right;padding:10px;color:#666;font-size:.78rem">TOTAL AR</td><td class="right" style="padding:10px;color:#e17055">$<%= arTotal.toFixed(2) %></td></tr>
      </tfoot>
    </table>
  </div>
</div>
</body>
</html>
