<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Inventory Items — <%= tenant.name %></title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Segoe UI', sans-serif; background: #0f0f1a; color: #e0e0e0; min-height: 100vh; }
    .topbar { background: #1a1a2e; height: 56px; display: flex; align-items: center; justify-content: space-between; padding: 0 24px; border-bottom: 1px solid rgba(255,255,255,.07); position: sticky; top: 0; z-index: 50; gap: 10px; flex-wrap: wrap; }
    .topbar-brand { font-weight: 700; color: #fff; }
    .btn { padding: 7px 14px; border: none; border-radius: 8px; cursor: pointer; font-size: .82rem; font-weight: 600; font-family: inherit; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; }
    .btn-ghost { background: rgba(255,255,255,.08); color: #ccc; }
    .btn-ghost:hover { background: rgba(255,255,255,.14); color: #fff; }
    .btn-primary { background: #7c5cbf; color: #fff; }
    .btn-primary:hover { opacity: .88; }
    .btn-danger { background: rgba(231,76,60,.15); color: #e74c3c; border: 1px solid rgba(231,76,60,.3); }
    .btn-danger:hover { background: rgba(231,76,60,.25); }
    .btn-sm { padding: 4px 10px; font-size: .75rem; }

    .main { padding: 20px 24px; max-width: 1300px; margin: 0 auto; }

    .filter-bar { display: flex; gap: 8px; margin-bottom: 16px; flex-wrap: wrap; align-items: center; }
    .search-input { padding: 7px 14px; background: #1a1a2e; border: 1.5px solid #2a2a3e; border-radius: 8px; color: #fff; font-size: .85rem; outline: none; font-family: inherit; min-width: 200px; }
    .search-input:focus { border-color: #7c5cbf; }
    .type-btn { padding: 6px 14px; border-radius: 20px; border: 1.5px solid #2a2a3e; background: none; color: #666; font-size: .78rem; font-weight: 600; cursor: pointer; font-family: inherit; text-decoration: none; white-space: nowrap; }
    .type-btn.active, .type-btn:hover { background: #7c5cbf; border-color: #7c5cbf; color: #fff; }

    .table-wrap { background: #1a1a2e; border-radius: 14px; border: 1px solid #2a2a3e; overflow: hidden; }
    .table-scroll { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; min-width: 860px; }
    th { text-align: left; font-size: .68rem; text-transform: uppercase; color: #444; font-weight: 700; padding: 10px 12px; border-bottom: 1px solid #2a2a3e; white-space: nowrap; }
    td { padding: 10px 12px; font-size: .83rem; color: #ccc; border-bottom: 1px solid rgba(255,255,255,.04); vertical-align: middle; }
    tr:last-child td { border-bottom: none; }
    tr:hover td { background: rgba(255,255,255,.02); }

    .flags { display: flex; gap: 4px; flex-wrap: wrap; }
    .flag { font-size: .65rem; font-weight: 700; padding: 2px 7px; border-radius: 8px; white-space: nowrap; }
    .flag-rm   { background: rgba(52,152,219,.15); color: #3498db; }
    .flag-sf   { background: rgba(155,89,182,.15); color: #9b59b6; }
    .flag-sold { background: rgba(0,184,148,.15);  color: #00b894; }

    .stock-val { font-weight: 700; color: #fff; }
    .stock-low { color: #e74c3c !important; }
    .cost-val  { color: #7c5cbf; font-weight: 600; }
    .action-btns { display: flex; gap: 5px; flex-wrap: wrap; }

    .empty-state { text-align: center; padding: 60px 20px; color: #444; }

    /* Modal */
    .overlay { position: fixed; inset: 0; background: rgba(0,0,0,.6); display: none; align-items: center; justify-content: center; z-index: 200; padding: 16px; }
    .overlay.open { display: flex; }
    .modal { background: #1a1a2e; border-radius: 16px; border: 1px solid #2a2a3e; width: 100%; max-width: 480px; padding: 24px; max-height: 90vh; overflow-y: auto; }
    .modal-title { font-size: 1rem; font-weight: 700; color: #fff; margin-bottom: 18px; }
    .form-group { margin-bottom: 14px; }
    .form-label { font-size: .72rem; font-weight: 700; color: #555; text-transform: uppercase; margin-bottom: 6px; display: block; }
    .form-input { width: 100%; padding: 9px 12px; background: #0f0f1a; border: 1.5px solid #2a2a3e; border-radius: 8px; color: #fff; font-size: .9rem; font-family: inherit; outline: none; }
    .form-input:focus { border-color: #7c5cbf; }
    select.form-input option { background: #1a1a2e; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .modal-footer { display: flex; gap: 10px; justify-content: flex-end; margin-top: 20px; }

    /* Checkboxes */
    .check-group { display: flex; flex-direction: column; gap: 8px; }
    .check-item { display: flex; align-items: center; gap: 10px; padding: 9px 12px; border: 1.5px solid #2a2a3e; border-radius: 9px; cursor: pointer; transition: border-color .15s; }
    .check-item:hover { border-color: #555; }
    .check-item input[type=checkbox] { width: 16px; height: 16px; accent-color: #7c5cbf; cursor: pointer; flex-shrink: 0; }
    .check-item.checked { border-color: #7c5cbf; background: rgba(124,92,191,.07); }
    .check-item-label { font-size: .88rem; font-weight: 600; color: #ddd; }
    .check-item-desc  { font-size: .72rem; color: #555; margin-top: 1px; }
  </style>
</head>
<body>

<div class="topbar">
  <div class="topbar-brand">📦 Inventory Items</div>
  <div style="display:flex;gap:8px;flex-wrap:wrap">
    <a href="/inventory" class="btn btn-ghost">← Dashboard</a>
    <button class="btn btn-ghost" onclick="openCatMgr()">🏷️ Categories</button>
    <button class="btn btn-primary" onclick="openCreate()">+ Add Item</button>
  </div>
</div>

<div class="main">
  <div class="filter-bar">
    <input type="text" class="search-input" placeholder="🔍 Search items..." id="searchInput" oninput="filterRows()" />
    <button class="type-btn active" id="filterAll" onclick="setFilter('all','',this)">All</button>
    <button class="type-btn" onclick="setFilter('type','rm',this)">🔵 Raw Material</button>
    <button class="type-btn" onclick="setFilter('type','sf',this)">🟣 Semi-Finished</button>
    <button class="type-btn" onclick="setFilter('type','sold',this)">🟢 Can Be Sold</button>
    <% invCategories.forEach(ic => { %>
    <button class="type-btn" onclick="setFilter('cat','<%= ic.id %>',this)" style="border-color:<%= ic.color %>">
      <span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:<%= ic.color %>;margin-right:4px"></span><%= ic.name %>
    </button>
    <% }) %>
  </div>

  <% if (items.length === 0) { %>
  <div class="empty-state">
    <div style="font-size:3rem">📦</div>
    <div style="margin-top:12px">No items yet.</div>
    <button class="btn btn-primary btn-sm" onclick="openCreate()" style="margin-top:12px">Add first item</button>
  </div>
  <% } else { %>
  <div class="table-wrap">
    <div class="table-scroll">
    <table id="itemsTable">
      <thead>
        <tr>
          <th>Name</th>
          <th>Category</th>
          <th>Type</th>
          <th>Unit</th>
          <th>Stock</th>
          <th>Avg Cost</th>
          <th>Recipe Cost</th>
          <th>Linked Menu Item</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
      <% items.forEach(item => { %>
      <tr
        data-name="<%= item.name.toLowerCase() %>"
        data-rm="<%= item.is_raw_material ? '1' : '0' %>"
        data-sf="<%= item.is_semi_finished ? '1' : '0' %>"
        data-sold="<%= item.can_be_sold ? '1' : '0' %>"
        data-cat="<%= item.inv_category_id || '' %>"
      >
        <td style="color:#fff;font-weight:600">
          <%= item.name %>
          <% if (item.sku) { %><span style="font-size:.7rem;color:#444;margin-left:4px">(<%= item.sku %>)</span><% } %>
        </td>
        <td>
          <% if (item.inv_category_name) { %>
            <span style="display:inline-flex;align-items:center;gap:5px;font-size:.75rem;font-weight:700;padding:2px 9px;border-radius:8px;background:<%= item.inv_category_color %>22;color:<%= item.inv_category_color %>">
              <span style="width:6px;height:6px;border-radius:50%;background:<%= item.inv_category_color %>"></span><%= item.inv_category_name %>
            </span>
          <% } else { %><span style="color:#333;font-size:.75rem">—</span><% } %>
        </td>
        <td>
          <div class="flags">
            <% if (item.is_raw_material)  { %><span class="flag flag-rm">Raw Material</span><% } %>
            <% if (item.is_semi_finished) { %><span class="flag flag-sf">Semi-Finished</span><% } %>
            <% if (item.can_be_sold)      { %><span class="flag flag-sold">Can Be Sold</span><% } %>
            <% if (!item.is_raw_material && !item.is_semi_finished && !item.can_be_sold) { %><span style="color:#333;font-size:.75rem">—</span><% } %>
          </div>
        </td>
        <td style="color:#666"><%= item.unit %></td>
        <td>
          <span class="stock-val <%= parseFloat(item.stock_qty) <= parseFloat(item.reorder_level) && parseFloat(item.reorder_level) > 0 ? 'stock-low' : '' %>">
            <%= parseFloat(item.stock_qty).toFixed(3) %>
          </span>
          <% if (parseFloat(item.reorder_level) > 0) { %>
          <span style="font-size:.7rem;color:#444"> / <%= parseFloat(item.reorder_level).toFixed(2) %></span>
          <% } %>
        </td>
        <td class="cost-val"><%= tenant.currency || '$' %><%= parseFloat(item.avg_cost).toFixed(4) %></td>
        <td>
          <% if (parseInt(item.recipe_lines) > 0) { %>
          <span style="color:#00b894;font-weight:600"><%= tenant.currency || '$' %><%= parseFloat(item.recipe_cost).toFixed(4) %></span>
          <% } else { %>
          <span style="color:#333">—</span>
          <% } %>
        </td>
        <td style="color:#666"><%= item.menu_item_name || '—' %></td>
        <td>
          <div class="action-btns">
            <a href="/inventory/items/<%= item.id %>/recipe" class="btn btn-ghost btn-sm">📝 Recipe</a>
            <button class="btn btn-ghost btn-sm" onclick='openEdit(<%= JSON.stringify(item) %>)'>Edit</button>
            <button class="btn btn-ghost btn-sm" onclick='openAdjust(<%= item.id %>, "<%= item.name.replace(/"/g,"") %>", "<%= item.unit %>")'>±Stock</button>
            <form method="POST" action="/inventory/items/<%= item.id %>/delete" style="display:inline" onsubmit="return confirm('Archive this item?')">
              <button type="submit" class="btn btn-danger btn-sm">✕</button>
            </form>
          </div>
        </td>
      </tr>
      <% }) %>
      </tbody>
    </table>
    </div>
  </div>
  <% } %>
</div>

<!-- Create Modal -->
<div class="overlay" id="createOverlay" onclick="if(event.target===this)closeCreate()">
  <div class="modal">
    <div class="modal-title">➕ Add Inventory Item</div>
    <form method="POST" action="/inventory/items">
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Name *</label>
          <input type="text" name="name" class="form-input" required placeholder="e.g. Flour" />
        </div>
        <div class="form-group">
          <label class="form-label">SKU / Code</label>
          <input type="text" name="sku" class="form-input" placeholder="optional" />
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Item Type (select all that apply)</label>
        <div class="check-group">
          <label class="check-item" id="c_rm_wrap">
            <input type="checkbox" name="is_raw_material" value="1" onchange="syncCheck('c_rm_wrap',this)" />
            <div>
              <div class="check-item-label">🔵 Raw Material</div>
              <div class="check-item-desc">Purchased ingredient used in recipes</div>
            </div>
          </label>
          <label class="check-item" id="c_sf_wrap">
            <input type="checkbox" name="is_semi_finished" value="1" onchange="syncCheck('c_sf_wrap',this)" />
            <div>
              <div class="check-item-label">🟣 Semi-Finished</div>
              <div class="check-item-desc">Made from raw materials, used in other recipes</div>
            </div>
          </label>
          <label class="check-item" id="c_sold_wrap" onchange="syncCheck('c_sold_wrap',this)">
            <input type="checkbox" name="can_be_sold" value="1" onchange="toggleCreateMenuLink(this)" />
            <div>
              <div class="check-item-label">🟢 Can Be Sold</div>
              <div class="check-item-desc">Appears as a POS product — link to a menu item</div>
            </div>
          </label>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Unit *</label>
          <select name="unit" class="form-input">
            <option>kg</option><option>g</option><option>L</option><option>ml</option>
            <option>pcs</option><option>box</option><option>bag</option><option>bottle</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Reorder Level</label>
          <input type="number" name="reorder_level" class="form-input" placeholder="0" step="0.001" min="0" />
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Inventory Category</label>
        <select name="inv_category_id" class="form-input">
          <option value="">No category</option>
          <% invCategories.forEach(ic => { %>
          <option value="<%= ic.id %>"><%= ic.name %></option>
          <% }) %>
        </select>
      </div>

      <div id="c_menuLinkGroup" style="display:none;margin-top:4px">
        <div style="background:#1e2a1e;border:1.5px solid #2d4a2d;border-radius:10px;padding:16px;margin-bottom:0">
          <p style="font-size:.8rem;color:#6fcf97;margin-bottom:14px;font-weight:600">🛒 Add this item to the menu so it appears in the POS?</p>
          <div style="display:flex;gap:10px;margin-bottom:14px">
            <label style="display:flex;align-items:center;gap:8px;cursor:pointer;flex:1;background:#162616;border:1.5px solid #2d4a2d;border-radius:8px;padding:10px 14px" id="c_addMenuYes">
              <input type="radio" name="add_to_menu" value="yes" onchange="toggleAddToMenu(true)" style="accent-color:#6fcf97;width:16px;height:16px" />
              <span style="font-size:.88rem;color:#e0e0e0;font-weight:600">Yes, add to menu</span>
            </label>
            <label style="display:flex;align-items:center;gap:8px;cursor:pointer;flex:1;background:#162616;border:1.5px solid #2d4a2d;border-radius:8px;padding:10px 14px" id="c_addMenuNo">
              <input type="radio" name="add_to_menu" value="no" onchange="toggleAddToMenu(false)" style="accent-color:#6fcf97;width:16px;height:16px" checked />
              <span style="font-size:.88rem;color:#e0e0e0;font-weight:600">No, just track stock</span>
            </label>
          </div>
          <div id="c_menuFields" style="display:none">
            <div class="form-row">
              <div class="form-group">
                <label class="form-label">Menu Name</label>
                <input type="text" name="menu_name" class="form-input" placeholder="Leave blank to use item name" />
              </div>
              <div class="form-group">
                <label class="form-label">Selling Price</label>
                <input type="number" name="selling_price" class="form-input" placeholder="0" min="0" step="0.01" />
              </div>
            </div>
            <div class="form-group">
              <label class="form-label">Menu Category</label>
              <select name="menu_category_id" class="form-input">
                <option value="">No category</option>
                <%
                  const rootCats = categories.filter(c => !c.parent_id);
                  rootCats.forEach(cat => {
                    const subs = categories.filter(c => String(c.parent_id) === String(cat.id));
                %>
                <% if (subs.length > 0) { %>
                  <optgroup label="<%= cat.name %>">
                    <option value="<%= cat.id %>"><%= cat.name %> (main)</option>
                    <% subs.forEach(sub => { %><option value="<%= sub.id %>">↳ <%= sub.name %></option><% }) %>
                  </optgroup>
                <% } else { %>
                  <option value="<%= cat.id %>"><%= cat.name %></option>
                <% } %>
                <% }) %>
              </select>
            </div>
          </div>
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-ghost" onclick="closeCreate()">Cancel</button>
        <button type="submit" class="btn btn-primary">Create</button>
      </div>
    </form>
  </div>
</div>

<!-- Edit Modal -->
<div class="overlay" id="editOverlay" onclick="if(event.target===this)closeEdit()">
  <div class="modal">
    <div class="modal-title">✏️ Edit Item</div>
    <form method="POST" id="editForm">
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Name *</label>
          <input type="text" name="name" id="editName" class="form-input" required />
        </div>
        <div class="form-group">
          <label class="form-label">SKU / Code</label>
          <input type="text" name="sku" id="editSku" class="form-input" />
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Item Type (select all that apply)</label>
        <div class="check-group">
          <label class="check-item" id="e_rm_wrap">
            <input type="checkbox" name="is_raw_material" value="1" id="e_rm" onchange="syncCheck('e_rm_wrap',this)" />
            <div>
              <div class="check-item-label">🔵 Raw Material</div>
              <div class="check-item-desc">Purchased ingredient used in recipes</div>
            </div>
          </label>
          <label class="check-item" id="e_sf_wrap">
            <input type="checkbox" name="is_semi_finished" value="1" id="e_sf" onchange="syncCheck('e_sf_wrap',this)" />
            <div>
              <div class="check-item-label">🟣 Semi-Finished</div>
              <div class="check-item-desc">Made from raw materials, used in other recipes</div>
            </div>
          </label>
          <label class="check-item" id="e_sold_wrap">
            <input type="checkbox" name="can_be_sold" value="1" id="e_sold" onchange="syncCheck('e_sold_wrap',this);toggleEditMenuLink(this)" />
            <div>
              <div class="check-item-label">🟢 Can Be Sold</div>
              <div class="check-item-desc">Appears as a POS product — link to a menu item</div>
            </div>
          </label>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Unit</label>
          <select name="unit" id="editUnit" class="form-input">
            <option>kg</option><option>g</option><option>L</option><option>ml</option>
            <option>pcs</option><option>box</option><option>bag</option><option>bottle</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Reorder Level</label>
          <input type="number" name="reorder_level" id="editReorder" class="form-input" step="0.001" min="0" />
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Inventory Category</label>
        <select name="inv_category_id" id="editInvCategory" class="form-input">
          <option value="">No category</option>
          <% invCategories.forEach(ic => { %>
          <option value="<%= ic.id %>"><%= ic.name %></option>
          <% }) %>
        </select>
      </div>

      <div class="form-group" id="e_menuLinkGroup" style="display:none">
        <label class="form-label">Link to Menu Item (POS)</label>
        <select name="menu_item_id" id="editMenuLink" class="form-input">
          <option value="">— Not linked —</option>
          <% menuItems.forEach(m => { %>
          <option value="<%= m.id %>"><%= m.name %></option>
          <% }) %>
        </select>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-ghost" onclick="closeEdit()">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
      </div>
    </form>
  </div>
</div>

<!-- Adjust Stock Modal -->
<div class="overlay" id="adjustOverlay" onclick="if(event.target===this)closeAdjust()">
  <div class="modal">
    <div class="modal-title">± Adjust Stock</div>
    <div style="font-size:.85rem;color:#666;margin-bottom:16px" id="adjustItemName"></div>
    <form method="POST" id="adjustForm">
      <div class="form-group">
        <label class="form-label">Quantity Change (use − to reduce)</label>
        <input type="number" name="qty_change" id="adjustQty" class="form-input" step="0.001" placeholder="e.g. 5 or -2" required />
      </div>
      <div class="form-group">
        <label class="form-label">Reason / Notes</label>
        <input type="text" name="notes" class="form-input" placeholder="e.g. Waste, Count correction..." />
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-ghost" onclick="closeAdjust()">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
      </div>
    </form>
  </div>
</div>

<script>
function syncCheck(wrapId, cb) {
  document.getElementById(wrapId).classList.toggle('checked', cb.checked);
}

// Create modal
function openCreate() { document.getElementById('createOverlay').classList.add('open'); }
function closeCreate() { document.getElementById('createOverlay').classList.remove('open'); }
function toggleCreateMenuLink(cb) {
  document.getElementById('c_menuLinkGroup').style.display = cb.checked ? '' : 'none';
  if (!cb.checked) {
    document.querySelectorAll('[name=add_to_menu]').forEach(r => { if (r.value === 'no') r.checked = true; });
    document.getElementById('c_menuFields').style.display = 'none';
  }
  syncCheck('c_sold_wrap', cb);
}
function toggleAddToMenu(yes) {
  document.getElementById('c_menuFields').style.display = yes ? '' : 'none';
}

// Edit modal
function openEdit(item) {
  document.getElementById('editName').value    = item.name;
  document.getElementById('editSku').value     = item.sku || '';
  document.getElementById('editUnit').value    = item.unit;
  document.getElementById('editReorder').value = item.reorder_level;
  document.getElementById('editMenuLink').value     = item.menu_item_id || '';
  document.getElementById('editInvCategory').value  = item.inv_category_id || '';
  document.getElementById('editForm').action        = '/inventory/items/' + item.id + '/edit';

  const rm   = !!item.is_raw_material;
  const sf   = !!item.is_semi_finished;
  const sold = !!item.can_be_sold;
  document.getElementById('e_rm').checked   = rm;
  document.getElementById('e_sf').checked   = sf;
  document.getElementById('e_sold').checked = sold;
  document.getElementById('e_rm_wrap').classList.toggle('checked', rm);
  document.getElementById('e_sf_wrap').classList.toggle('checked', sf);
  document.getElementById('e_sold_wrap').classList.toggle('checked', sold);
  document.getElementById('e_menuLinkGroup').style.display = sold ? '' : 'none';

  document.getElementById('editOverlay').classList.add('open');
}
function closeEdit() { document.getElementById('editOverlay').classList.remove('open'); }
function toggleEditMenuLink(cb) {
  document.getElementById('e_menuLinkGroup').style.display = cb.checked ? '' : 'none';
}

// Adjust
function openAdjust(id, name, unit) {
  document.getElementById('adjustItemName').textContent = name + ' (' + unit + ')';
  document.getElementById('adjustForm').action = '/inventory/items/' + id + '/adjust';
  document.getElementById('adjustQty').value = '';
  document.getElementById('adjustOverlay').classList.add('open');
}
function closeAdjust() { document.getElementById('adjustOverlay').classList.remove('open'); }

// Filter
let _filterType = 'all', _filterVal = '';
function setFilter(type, val, btn) {
  _filterType = type; _filterVal = val;
  document.querySelectorAll('.type-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  filterRows();
}
function filterRows() {
  const q = document.getElementById('searchInput').value.toLowerCase();
  document.querySelectorAll('#itemsTable tbody tr').forEach(row => {
    const matchName = row.dataset.name.includes(q);
    const matchFilter = _filterType === 'all'
      || (_filterType === 'type' && _filterVal === 'rm'   && row.dataset.rm   === '1')
      || (_filterType === 'type' && _filterVal === 'sf'   && row.dataset.sf   === '1')
      || (_filterType === 'type' && _filterVal === 'sold' && row.dataset.sold === '1')
      || (_filterType === 'cat'  && row.dataset.cat === _filterVal);
    row.style.display = matchName && matchFilter ? '' : 'none';
  });
}

// Category manager
function openCatMgr() { document.getElementById('catMgrOverlay').classList.add('open'); }
function closeCatMgr() { document.getElementById('catMgrOverlay').classList.remove('open'); }
</script>

<!-- Category Manager Modal -->
<div class="overlay" id="catMgrOverlay" onclick="if(event.target===this)closeCatMgr()">
  <div class="modal" style="max-width:400px">
    <div class="modal-title">🏷️ Inventory Categories</div>

    <!-- Add category form -->
    <form method="POST" action="/inventory/categories" style="margin-bottom:20px">
      <div class="form-row" style="grid-template-columns:1fr auto auto;align-items:end;gap:8px">
        <div class="form-group" style="margin-bottom:0">
          <label class="form-label">Category Name</label>
          <input type="text" name="name" class="form-input" placeholder="e.g. Beverages" required />
        </div>
        <div class="form-group" style="margin-bottom:0">
          <label class="form-label">Color</label>
          <input type="color" name="color" value="#7c5cbf" style="width:44px;height:38px;padding:2px;border-radius:8px;border:1.5px solid #2a2a3e;background:#0f0f1a;cursor:pointer" />
        </div>
        <button type="submit" class="btn btn-primary" style="height:38px;white-space:nowrap">+ Add</button>
      </div>
    </form>

    <!-- Existing categories -->
    <% if (invCategories.length === 0) { %>
      <p style="color:#444;font-size:.85rem;text-align:center;padding:20px 0">No categories yet.</p>
    <% } else { %>
      <div style="display:flex;flex-direction:column;gap:8px">
        <% invCategories.forEach(ic => { %>
        <div style="display:flex;align-items:center;gap:10px;padding:10px 12px;background:#0f0f1a;border-radius:9px;border:1px solid #2a2a3e">
          <span style="width:12px;height:12px;border-radius:50%;background:<%= ic.color %>;flex-shrink:0"></span>
          <span style="flex:1;color:#ddd;font-size:.88rem;font-weight:600"><%= ic.name %></span>
          <form method="POST" action="/inventory/categories/<%= ic.id %>/delete" onsubmit="return confirm('Delete category? Items will be uncategorised.')">
            <button type="submit" class="btn btn-danger btn-sm">✕</button>
          </form>
        </div>
        <% }) %>
      </div>
    <% } %>

    <div class="modal-footer">
      <button type="button" class="btn btn-ghost" onclick="closeCatMgr()">Close</button>
    </div>
  </div>
</div>

</body>
</html>
