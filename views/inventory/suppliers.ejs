<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Suppliers — <%= tenant.name %></title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Segoe UI', sans-serif; background: #0f0f1a; color: #e0e0e0; min-height: 100vh; }
    .topbar { background: #1a1a2e; height: 60px; display: flex; align-items: center; justify-content: space-between; padding: 0 20px; border-bottom: 1px solid rgba(255,255,255,.07); position: sticky; top: 0; z-index: 100; }
    .btn { padding: 7px 14px; border: none; border-radius: 8px; cursor: pointer; font-size: .82rem; font-weight: 600; font-family: inherit; text-decoration: none; display: inline-flex; align-items: center; gap: 5px; }
    .btn-ghost { background: rgba(255,255,255,.08); color: #ccc; }
    .btn-ghost:hover { background: rgba(255,255,255,.14); color: #fff; }
    .btn-primary { background: #7c5cbf; color: #fff; }
    .btn-primary:hover { opacity: .88; }
    .btn-danger { background: rgba(231,76,60,.15); color: #e74c3c; border: 1px solid rgba(231,76,60,.25); }
    .btn-danger:hover { background: rgba(231,76,60,.25); }
    .btn-sm { padding: 4px 10px; font-size: .75rem; }

    .main { padding: 28px; max-width: 1200px; margin: 0 auto; }
    .page-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px; }
    .page-title { font-size: 1.3rem; font-weight: 800; color: #fff; }

    .stats-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px,1fr)); gap: 14px; margin-bottom: 28px; }
    .stat { background: #1a1a2e; border: 1px solid #2a2a3e; border-radius: 12px; padding: 16px; }
    .stat-label { font-size: .7rem; text-transform: uppercase; color: #555; font-weight: 700; }
    .stat-val { font-size: 1.5rem; font-weight: 800; color: #a78bdf; margin-top: 4px; }

    .card { background: #1a1a2e; border: 1px solid #2a2a3e; border-radius: 12px; padding: 20px; margin-bottom: 20px; overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; font-size: .85rem; }
    th { text-align: left; color: #444; font-size: .7rem; text-transform: uppercase; font-weight: 700; padding: 8px 12px; border-bottom: 1px solid #2a2a3e; }
    td { padding: 12px; border-bottom: 1px solid rgba(255,255,255,.04); color: #ccc; vertical-align: middle; }
    tr:last-child td { border-bottom: none; }
    .balance-due { color: #e74c3c; font-weight: 700; }
    .balance-ok { color: #00b894; font-weight: 700; }

    .modal-bg { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.7); z-index: 400; align-items: center; justify-content: center; }
    .modal-bg.open { display: flex; }
    .modal { background: #1a1a2e; border: 1px solid #2a2a3e; border-radius: 16px; padding: 28px; width: 460px; max-width: 95vw; max-height: 90vh; overflow-y: auto; }
    .modal-title { font-size: 1rem; font-weight: 800; color: #fff; margin-bottom: 20px; }
    .form-group { margin-bottom: 14px; }
    .form-label { display: block; font-size: .72rem; font-weight: 700; color: #555; text-transform: uppercase; margin-bottom: 5px; }
    .form-input { width: 100%; padding: 9px 12px; background: #0f0f1a; border: 1.5px solid #2a2a3e; border-radius: 8px; color: #fff; font-size: .88rem; font-family: inherit; outline: none; }
    .form-input:focus { border-color: #7c5cbf; }
    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .toast { position: fixed; top: 70px; right: 20px; padding: 10px 18px; border-radius: 10px; font-size: .85rem; font-weight: 600; z-index: 9999; }
    .toast-ok { background: rgba(0,184,148,.2); color: #00b894; border: 1px solid rgba(0,184,148,.3); }
    .toast-err { background: rgba(231,76,60,.2); color: #e74c3c; border: 1px solid rgba(231,76,60,.3); }
  </style>
</head>
<body>

<% const cur = tenant.currency || '$' %>

<div class="topbar">
  <div style="display:flex;align-items:center;gap:8px">
    <a href="/admin" class="btn btn-ghost" style="padding:6px 10px;font-size:1.1rem" title="Home">🏠</a>
    <a href="/inventory" class="btn btn-ghost">Inventory</a>
    <span style="font-weight:700;color:#fff">🏢 Suppliers</span>
  </div>
  <div style="display:flex;gap:8px">
    <a href="/inventory/purchases" class="btn btn-ghost">📥 Purchases</a>
    <button class="btn btn-primary" onclick="openCreate()">+ New Supplier</button>
  </div>
</div>

<div class="main">
  <% const totalDue = suppliers.reduce((s,x) => s + Math.max(0, x.total_purchased + x.opening_balance - x.paid), 0) %>
  <div class="stats-row">
    <div class="stat">
      <div class="stat-label">Total Suppliers</div>
      <div class="stat-val"><%= suppliers.length %></div>
    </div>
    <div class="stat">
      <div class="stat-label">Total Purchased</div>
      <div class="stat-val"><%= cur %><%= suppliers.reduce((s,x)=>s+x.total_purchased,0).toFixed(0) %></div>
    </div>
    <div class="stat">
      <div class="stat-label">Outstanding Balance</div>
      <div class="stat-val" style="color:#e74c3c"><%= cur %><%= totalDue.toFixed(0) %></div>
    </div>
  </div>

  <div class="card">
    <table>
      <thead>
        <tr>
          <th>Supplier</th>
          <th>Phone / Email</th>
          <th>Tax No</th>
          <th>Receipts</th>
          <th>Total Purchased</th>
          <th>Paid</th>
          <th>Balance Due</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
      <% suppliers.forEach(s => {
        const due = s.total_purchased + (parseFloat(s.opening_balance)||0) - s.paid;
      %>
      <tr>
        <td style="color:#fff;font-weight:700"><%= s.name %></td>
        <td style="font-size:.8rem;color:#888"><%= s.phone || '' %><% if (s.phone && s.email) { %><br><% } %><%= s.email || '' %></td>
        <td style="font-size:.8rem;color:#555"><%= s.tax_no || '—' %></td>
        <td style="text-align:center"><%= s.receipt_count %></td>
        <td><%= cur %><%= s.total_purchased.toFixed(2) %></td>
        <td style="color:#00b894"><%= cur %><%= s.paid.toFixed(2) %></td>
        <td class="<%= due > 0.01 ? 'balance-due' : 'balance-ok' %>"><%= cur %><%= due.toFixed(2) %></td>
        <td>
          <div style="display:flex;gap:6px">
            <button class="btn btn-ghost btn-sm" onclick='openEdit(<%= JSON.stringify(s) %>)'>✏️</button>
            <form method="POST" action="/inventory/suppliers/<%= s.id %>/delete" onsubmit="return confirm('Delete supplier <%= s.name %>?')">
              <button type="submit" class="btn btn-danger btn-sm">✕</button>
            </form>
          </div>
        </td>
      </tr>
      <% }) %>
      <% if (!suppliers.length) { %>
      <tr><td colspan="8" style="text-align:center;color:#444;padding:32px">No suppliers yet. Add the first one.</td></tr>
      <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- Create modal -->
<div class="modal-bg" id="modalCreate">
  <div class="modal">
    <div class="modal-title">➕ New Supplier</div>
    <form method="POST" action="/inventory/suppliers">
      <div class="form-group"><label class="form-label">Name *</label><input name="name" class="form-input" required placeholder="Supplier name" /></div>
      <div class="form-grid">
        <div class="form-group"><label class="form-label">Phone</label><input name="phone" class="form-input" placeholder="+964..." /></div>
        <div class="form-group"><label class="form-label">Email</label><input name="email" class="form-input" type="email" /></div>
      </div>
      <div class="form-group"><label class="form-label">Address</label><input name="address" class="form-input" /></div>
      <div class="form-grid">
        <div class="form-group"><label class="form-label">Tax No</label><input name="tax_no" class="form-input" /></div>
        <div class="form-group"><label class="form-label">Opening Balance</label><input name="opening_balance" class="form-input" type="number" step="0.01" value="0" /></div>
      </div>
      <div class="form-group"><label class="form-label">Notes</label><textarea name="notes" class="form-input" rows="2" style="resize:vertical"></textarea></div>
      <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:8px">
        <button type="button" class="btn btn-ghost" onclick="closeAll()">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
      </div>
    </form>
  </div>
</div>

<!-- Edit modal -->
<div class="modal-bg" id="modalEdit">
  <div class="modal">
    <div class="modal-title">✏️ Edit Supplier</div>
    <form method="POST" id="editForm">
      <div class="form-group"><label class="form-label">Name *</label><input name="name" id="editName" class="form-input" required /></div>
      <div class="form-grid">
        <div class="form-group"><label class="form-label">Phone</label><input name="phone" id="editPhone" class="form-input" /></div>
        <div class="form-group"><label class="form-label">Email</label><input name="email" id="editEmail" class="form-input" type="email" /></div>
      </div>
      <div class="form-group"><label class="form-label">Address</label><input name="address" id="editAddress" class="form-input" /></div>
      <div class="form-grid">
        <div class="form-group"><label class="form-label">Tax No</label><input name="tax_no" id="editTaxNo" class="form-input" /></div>
        <div class="form-group"><label class="form-label">Opening Balance</label><input name="opening_balance" id="editOpeningBalance" class="form-input" type="number" step="0.01" /></div>
      </div>
      <div class="form-group"><label class="form-label">Notes</label><textarea name="notes" id="editNotes" class="form-input" rows="2" style="resize:vertical"></textarea></div>
      <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:8px">
        <button type="button" class="btn btn-ghost" onclick="closeAll()">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
      </div>
    </form>
  </div>
</div>

<% if (locals.success) { %>
<div class="toast toast-ok" id="toast"><%= locals.success %></div>
<% } %>
<% if (locals.error) { %>
<div class="toast toast-err" id="toast"><%= locals.error %></div>
<% } %>

<script>
function openCreate() { document.getElementById('modalCreate').classList.add('open'); }
function closeAll() { document.querySelectorAll('.modal-bg').forEach(m => m.classList.remove('open')); }
function openEdit(s) {
  document.getElementById('editForm').action = '/inventory/suppliers/' + s.id + '/edit';
  document.getElementById('editName').value = s.name || '';
  document.getElementById('editPhone').value = s.phone || '';
  document.getElementById('editEmail').value = s.email || '';
  document.getElementById('editAddress').value = s.address || '';
  document.getElementById('editTaxNo').value = s.tax_no || '';
  document.getElementById('editOpeningBalance').value = s.opening_balance || 0;
  document.getElementById('editNotes').value = s.notes || '';
  document.getElementById('modalEdit').classList.add('open');
}
document.querySelectorAll('.modal-bg').forEach(m => m.addEventListener('click', e => { if (e.target === m) closeAll(); }));
setTimeout(() => { const t = document.getElementById('toast'); if (t) t.remove(); }, 3500);
</script>
</body>
</html>
