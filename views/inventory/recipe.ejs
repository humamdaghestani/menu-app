<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Recipe — <%= item.name %></title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Segoe UI', sans-serif; background: #0f0f1a; color: #e0e0e0; min-height: 100vh; }
    .topbar { background: #1a1a2e; height: 56px; display: flex; align-items: center; justify-content: space-between; padding: 0 24px; border-bottom: 1px solid rgba(255,255,255,.07); }
    .btn { padding: 7px 14px; border: none; border-radius: 8px; cursor: pointer; font-size: .82rem; font-weight: 600; font-family: inherit; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; }
    .btn-ghost { background: rgba(255,255,255,.08); color: #ccc; }
    .btn-ghost:hover { background: rgba(255,255,255,.14); color: #fff; }
    .btn-primary { background: #7c5cbf; color: #fff; }
    .btn-primary:hover { opacity: .88; }
    .btn-danger { background: rgba(231,76,60,.15); color: #e74c3c; border: 1px solid rgba(231,76,60,.3); }
    .btn-danger:hover { background: rgba(231,76,60,.25); }
    .btn-sm { padding: 4px 10px; font-size: .75rem; }

    .main { padding: 24px; max-width: 900px; margin: 0 auto; }
    .page-header { margin-bottom: 28px; }
    .page-title { font-size: 1.3rem; font-weight: 800; color: #fff; }
    .page-sub { font-size: .82rem; color: #555; margin-top: 6px; }

    .cost-banner { background: linear-gradient(135deg, rgba(124,92,191,.2), rgba(124,92,191,.08)); border: 1px solid rgba(124,92,191,.4); border-radius: 14px; padding: 20px 24px; margin-bottom: 24px; display: flex; align-items: center; gap: 24px; flex-wrap: wrap; }
    .cost-main { font-size: 2rem; font-weight: 800; color: #a78bdf; }
    .cost-label { font-size: .75rem; color: #666; text-transform: uppercase; font-weight: 700; }
    .cost-margin { font-size: 1rem; font-weight: 700; }

    .card { background: #1a1a2e; border-radius: 14px; border: 1px solid #2a2a3e; padding: 20px; margin-bottom: 20px; }
    .card-title { font-size: .9rem; font-weight: 700; color: #fff; margin-bottom: 16px; }

    table { width: 100%; border-collapse: collapse; }
    th { text-align: left; font-size: .72rem; text-transform: uppercase; color: #444; font-weight: 700; padding: 8px 12px; border-bottom: 1px solid #2a2a3e; }
    td { padding: 10px 12px; font-size: .85rem; color: #ccc; border-bottom: 1px solid rgba(255,255,255,.04); vertical-align: middle; }
    tr:last-child td { border-bottom: none; }

    .empty-recipe { text-align: center; padding: 40px; color: #444; font-size: .85rem; }

    .add-form { display: flex; gap: 10px; align-items: flex-end; flex-wrap: wrap; }
    .form-group { display: flex; flex-direction: column; gap: 5px; flex: 1; min-width: 140px; }
    .form-label { font-size: .72rem; font-weight: 700; color: #555; text-transform: uppercase; }
    .form-input { padding: 8px 12px; background: #0f0f1a; border: 1.5px solid #2a2a3e; border-radius: 8px; color: #fff; font-size: .88rem; font-family: inherit; outline: none; }
    .form-input:focus { border-color: #7c5cbf; }
    select.form-input option { background: #1a1a2e; }

    .qty-edit { display: flex; gap: 6px; align-items: center; }
    .qty-input { width: 80px; padding: 4px 8px; background: #0f0f1a; border: 1.5px solid #2a2a3e; border-radius: 6px; color: #fff; font-size: .85rem; font-family: inherit; outline: none; }
  </style>
</head>
<body>

<div class="topbar">
  <div style="display:flex;align-items:center;gap:12px">
    <a href="/admin" class="btn btn-ghost" style="padding:6px 10px;font-size:1.1rem;flex-shrink:0" title="All Modules">🏠</a>
    <a href="/inventory" class="btn btn-ghost" style="padding:5px 14px;font-size:.82rem;font-weight:600;flex-shrink:0">Inventory</a>
    <button onclick="history.back()" class="btn btn-ghost">← Back</button>
    <span style="font-weight:700;color:#fff">📝 Recipe: <%= item.name %></span>
    <span style="font-size:.72rem;color:#555">
      <% if (item.is_raw_material) { %>Raw Material<% } %>
      <% if (item.is_semi_finished) { %><% if (item.is_raw_material) { %> · <% } %>Semi-Finished<% } %>
      <% if (item.can_be_sold) { %><% if (item.is_raw_material || item.is_semi_finished) { %> · <% } %>Can Be Sold<% } %>
       · <%= item.unit %>
    </span>
  </div>
</div>

<div class="main">

  <% if (success === 'location_saved') { %>
  <div style="background:#1e3a2e;border:1px solid #00b894;color:#00b894;padding:10px 16px;border-radius:8px;margin-bottom:16px;font-size:.85rem">✅ Production location saved.</div>
  <% } %>

  <!-- Cost banner -->
  <div class="cost-banner">
    <div>
      <div class="cost-label">Recipe Cost (per <%= item.unit %>)</div>
      <div class="cost-main"><%= tenant.currency || '$' %><%= totalCost.toFixed(4) %></div>
    </div>
    <% if (item.menu_item_id) { %>
    <div style="border-left:1px solid rgba(124,92,191,.3);padding-left:24px">
      <div class="cost-label">Linked Menu Item</div>
      <div style="font-size:1rem;font-weight:700;color:#a78bdf;margin-top:4px"><%= item.menu_item_name || 'Linked' %></div>
    </div>
    <% } %>
    <div style="border-left:1px solid rgba(124,92,191,.3);padding-left:24px">
      <div class="cost-label">Ingredients</div>
      <div style="font-size:1rem;font-weight:700;color:#fff;margin-top:4px"><%= recipe.length %> lines</div>
    </div>
    <% if (item.menu_item_id && locations.length) { %>
    <div style="border-left:1px solid rgba(124,92,191,.3);padding-left:24px">
      <div class="cost-label" style="margin-bottom:8px">Production Location</div>
      <form method="POST" action="/inventory/items/<%= item.id %>/set-location" style="display:flex;gap:8px;align-items:center">
        <select name="production_location_id" class="form-input" style="min-width:150px;padding:6px 10px;font-size:.82rem">
          <option value="">— None —</option>
          <% locations.forEach(l => { %>
          <option value="<%= l.id %>" <%= item.production_location_id == l.id ? 'selected' : '' %>><%= l.name %></option>
          <% }); %>
        </select>
        <button type="submit" class="btn btn-primary" style="padding:6px 12px;font-size:.78rem">Save</button>
      </form>
    </div>
    <% } %>
  </div>

  <!-- Current recipe -->
  <div class="card">
    <div class="card-title">🧪 Ingredients</div>
    <% if (recipe.length === 0) { %>
    <div class="empty-recipe">No ingredients yet. Add the first one below.</div>
    <% } else { %>
    <table>
      <thead>
        <tr><th>Ingredient</th><th>Unit</th><th>Quantity</th><th>Avg Cost</th><th>Line Cost</th><th></th></tr>
      </thead>
      <tbody>
      <% recipe.forEach(r => { %>
      <tr>
        <td style="color:#fff;font-weight:600"><%= r.ingredient_name %></td>
        <td style="color:#555"><%= r.unit %></td>
        <td>
          <form method="POST" action="/inventory/items/<%= item.id %>/recipe/<%= r.id %>/edit" class="qty-edit">
            <input type="number" name="quantity" class="qty-input" value="<%= parseFloat(r.quantity) %>" step="0.0001" min="0.0001" required />
            <button type="submit" class="btn btn-ghost btn-sm">Save</button>
          </form>
        </td>
        <td style="color:#666"><%= tenant.currency || '$' %><%= parseFloat(r.avg_cost).toFixed(4) %></td>
        <td style="color:#a78bdf;font-weight:600"><%= tenant.currency || '$' %><%= parseFloat(r.line_cost).toFixed(4) %></td>
        <td>
          <form method="POST" action="/inventory/items/<%= item.id %>/recipe/<%= r.id %>/delete" onsubmit="return confirm('Remove ingredient?')">
            <button type="submit" class="btn btn-danger btn-sm">✕</button>
          </form>
        </td>
      </tr>
      <% }) %>
      </tbody>
    </table>
    <% } %>
  </div>

  <!-- True Cost Analysis -->
  <%
    const payrollPerPortion  = overhead.totalPortions > 0 ? overhead.monthlyPayroll  / overhead.totalPortions : 0;
    const expensePerPortion  = overhead.totalPortions > 0 ? overhead.monthlyExpenses / overhead.totalPortions : 0;
    const trueTotal          = totalCost + payrollPerPortion + expensePerPortion;
    const sellPrice          = overhead.sellPrice || 0;
    const trueProfit         = sellPrice - trueTotal;
    const trueMarginPct      = sellPrice > 0 ? (trueProfit / sellPrice * 100) : 0;
    const foodCostPct        = sellPrice > 0 ? (totalCost / sellPrice * 100) : 0;
    const hasSell            = sellPrice > 0;
    const cur                = tenant.currency || '$';
  %>
  <div class="card" style="border-color:rgba(0,184,148,.3)">
    <div class="card-title" style="color:#00b894">📊 True Cost per Portion (last 30 days)</div>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:16px;margin-bottom:20px">
      <div style="background:#0f0f1a;border-radius:10px;padding:14px">
        <div style="font-size:.68rem;text-transform:uppercase;color:#444;font-weight:700;margin-bottom:6px">🧪 Ingredient Cost</div>
        <div style="font-size:1.3rem;font-weight:800;color:#a78bdf"><%= cur %><%= totalCost.toFixed(4) %></div>
        <div style="font-size:.72rem;color:#555;margin-top:3px">BOM / recipe cost</div>
      </div>
      <div style="background:#0f0f1a;border-radius:10px;padding:14px">
        <div style="font-size:.68rem;text-transform:uppercase;color:#444;font-weight:700;margin-bottom:6px">👥 Labor per Portion</div>
        <div style="font-size:1.3rem;font-weight:800;color:#3498db"><%= cur %><%= payrollPerPortion.toFixed(4) %></div>
        <div style="font-size:.72rem;color:#555;margin-top:3px">
          <% if (overhead.monthlyPayroll > 0) { %>
          <%= cur %><%= overhead.monthlyPayroll.toLocaleString(undefined,{maximumFractionDigits:0}) %> salary ÷ <%= overhead.totalPortions.toLocaleString(undefined,{maximumFractionDigits:0}) %> portions
          <% } else { %>No payroll data<% } %>
        </div>
      </div>
      <div style="background:#0f0f1a;border-radius:10px;padding:14px">
        <div style="font-size:.68rem;text-transform:uppercase;color:#444;font-weight:700;margin-bottom:6px">🏢 Fixed Overhead</div>
        <div style="font-size:1.3rem;font-weight:800;color:#e67e22"><%= cur %><%= expensePerPortion.toFixed(4) %></div>
        <div style="font-size:.72rem;color:#555;margin-top:3px">
          <% if (overhead.monthlyExpenses > 0) { %>
          Rent + expenses ÷ <%= overhead.totalPortions.toLocaleString(undefined,{maximumFractionDigits:0}) %> portions
          <% } else { %>No expense data<% } %>
        </div>
      </div>
      <div style="background:linear-gradient(135deg,rgba(0,184,148,.12),rgba(0,184,148,.04));border:1px solid rgba(0,184,148,.3);border-radius:10px;padding:14px">
        <div style="font-size:.68rem;text-transform:uppercase;color:#00b894;font-weight:700;margin-bottom:6px">= TRUE COST</div>
        <div style="font-size:1.5rem;font-weight:800;color:#00b894"><%= cur %><%= trueTotal.toFixed(4) %></div>
        <div style="font-size:.72rem;color:#555;margin-top:3px">Full cost per portion</div>
      </div>
    </div>
    <% if (hasSell) { %>
    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;padding-top:12px;border-top:1px solid #2a2a3e">
      <div style="text-align:center">
        <div style="font-size:.68rem;text-transform:uppercase;color:#444;font-weight:700;margin-bottom:4px">Sell Price</div>
        <div style="font-size:1.2rem;font-weight:800;color:#fff"><%= cur %><%= sellPrice.toFixed(2) %></div>
      </div>
      <div style="text-align:center">
        <div style="font-size:.68rem;text-transform:uppercase;color:#444;font-weight:700;margin-bottom:4px">True Profit</div>
        <div style="font-size:1.2rem;font-weight:800;color:<%= trueProfit >= 0 ? '#00b894' : '#e74c3c' %>"><%= cur %><%= trueProfit.toFixed(2) %></div>
      </div>
      <div style="text-align:center">
        <div style="font-size:.68rem;text-transform:uppercase;color:#444;font-weight:700;margin-bottom:4px">True Margin</div>
        <div style="font-size:1.2rem;font-weight:800;color:<%= trueMarginPct >= 50 ? '#00b894' : trueMarginPct >= 30 ? '#f39c12' : '#e74c3c' %>"><%= trueMarginPct.toFixed(1) %>%</div>
      </div>
    </div>
    <div style="display:flex;gap:8px;margin-top:10px;padding-top:10px;border-top:1px solid #1a1a2e;font-size:.75rem;color:#555">
      <span>Food cost only: <strong style="color:<%= foodCostPct <= 30 ? '#00b894' : '#e74c3c' %>"><%= foodCostPct.toFixed(1) %>%</strong></span>
      <span style="margin-left:auto;color:#333">True cost includes labor + overhead allocation from last 30 days</span>
    </div>
    <% } else { %>
    <div style="font-size:.78rem;color:#444;padding-top:10px;border-top:1px solid #2a2a3e">Link this item to a menu item to see sell price and margin analysis.</div>
    <% } %>
  </div>

  <!-- Add ingredient -->
  <div class="card">
    <div class="card-title">➕ Add Ingredient</div>
    <form method="POST" action="/inventory/items/<%= item.id %>/recipe" class="add-form">
      <div class="form-group">
        <label class="form-label">Ingredient</label>
        <select name="ingredient_id" class="form-input" required>
          <option value="">— Select —</option>
          <% ingredients.forEach(ing => { %>
          <option value="<%= ing.id %>"><%= ing.name %> (<%= ing.unit %>) — cost: <%= tenant.currency || '$' %><%= parseFloat(ing.avg_cost).toFixed(4) %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group" style="max-width:140px">
        <label class="form-label">Quantity used</label>
        <input type="number" name="quantity" class="form-input" step="0.0001" min="0.0001" placeholder="e.g. 0.25" required />
      </div>
      <button type="submit" class="btn btn-primary" style="align-self:flex-end">Add</button>
    </form>
  </div>

</div>
</body>
</html>
