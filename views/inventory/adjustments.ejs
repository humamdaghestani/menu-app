<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Adjustments — <%= tenant.name %></title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Segoe UI', sans-serif; background: #0f0f1a; color: #e0e0e0; min-height: 100vh; }
    .topbar { background: #1a1a2e; height: 60px; display: flex; align-items: center; justify-content: space-between; padding: 0 20px; border-bottom: 1px solid rgba(255,255,255,.07); position: sticky; top: 0; z-index: 100; }
    .topbar-brand { font-weight: 700; color: #fff; font-size: 1rem; }
    .topbar-sub { font-size: .72rem; color: #555; }
    .btn { padding: 7px 14px; border: none; border-radius: 8px; cursor: pointer; font-size: .82rem; font-weight: 600; font-family: inherit; text-decoration: none; display: inline-flex; align-items: center; gap: 5px; }
    .btn-ghost { background: rgba(255,255,255,.08); color: #ccc; }
    .btn-ghost:hover { background: rgba(255,255,255,.14); color: #fff; }
    .btn-primary { background: #f39c12; color: #fff; }
    .main { padding: 28px; max-width: 1100px; margin: 0 auto; }
    .section { background: #1a1a2e; border: 1.5px solid #2a2a3e; border-radius: 12px; padding: 20px; margin-bottom: 20px; }
    .section h3 { color: #fff; font-size: .92rem; font-weight: 700; margin-bottom: 16px; }
    table { width: 100%; border-collapse: collapse; font-size: .85rem; }
    th { text-align: left; color: #555; font-size: .72rem; text-transform: uppercase; padding: 8px 10px; border-bottom: 1px solid #2a2a3e; }
    td { padding: 10px; border-bottom: 1px solid #1e1e32; color: #ccc; }
    tr:last-child td { border-bottom: none; }
    .badge { display: inline-block; padding: 2px 8px; border-radius: 20px; font-size: .7rem; font-weight: 700; }
    .badge-write-off { background: rgba(231,76,60,.15); color: #e74c3c; }
    .badge-spoilage { background: rgba(231,76,60,.12); color: #c0392b; }
    .badge-correction-in { background: rgba(0,184,148,.15); color: #00b894; }
    .badge-correction-out { background: rgba(243,156,18,.15); color: #f39c12; }
    .form-group { margin-bottom: 12px; }
    .form-group label { display: block; font-size: .78rem; color: #aaa; margin-bottom: 4px; }
    .form-group input, .form-group select, .form-group textarea { width: 100%; background: #0f0f1a; border: 1.5px solid #2a2a3e; color: #fff; padding: 8px 10px; border-radius: 8px; font-size: .85rem; font-family: inherit; }
    .err { background: rgba(231,76,60,.12); color: #e74c3c; border-radius: 8px; padding: 10px 14px; margin-bottom: 16px; font-size: .85rem; }
  </style>
</head>
<body>
<div class="topbar">
  <div style="display:flex;align-items:center;gap:8px">
    <a href="/admin" class="btn btn-ghost" style="padding:6px 10px;font-size:1.1rem;flex-shrink:0" title="All Modules">🏠</a>
    <div>
      <div class="topbar-brand">📝 Stock Adjustments</div>
      <div class="topbar-sub"><%= tenant.name %></div>
    </div>
  </div>
  <div style="display:flex;gap:8px">
    <a href="/inventory" class="btn btn-ghost">📦 Inventory</a>
    <a href="/inventory/items" class="btn btn-ghost">🗃 Items</a>
    <button onclick="history.back()" class="btn btn-ghost">← Back</button>
  </div>
</div>

<div class="main">
  <% if (locals.error) { %><div class="err"><%= locals.error %></div><% } %>

  <div style="display:grid;grid-template-columns:1fr 320px;gap:20px">
    <div class="section">
      <h3>📋 Adjustment Log</h3>
      <table>
        <thead><tr><th>Item</th><th>Type</th><th>Qty Change</th><th>Cost Impact</th><th>Reason</th><th>Date</th></tr></thead>
        <tbody>
        <% adjustments.forEach(a => { %>
        <tr>
          <td style="color:#fff;font-weight:600"><%= a.item_name || '—' %></td>
          <td><span class="badge badge-<%= a.type %>"><%= a.type %></span></td>
          <td style="color:<%= parseFloat(a.qty_change) >= 0 ? '#00b894' : '#e74c3c' %>;font-weight:700">
            <%= parseFloat(a.qty_change) >= 0 ? '+' : '' %><%= parseFloat(a.qty_change).toFixed(3) %>
          </td>
          <td style="color:#e74c3c">$<%= parseFloat(a.cost_impact).toFixed(2) %></td>
          <td style="font-size:.78rem;color:#aaa"><%= a.reason || '—' %></td>
          <td style="font-size:.78rem;color:#555"><%= a.created_at.toISOString().slice(0,10) %></td>
        </tr>
        <% }) %>
        <% if (!adjustments.length) { %><tr><td colspan="6" style="color:#555;text-align:center;padding:24px">No adjustments yet</td></tr><% } %>
        </tbody>
      </table>
    </div>

    <div class="section">
      <h3>➕ New Adjustment</h3>
      <form method="POST" action="/inventory/adjustments">
        <div class="form-group">
          <label>Item *</label>
          <select name="item_id" required>
            <option value="">Select item...</option>
            <% items.forEach(i => { %><option value="<%= i.id %>"><%= i.name %> (Stock: <%= parseFloat(i.stock_qty).toFixed(2) %> <%= i.unit %>)</option><% }) %>
          </select>
        </div>
        <div class="form-group">
          <label>Adjustment Type *</label>
          <select name="type" required>
            <option value="write-off">Write-off (remove)</option>
            <option value="spoilage">Spoilage (remove)</option>
            <option value="correction-out">Correction — Out (remove)</option>
            <option value="correction-in">Correction — In (add)</option>
          </select>
        </div>
        <div class="form-group">
          <label>Quantity *</label>
          <input type="number" name="qty_change" step="0.001" required placeholder="Enter quantity (positive number)" min="0.001" />
          <div style="font-size:.72rem;color:#555;margin-top:3px">Enter a positive number. Direction is set by type above.</div>
        </div>
        <div class="form-group">
          <label>Reason</label>
          <input type="text" name="reason" placeholder="Damaged, expired, counting error..." />
        </div>
        <button type="submit" class="btn btn-primary" style="width:100%">Record Adjustment</button>
      </form>
    </div>
  </div>
</div>
</body>
</html>
