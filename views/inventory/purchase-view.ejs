<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Receipt #<%= receipt.id %> — <%= tenant.name %></title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Segoe UI', sans-serif; background: #0f0f1a; color: #e0e0e0; min-height: 100vh; }
    .topbar { background: #1a1a2e; height: 56px; display: flex; align-items: center; justify-content: space-between; padding: 0 24px; border-bottom: 1px solid rgba(255,255,255,.07); }
    .btn { padding: 7px 14px; border: none; border-radius: 8px; cursor: pointer; font-size: .82rem; font-weight: 600; font-family: inherit; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; }
    .btn-ghost { background: rgba(255,255,255,.08); color: #ccc; }
    .btn-ghost:hover { background: rgba(255,255,255,.14); color: #fff; }
    .btn-danger { background: rgba(231,76,60,.15); color: #e74c3c; border: 1px solid rgba(231,76,60,.3); }
    .btn-danger:hover { background: rgba(231,76,60,.25); }
    .badge-voided { display: inline-block; padding: 3px 12px; border-radius: 20px; font-size: .75rem; font-weight: 700; background: rgba(231,76,60,.15); color: #e74c3c; border: 1px solid rgba(231,76,60,.3); }
    .badge-active { display: inline-block; padding: 3px 12px; border-radius: 20px; font-size: .75rem; font-weight: 700; background: rgba(0,184,148,.15); color: #00b894; border: 1px solid rgba(0,184,148,.3); }
    .main { padding: 24px; max-width: 800px; margin: 0 auto; }
    .toast { position: fixed; top: 70px; right: 20px; padding: 10px 18px; border-radius: 10px; font-size: .85rem; font-weight: 600; z-index: 9999; }
    .toast-ok  { background: rgba(0,184,148,.2); color: #00b894; border: 1px solid rgba(0,184,148,.3); }
    .toast-err { background: rgba(231,76,60,.2); color: #e74c3c; border: 1px solid rgba(231,76,60,.3); }
    .card { background: #1a1a2e; border-radius: 14px; border: 1px solid #2a2a3e; padding: 24px; margin-bottom: 20px; }
    .receipt-header { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 16px; margin-bottom: 24px; }
    .rh-item { }
    .rh-label { font-size: .7rem; text-transform: uppercase; color: #444; font-weight: 700; margin-bottom: 4px; }
    .rh-val { font-size: .95rem; color: #fff; font-weight: 600; }
    table { width: 100%; border-collapse: collapse; }
    th { text-align: left; font-size: .72rem; text-transform: uppercase; color: #444; font-weight: 700; padding: 8px 12px; border-bottom: 1px solid #2a2a3e; }
    td { padding: 10px 12px; font-size: .85rem; color: #ccc; border-bottom: 1px solid rgba(255,255,255,.04); }
    tr:last-child td { border-bottom: none; }
    .grand { display: flex; justify-content: flex-end; gap: 16px; align-items: center; padding-top: 14px; border-top: 1px solid #2a2a3e; margin-top: 8px; }
    .img-card { background: #1a1a2e; border-radius: 14px; border: 1px solid #2a2a3e; padding: 20px; margin-bottom: 20px; }
    .img-card-title { font-size: .85rem; font-weight: 700; color: #fff; margin-bottom: 14px; }
    .drop-zone { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; border: 2px dashed #2a2a3e; border-radius: 10px; padding: 22px 14px; cursor: pointer; transition: border-color .15s; min-height: 90px; }
    .drop-zone:hover, .drop-zone.hover { border-color: #7c5cbf; }
    .bill-img { max-width: 100%; max-height: 480px; border-radius: 10px; border: 1px solid #2a2a3e; object-fit: contain; display: block; cursor: zoom-in; }
    .lightbox { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.92); z-index: 9000; align-items: center; justify-content: center; }
    .lightbox.open { display: flex; }
    .lightbox img { max-width: 95vw; max-height: 95vh; border-radius: 10px; object-fit: contain; }
  </style>
</head>
<body>

<div class="topbar">
  <div style="display:flex;align-items:center;gap:12px">
    <a href="/admin" class="btn btn-ghost" style="padding:6px 10px;font-size:1.1rem;flex-shrink:0" title="All Modules">🏠</a>
    <a href="/inventory" class="btn btn-ghost" style="padding:5px 14px;font-size:.82rem;font-weight:600;flex-shrink:0">Inventory</a>
    <button onclick="history.back()" class="btn btn-ghost">← Back</button>
    <span style="font-weight:700;color:#fff">🧾 Receipt #<%= receipt.id %></span>
    <span class="badge-<%= receipt.status || 'active' %>"><%= receipt.status || 'active' %></span>
  </div>
  <% if ((receipt.status || 'active') === 'active') { %>
  <form method="POST" action="/inventory/purchases/<%= receipt.id %>/void" onsubmit="return confirm('Void this receipt? Stock will be reversed.')">
    <button type="submit" class="btn btn-danger">🚫 Void Receipt</button>
  </form>
  <% } %>
</div>
<% if (locals.success) { %><div class="toast toast-ok" id="toast"><%= locals.success %></div><% } %>
<% if (locals.error)   { %><div class="toast toast-err" id="toast"><%= locals.error %></div><% } %>
<script>setTimeout(()=>{const t=document.getElementById('toast');if(t)t.remove();},3500);</script>

<div class="main">
  <div class="card">
    <div class="receipt-header">
      <div class="rh-item">
        <div class="rh-label">Date</div>
        <div class="rh-val"><%= new Date(receipt.receipt_date || receipt.created_at).toLocaleDateString() %></div>
      </div>
      <div class="rh-item">
        <div class="rh-label">Supplier</div>
        <div class="rh-val"><%= receipt.supplier_name || '—' %></div>
      </div>
      <div class="rh-item">
        <div class="rh-label">Invoice #</div>
        <div class="rh-val"><%= receipt.invoice_no || '—' %></div>
      </div>
      <div class="rh-item">
        <div class="rh-label">Created By</div>
        <div class="rh-val"><%= receipt.created_by_name || '—' %></div>
      </div>
      <% if (receipt.notes) { %>
      <div class="rh-item" style="grid-column:1/-1">
        <div class="rh-label">Notes</div>
        <div class="rh-val" style="color:#888"><%= receipt.notes %></div>
      </div>
      <% } %>
    </div>

    <table>
      <thead>
        <tr><th>Item</th><th>Unit</th><th>Quantity</th><th>Unit Price</th><th>Total</th></tr>
      </thead>
      <tbody>
      <% lines.forEach(l => { %>
      <tr>
        <td style="color:#fff;font-weight:600"><%= l.item_name || '—' %></td>
        <td style="color:#555"><%= l.unit || '—' %></td>
        <td><%= parseFloat(l.quantity).toFixed(3) %></td>
        <td style="color:#7c5cbf"><%= tenant.currency || '$' %><%= parseFloat(l.unit_price).toFixed(4) %></td>
        <td style="color:#fff;font-weight:700"><%= tenant.currency || '$' %><%= parseFloat(l.total).toFixed(2) %></td>
      </tr>
      <% }) %>
      </tbody>
    </table>

    <div class="grand">
      <span style="font-size:.85rem;color:#555">Grand Total</span>
      <span style="font-size:1.4rem;font-weight:800;color:#fff"><%= tenant.currency || '$' %><%= parseFloat(receipt.total).toFixed(2) %></span>
    </div>
  </div>

  <!-- Bill Image -->
  <div class="img-card">
    <div class="img-card-title">📎 Bill Image</div>
    <% if (receipt.bill_image) { %>
    <img src="<%= receipt.bill_image %>" class="bill-img" onclick="openLightbox()" alt="Bill image" />
    <div style="display:flex;gap:10px;margin-top:12px;align-items:center">
      <button onclick="openLightbox()" class="btn btn-ghost">🔍 Full Size</button>
      <a href="<%= receipt.bill_image %>" download="receipt-<%= receipt.id %>.jpg" class="btn btn-ghost">⬇ Download</a>
      <form method="POST" action="/inventory/purchases/<%= receipt.id %>/image/delete" onsubmit="return confirm('Remove the bill image?')" style="margin-left:auto">
        <button type="submit" class="btn btn-danger" style="font-size:.78rem">✕ Remove</button>
      </form>
    </div>
    <div style="margin-top:14px;border-top:1px solid #2a2a3e;padding-top:14px">
      <div style="font-size:.75rem;color:#555;margin-bottom:8px">Replace image</div>
    <% } else { %>
    <div style="font-size:.82rem;color:#555;margin-bottom:12px">No image attached yet.</div>
    <% } %>
    <form method="POST" action="/inventory/purchases/<%= receipt.id %>/image" id="imgUploadForm">
      <input type="hidden" name="bill_image" id="billImageData" />
      <label for="billImageFile" id="imgDropZone" class="drop-zone">
        <span style="font-size:1.6rem">🖼️</span>
        <span style="font-size:.82rem;color:#555">Click or drag image here</span>
        <span style="font-size:.72rem;color:#444">Any image — auto-resized &amp; compressed</span>
      </label>
      <input type="file" id="billImageFile" accept="image/*" style="display:none" onchange="handleBillImage(this.files[0])" />
      <div id="imgPreviewWrap" style="display:none;margin-top:10px">
        <img id="imgPreviewEl" style="max-width:100%;max-height:200px;border-radius:8px;border:1px solid #2a2a3e;object-fit:contain;display:block" />
        <div style="display:flex;align-items:center;gap:10px;margin-top:8px">
          <span id="imgSizeLabel" style="font-size:.72rem;color:#00b894"></span>
          <button type="button" onclick="clearBillImage()" style="background:none;border:none;color:#e74c3c;font-size:.78rem;cursor:pointer;font-family:inherit">✕ Remove</button>
          <button type="submit" class="btn btn-primary" style="margin-left:auto">💾 Save Image</button>
        </div>
      </div>
    </form>
    <% if (receipt.bill_image) { %></div><% } %>
  </div>
</div>

<!-- Lightbox -->
<div class="lightbox" id="lightbox" onclick="closeLightbox()">
  <% if (receipt.bill_image) { %>
  <img src="<%= receipt.bill_image %>" alt="Bill" />
  <% } %>
</div>

<script>
const MAX_PX  = 1200;
const QUALITY = 0.72;

function handleBillImage(file) {
  if (!file) return;
  const reader = new FileReader();
  reader.onload = e => resizeAndStore(e.target.result);
  reader.readAsDataURL(file);
}
function resizeAndStore(dataUrl) {
  const img = new Image();
  img.onload = () => {
    let { width: w, height: h } = img;
    if (w > MAX_PX || h > MAX_PX) {
      const ratio = Math.min(MAX_PX / w, MAX_PX / h);
      w = Math.round(w * ratio); h = Math.round(h * ratio);
    }
    const canvas = document.createElement('canvas');
    canvas.width = w; canvas.height = h;
    canvas.getContext('2d').drawImage(img, 0, 0, w, h);
    const out = canvas.toDataURL('image/jpeg', QUALITY);
    document.getElementById('billImageData').value = out;
    document.getElementById('imgPreviewEl').src = out;
    document.getElementById('imgPreviewWrap').style.display = 'block';
    document.getElementById('imgDropZone').style.borderColor = '#7c5cbf';
    const kb = Math.round(out.length * 0.75 / 1024);
    document.getElementById('imgSizeLabel').textContent = `${w}×${h}px · ~${kb} KB`;
  };
  img.src = dataUrl;
}
function clearBillImage() {
  document.getElementById('billImageData').value = '';
  document.getElementById('billImageFile').value = '';
  document.getElementById('imgPreviewWrap').style.display = 'none';
  document.getElementById('imgDropZone').style.borderColor = '#2a2a3e';
}
function openLightbox()  { document.getElementById('lightbox').classList.add('open'); }
function closeLightbox() { document.getElementById('lightbox').classList.remove('open'); }

const dz = document.getElementById('imgDropZone');
if (dz) {
  dz.addEventListener('dragover', e => { e.preventDefault(); dz.classList.add('hover'); });
  dz.addEventListener('dragleave', () => dz.classList.remove('hover'));
  dz.addEventListener('drop', e => {
    e.preventDefault(); dz.classList.remove('hover');
    const f = e.dataTransfer.files[0];
    if (f && f.type.startsWith('image/')) handleBillImage(f);
  });
}
</script>
</body>
</html>
