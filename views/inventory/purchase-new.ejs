<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>New Purchase Receipt — <%= tenant.name %></title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Segoe UI', sans-serif; background: #0f0f1a; color: #e0e0e0; min-height: 100vh; }
    .topbar { background: #1a1a2e; height: 56px; display: flex; align-items: center; justify-content: space-between; padding: 0 24px; border-bottom: 1px solid rgba(255,255,255,.07); }
    .btn { padding: 7px 14px; border: none; border-radius: 8px; cursor: pointer; font-size: .82rem; font-weight: 600; font-family: inherit; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; }
    .btn-ghost  { background: rgba(255,255,255,.08); color: #ccc; }
    .btn-ghost:hover  { background: rgba(255,255,255,.14); color: #fff; }
    .btn-primary { background: #7c5cbf; color: #fff; }
    .btn-primary:hover { opacity: .88; }
    .btn-success { background: #00b894; color: #fff; }
    .btn-success:hover { opacity: .88; }

    .main { padding: 24px; max-width: 960px; margin: 0 auto; }
    .card { background: #1a1a2e; border-radius: 14px; border: 1px solid #2a2a3e; padding: 20px; margin-bottom: 20px; }
    .card-title { font-size: .9rem; font-weight: 700; color: #fff; margin-bottom: 16px; display: flex; justify-content: space-between; align-items: center; }

    .form-row { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 14px; }
    .form-group { display: flex; flex-direction: column; gap: 6px; }
    .form-label { font-size: .72rem; font-weight: 700; color: #555; text-transform: uppercase; }
    .form-input { padding: 9px 12px; background: #0f0f1a; border: 1.5px solid #2a2a3e; border-radius: 8px; color: #fff; font-size: .9rem; font-family: inherit; outline: none; width: 100%; }
    .form-input:focus { border-color: #7c5cbf; }
    select.form-input option { background: #1a1a2e; }

    /* Lines table */
    .lines-table { width: 100%; border-collapse: collapse; }
    .lines-table th { text-align: left; font-size: .68rem; text-transform: uppercase; color: #444; font-weight: 700; padding: 6px 8px; border-bottom: 1px solid #2a2a3e; white-space: nowrap; }
    .lines-table td { padding: 5px 6px; border-bottom: 1px solid rgba(255,255,255,.03); vertical-align: top; }
    .line-input { width: 100%; padding: 7px 10px; background: #0f0f1a; border: 1.5px solid #2a2a3e; border-radius: 7px; color: #fff; font-size: .85rem; font-family: inherit; outline: none; }
    .line-input:focus { border-color: #7c5cbf; }

    /* Searchable item picker */
    .item-picker { position: relative; }
    .item-search { width: 100%; padding: 7px 28px 7px 10px; background: #0f0f1a; border: 1.5px solid #2a2a3e; border-radius: 7px; color: #fff; font-size: .85rem; font-family: inherit; outline: none; }
    .item-search:focus { border-color: #7c5cbf; }
    .item-search::placeholder { color: #444; }
    .picker-arrow { position: absolute; right: 8px; top: 50%; transform: translateY(-50%); color: #555; pointer-events: none; font-size: .7rem; }
    .picker-dropdown { display: none; position: absolute; top: calc(100% + 3px); left: 0; right: 0; background: #1a1a2e; border: 1.5px solid #7c5cbf; border-radius: 8px; z-index: 200; max-height: 220px; overflow-y: auto; box-shadow: 0 8px 24px rgba(0,0,0,.5); }
    .picker-dropdown.open { display: block; }
    .picker-opt { padding: 8px 12px; font-size: .85rem; color: #ccc; cursor: pointer; display: flex; align-items: center; gap: 8px; }
    .picker-opt:hover, .picker-opt.focused { background: rgba(124,92,191,.2); color: #fff; }
    .picker-opt.create { color: #7c5cbf; font-weight: 600; border-bottom: 1px solid #2a2a3e; }
    .picker-opt .unit-tag { font-size: .7rem; color: #555; background: #0f0f1a; padding: 1px 6px; border-radius: 4px; margin-left: auto; }
    .picker-empty { padding: 12px; font-size: .82rem; color: #444; text-align: center; }

    /* Supplier autocomplete */
    .supp-wrap { position: relative; }
    .supp-drop { display: none; position: absolute; top: calc(100% + 3px); left: 0; right: 0; background: #1a1a2e; border: 1.5px solid #7c5cbf; border-radius: 8px; z-index: 200; max-height: 220px; overflow-y: auto; box-shadow: 0 8px 24px rgba(0,0,0,.5); }
    .supp-drop.open { display: block; }
    .supp-opt { padding: 8px 12px; font-size: .88rem; color: #ccc; cursor: pointer; }
    .supp-opt:hover, .supp-opt.focused { background: rgba(124,92,191,.2); color: #fff; }
    .supp-opt-create { padding: 10px 12px; font-size: .88rem; color: #7c5cbf; font-weight: 700; cursor: pointer; border-top: 1px solid #2a2a3e; display: flex; align-items: center; gap: 8px; }
    .supp-opt-create:hover { background: rgba(124,92,191,.15); }

    /* Quick-create supplier modal */
    .qmodal-bg { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.75); z-index: 900; align-items: center; justify-content: center; }
    .qmodal-bg.open { display: flex; }
    .qmodal { background: #1a1a2e; border: 1px solid #2a2a3e; border-radius: 16px; padding: 28px; width: 480px; max-width: 96vw; max-height: 92vh; overflow-y: auto; }
    .qmodal-title { font-size: 1.05rem; font-weight: 800; color: #fff; margin-bottom: 20px; }
    .qf-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px; }
    .qf-group { display: flex; flex-direction: column; gap: 5px; }
    .qf-group.full { grid-column: 1/-1; }
    .qf-label { font-size: .7rem; font-weight: 700; color: #555; text-transform: uppercase; }
    .qf-input { padding: 9px 12px; background: #0f0f1a; border: 1.5px solid #2a2a3e; border-radius: 8px; color: #fff; font-size: .88rem; font-family: inherit; outline: none; width: 100%; }
    .qf-input:focus { border-color: #7c5cbf; }
    .qerror { color: #e74c3c; font-size: .82rem; margin-bottom: 10px; display: none; }

    /* New item inline */
    .new-item-row { display: none; margin-top: 4px; }
    .new-item-row.show { display: block; }
    .new-item-hint { font-size: .7rem; color: #f39c12; margin-bottom: 4px; }

    .line-total { font-size: .85rem; font-weight: 600; color: #a78bdf; white-space: nowrap; display:block; padding: 7px 4px; }
    .btn-remove { background: none; border: none; color: #e74c3c; cursor: pointer; font-size: 1.1rem; padding: 4px 8px; }
    .btn-remove:hover { color: #ff6b7a; }

    .total-row { display: flex; justify-content: flex-end; gap: 16px; align-items: center; margin-top: 16px; padding-top: 14px; border-top: 1px solid #2a2a3e; }

    .error-banner { background: rgba(231,76,60,.15); border: 1px solid rgba(231,76,60,.3); color: #e74c3c; padding: 12px 16px; border-radius: 8px; margin-bottom: 16px; font-size: .88rem; }
  </style>
</head>
<body>

<div class="topbar">
  <div style="display:flex;align-items:center;gap:12px">
    <a href="/admin" class="btn btn-ghost" style="padding:6px 10px;font-size:1.1rem;flex-shrink:0" title="All Modules">🏠</a>
    <a href="/inventory" class="btn btn-ghost" style="padding:5px 14px;font-size:.82rem;font-weight:600;flex-shrink:0">Inventory</a>
    <button onclick="history.back()" class="btn btn-ghost">← Back</button>
    <span style="font-weight:700;color:#fff">🧾 New Purchase Receipt</span>
  </div>
</div>

<div class="main">
  <% if (locals.error) { %>
  <div class="error-banner">⚠ Error: <%= error %></div>
  <% } %>

  <form method="POST" action="/inventory/purchases">

    <div class="card">
      <div class="card-title">Receipt Info</div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Supplier</label>
          <input type="hidden" name="supplier_id" id="suppIdField" />
          <div class="supp-wrap">
            <input type="text" name="supplier_name" id="supplierInput" class="form-input" placeholder="Search suppliers or type name…" autocomplete="off"
              oninput="suppFilter(this.value)" onfocus="suppFilter(this.value)" />
            <div class="supp-drop" id="suppDrop"></div>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Invoice / Receipt #</label>
          <input type="text" name="invoice_no" class="form-input" placeholder="optional" />
        </div>
        <div class="form-group">
          <label class="form-label">Date</label>
          <input type="date" name="receipt_date" class="form-input" value="<%= new Date().toISOString().slice(0,10) %>" />
        </div>
      </div>
      <div class="form-group" style="margin-top:12px">
        <label class="form-label">Notes</label>
        <input type="text" name="notes" class="form-input" placeholder="optional..." />
      </div>
      <div class="form-group" style="margin-top:12px">
        <label class="form-label">Bill Image <span style="font-size:.7rem;color:#555;font-weight:400;text-transform:none">(photo / scan — auto-compressed)</span></label>
        <input type="hidden" name="bill_image" id="billImageData" />
        <div id="imgPickerWrap" style="position:relative">
          <label for="billImageFile" id="imgDropZone" style="display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;border:2px dashed #2a2a3e;border-radius:10px;padding:22px 14px;cursor:pointer;transition:border-color .15s;min-height:90px">
            <span style="font-size:1.6rem">🖼️</span>
            <span style="font-size:.82rem;color:#555">Click or drag an image here</span>
            <span style="font-size:.72rem;color:#444">JPG, PNG, HEIC, WEBP — resized to max 1200 px, compressed automatically</span>
          </label>
          <input type="file" id="billImageFile" accept="image/*" style="display:none" onchange="handleBillImage(this.files[0])" />
        </div>
        <div id="imgPreviewWrap" style="display:none;margin-top:10px;position:relative">
          <img id="imgPreviewEl" style="max-width:100%;max-height:220px;border-radius:8px;border:1px solid #2a2a3e;object-fit:contain;display:block" />
          <div style="margin-top:6px;display:flex;align-items:center;gap:8px">
            <span id="imgSizeLabel" style="font-size:.72rem;color:#00b894"></span>
            <button type="button" onclick="clearBillImage()" style="background:none;border:none;color:#e74c3c;font-size:.78rem;cursor:pointer;font-family:inherit">✕ Remove</button>
          </div>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-title">
        <span>📦 Items Purchased</span>
        <div style="display:flex;gap:8px;align-items:center">
          <div style="position:relative;display:flex;align-items:center">
            <span style="position:absolute;left:10px;font-size:.9rem;pointer-events:none">📷</span>
            <input type="text" id="barcodeInput" placeholder="Scan barcode…" autocomplete="off"
              style="padding:6px 10px 6px 32px;background:#0f0f1a;border:1.5px solid #2a2a3e;border-radius:8px;color:#fff;font-size:.85rem;font-family:inherit;outline:none;width:180px"
              onfocus="this.style.borderColor='#7c5cbf'" onblur="this.style.borderColor='#2a2a3e'"
              onkeydown="if(event.key==='Enter'){event.preventDefault();scanBarcode(this.value);this.value='';}" />
          </div>
          <button type="button" class="btn btn-primary" onclick="addLine()">+ Add Row</button>
        </div>
      </div>

      <table class="lines-table">
        <thead>
          <tr>
            <th style="width:30%">Item</th>
            <th style="width:9%">Unit</th>
            <th style="width:12%">Qty</th>
            <th style="width:20%">Unit Price (<%= tenant.currency || 'IQD' %>)</th>
            <th style="width:17%">Last Price</th>
            <th style="width:8%">Total</th>
            <th style="width:4%"></th>
          </tr>
        </thead>
        <tbody id="linesBody"></tbody>
      </table>

      <div class="total-row">
        <span style="font-size:.82rem;color:#555">Grand Total</span>
        <span style="font-size:1.4rem;font-weight:800;color:#fff" id="grandTotal"><%= tenant.currency || 'IQD' %> 0.00</span>
      </div>
    </div>

    <div style="display:flex;justify-content:flex-end;gap:12px">
      <a href="/inventory/purchases" class="btn btn-ghost">Cancel</a>
      <button type="submit" class="btn btn-success">✓ Save Receipt</button>
    </div>
  </form>
</div>

<script>
const CUR = '<%= tenant.currency || "IQD" %>';
const INV_ITEMS = <%- JSON.stringify(invItems) %>;
const SUPPLIERS = <%- JSON.stringify(suppliers) %>;
const LAST_PRICES = <%- JSON.stringify(lastPrices) %>;
let idx = 0;

// ── Supplier autocomplete ──────────────────────────────────────────
let _suppList = <%- JSON.stringify(suppliers) %>; // live-updated when new supplier is created

function suppFilter(q) {
  const drop = document.getElementById('suppDrop');
  const ql = (q||'').toLowerCase();
  const matches = _suppList.filter(s => s.name.toLowerCase().includes(ql));
  if (matches.length === 0 && !q) { drop.classList.remove('open'); return; }
  let html = matches.map(s => `<div class="supp-opt" onclick="suppSelect(${s.id},'${escJ(s.name)}')">${escH(s.name)}</div>`).join('');
  if (!matches.length) html = `<div class="supp-opt" style="color:#555;cursor:default">No match found</div>`;
  html += `<div class="supp-opt-create" onclick="openCreateSupplier('${escJ(q||'')}')">➕ Create new supplier${q ? ': <b>' + escH(q) + '</b>' : ''}</div>`;
  drop.innerHTML = html;
  drop.classList.add('open');
}
function suppSelect(id, name) {
  document.getElementById('supplierInput').value = name;
  document.getElementById('suppIdField').value = id || '';
  document.getElementById('suppDrop').classList.remove('open');
}
document.addEventListener('click', e => {
  if (!e.target.closest('.supp-wrap')) document.getElementById('suppDrop').classList.remove('open');
});
document.addEventListener('keydown', e => {
  const drop = document.getElementById('suppDrop');
  if (!drop.classList.contains('open')) return;
  const opts = drop.querySelectorAll('.supp-opt');
  const cur  = drop.querySelector('.supp-opt.focused');
  let ci = Array.from(opts).indexOf(cur);
  if (e.key === 'ArrowDown') { e.preventDefault(); if(cur)cur.classList.remove('focused'); const n=opts[Math.min(ci+1,opts.length-1)]; if(n){n.classList.add('focused');n.scrollIntoView({block:'nearest'});} }
  else if (e.key === 'ArrowUp') { e.preventDefault(); if(cur)cur.classList.remove('focused'); const p=opts[Math.max(ci-1,0)]; if(p){p.classList.add('focused');p.scrollIntoView({block:'nearest'});} }
  else if (e.key === 'Enter' && cur) { e.preventDefault(); cur.click(); }
  else if (e.key === 'Escape') drop.classList.remove('open');
});

// ── Quick-create supplier modal ────────────────────────────────────
function openCreateSupplier(prefill) {
  document.getElementById('suppDrop').classList.remove('open');
  document.getElementById('qsName').value = prefill || '';
  document.getElementById('qsPhone').value = '';
  document.getElementById('qsEmail').value = '';
  document.getElementById('qsAddress').value = '';
  document.getElementById('qsTaxNo').value = '';
  document.getElementById('qsBalance').value = '0';
  document.getElementById('qsNotes').value = '';
  document.getElementById('qsError').style.display = 'none';
  document.getElementById('qsModal').classList.add('open');
  document.getElementById('qsName').focus();
}
function closeCreateSupplier() {
  document.getElementById('qsModal').classList.remove('open');
}
async function submitCreateSupplier() {
  const name = document.getElementById('qsName').value.trim();
  if (!name) { showQsError('Supplier name is required'); return; }
  const btn = document.getElementById('qsSaveBtn');
  btn.disabled = true; btn.textContent = 'Saving…';
  try {
    const r = await fetch('/inventory/suppliers/quick', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        name,
        phone:           document.getElementById('qsPhone').value.trim()||null,
        email:           document.getElementById('qsEmail').value.trim()||null,
        address:         document.getElementById('qsAddress').value.trim()||null,
        tax_no:          document.getElementById('qsTaxNo').value.trim()||null,
        opening_balance: document.getElementById('qsBalance').value||0,
        notes:           document.getElementById('qsNotes').value.trim()||null,
      }),
    });
    const data = await r.json();
    if (!data.ok) { showQsError(data.error || 'Failed to save'); return; }
    // Add to local list and select
    _suppList.push({ id: data.id, name: data.name });
    suppSelect(data.id, data.name);
    closeCreateSupplier();
  } catch (e) { showQsError('Network error'); }
  btn.disabled = false; btn.textContent = 'Save Supplier';
}
function showQsError(msg) {
  const el = document.getElementById('qsError');
  el.textContent = msg; el.style.display = 'block';
}

// ── Searchable picker ──────────────────────────────────────────────
function createPicker(i) {
  const wrap = document.createElement('div');
  wrap.className = 'item-picker';
  wrap.id = 'picker_' + i;

  // Hidden value field submitted with form
  const hidden = document.createElement('input');
  hidden.type = 'hidden';
  hidden.name = 'item_id';
  hidden.id   = 'item_id_' + i;

  // Visible search input
  const search = document.createElement('input');
  search.type = 'text';
  search.className = 'item-search';
  search.placeholder = 'Search item…';
  search.autocomplete = 'off';
  search.id = 'search_' + i;

  const arrow = document.createElement('span');
  arrow.className = 'picker-arrow';
  arrow.textContent = '▾';

  // Dropdown
  const drop = document.createElement('div');
  drop.className = 'picker-dropdown';
  drop.id = 'drop_' + i;

  wrap.appendChild(hidden);
  wrap.appendChild(search);
  wrap.appendChild(arrow);
  wrap.appendChild(drop);

  // Events
  search.addEventListener('focus', () => { renderDrop(i, search.value); drop.classList.add('open'); });
  search.addEventListener('input', () => { hidden.value = ''; renderDrop(i, search.value); drop.classList.add('open'); });
  search.addEventListener('keydown', e => handleKey(e, i));
  document.addEventListener('click', e => { if (!wrap.contains(e.target)) drop.classList.remove('open'); });

  return wrap;
}

function renderDrop(i, q) {
  const drop   = document.getElementById('drop_' + i);
  const search = document.getElementById('search_' + i);
  q = (q || '').toLowerCase().trim();

  const filtered = INV_ITEMS.filter(it => it.name.toLowerCase().includes(q));
  let html = `<div class="picker-opt create" onclick="selectNew(${i})">➕ Create new item${q ? ': <b>' + escH(q) + '</b>' : '…'}</div>`;

  if (filtered.length === 0 && q) {
    html += `<div class="picker-empty">No match — will create "${escH(q)}"</div>`;
  } else {
    filtered.forEach(it => {
      html += `<div class="picker-opt" onclick="selectItem(${i},${it.id},'${escJ(it.name)}','${escJ(it.unit)}')">${escH(it.name)}<span class="unit-tag">${escH(it.unit)}</span></div>`;
    });
  }
  drop.innerHTML = html;
}

function handleKey(e, i) {
  const drop = document.getElementById('drop_' + i);
  const opts = drop.querySelectorAll('.picker-opt:not([disabled])');
  const cur  = drop.querySelector('.picker-opt.focused');
  let curIdx = Array.from(opts).indexOf(cur);

  if (e.key === 'ArrowDown') {
    e.preventDefault();
    if (cur) cur.classList.remove('focused');
    const next = opts[Math.min(curIdx + 1, opts.length - 1)];
    if (next) { next.classList.add('focused'); next.scrollIntoView({ block: 'nearest' }); }
  } else if (e.key === 'ArrowUp') {
    e.preventDefault();
    if (cur) cur.classList.remove('focused');
    const prev = opts[Math.max(curIdx - 1, 0)];
    if (prev) { prev.classList.add('focused'); prev.scrollIntoView({ block: 'nearest' }); }
  } else if (e.key === 'Enter') {
    e.preventDefault();
    if (cur) cur.click();
    else {
      // Enter with no selection → treat typed text as "create new"
      selectNew(i);
    }
  } else if (e.key === 'Escape') {
    drop.classList.remove('open');
  }
}

function selectItem(i, id, name, unit) {
  document.getElementById('item_id_' + i).value = id;
  document.getElementById('search_'  + i).value = name;
  document.getElementById('drop_'    + i).classList.remove('open');
  const unitFld = document.getElementById('unit_' + i);
  unitFld.value = unit;
  unitFld.setAttribute('readonly', 'readonly');
  document.getElementById('newRow_'  + i).classList.remove('show');

  // Auto-fill last price and show hint
  const lp = LAST_PRICES[id];
  const priceInput = document.getElementById('price_' + i);
  const lastCell   = document.getElementById('last_' + i);
  if (lp && lp.price > 0) {
    if (!priceInput.value || parseFloat(priceInput.value) === 0) {
      priceInput.value = lp.price.toFixed(4);
      recalc(i);
    }
    let hint = `<span style="color:#a78bdf;font-weight:700">${CUR} ${lp.price.toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2})}</span>`;
    if (lp.date) hint += `<br><span style="color:#444;font-size:.7rem">${lp.date}`;
    if (lp.supplier) hint += ` · ${lp.supplier}`;
    if (lp.date) hint += `</span>`;
    lastCell.innerHTML = hint;
  } else {
    lastCell.innerHTML = '<span style="color:#333;font-size:.75rem">No history</span>';
  }
  updateDiff(i);
}

function selectNew(i) {
  const search = document.getElementById('search_' + i);
  document.getElementById('item_id_' + i).value = 'new';
  document.getElementById('drop_'    + i).classList.remove('open');
  const unitFld = document.getElementById('unit_' + i);
  unitFld.value = '';
  unitFld.removeAttribute('readonly');
  const newRow  = document.getElementById('newRow_' + i);
  newRow.classList.add('show');
  // Pre-fill new item name with whatever was typed
  const nameInput = document.getElementById('newName_' + i);
  if (search.value && !nameInput.value) nameInput.value = search.value;
  search.value = '➕ Create new item';
  nameInput.focus();
}

function escH(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
function escJ(s) { return String(s).replace(/\\/g,'\\\\').replace(/'/g,"\\'"); }

// ── Row management ─────────────────────────────────────────────────
function mkTd(html) { const td = document.createElement('td'); td.innerHTML = html; return td; }

function addLine() {
  const tbody = document.getElementById('linesBody');
  const tr = document.createElement('tr');
  const i  = idx++;
  tr.id = 'line_' + i;

  // Cell 1: item picker + new-item row (built as DOM nodes to preserve listeners)
  const tdItem = document.createElement('td');
  tdItem.appendChild(createPicker(i));
  const newRow = document.createElement('div');
  newRow.className = 'new-item-row';
  newRow.id = 'newRow_' + i;
  newRow.innerHTML = `<div class="new-item-hint">✦ New item name:</div><input type="text" name="new_item_name" class="line-input" placeholder="Item name" id="newName_${i}" />`;
  tdItem.appendChild(newRow);

  // Remaining cells
  const tdUnit  = mkTd(`<input type="text" name="unit" id="unit_${i}" class="line-input" placeholder="kg" />`);
  const tdQty   = mkTd(`<input type="number" name="quantity" id="qty_${i}" class="line-input" step="0.001" min="0.001" placeholder="0" required />`);
  const tdPrice = mkTd(`<input type="number" name="unit_price" id="price_${i}" class="line-input" step="0.0001" min="0" placeholder="0.00" required />`);
  const tdLast  = mkTd(`<div id="last_${i}" style="font-size:.78rem;line-height:1.5;color:#555">—</div>`);
  const tdTotal = mkTd(`<span class="line-total" id="lt_${i}">${CUR} 0.00</span>`);
  const tdDel   = mkTd(`<button type="button" class="btn-remove">✕</button>`);
  tdDel.querySelector('button').onclick = () => removeLine(i);
  tdQty.querySelector('input').oninput   = () => recalc(i);
  tdPrice.querySelector('input').oninput = () => recalc(i);

  tr.append(tdItem, tdUnit, tdQty, tdPrice, tdLast, tdTotal, tdDel);
  tbody.appendChild(tr);
  document.getElementById('search_' + i).focus();
}

function updateDiff(i) {
  const itemId = document.getElementById('item_id_' + i)?.value;
  const lp = itemId && LAST_PRICES[itemId];
  if (!lp || !lp.price) return;
  const cur = parseFloat(document.getElementById('price_' + i)?.value) || 0;
  if (!cur) return;
  const diff = cur - lp.price;
  const pct  = (diff / lp.price * 100);
  const el   = document.getElementById('last_' + i);
  if (!el) return;
  const diffStr = (diff >= 0 ? '▲ +' : '▼ ') + Math.abs(diff).toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2})
    + ' (' + (diff >= 0 ? '+' : '') + pct.toFixed(1) + '%)';
  const color = diff > 0 ? '#e74c3c' : diff < 0 ? '#00b894' : '#888';
  let hint = `<span style="color:#a78bdf;font-weight:700">${CUR} ${lp.price.toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2})}</span>`;
  if (lp.date) hint += `<br><span style="color:#444;font-size:.7rem">${lp.date}${lp.supplier ? ' · ' + lp.supplier : ''}</span>`;
  hint += `<br><span style="color:${color};font-size:.78rem;font-weight:700">${diffStr}</span>`;
  el.innerHTML = hint;
}

function recalc(i) {
  const qty   = parseFloat(document.getElementById('qty_'   + i)?.value) || 0;
  const price = parseFloat(document.getElementById('price_' + i)?.value) || 0;
  const el    = document.getElementById('lt_' + i);
  if (el) el.textContent = CUR + ' ' + (qty * price).toFixed(2);
  updateDiff(i);
  recalcTotal();
}

function recalcTotal() {
  let sum = 0;
  document.querySelectorAll('[id^="lt_"]').forEach(el => {
    sum += parseFloat(el.textContent.replace(CUR, '').trim()) || 0;
  });
  document.getElementById('grandTotal').textContent = CUR + ' ' + sum.toFixed(2);
}

function removeLine(i) {
  const row = document.getElementById('line_' + i);
  if (row) row.remove();
  recalcTotal();
}

addLine();

// ── Bill image: client-side resize & compress ──────────────────────
const MAX_PX = 1200;
const QUALITY = 0.72;

function handleBillImage(file) {
  if (!file) return;
  const reader = new FileReader();
  reader.onload = e => resizeAndStore(e.target.result);
  reader.readAsDataURL(file);
}

function resizeAndStore(dataUrl) {
  const img = new Image();
  img.onload = () => {
    let { width: w, height: h } = img;
    if (w > MAX_PX || h > MAX_PX) {
      const ratio = Math.min(MAX_PX / w, MAX_PX / h);
      w = Math.round(w * ratio);
      h = Math.round(h * ratio);
    }
    const canvas = document.createElement('canvas');
    canvas.width  = w;
    canvas.height = h;
    canvas.getContext('2d').drawImage(img, 0, 0, w, h);
    const out = canvas.toDataURL('image/jpeg', QUALITY);
    document.getElementById('billImageData').value = out;
    document.getElementById('imgPreviewEl').src = out;
    document.getElementById('imgPreviewWrap').style.display = 'block';
    document.getElementById('imgDropZone').style.borderColor = '#7c5cbf';
    const kb = Math.round(out.length * 0.75 / 1024);
    document.getElementById('imgSizeLabel').textContent = `${w}×${h}px — ~${kb} KB`;
  };
  img.src = dataUrl;
}

function clearBillImage() {
  document.getElementById('billImageData').value = '';
  document.getElementById('billImageFile').value = '';
  document.getElementById('imgPreviewWrap').style.display = 'none';
  document.getElementById('imgDropZone').style.borderColor = '#2a2a3e';
}

// ── Barcode scanner ────────────────────────────────────────────────
async function scanBarcode(code) {
  code = (code || '').trim();
  if (!code) return;
  try {
    const r = await fetch('/inventory/api/barcode/' + encodeURIComponent(code));
    const data = await r.json();
    if (!data.found) {
      showScanToast('⚠ No item found for barcode: ' + code, '#e74c3c');
      return;
    }
    const item = data.item;
    addLine();
    const i = idx - 1;
    // Small delay so DOM is ready
    setTimeout(() => {
      selectItem(i, item.id, item.name, item.unit);
      const qtyInput = document.getElementById('qty_' + i);
      if (qtyInput) { qtyInput.value = 1; qtyInput.focus(); recalc(i); }
    }, 50);
    showScanToast('✓ ' + item.name, '#00b894');
  } catch (e) {
    showScanToast('⚠ Scanner error', '#e74c3c');
  }
}
function showScanToast(msg, color) {
  let t = document.getElementById('scanToast');
  if (!t) { t = document.createElement('div'); t.id = 'scanToast'; document.body.appendChild(t); }
  t.textContent = msg;
  t.style.cssText = `position:fixed;top:70px;right:20px;padding:9px 16px;border-radius:9px;font-size:.85rem;font-weight:700;z-index:9999;background:${color}22;color:${color};border:1px solid ${color}44;transition:opacity .4s`;
  t.style.opacity = '1';
  clearTimeout(t._timer);
  t._timer = setTimeout(() => { t.style.opacity = '0'; }, 2200);
}

// Drag-and-drop support
const dz = document.getElementById('imgDropZone');
dz.addEventListener('dragover', e => { e.preventDefault(); dz.style.borderColor = '#7c5cbf'; });
dz.addEventListener('dragleave', () => dz.style.borderColor = document.getElementById('billImageData').value ? '#7c5cbf' : '#2a2a3e');
dz.addEventListener('drop', e => { e.preventDefault(); const f = e.dataTransfer.files[0]; if (f && f.type.startsWith('image/')) handleBillImage(f); });
</script>

