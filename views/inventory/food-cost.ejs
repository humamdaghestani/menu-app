<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>Food Cost % — <%= tenant.name %></title>
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    body{font-family:'Segoe UI',sans-serif;background:#0f0f1a;color:#e0e0e0;min-height:100vh}
    .topbar{background:#1a1a2e;height:56px;display:flex;align-items:center;justify-content:space-between;padding:0 24px;border-bottom:1px solid rgba(255,255,255,.07);position:sticky;top:0;z-index:50}
    .btn{padding:7px 14px;border:none;border-radius:8px;cursor:pointer;font-size:.8rem;font-weight:600;font-family:inherit;text-decoration:none;display:inline-flex;align-items:center;gap:5px}
    .btn-ghost{background:rgba(255,255,255,.08);color:#ccc}.btn-ghost:hover{background:rgba(255,255,255,.14);color:#fff}
    .btn-primary{background:#7c5cbf;color:#fff}
    .main{padding:24px;max-width:1100px;margin:0 auto}
    .page-title{font-size:1.3rem;font-weight:800;color:#fff;margin-bottom:4px}
    .page-sub{font-size:.82rem;color:#555;margin-bottom:20px}
    .filter-row{display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap;margin-bottom:20px}
    .fg{display:flex;flex-direction:column;gap:4px}
    .fl{font-size:.68rem;font-weight:700;text-transform:uppercase;color:#555}
    input[type=date],input[type=number]{background:#1a1a2e;border:1.5px solid #2a2a3e;color:#fff;padding:7px 10px;border-radius:8px;font-family:inherit;font-size:.82rem;outline:none}
    input[type=number]{width:70px}
    .summary-bar{background:#1a1a2e;border-radius:14px;border:1px solid #2a2a3e;padding:18px 24px;margin-bottom:20px;display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:16px}
    .s-label{font-size:.67rem;text-transform:uppercase;color:#444;font-weight:700;margin-bottom:5px}
    .s-val{font-size:1.35rem;font-weight:800}
    .card{background:#1a1a2e;border-radius:14px;border:1px solid #2a2a3e;overflow:hidden}
    table{width:100%;border-collapse:collapse}
    th{text-align:left;font-size:.67rem;text-transform:uppercase;color:#444;font-weight:700;padding:9px 14px;border-bottom:1px solid #2a2a3e}
    td{padding:10px 14px;font-size:.83rem;color:#ccc;border-bottom:1px solid rgba(255,255,255,.04);vertical-align:middle}
    tr:last-child td{border-bottom:none}
    .empty{text-align:center;padding:48px;color:#333}
    .pct-bar-wrap{width:100px;height:8px;background:#2a2a3e;border-radius:4px;overflow:hidden;display:inline-block;vertical-align:middle}
    .pct-bar{height:100%;border-radius:4px}
    .fc-ok{color:#00b894}
    .fc-warn{color:#f39c12}
    .fc-bad{color:#e74c3c}
  </style>
</head>
<body>
<div class="topbar">
  <div style="display:flex;align-items:center;gap:8px">
    <a href="/admin" class="btn btn-ghost" style="padding:6px 10px;font-size:1.1rem">🏠</a>
    <a href="/inventory" class="btn btn-ghost">Inventory</a>
    <span style="color:#444;font-size:.85rem;font-weight:600">/ Food Cost %</span>
  </div>
</div>

<div class="main">
  <div class="page-title">🍽️ Food Cost % by Menu Item</div>
  <div class="page-sub">BOM cost ÷ revenue for each item sold. Target line shows your food cost budget.</div>

  <form method="GET" action="/inventory/food-cost" class="filter-row">
    <div class="fg"><div class="fl">From</div><input type="date" name="from" value="<%= from %>" /></div>
    <div class="fg"><div class="fl">To</div><input type="date" name="to" value="<%= to %>" /></div>
    <div class="fg"><div class="fl">Target %</div><input type="number" name="target" value="<%= target %>" min="1" max="100" step="1" /></div>
    <button type="submit" class="btn btn-primary">Apply</button>
  </form>

  <div class="summary-bar">
    <div>
      <div class="s-label">Total Revenue</div>
      <div class="s-val" style="color:#fff"><%= (tenant.currency||'') %><%= totalRev.toLocaleString(undefined,{maximumFractionDigits:0}) %></div>
    </div>
    <div>
      <div class="s-label">Total COGS</div>
      <div class="s-val" style="color:#a78bdf"><%= (tenant.currency||'') %><%= totalCogs.toLocaleString(undefined,{maximumFractionDigits:0}) %></div>
    </div>
    <div>
      <div class="s-label">Overall Food Cost %</div>
      <div class="s-val" style="color:<%= overallFcPct <= target ? '#00b894' : overallFcPct <= target*1.2 ? '#f39c12' : '#e74c3c' %>"><%= overallFcPct.toFixed(1) %>%</div>
    </div>
    <div>
      <div class="s-label">Target</div>
      <div class="s-val" style="color:#555"><%= target %>%</div>
    </div>
    <div>
      <div class="s-label">Items Above Target</div>
      <div class="s-val" style="color:#e74c3c"><%= rows.filter(r=>r.fcPct>target && r.rev>0).length %></div>
    </div>
    <div>
      <div class="s-label">Items Tracked</div>
      <div class="s-val" style="color:#fff"><%= rows.length %></div>
    </div>
  </div>

  <% if (!rows.length) { %>
  <div class="card"><div class="empty">No sales data for this period, or no items have recipes configured.</div></div>
  <% } else { %>
  <div class="card">
    <div style="overflow-x:auto">
    <table>
      <thead>
        <tr>
          <th>Menu Item</th>
          <th>Sell Price</th>
          <th>BOM Cost</th>
          <th>Qty Sold</th>
          <th>Revenue</th>
          <th>COGS</th>
          <th style="white-space:nowrap">Food Cost %</th>
        </tr>
      </thead>
      <tbody>
      <% rows.forEach(r => {
        const cls = r.fcPct <= target ? 'fc-ok' : r.fcPct <= target*1.3 ? 'fc-warn' : 'fc-bad';
        const barPct = Math.min(r.fcPct, 100);
        const barColor = r.fcPct <= target ? '#00b894' : r.fcPct <= target*1.3 ? '#f39c12' : '#e74c3c';
      %>
      <tr>
        <td style="color:#ddd;font-weight:600"><%= r.name %></td>
        <td><%= (tenant.currency||'') %><%= parseFloat(r.sell_price).toFixed(2) %></td>
        <td style="color:#a78bdf"><%= (tenant.currency||'') %><%= (r.bom||0).toFixed(4) %></td>
        <td style="color:#888"><%= r.qty.toLocaleString(undefined,{maximumFractionDigits:0}) %></td>
        <td><%= (tenant.currency||'') %><%= r.rev.toLocaleString(undefined,{maximumFractionDigits:2}) %></td>
        <td><%= (tenant.currency||'') %><%= r.cogs.toLocaleString(undefined,{maximumFractionDigits:2}) %></td>
        <td>
          <div style="display:flex;align-items:center;gap:8px">
            <span class="<%= cls %>" style="font-weight:700;min-width:44px"><%= r.rev > 0 ? r.fcPct.toFixed(1)+'%' : '—' %></span>
            <% if (r.rev > 0) { %>
            <div class="pct-bar-wrap">
              <div class="pct-bar" style="width:<%= barPct %>%;background:<%= barColor %>"></div>
            </div>
            <% } %>
          </div>
        </td>
      </tr>
      <% }); %>
      </tbody>
    </table>
    </div>
  </div>
  <div style="font-size:.72rem;color:#333;padding:10px;text-align:center">
    Food Cost % = BOM cost per portion × qty sold ÷ revenue · Target: <%= target %>% · Items without a recipe show 0% BOM cost
  </div>
  <% } %>
</div>
</body>
</html>
