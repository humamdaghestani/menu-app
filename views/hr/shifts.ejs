<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Shifts — <%= tenant.name %></title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Segoe UI', sans-serif; background: #0f0f1a; color: #e0e0e0; min-height: 100vh; }
    .topbar { background: #1a1a2e; height: 60px; display: flex; align-items: center; justify-content: space-between; padding: 0 20px; border-bottom: 1px solid rgba(255,255,255,.07); position: sticky; top: 0; z-index: 100; }
    .topbar-brand { font-weight: 700; color: #fff; font-size: 1rem; }
    .topbar-sub { font-size: .72rem; color: #555; }
    .btn { padding: 7px 14px; border: none; border-radius: 8px; cursor: pointer; font-size: .82rem; font-weight: 600; font-family: inherit; text-decoration: none; display: inline-flex; align-items: center; gap: 5px; }
    .btn-ghost { background: rgba(255,255,255,.08); color: #ccc; }
    .btn-ghost:hover { background: rgba(255,255,255,.14); color: #fff; }
    .btn-primary { background: #7c5cbf; color: #fff; }
    .btn-danger { background: rgba(231,76,60,.15); color: #e74c3c; }
    .main { padding: 28px; max-width: 1100px; margin: 0 auto; }
    .section { background: #1a1a2e; border: 1.5px solid #2a2a3e; border-radius: 12px; padding: 20px; margin-bottom: 20px; }
    .section h3 { color: #fff; font-size: .92rem; font-weight: 700; margin-bottom: 16px; }
    table { width: 100%; border-collapse: collapse; font-size: .85rem; }
    th { text-align: left; color: #555; font-size: .72rem; text-transform: uppercase; letter-spacing: .05em; padding: 8px 10px; border-bottom: 1px solid #2a2a3e; }
    td { padding: 10px; border-bottom: 1px solid #1e1e32; color: #ccc; }
    tr:last-child td { border-bottom: none; }
    .form-group { margin-bottom: 12px; }
    .form-group label { display: block; font-size: .78rem; color: #aaa; margin-bottom: 4px; }
    .form-group input, .form-group select { width: 100%; background: #0f0f1a; border: 1.5px solid #2a2a3e; color: #fff; padding: 8px 10px; border-radius: 8px; font-size: .85rem; font-family: inherit; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .week-nav { display: flex; align-items: center; gap: 10px; margin-bottom: 20px; }
    .week-nav input[type=date] { background: #1a1a2e; border: 1.5px solid #2a2a3e; color: #fff; padding: 7px 10px; border-radius: 8px; font-size: .82rem; }
  </style>
</head>
<body>
<div class="topbar">
  <div style="display:flex;align-items:center;gap:8px">
    <a href="/admin" class="btn btn-ghost" style="padding:6px 10px;font-size:1.1rem;flex-shrink:0" title="All Modules">🏠</a>
    <div>
      <div class="topbar-brand">📅 Shift Log</div>
      <div class="topbar-sub"><%= tenant.name %></div>
    </div>
  </div>
  <div style="display:flex;gap:8px">
    <a href="/hr" class="btn btn-ghost">👥 Employees</a>
    <a href="/hr/payroll" class="btn btn-ghost">💰 Payroll</a>
    <button onclick="history.back()" class="btn btn-ghost">← Back</button>
  </div>
</div>

<div class="main">
  <form method="GET" action="/hr/shifts">
    <div class="week-nav">
      <span style="color:#aaa;font-size:.85rem">Week starting:</span>
      <input type="date" name="week" value="<%= weekStart %>" onchange="this.form.submit()" />
    </div>
  </form>

  <div style="display:grid;grid-template-columns:1fr 320px;gap:20px">
    <div class="section">
      <h3>📋 Shifts</h3>
      <table>
        <thead><tr><th>Employee</th><th>Date</th><th>Start</th><th>End</th><th>Hours</th><th>Notes</th><th></th></tr></thead>
        <tbody>
        <% shifts.forEach(s => { %>
        <tr>
          <td style="color:#fff;font-weight:600"><%= s.employee_name %></td>
          <td><%= s.shift_date ? s.shift_date.toISOString().slice(0,10) : '—' %></td>
          <td><%= s.start_time || '—' %></td>
          <td><%= s.end_time || '—' %></td>
          <td><%= s.hours_worked || '—' %></td>
          <td style="font-size:.78rem;color:#555"><%= s.notes || '' %></td>
          <td>
            <form method="POST" action="/hr/shifts/<%= s.id %>/delete" onsubmit="return confirm('Delete shift?')">
              <button class="btn btn-danger" style="font-size:.72rem;padding:3px 8px">✕</button>
            </form>
          </td>
        </tr>
        <% }) %>
        <% if (!shifts.length) { %><tr><td colspan="7" style="color:#555;text-align:center;padding:24px">No shifts this week</td></tr><% } %>
        </tbody>
      </table>
    </div>

    <div class="section">
      <h3>➕ Log Shift</h3>
      <form method="POST" action="/hr/shifts">
        <div class="form-group">
          <label>Employee *</label>
          <select name="employee_id" required>
            <option value="">Select...</option>
            <% employees.forEach(e => { %><option value="<%= e.id %>"><%= e.name %></option><% }) %>
          </select>
        </div>
        <div class="form-group"><label>Date *</label><input type="date" name="shift_date" value="<%= weekStart %>" required /></div>
        <div class="form-row">
          <div class="form-group"><label>Start Time</label><input type="time" name="start_time" /></div>
          <div class="form-group"><label>End Time</label><input type="time" name="end_time" /></div>
        </div>
        <div class="form-group"><label>Hours Worked</label><input type="number" name="hours_worked" step="0.25" placeholder="8" /></div>
        <div class="form-group"><label>Notes</label><input type="text" name="notes" /></div>
        <button type="submit" class="btn btn-primary" style="width:100%">Log Shift</button>
      </form>
    </div>
  </div>
</div>
</body>
</html>
