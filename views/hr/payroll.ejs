<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Payroll — <%= tenant.name %></title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Segoe UI', sans-serif; background: #0f0f1a; color: #e0e0e0; min-height: 100vh; }
    .topbar { background: #1a1a2e; height: 60px; display: flex; align-items: center; justify-content: space-between; padding: 0 20px; border-bottom: 1px solid rgba(255,255,255,.07); position: sticky; top: 0; z-index: 100; }
    .topbar-brand { font-weight: 700; color: #fff; font-size: 1rem; }
    .topbar-sub { font-size: .72rem; color: #555; }
    .btn { padding: 7px 14px; border: none; border-radius: 8px; cursor: pointer; font-size: .82rem; font-weight: 600; font-family: inherit; text-decoration: none; display: inline-flex; align-items: center; gap: 5px; }
    .btn-ghost { background: rgba(255,255,255,.08); color: #ccc; }
    .btn-ghost:hover { background: rgba(255,255,255,.14); color: #fff; }
    .btn-primary { background: #7c5cbf; color: #fff; }
    .btn-success { background: rgba(0,184,148,.15); color: #00b894; }
    .btn-danger { background: rgba(231,76,60,.15); color: #e74c3c; }
    .main { padding: 28px; max-width: 1200px; margin: 0 auto; }
    .section { background: #1a1a2e; border: 1.5px solid #2a2a3e; border-radius: 12px; padding: 20px; margin-bottom: 20px; }
    .section h3 { color: #fff; font-size: .92rem; font-weight: 700; margin-bottom: 16px; }
    table { width: 100%; border-collapse: collapse; font-size: .85rem; }
    th { text-align: left; color: #555; font-size: .72rem; text-transform: uppercase; padding: 8px 10px; border-bottom: 1px solid #2a2a3e; }
    td { padding: 10px; border-bottom: 1px solid #1e1e32; color: #ccc; }
    tr:last-child td { border-bottom: none; }
    .badge { display: inline-block; padding: 2px 8px; border-radius: 20px; font-size: .7rem; font-weight: 700; }
    .badge-paid { background: rgba(0,184,148,.15); color: #00b894; }
    .badge-draft { background: rgba(243,156,18,.15); color: #f39c12; }
    .form-group { margin-bottom: 12px; }
    .form-group label { display: block; font-size: .78rem; color: #aaa; margin-bottom: 4px; }
    .form-group input, .form-group select { width: 100%; background: #0f0f1a; border: 1.5px solid #2a2a3e; color: #fff; padding: 8px 10px; border-radius: 8px; font-size: .85rem; font-family: inherit; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  </style>
</head>
<body>
<div class="topbar">
  <div style="display:flex;align-items:center;gap:8px">
    <a href="/hr" class="btn btn-ghost" style="padding:6px 10px;font-size:1.1rem;flex-shrink:0" title="Hr Home">🏠</a>
    <a href="/admin" class="btn btn-ghost" style="padding:5px 10px;font-size:.78rem;flex-shrink:0" title="All Modules">⊞ Modules</a>
    <div>
      <div class="topbar-brand">💰 Payroll</div>
      <div class="topbar-sub"><%= tenant.name %></div>
    </div>
  </div>
  <div style="display:flex;gap:8px">
    <a href="/hr" class="btn btn-ghost">👥 Employees</a>
    <a href="/hr/shifts" class="btn btn-ghost">📅 Shifts</a>
    <button onclick="history.back()" class="btn btn-ghost">← Back</button>
  </div>
</div>

<div class="main">
  <div style="display:grid;grid-template-columns:1fr 320px;gap:20px">
    <div class="section">
      <h3>📋 Payroll Records</h3>
      <table>
        <thead><tr><th>Employee</th><th>Period</th><th>Base</th><th>Allowances</th><th>Deductions</th><th>Net Pay</th><th>Status</th><th>Actions</th></tr></thead>
        <tbody>
        <% payrolls.forEach(p => { %>
        <tr>
          <td style="color:#fff;font-weight:600"><%= p.employee_name %></td>
          <td style="font-size:.78rem"><%= p.period_start.toISOString().slice(0,10) %> → <%= p.period_end.toISOString().slice(0,10) %></td>
          <td>$<%= parseFloat(p.base_salary).toFixed(2) %></td>
          <td style="color:#00b894">+$<%= parseFloat(p.allowances).toFixed(2) %></td>
          <td style="color:#e74c3c">-$<%= parseFloat(p.deductions).toFixed(2) %></td>
          <td style="font-weight:700;color:#fff">$<%= parseFloat(p.net_pay).toFixed(2) %></td>
          <td><span class="badge badge-<%= p.status %>"><%= p.status %></span></td>
          <td style="display:flex;gap:5px">
            <% if (p.status === 'draft') { %>
            <form method="POST" action="/hr/payroll/<%= p.id %>/pay"><button class="btn btn-success" style="font-size:.72rem;padding:3px 8px">Pay</button></form>
            <% } %>
            <form method="POST" action="/hr/payroll/<%= p.id %>/delete" onsubmit="return confirm('Delete?')"><button class="btn btn-danger" style="font-size:.72rem;padding:3px 8px">✕</button></form>
          </td>
        </tr>
        <% }) %>
        <% if (!payrolls.length) { %><tr><td colspan="8" style="color:#555;text-align:center;padding:24px">No payroll records</td></tr><% } %>
        </tbody>
      </table>
    </div>

    <div class="section">
      <h3>➕ Create Payroll</h3>
      <form method="POST" action="/hr/payroll">
        <div class="form-group">
          <label>Employee *</label>
          <select name="employee_id" required>
            <option value="">Select...</option>
            <% employees.forEach(e => { %><option value="<%= e.id %>"><%= e.name %> ($<%= parseFloat(e.salary).toFixed(0) %>/<%= e.salary_type %>)</option><% }) %>
          </select>
        </div>
        <div class="form-row">
          <div class="form-group"><label>Period Start *</label><input type="date" name="period_start" required /></div>
          <div class="form-group"><label>Period End *</label><input type="date" name="period_end" required /></div>
        </div>
        <div class="form-group"><label>Base Salary ($)</label><input type="number" name="base_salary" step="0.01" value="0" /></div>
        <div class="form-row">
          <div class="form-group"><label>Allowances ($)</label><input type="number" name="allowances" step="0.01" value="0" /></div>
          <div class="form-group"><label>Deductions ($)</label><input type="number" name="deductions" step="0.01" value="0" /></div>
        </div>
        <div class="form-group"><label>Notes</label><input type="text" name="notes" /></div>
        <button type="submit" class="btn btn-primary" style="width:100%">Create Payroll</button>
      </form>
    </div>
  </div>
</div>
</body>
</html>
